# Runtime env for the production container (server-side, process.env).
# Copy to .env.docker on the VPS and fill in real values. Never commit .env.docker.
#
# IMPORTANT: this file now reflects the shape AFTER the Supabase rebuild cutover (see
# KE_HOACH_REBUILD_FULLSTACK.md) — Supabase vars (SUPABASE_URL/SUPABASE_PUBLISHABLE_KEY/
# SUPABASE_SERVICE_ROLE_KEY) are gone because nothing in the code reads them anymore. The VPS's
# CURRENTLY LIVE `.env.docker` is still the old 100%-Supabase shape and must keep its SUPABASE_* values
# until the actual cutover (Giai đoạn 7) — do not blindly overwrite it with this template before then.

# Lovable connector gateway (used to proxy Paddle payments)
LOVABLE_API_KEY=

# Direct AI providers (bypass Lovable Gateway) — see src/lib/ai-providers.server.ts. Leave
# AI_TEXT_PROVIDER/AI_AUDIO_PROVIDER unset to keep using Lovable (current production behavior) —
# switching is config-only, no code change: set AI_TEXT_PROVIDER=gemini|deepseek and/or
# AI_AUDIO_PROVIDER=gemini once you're ready to actually cut over on the live server.
# AI_TEXT_PROVIDER=
# AI_AUDIO_PROVIDER=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Paddle payments
PADDLE_LIVE_API_KEY=
PADDLE_SANDBOX_API_KEY=
PAYMENTS_LIVE_WEBHOOK_SECRET=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=

# Cron endpoint auth
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# ---------------------------------------------------------------------------
# Below: for the in-progress rebuild off Supabase (KE_HOACH_REBUILD_FULLSTACK.md).
# Not used by the current production deployment yet — only needed once that
# migration cuts over. See HUONG_DAN_LAY_SMTP_GOOGLE_OAUTH.md for how to get
# the SMTP/Google values.
# ---------------------------------------------------------------------------

# Self-hosted Postgres (replaces Supabase)
DATABASE_URL=postgres://<user>:<password>@postgres:5432/lingoraenglish

# Base URL used to build links in emails (verify/reset) — no trailing slash.
APP_URL=https://lingoraenglishai.com

# SMTP — email verification + password reset. Leave blank to log instead of
# sending (see src/lib/email.server.ts).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lingora English <no-reply@lingoraenglishai.com>"

# DEV/STAGING ONLY — never set this on the real deployment. With no SMTP
# configured yet there's no verification email to click, so this skips the
# "confirm your email" gate entirely: signUp logs the learner in immediately
# and signIn no longer checks emailConfirmedAt (see auth.functions.ts). Only
# takes effect when NODE_ENV is NOT "production" — that check is hardcoded,
# not just documentation, so leaving this "true" in a prod env file by
# accident does nothing on the live server.
AUTH_DEV_SKIP_EMAIL_VERIFICATION=false

# Google OAuth — GOOGLE_CLIENT_ID must equal VITE_GOOGLE_CLIENT_ID (same
# Client ID, not a secret; VITE_GOOGLE_CLIENT_ID is baked into the client
# bundle at build time so it must also be set wherever `docker build` runs,
# not just in this runtime file). GOOGLE_CLIENT_SECRET is server-only.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

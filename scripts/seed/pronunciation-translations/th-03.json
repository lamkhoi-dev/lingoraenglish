[{"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|point|3", "text": "got to → gotta"}, {"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|caution", "text": "รูปแบบเหล่านี้เป็นภาษาพูดแบบไม่เป็นทางการ ห้ามเขียนในเรียงความ อีเมล หรือการสอบที่เป็นทางการ และหลีกเลี่ยงการใช้ในการนำเสนอที่เป็นทางการ"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|explain", "text": "การย่อคำแบบสบาย ๆ ที่คุณจะได้ยินบ่อยมากในภาพยนตร์และบทสนทนาในชีวิตจริง"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|0", "text": "kind of → kinda"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|1", "text": "sort of → sorta"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|2", "text": "let me → lemme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|3", "text": "give me → gimme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|4", "text": "what do you → whaddaya"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|caution", "text": "ใช้เฉพาะภาษาพูดไม่เป็นทางการเท่านั้น ในการสอบ IELTS หรือสัมภาษณ์งาน ให้ใช้รูปเต็ม"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|explain", "text": "การย่อคำที่เกี่ยวกับ obligation และ habit ที่พบบ่อยในภาษาอังกฤษพูดแบบสบาย ๆ"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|0", "text": "have to → hafta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|1", "text": "need to → needa"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|2", "text": "used to → useta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|caution", "text": "ใช้เฉพาะภาษาพูดไม่เป็นทางการเท่านั้น — ห้ามเขียน"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|explain", "text": "การย่อคำกริยาช่วยในอดีต — พบบ่อยมากเมื่อพูดถึงความเสียใจหรือสถานการณ์สมมติ"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|0", "text": "could have → coulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|1", "text": "would have → woulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|2", "text": "should have → shoulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|caution", "text": "ใช้เฉพาะภาษาพูดไม่เป็นทางการเท่านั้น — ในการเขียนที่เป็นทางการให้เขียน 'could have' แบบเต็ม"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|explain", "text": "การย่อคำแบบสบายมาก ๆ ที่พบบ่อยในเพลง ภาพยนตร์ และบทสนทนาสบาย ๆ ระหว่างเพื่อน"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|0", "text": "don't know → dunno"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|1", "text": "don't you → dontcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|2", "text": "what are you → whatcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|caution", "text": "ไม่เป็นทางการมาก ๆ — ใช้เฉพาะกับเพื่อนสนิทเท่านั้น ห้ามใช้ในบริบทการทำงานหรือการสอบ"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|explain", "text": "การย่อคำที่เชื่อมกับคำบุพบทที่พบบ่อยในภาษาพูดแบบสบาย ๆ"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|0", "text": "out of → outta"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|1", "text": "off of → offa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|2", "text": "cup of → cuppa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|caution", "text": "ใช้เฉพาะภาษาพูดไม่เป็นทางการเท่านั้น"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|explain", "text": "คำอุทานในชีวิตประจำวันและวลีสบาย ๆ ที่มีการย่อคำอย่างมาก"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|0", "text": "come on → c'mon"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|1", "text": "going to be → gonna be"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|2", "text": "some more → s'more"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|caution", "text": "ใช้เฉพาะภาษาพูดไม่เป็นทางการเท่านั้น"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|explain", "text": "คำขึ้นต้นประโยคคำถามมักถูกลดเสียงอย่างมากในการสนทนาที่รวดเร็วและเป็นกันเอง"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|0", "text": "did you → dja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|1", "text": "do you → dya"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|2", "text": "would you → wouldja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|caution", "text": "ใช้เฉพาะในบริบทการพูดแบบเป็นกันเองเท่านั้น"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|explain", "text": "ภาษาพูดแบบเป็นกันเองมักลดรูปวลีบอกเวลาด้วยเช่นกัน"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|0", "text": "a couple of → a couple"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|1", "text": "in a minute → in a min"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|caution", "text": "ใช้ได้ในการพูดแบบเป็นกันเอง แต่ไม่ใช้ในการเขียน"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|explain", "text": "การลดรูปในภาษาพูดแบบเป็นกันเองที่พบบ่อยขึ้นและได้ยินตลอดในการสนทนาสบาย ๆ"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|0", "text": "probably → prolly"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|1", "text": "trying to → tryna"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|2", "text": "supposed to → s'posed to"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|caution", "text": "ใช้เฉพาะภาษาพูดไม่เป็นทางการเท่านั้น"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|explain", "text": "การลดรูปแบบเป็นกันเองที่พบบ่อยในหมู่เพื่อนฝูงและในการพูดแบบไม่เป็นทางการของชาวอเมริกัน"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|0", "text": "let's go → less go"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|1", "text": "give it to me → gimme that"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|2", "text": "you all → y'all"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|caution", "text": "ไม่เป็นทางการมาก — 'y'all' เป็นภาษาถิ่น (ทางใต้ของสหรัฐฯ) แต่เป็นที่เข้าใจกันอย่างกว้างขวาง (US)"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|explain", "text": "เลขกลมจะลดเสียงพยัญชนะกลางคำในการพูดแบบอเมริกันที่รวดเร็วและเป็นกันเอง"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|0", "text": "twenty → twenny"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|1", "text": "hundred → hunnerd"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|caution", "text": "ใช้เฉพาะภาษาพูดไม่เป็นทางการเท่านั้น — ในบริบททางการให้ออกเสียงแบบเต็มรูปเสมอ"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|explain", "text": "คำในชีวิตประจำวันอีกชุดหนึ่งที่มักสูญเสียพยางค์ในการพูดที่รวดเร็วและผ่อนคลาย"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|0", "text": "different → diff'rent"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|1", "text": "general → gen'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|2", "text": "several → sev'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|3", "text": "camera → cam'ra"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|caution", "text": "ใช้ได้ในการพูดแบบสบาย ๆ แต่ในการนำเสนออย่างเป็นทางการควรออกเสียงเต็มรูปแบบให้ชัดเจน"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|explain", "text": "เป็นการลดเสียงแบบไม่เป็นทางการมาก ๆ ที่คุณจะได้ยินในเพลงและการพูดแบบอเมริกันสบาย ๆ แต่ไม่ควรใช้ในสถานการณ์ระดับมืออาชีพ"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|0", "text": "I'm going to → I'ma"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|1", "text": "kind of like → kinda like"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|caution", "text": "ไม่เป็นทางการมาก ๆ — ใช้กับเพื่อนหรือเนื้อเพลงเท่านั้น ห้ามใช้ในบริบทระดับมืออาชีพ"}, {"key": "551b9527-f712-421d-966c-24644f360746|explain", "text": "การลดเสียงในคำทักทายประจำวันเพิ่มเติม นอกเหนือจาก what's up / how's it going"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|0", "text": "how are you → how ya doin'"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|1", "text": "good to see you → good to see ya"}, {"key": "551b9527-f712-421d-966c-24644f360746|caution", "text": "ใช้เฉพาะรูปแบบการพูดแบบสบาย ๆ เท่านั้น"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|explain", "text": "การลดเสียงที่เกี่ยวกับหน้าที่และความต้องการเพิ่มเติม ซึ่งพบได้บ่อยในการพูดแบบอเมริกันสบาย ๆ"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|0", "text": "ought to → oughta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|1", "text": "don't have to → don't hafta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|2", "text": "want you → wantcha"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|caution", "text": "ใช้เฉพาะการพูดแบบไม่เป็นทางการเท่านั้น"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|explain", "text": "นี่คือตัวอย่างคลาสสิกที่แสดงให้เห็นว่าการลดเสียงแบบอเมริกันสบาย ๆ สามารถไปได้ไกลแค่ไหน — หลายคำรวมกันจนฟังเหมือนเป็นคำเดียว"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|0", "text": "Did you eat yet? → Jeetyet?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|1", "text": "Did you already? → Jeetalready?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|caution", "text": "ไม่เป็นทางการมาก ๆ — ใช้สำหรับจับเสียงเจ้าของภาษาที่พูดเร็ว ไม่ใช่สำหรับการพูดอย่างเป็นทางการของคุณเอง"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|explain", "text": "การลดเสียงระดับวลีที่พบบ่อยอีกสองแบบในการสนทนาสบาย ๆ"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|0", "text": "because of → 'cause of"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|1", "text": "sort of a → sorta a"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|caution", "text": "ใช้เฉพาะการพูดแบบไม่เป็นทางการเท่านั้น"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|explain", "text": "ทางเลือกแบบสบาย ๆ ที่พบบ่อยมากแทน 'yes' และ 'no' ในการพูดภาษาอังกฤษแบบสบาย ๆ"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|0", "text": "yes → yep / uh-huh"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|1", "text": "no → nope / nah"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|caution", "text": "ใช้เฉพาะการสนทนาสบาย ๆ เท่านั้น — ใช้ 'yes'/'no' ในบริบททางการหรือการสอบ"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|explain", "text": "ทั้งสองลดเสียงเป็น 'wanna' ที่ฟังคล้ายกัน แต่ตัวหนึ่งตามด้วยคำนามและอีกตัวตามด้วยคำกริยา — ควรสังเกตความแตกต่าง"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|0", "text": "want a (coffee) → wanna coffee"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|1", "text": "want to (go) → wanna go"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|caution", "text": "ใช้เฉพาะภาษาพูดที่ไม่เป็นทางการเท่านั้น"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|0", "text": "'want a' + คำนาม → wanna"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|1", "text": "'want to' + คำกริยา → wanna"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|explain", "text": "รูปปฏิเสธของ 'would have' ย่อแบบเดียวกับรูปบอกเล่า"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|point|0", "text": "wouldn't have → wouldn'ta"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|caution", "text": "ใช้เฉพาะภาษาพูดที่ไม่เป็นทางการเท่านั้น — ในบริบทอื่นให้เขียน 'wouldn't have' แบบเต็ม"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|explain", "text": "การย่ออีกสองแบบที่ใช้บ่อยในชีวิตประจำวัน พบได้ทั่วไปในการอธิบายหรือขอร้องแบบไม่เป็นทางการ"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|0", "text": "just because → just 'cause"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|1", "text": "going to need → gonna need"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|caution", "text": "ใช้เฉพาะภาษาพูดที่ไม่เป็นทางการเท่านั้น"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|explain", "text": "'Ain't' ใช้แทน am not/is not/are not/has not/have not ในการพูดแบบกันเองมาก ๆ และได้ยินได้ทั่วไปในเพลงและการพูดคุยแบบไม่เป็นทางการ"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|0", "text": "I am not → I ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|1", "text": "that is not → that ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|2", "text": "you have not → you ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|caution", "text": "ห้ามใช้ในการเขียนหรือการพูดแบบทางการ — ถือว่าเป็นไวยากรณ์ที่ไม่มาตรฐาน แม้จะพบได้บ่อยมากในการพูดแบบไม่เป็นทางการ"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|explain", "text": "วิธีพูดแบบกันเองที่ใช้บ่อยมากสำหรับความหมายว่า 'I understand' หรือแปลตรงตัวว่า 'caught you'"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|0", "text": "got you (understand) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|1", "text": "got you (caught) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|caution", "text": "ใช้เฉพาะภาษาพูดที่ไม่เป็นทางการเท่านั้น — ในบริบทการทำงานให้พูดว่า 'I understand' หรือ 'got it'"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|explain", "text": "การย่อ modal-perfect ที่ใช้เดาเกี่ยวกับอดีต ใช้คู่กับ coulda/woulda/shoulda"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|0", "text": "must have → musta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|1", "text": "might have → mighta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|caution", "text": "ใช้เฉพาะภาษาพูดที่ไม่เป็นทางการเท่านั้น — ในบริบทอื่นให้เขียน 'must have'/'might have' แบบเต็ม"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|explain", "text": "รูปปฏิเสธของ coulda/woulda/shoulda ใช้บ่อยเมื่อพูดถึงความเสียใจ"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|0", "text": "shouldn't have → shouldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|1", "text": "couldn't have → couldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|caution", "text": "ใช้เฉพาะภาษาพูดที่ไม่เป็นทางการเท่านั้น — ในบริบททางการให้เขียน 'shouldn't have'/'couldn't have' แบบเต็ม"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|explain", "text": "ในการพูดแบบสบาย ๆ เสียง -ing ท้ายคำมักตัด 'g' ออก ทำให้ฟังดูเหมือน -in' ซึ่งเกิดได้กับคำกริยาที่ลงท้ายด้วย -ing แทบทุกคำ (, so it sounds like -in)"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|0", "text": "doing → doin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|1", "text": "going → goin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|2", "text": "talking → talkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|3", "text": "thinking → thinkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|caution", "text": "ใช้เฉพาะในภาษาพูดแบบกันเองเท่านั้น — ออกเสียง '-ing' ให้ครบถ้วนชัดเจนในการนำเสนอ สัมภาษณ์ และการสอบ"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|explain", "text": "รูปแบบการตัดเสียง g แบบเดียวกันนี้ใช้กับคำสรรพนามไม่ชี้เฉพาะที่ลงท้ายด้วย -thing ด้วย"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|0", "text": "something → somethin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|1", "text": "nothing → nothin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|2", "text": "anything → anythin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|caution", "text": "ใช้เฉพาะในภาษาพูดแบบกันเองเท่านั้น"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|explain", "text": "'Them' ลดรูปเป็น 'em (เสียง 'th' หายไป) เมื่ออยู่หลังคำกริยา ในภาษาพูดแบบกันเองที่ใช้บ่อยมาก"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|0", "text": "tell them → tell 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|1", "text": "get them → get 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|2", "text": "ask them → ask 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|caution", "text": "ใช้เฉพาะภาษาพูดแบบไม่เป็นทางการเท่านั้น — ให้พูด 'them' เต็มคำในการเขียนหรือการพูดแบบทางการ"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|explain", "text": "'And' ลดรูปเป็นเสียง 'n' สั้น ๆ ระหว่างคำสองคำที่เชื่อมกันแนบชิด โดยเฉพาะในวลีสำเร็จรูป"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|0", "text": "rock and roll → rock 'n' roll"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|1", "text": "fish and chips → fish 'n' chips"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|2", "text": "back and forth → back 'n' forth"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|caution", "text": "พบได้ทั่วไปในวลีสำเร็จรูปและการพูดเร็ว — ให้พูด 'and' ให้ชัดเจนในการเขียนแบบทางการ"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|explain", "text": "'Because' ที่อยู่เดี่ยว ๆ (ไม่ใช่แค่ 'because of') มักย่อเป็น 'cause ในการตอบแบบกันเอง"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|point|0", "text": "because → 'cause"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|caution", "text": "ใช้เฉพาะภาษาพูดแบบไม่เป็นทางการเท่านั้น — นอกนั้นให้เขียน 'because' เต็มคำ"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|explain", "text": "'Of course' มักตัดคำแรกออกในการตอบแบบเร็ว ๆ กันเอง"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|point|0", "text": "of course → 'course"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|caution", "text": "ใช้เฉพาะภาษาพูดแบบกันเองเท่านั้น"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|explain", "text": "การออกเสียงแบบกันเองที่พบบ่อยมากของ 'all right' ใช้เพื่อตอบรับหรือรับทราบ"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|point|0", "text": "all right → aight"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|caution", "text": "ไม่เป็นทางการมาก — ให้พูด 'all right' หรือ 'okay' ในบริบทการทำงาน"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|explain", "text": "'Let you' ลดรูปในลักษณะเดียวกับที่ 'want you'/'wantcha' เป็น"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|point|0", "text": "let you → letcha"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|caution", "text": "ใช้เฉพาะภาษาพูดที่ไม่เป็นทางการเท่านั้น"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|explain", "text": "การกลืนเสียงแบบเร็วสุดขั้วอีกแบบ คล้ายกับ 'jeetyet' — หลายคำถูกบีบรวมเป็นเสียงเดียว"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|point|0", "text": "did you ever → jever"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|caution", "text": "ใช้สำหรับจับเสียงเจ้าของภาษาเวลาพูดเร็ว ไม่ใช่สำหรับการพูดอย่างเป็นทางการของคุณเอง"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|explain", "text": "การลดรูปสองอย่างซ้อนกันเมื่อ 'going to' และ 'have to' อยู่ติดกัน"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|point|0", "text": "going to have to → gonna hafta"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|caution", "text": "ใช้เฉพาะภาษาพูดที่ไม่เป็นทางการ — ถ้าเขียนให้เขียน 'going to have to' แบบเต็ม"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|explain", "text": "การลดรูปเป็น 'gonna' ยังใช้ได้กับประโยคปฏิเสธและอดีตกาล"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|0", "text": "not going to → not gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|1", "text": "wasn't going to → wasn't gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|caution", "text": "ใช้เฉพาะภาษาพูดที่ไม่เป็นทางการเท่านั้น"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|explain", "text": "การลดรูปของ tag question ในภาษาอังกฤษแบบอังกฤษที่พบบ่อยมาก ใช้เพื่อยืนยันหรือเน้น"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|point|0", "text": "isn't it → innit"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|caution", "text": "เป็นสแลงอังกฤษที่ไม่เป็นทางการมาก — อย่าใช้ในภาษาพูดทางการ แม้จะอยู่ในสหราชอาณาจักรก็ตาม (UK)"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|explain", "text": "วิธีพูดแบบสบาย ๆ เพื่อเสนอสิ่งใดสิ่งหนึ่งหรือขอความเห็นชอบ"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|point|0", "text": "what do you say → whaddya say"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|caution", "text": "ใช้เฉพาะภาษาพูดที่ไม่เป็นทางการเท่านั้น"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|explain", "text": "วลอเติมที่พบบ่อยมากในภาษาอังกฤษแบบพูดสบาย ๆ ใช้ขณะคิดหรือเพื่อเน้น"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|point|0", "text": "you know → y'know"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|caution", "text": "ใช้เป็นวลอเติมแบบสบาย ๆ เท่านั้น — ใช้มากเกินไปฟังดูไม่เรียบร้อยแม้ในภาษาพูดสบาย ๆ"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|explain", "text": "คำทักทายแบบสบายมาก ย่อมาจาก 'what's up'"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|point|0", "text": "what's up → s'up"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|caution", "text": "เป็นคำทักทายที่ไม่เป็นทางการมาก ใช้ระหว่างเพื่อนเท่านั้น"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|explain", "text": "'Him' และ 'her' ก็อ่อนเสียงลงในภาษาพูดสบาย ๆ เช่นเดียวกับ 'them' → 'em"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|0", "text": "tell him → tell 'im"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|1", "text": "ask her → ask 'er"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|caution", "text": "ใช้เฉพาะภาษาพูดที่ไม่เป็นทางการเท่านั้น"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|explain", "text": "'Kinda' และ 'sorta' มักใช้รวมกันเพื่อถ่วงน้ำหนักคำพูดมากขึ้นในภาษาพูดสบาย ๆ"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|point|0", "text": "kind of sort of → kinda sorta"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|caution", "text": "ไม่เป็นทางการมาก — หลีกเลี่ยงในบริบทการทำงานหรือการสอบทุกประเภท"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|explain", "text": "อีกหนึ่งคำผสมที่ใช้เริ่มคำถามในภาษาพูดเร็ว ๆ เช่นเดียวกับ dja และ wouldja"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|point|0", "text": "didn't you → dincha"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|caution", "text": "ใช้สำหรับจับเสียงพูดเร็วของเจ้าของภาษา ไม่ใช่สำหรับการพูดอย่างเป็นทางการของคุณเอง"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|explain", "text": "รูปอดีตของ 'have to' ลดเสียงแบบเดียวกับรูปปัจจุบัน"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|point|0", "text": "had to → hadta"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|caution", "text": "ใช้เฉพาะภาษาพูดไม่เป็นทางการเท่านั้น"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|explain", "text": "การลดเสียงแบบสบาย ๆ ที่ใช้ในการขอร้องอย่างไม่เป็นทางการ เช่นเดียวกับรูป wouldja และ couldja"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|point|0", "text": "will you → willcha"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|caution", "text": "ใช้เฉพาะภาษาพูดไม่เป็นทางการเท่านั้น"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|explain", "text": "วลีบอกปริมาณที่มี 'of' ลดเสียงแบบเดียวกับ 'cup of' ใน 'cuppa'"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|0", "text": "lots of → lotsa"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|1", "text": "bunch of → buncha"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|caution", "text": "ใช้เฉพาะภาษาพูดไม่เป็นทางการเท่านั้น"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|explain", "text": "คำเน้นความหมายแบบไม่เป็นทางการที่แปลว่า 'น่าประทับใจ/ใหญ่โตมาก' (a very impressive/big)"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|point|0", "text": "hell of a → helluva"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|caution", "text": "ค่อนข้างหยาบเล็กน้อย — ใช้กับเพื่อนได้ แต่เลี่ยงในสถานการณ์ที่เป็นทางการหรือสุภาพ"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|explain", "text": "การลดเสียงในอดีตของคำทักทายเก่า 'how do you do' ปัจจุบันกลายเป็นคำทักทายแบบสบาย ๆ ที่เป็นมิตรในตัวเอง (โดยเฉพาะในภาคใต้ของสหรัฐฯ) (US)"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|point|0", "text": "how do you do → howdy"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|caution", "text": "ใช้เป็นคำทักทายแบบสบาย ๆ ที่เป็นมิตรเท่านั้น"}, {"key": "47538641-f573-4840-af35-02857a1d24de|explain", "text": "'I suppose' มักตัดพยางค์กลางออกในภาษาพูดสบาย ๆ ใช้แสดงความไม่แน่ใจเล็กน้อยหรือการเห็นด้วยอย่างไม่เต็มใจ — ต่างจาก 'supposed to' → s'posed to"}, {"key": "47538641-f573-4840-af35-02857a1d24de|point|0", "text": "I suppose → I s'pose"}, {"key": "47538641-f573-4840-af35-02857a1d24de|caution", "text": "ใช้เฉพาะภาษาพูดไม่เป็นทางการเท่านั้น — ในกรณีอื่นให้เขียน 'I suppose' แบบเต็ม"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|explain", "text": "ฝึกการลดเสียงให้เชี่ยวชาญผ่านแบบฝึกหัดเฉพาะทาง 50 ชุด ฟังเสียงต้นแบบ AI อย่างตั้งใจ ทำซ้ำ และอัดเสียงของคุณเพื่อรับคะแนนและการFeedbackการออกเสียงแบบละเอียดแบบเรียลไทม์"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|0", "text": "เน้นจังหวะ การเน้นเสียง และการไหลของเสียงที่ไฮไลต์ไว้ในแต่ละแบบฝึกหัด"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|1", "text": "ฟังเสียงต้นแบบอ้างอิงก่อนอัดเสียงทุกครั้ง"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|2", "text": "ตรวจสอบคะแนน AI และFeedbackระดับหน่วยเสียงของคุณเพื่อระบุจุดที่ต้องปรับปรุง"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|caution", "text": "อย่าทำแบบฝึกหัดเร็วเกินไป เน้นความชัดเจน จังหวะที่เป็นธรรมชาติ และการออกเสียงที่ถูกต้อง"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|0", "text": "การลดเสียงคำช่วยอย่างมากเพื่อให้เสียงไหลเป็นธรรมชาติ"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|1", "text": "'going to' -> 'gonna'; 'him' -> ''im'"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|2", "text": "'have got to' ลดเสียงเป็น 'gotta'"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|3", "text": "'want a' -> 'wanna'; 'of' -> 'a' /ə/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|4", "text": "'has to' -> 'hasta' /hæstə/; 'for' -> /fər/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|5", "text": "'let me' -> 'lemme'; 'you' -> 'ya'"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|6", "text": "'give me' -> 'gimme'"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|7", "text": "'could you' -> 'couldja' /kʊdʒə/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|8", "text": "'would you' -> 'wouldja'"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|9", "text": "'what did you' -> 'whaddya'; 'him' -> ''im'"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|10", "text": "'should have' -> 'shoulda' /ʃʊdə/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|11", "text": "'could have' -> 'coulda' /kʊdə/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|12", "text": "'would have' -> 'woulda' /wʊdə/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|13", "text": "'must have' -> 'musta' /mʌstə/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|14", "text": "'might have' -> 'mighta' /maɪtə/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|15", "text": "'used to' -> 'usta' /juːstə/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|16", "text": "'supposed to' -> 'sposta' /spoʊstə/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|17", "text": "'need to' -> 'needa'; 'to' -> /də/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|18", "text": "'to' -> /də/; 'for' -> /fər/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|19", "text": "'kind of' -> 'kinda' /kaɪndə/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|20", "text": "'sort of' -> 'sorta' /sɔːrtə/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|21", "text": "'lots of' -> 'lotsa' /lɒtsə/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|22", "text": "'out of' -> 'outta' /aʊtə/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|23", "text": "'front of' -> 'fronta'"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|24", "text": "'I am going to' ลดรูปเป็น 'I'mma' ในการพูดแบบไม่เป็นทางการ"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|25", "text": "'don't you' -> 'doncha'; 'want to' -> 'wanna'"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|26", "text": "'didn't you' -> 'didn'tcha'"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|27", "text": "'haven't you' -> 'haven'tcha'"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|28", "text": "'and' ลดรูปเป็นพยางค์ 'n' /n/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|29", "text": "'day and night' -> 'day 'n night'"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|30", "text": "'or' ลดรูปเป็น /ər/; 'it or' ออกเสียงเชื่อมกันอย่างราบรื่น"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|31", "text": "'or' ลดรูปเป็น /ər/ ที่ไม่เน้นเสียง"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|32", "text": "'and' ลดรูปเป็น /n/ เมื่ออยู่ระหว่างเสียงหยุด"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|33", "text": "'that' ที่เป็น relative ลดเสียงเป็น /ðət/ ด้วยเสียง schwa"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|34", "text": "'that' ที่เป็นคำสันธานออกเสียงเบาและสั้น"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|35", "text": "'that' ออกเสียงเป็น /ðət/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|36", "text": "'them' ลดเสียงเป็น ''em' /əm/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|37", "text": "'them' -> ''em'"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|38", "text": "'them' -> ''em'"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|39", "text": "'some' -> /səm/; 'for' -> /fər/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|40", "text": "'for' -> /fər/; 'you' -> /jə/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|41", "text": "'are' -> /ər/; 'you' -> /jə/; 'to' -> /tə/"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|42", "text": "'were' ลดเสียงเป็น /wər/"}]
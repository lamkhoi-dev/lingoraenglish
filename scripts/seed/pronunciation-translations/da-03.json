[{"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|point|3", "text": "got to → gotta"}, {"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|caution", "text": "Dette er uformelle talesprogsformer. Skriv dem ikke i essays, e-mails eller formelle eksamener, og undgå dem i en formel præsentation."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|explain", "text": "Flere afslappede sammentrækninger, som du konstant vil høre i film og virkelige samtaler."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|0", "text": "kind of → kinda"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|1", "text": "sort of → sorta"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|2", "text": "let me → lemme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|3", "text": "give me → gimme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|4", "text": "what do you → whaddaya"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|caution", "text": "Kun uformelt. I en IELTS eller jobsamtale skal du holde dig til de fulde former."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|explain", "text": "Flere sammentrækninger med forpligtelse og vane, som er almindelige i afslappet talt engelsk."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|0", "text": "have to → hafta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|1", "text": "need to → needa"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|2", "text": "used to → useta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|caution", "text": "Kun uformelle talesprogsformer — skriv dem aldrig."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|explain", "text": "Sammentrækninger af modale verber i datid — meget almindelige, når man taler om fortrydelser eller hypotetiske situationer."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|0", "text": "could have → coulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|1", "text": "would have → woulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|2", "text": "should have → shoulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|caution", "text": "Kun uformelt talesprog — skriv 'could have' i sin fulde form i formel skrift."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|explain", "text": "Meget afslappede sammentrækninger, som er almindelige i sange, film og afslappet samtale mellem venner."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|0", "text": "don't know → dunno"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|1", "text": "don't you → dontcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|2", "text": "what are you → whatcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|caution", "text": "Meget uformelt — kun med tætte venner, aldrig i professionelle sammenhænge eller til eksamen."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|explain", "text": "Almindelige sammentrækninger med præpositioner i uformel tale."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|0", "text": "out of → outta"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|1", "text": "off of → offa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|2", "text": "cup of → cuppa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|caution", "text": "Kun uformelt."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|explain", "text": "Hverdagsudråb og afslappede vendinger med kraftig sammentrækning."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|0", "text": "come on → c'mon"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|1", "text": "going to be → gonna be"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|2", "text": "some more → s'more"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|caution", "text": "Kun uformelt."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|explain", "text": "Spørgsmålsindledere reduceres kraftigt i hurtig, afslappet samtale."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|0", "text": "did you → dja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|1", "text": "do you → dya"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|2", "text": "would you → wouldja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|caution", "text": "Kun i uformelle, mundtlige sammenhænge."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|explain", "text": "Afslappet tale reducerer ofte også tidsudtryk."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|0", "text": "a couple of → a couple"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|1", "text": "in a minute → in a min"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|caution", "text": "Fint i afslappet tale, ikke i skrift."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|explain", "text": "Mere almindelige uformelle reduktioner, som høres konstant i afslappet samtale."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|0", "text": "probably → prolly"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|1", "text": "trying to → tryna"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|2", "text": "supposed to → s'posed to"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|caution", "text": "Kun uformelt talt sprog."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|explain", "text": "Uformelle reduktioner, der er almindelige blandt venner og i amerikansk uformel tale."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|0", "text": "let's go → less go"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|1", "text": "give it to me → gimme that"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|2", "text": "you all → y'all"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|caution", "text": "Meget uformelt — 'y'all' er regionalt (Southern US), men bredt forstået."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|explain", "text": "Runde tal reducerer deres midterste konsonantlyde i hurtig, afslappet amerikansk tale."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|0", "text": "twenty → twenny"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|1", "text": "hundred → hunnerd"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|caution", "text": "Kun uformelt talt sprog — sig altid den fulde form i formelle sammenhænge."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|explain", "text": "Et andet sæt hverdagsord, der regelmæssigt mister en stavelse i hurtig, afslappet tale."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|0", "text": "different → diff'rent"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|1", "text": "general → gen'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|2", "text": "several → sev'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|3", "text": "camera → cam'ra"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|caution", "text": "Fint i afslappet tale; sig den fulde form tydeligt i formelle præsentationer."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|explain", "text": "Meget uformelle reduktioner, som du hører i sange og afslappet amerikansk tale, men som aldrig bør bruges i professionelle sammenhænge."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|0", "text": "I'm going to → I'ma"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|1", "text": "kind of like → kinda like"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|caution", "text": "Ekstremt uformelt — kun venner/sangtekster, aldrig professionelle sammenhænge."}, {"key": "551b9527-f712-421d-966c-24644f360746|explain", "text": "Flere hverdagsreduktioner af hilsner ud over what's up / how's it going."}, {"key": "551b9527-f712-421d-966c-24644f360746|point|0", "text": "how are you → how ya doin'"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|1", "text": "good to see you → good to see ya"}, {"key": "551b9527-f712-421d-966c-24644f360746|caution", "text": "Kun i afslappet talt form."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|explain", "text": "Flere reduktioner af forpligtelse og ønske, som er almindelige i afslappet amerikansk tale."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|0", "text": "ought to → oughta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|1", "text": "don't have to → don't hafta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|2", "text": "want you → wantcha"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|caution", "text": "Kun uformelt talt sprog."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|explain", "text": "Dette er et klassisk eksempel på, hvor langt afslappet amerikansk reduktion kan gå — flere ord smelter sammen til det, der lyder som ét."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|0", "text": "Did you eat yet? → Jeetyet?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|1", "text": "Did you already? → Jeetalready?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|caution", "text": "Ekstremt uformelt — til at genkende hurtig indfødt tale, ikke til din egen formelle tale."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|explain", "text": "To mere almindelige reduktioner på sætningsniveau i afslappet samtale."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|0", "text": "because of → 'cause of"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|1", "text": "sort of a → sorta a"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|caution", "text": "Kun uformelt talt sprog."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|explain", "text": "Meget almindelige afslappede alternativer til 'yes' og 'no' i afslappet talt engelsk."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|0", "text": "yes → yep / uh-huh"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|1", "text": "no → nope / nah"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|caution", "text": "Kun i afslappet samtale — brug 'yes'/'no' i formelle eller eksamenssammenhænge."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|explain", "text": "Begge reduceres til et enslydende 'wanna', men den ene efterfølges af et navneord og den anden af et udsagnsord — det er værd at lægge mærke til forskellen."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|0", "text": "want a (coffee) → wanna coffee"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|1", "text": "want to (go) → wanna go"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|caution", "text": "Kun uformelt talt sprog."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|0", "text": "'want a' + substantiv → wanna"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|1", "text": "'want to' + verbum → wanna"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|explain", "text": "Den negative form af 'would have' reduceres på samme måde som den positive form."}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|point|0", "text": "wouldn't have → wouldn'ta"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|caution", "text": "Kun uformelt talt sprog — skriv 'wouldn't have' i fuld form ellers."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|explain", "text": "To mere hverdagsreduktioner, der er almindelige i afslappede forklaringer og anmodninger."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|0", "text": "just because → just 'cause"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|1", "text": "going to need → gonna need"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|caution", "text": "Kun uformelt talt sprog."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|explain", "text": "'Ain't' erstatter am not/is not/are not/has not/have not i meget afslappet tale og høres overalt i sange og uformel samtale."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|0", "text": "I am not → I ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|1", "text": "that is not → that ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|2", "text": "you have not → you ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|caution", "text": "Brug aldrig i skrift eller formel tale — betragtes som ustandardgrammatik, selvom det er yderst almindeligt uformelt."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|explain", "text": "En meget almindelig afslappet måde at sige 'I understand' eller bogstaveligt 'caught you'."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|0", "text": "got you (understand) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|1", "text": "got you (caught) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|caution", "text": "Kun uformelt talt sprog — sig 'I understand' eller 'got it' i professionelle sammenhænge."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|explain", "text": "Modal-perfekt-reduktioner brugt til gæt om fortiden, sammen med coulda/woulda/shoulda."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|0", "text": "must have → musta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|1", "text": "might have → mighta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|caution", "text": "Kun uformelt talt sprog — skriv 'must have'/'might have' i fuld form ellers."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|explain", "text": "De negative modstykker til coulda/woulda/shoulda, almindelige når man taler om fortrydelser."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|0", "text": "shouldn't have → shouldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|1", "text": "couldn't have → couldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|caution", "text": "Kun uformelt talt sprog — skriv 'shouldn't have'/'couldn't have' i fuld form i formelle sammenhænge."}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|explain", "text": "I afslappet tale dropper den afsluttende -ing-lyd ofte sit 'g', så det lyder som -in'. Det sker med næsten ethvert -ing-verbum. (, so it sounds like -in)"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|0", "text": "doing → doin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|1", "text": "going → goin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|2", "text": "talking → talkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|3", "text": "thinking → thinkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|caution", "text": "Kun i afslappet tale — udtal den fulde '-ing' tydeligt i præsentationer, samtaler og eksamener."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|explain", "text": "Samme mønster med at droppe g gælder for ubestemte stedord, der ender på -thing."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|0", "text": "something → somethin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|1", "text": "nothing → nothin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|2", "text": "anything → anythin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|caution", "text": "Kun i afslappet tale."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|explain", "text": "'Them' reduceres til 'em ('th' forsvinder) efter et verbum i meget almindelig afslappet tale."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|0", "text": "tell them → tell 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|1", "text": "get them → get 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|2", "text": "ask them → ask 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|caution", "text": "Kun uformelt talt sprog — sig 'them' i fuld form i skrift eller formel tale."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|explain", "text": "'And' reduceres til en hurtig 'n'-lyd mellem to tæt forbundne ord, især i faste vendinger."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|0", "text": "rock and roll → rock 'n' roll"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|1", "text": "fish and chips → fish 'n' chips"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|2", "text": "back and forth → back 'n' forth"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|caution", "text": "Almindeligt i faste vendinger og hurtig tale — skriv 'and' tydeligt i formel skrift."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|explain", "text": "'Because' alene (ikke kun 'because of') forkortes ofte til 'cause i afslappede svar."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|point|0", "text": "because → 'cause"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|caution", "text": "Kun uformelt talt sprog — skriv 'because' i fuld form ellers."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|explain", "text": "'Of course' dropper ofte det første ord i hurtige, afslappede svar."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|point|0", "text": "of course → 'course"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|caution", "text": "Kun i afslappet talt sprog."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|explain", "text": "En meget almindelig afslappet udtale af 'all right', brugt til at give samtykke eller bekræfte."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|point|0", "text": "all right → aight"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|caution", "text": "Meget uformelt — sig 'all right' eller 'okay' i professionelle sammenhænge."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|explain", "text": "'Let you' reduceres på samme måde som 'want you'/'wantcha'."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|point|0", "text": "let you → letcha"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|caution", "text": "Kun uformelt talt sprog."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|explain", "text": "Endnu en ekstrem hurtig-tale-sammensmeltning, ligesom 'jeetyet' — flere ord komprimeres til én lyd."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|point|0", "text": "did you ever → jever"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|caution", "text": "Til at genkende hurtig indfødt tale, ikke til din egen formelle tale."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|explain", "text": "To reduktioner stables oven på hinanden, når 'going to' og 'have to' optræder side om side."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|point|0", "text": "going to have to → gonna hafta"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|caution", "text": "Kun uformelt talt sprog — skriv 'going to have to' i fuld form ellers."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|explain", "text": "'gonna'-reduktionen gælder stadig med nægtelser og datid."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|0", "text": "not going to → not gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|1", "text": "wasn't going to → wasn't gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|caution", "text": "Kun uformelt talt sprog."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|explain", "text": "En meget almindelig britisk engelsk reduktion af spørgende tillægssætning, brugt til at bekræfte eller understrege."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|point|0", "text": "isn't it → innit"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|caution", "text": "Meget uformelt britisk slang — brug det ikke i formel tale, selv ikke i Storbritannien. (UK)"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|explain", "text": "En afslappet måde at foreslå noget eller bede om enighed."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|point|0", "text": "what do you say → whaddya say"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|caution", "text": "Kun uformelt talt sprog."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|explain", "text": "En ekstremt almindelig fyldfrase i uformelt talt engelsk, brugt mens man tænker eller for at understrege."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|point|0", "text": "you know → y'know"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|caution", "text": "Kun uformel fyldfrase — for meget brug lyder upoleret, selv uformelt."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|explain", "text": "En meget afslappet hilsen, forkortet fra 'what's up'."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|point|0", "text": "what's up → s'up"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|caution", "text": "Kun en meget uformel hilsen mellem venner."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|explain", "text": "'Him' og 'her' svækkes også i uformel tale, ligesom 'them' → 'em."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|0", "text": "tell him → tell 'im"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|1", "text": "ask her → ask 'er"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|caution", "text": "Kun uformelt talt sprog."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|explain", "text": "'Kinda' og 'sorta' kombineres ofte for ekstra forbehold i meget uformel tale."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|point|0", "text": "kind of sort of → kinda sorta"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|caution", "text": "Meget uformelt — undgå i enhver professionel eller eksamenssammenhæng."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|explain", "text": "Endnu en sammentrækning af spørgsmålsstartere i hurtig tale, side om side med dja og wouldja."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|point|0", "text": "didn't you → dincha"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|caution", "text": "Til at genkende hurtig indfødt tale, ikke til din egen formelle tale."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|explain", "text": "Datidsformen af 'have to' reduceres på samme måde som nutidsformen."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|point|0", "text": "had to → hadta"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|caution", "text": "Kun uformelt talt sprog."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|explain", "text": "En afslappet reduktion brugt i uformelle anmodninger, side om side med wouldja og couldja-lignende former."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|point|0", "text": "will you → willcha"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|caution", "text": "Kun uformelt talt sprog."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|explain", "text": "Mængdeudtryk med 'of' reduceres på samme måde som 'cup of' i 'cuppa'."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|0", "text": "lots of → lotsa"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|1", "text": "bunch of → buncha"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|caution", "text": "Kun uformelt talt sprog."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|explain", "text": "En stærk uformel forstærker, der betyder 'en meget imponerende/stor'. (a very impressive/big)"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|point|0", "text": "hell of a → helluva"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|caution", "text": "Let grov — fint blandt venner, undgå i professionelle eller høflige sammenhænge."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|explain", "text": "En historisk reduktion af den gamle hilsen 'how do you do', nu sin egen afslappede, venlige hilsen (især i det sydlige USA)."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|point|0", "text": "how do you do → howdy"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|caution", "text": "Kun afslappet, venlig hilsen."}, {"key": "47538641-f573-4840-af35-02857a1d24de|explain", "text": "'I suppose' dropper ofte sin midterste stavelse i afslappet tale, brugt til at udtrykke mild usikkerhed eller modvillig enighed — forskellig fra 'supposed to' → s'posed to."}, {"key": "47538641-f573-4840-af35-02857a1d24de|point|0", "text": "I suppose → I s'pose"}, {"key": "47538641-f573-4840-af35-02857a1d24de|caution", "text": "Kun uformelt talt sprog — skriv 'I suppose' i fuld form ellers."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|explain", "text": "Mestr reduktioner gennem 50 målrettede øvelser. Lyt grundigt til AI-modellen, gentag, og optag din stemme for at få detaljeret udtalescore og feedback i realtid."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|0", "text": "Fokusér på rytmen, trykket og flowet, der fremhæves i hver øvelse."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|1", "text": "Lyt til referencemodellens lyd før hvert optagelsesforsøg."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|2", "text": "Gennemgå din AI-score og fonemniveau-feedback for at identificere forbedringsområder."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|caution", "text": "Skynd dig ikke gennem øvelserne; prioritér klarhed, naturlig kadence og præcis artikulation."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|0", "text": "Ekstrem reduktion af hjælpeord til naturligt flow."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|1", "text": "'going to' -> 'gonna'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|2", "text": "'have got to' reduceres til 'gotta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|3", "text": "'want a' -> 'wanna'; 'of' -> 'a' /ə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|4", "text": "'has to' -> 'hasta' /hæstə/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|5", "text": "'let me' -> 'lemme'; 'you' -> 'ya'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|6", "text": "'give me' -> 'gimme'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|7", "text": "'could you' -> 'couldja' /kʊdʒə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|8", "text": "'would you' -> 'wouldja'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|9", "text": "'what did you' -> 'whaddya'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|10", "text": "'should have' -> 'shoulda' /ʃʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|11", "text": "'could have' -> 'coulda' /kʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|12", "text": "'would have' -> 'woulda' /wʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|13", "text": "'must have' -> 'musta' /mʌstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|14", "text": "'might have' -> 'mighta' /maɪtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|15", "text": "'used to' -> 'usta' /juːstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|16", "text": "'supposed to' -> 'sposta' /spoʊstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|17", "text": "'need to' -> 'needa'; 'to' -> /də/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|18", "text": "'to' -> /də/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|19", "text": "'kind of' -> 'kinda' /kaɪndə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|20", "text": "'sort of' -> 'sorta' /sɔːrtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|21", "text": "'lots of' -> 'lotsa' /lɒtsə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|22", "text": "'out of' -> 'outta' /aʊtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|23", "text": "'front of' -> 'fronta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|24", "text": "'I am going to' reduceres til 'I'mma' i uformel tale."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|25", "text": "'don't you' -> 'doncha'; 'want to' -> 'wanna'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|26", "text": "'didn't you' -> 'didn'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|27", "text": "'haven't you' -> 'haven'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|28", "text": "'and' reduceres til stavelsesdannende 'n' /n/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|29", "text": "'day and night' -> 'day 'n night'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|30", "text": "'or' reduceres til /ər/; 'it or' smelter gnidningsløst sammen."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|31", "text": "'or' reduceres til ubetonet /ər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|32", "text": "'and' reduceres til /n/ mellem lukkelyde."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|33", "text": "Relativt 'that' reduceres til /ðət/ med schwa."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|34", "text": "Konjunktionen 'that' er svag og kort."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|35", "text": "'that' udtales som /ðət/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|36", "text": "'them' reduceres til ''em' /əm/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|37", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|38", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|39", "text": "'some' -> /səm/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|40", "text": "'for' -> /fər/; 'you' -> /jə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|41", "text": "'are' -> /ər/; 'you' -> /jə/; 'to' -> /tə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|42", "text": "'were' reduceres til /wər/."}]
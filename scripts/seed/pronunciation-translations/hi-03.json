[{"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|point|3", "text": "got to → gotta"}, {"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|caution", "text": "ये अनौपचारिक बोलचाल के रूप हैं। इन्हें essays, emails या formal exams में मत लिखें, और formal presentation में इनसे बचें।"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|explain", "text": "कुछ और casual reductions जो आप films और असली बातचीत में लगातार सुनेंगे।"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|0", "text": "kind of → kinda"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|1", "text": "sort of → sorta"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|2", "text": "let me → lemme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|3", "text": "give me → gimme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|4", "text": "what do you → whaddaya"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|caution", "text": "केवल अनौपचारिक। IELTS या job interview में पूरे रूप इस्तेमाल करें।"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|explain", "text": "आरामदायक बोलचाल की English में आम obligation और habit reductions।"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|0", "text": "have to → hafta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|1", "text": "need to → needa"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|2", "text": "used to → useta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|caution", "text": "केवल अनौपचारिक बोलचाल के रूप — इन्हें कभी मत लिखें।"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|explain", "text": "Past modal reductions — regrets या hypothetical situations की बात करते समय बहुत आम।"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|0", "text": "could have → coulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|1", "text": "would have → woulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|2", "text": "should have → shoulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|caution", "text": "केवल अनौपचारिक बोलचाल — formal writing में 'could have' पूरा लिखें।"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|explain", "text": "बहुत casual reductions जो songs, films और दोस्तों के बीच आरामदायक बातचीत में आम हैं।"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|0", "text": "don't know → dunno"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|1", "text": "don't you → dontcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|2", "text": "what are you → whatcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|caution", "text": "बहुत अनौपचारिक — केवल करीबी दोस्तों के साथ, professional या exam contexts में कभी नहीं।"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|explain", "text": "casual speech में आम preposition-linked reductions।"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|0", "text": "out of → outta"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|1", "text": "off of → offa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|2", "text": "cup of → cuppa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|caution", "text": "केवल अनौपचारिक।"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|explain", "text": "रोज़मर्रा के exclamations और casual phrases जिनमें भारी reduction होती है।"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|0", "text": "come on → c'mon"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|1", "text": "going to be → gonna be"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|2", "text": "some more → s'more"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|caution", "text": "केवल अनौपचारिक।"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|explain", "text": "तेज़, अनौपचारिक बातचीत में प्रश्न-शुरुआत बहुत कम हो जाती हैं।"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|0", "text": "did you → dja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|1", "text": "do you → dya"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|2", "text": "would you → wouldja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|caution", "text": "केवल अनौपचारिक, बोलचाल के संदर्भों के लिए।"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|explain", "text": "अनौपचारिक बोली में समय-संबंधी वाक्यांश भी अक्सर छोटे हो जाते हैं।"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|0", "text": "a couple of → a couple"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|1", "text": "in a minute → in a min"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|caution", "text": "अनौपचारिक बातचीत में ठीक है, लेखन में नहीं।"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|explain", "text": "अधिक सामान्य अनौपचारिक संक्षेपण जो आरामदायक बातचीत में लगातार सुनाई देते हैं।"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|0", "text": "probably → prolly"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|1", "text": "trying to → tryna"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|2", "text": "supposed to → s'posed to"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|caution", "text": "केवल अनौपचारिक बोलचाल में।"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|explain", "text": "दोस्तों के बीच और अमेरिकी अनौपचारिक बोली में सामान्य संक्षेपण।"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|0", "text": "let's go → less go"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|1", "text": "give it to me → gimme that"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|2", "text": "you all → y'all"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|caution", "text": "बहुत अनौपचारिक — 'y'all' क्षेत्रीय है (दक्षिणी अमेरिका) लेकिन व्यापक रूप से समझा जाता है। (US)"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|explain", "text": "तेज़, अनौपचारिक अमेरिकी बोली में गोल संख्याओं के बीच के व्यंजन ध्वनियाँ छोटी हो जाती हैं।"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|0", "text": "twenty → twenny"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|1", "text": "hundred → hunnerd"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|caution", "text": "केवल अनौपचारिक बोलचाल में — औपचारिक संदर्भों में हमेशा पूर्ण रूप बोलें।"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|explain", "text": "रोज़मर्रा के शब्दों का एक और समूह जो तेज़, आरामदायक बोली में नियमित रूप से एक अक्षर खो देते हैं।"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|0", "text": "different → diff'rent"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|1", "text": "general → gen'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|2", "text": "several → sev'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|3", "text": "camera → cam'ra"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|caution", "text": "अनौपचारिक बोलचाल में ठीक है; औपचारिक प्रस्तुतियों में पूरा रूप स्पष्ट रूप से कहें।"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|explain", "text": "बहुत अनौपचारिक संक्षेपण जो आप गानों और अनौपचारिक अमेरिकी बोलचाल में सुनेंगे, लेकिन पेशेवर परिस्थितियों में कभी इस्तेमाल नहीं करने चाहिए।"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|0", "text": "I'm going to → I'ma"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|1", "text": "kind of like → kinda like"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|caution", "text": "अत्यंत अनौपचारिक — केवल दोस्तों/गानों के बोल में, कभी पेशेवर संदर्भों में नहीं।"}, {"key": "551b9527-f712-421d-966c-24644f360746|explain", "text": "what's up / how's it going के अलावा कुछ और रोज़मर्रा के अभिवादन संक्षेपण।"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|0", "text": "how are you → how ya doin'"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|1", "text": "good to see you → good to see ya"}, {"key": "551b9527-f712-421d-966c-24644f360746|caution", "text": "केवल अनौपचारिक बोलचाल के रूप।"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|explain", "text": "आरामदायक अमेरिकी बोलचाल में आम obligation और desire के कुछ और संक्षेपण।"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|0", "text": "ought to → oughta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|1", "text": "don't have to → don't hafta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|2", "text": "want you → wantcha"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|caution", "text": "केवल अनौपचारिक बोलचाल में।"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|explain", "text": "यह एक उत्कृष्ट उदाहरण है कि अनौपचारिक अमेरिकी संक्षेपण कितनी दूर तक जा सकता है — कई शब्द मिलकर एक जैसे सुनाई देते हैं।"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|0", "text": "Did you eat yet? → Jeetyet?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|1", "text": "Did you already? → Jeetalready?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|caution", "text": "अत्यंत अनौपचारिक — तेज़ देशी भाषण को पहचानने के लिए, अपनी औपचारिक बोली के लिए नहीं।"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|explain", "text": "अनौपचारिक बातचीत में दो और आम phrase-level संक्षेपण।"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|0", "text": "because of → 'cause of"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|1", "text": "sort of a → sorta a"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|caution", "text": "केवल अनौपचारिक बोलचाल में।"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|explain", "text": "आरामदायक बोलचाल की अंग्रेज़ी में 'yes' और 'no' के बहुत आम अनौपचारिक विकल्प।"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|0", "text": "yes → yep / uh-huh"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|1", "text": "no → nope / nah"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|caution", "text": "केवल अनौपचारिक बातचीत में — औपचारिक या परीक्षा संदर्भों में 'yes'/'no' का प्रयोग करें।"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|explain", "text": "दोनों समान सुनाई देने वाले 'wanna' में बदल जाते हैं, लेकिन एक के बाद noun आता है और दूसरे के बाद verb — यह अंतर ध्यान देने योग्य है।"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|0", "text": "want a (coffee) → wanna coffee"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|1", "text": "want to (go) → wanna go"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|caution", "text": "केवल अनौपचारिक बोलचाल में।"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|0", "text": "'want a' + noun → wanna"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|1", "text": "'want to' + verb → wanna"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|explain", "text": "'would have' का नकारात्मक रूप भी सकारात्मक रूप की तरह ही संक्षिप्त होता है।"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|point|0", "text": "wouldn't have → wouldn'ta"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|caution", "text": "केवल अनौपचारिक बोलचाल में — अन्यथा 'wouldn't have' पूरा लिखें।"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|explain", "text": "आम बोलचाल की व्याख्याओं और अनुरोधों में प्रयुक्त दो और रोज़मर्रा के संक्षिप्त रूप।"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|0", "text": "just because → just 'cause"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|1", "text": "going to need → gonna need"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|caution", "text": "केवल अनौपचारिक बोलचाल में।"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|explain", "text": "'Ain't' बहुत अनौपचारिक बोलचाल में am not/is not/are not/has not/have not की जगह आता है और गानों तथा अनौपचारिक बातचीत में हर जगह सुनाई देता है।"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|0", "text": "I am not → I ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|1", "text": "that is not → that ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|2", "text": "you have not → you ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|caution", "text": "लिखने या औपचारिक भाषण में कभी प्रयोग न करें — इसे गैर-मानक व्याकरण माना जाता है, भले ही अनौपचारिक रूप से यह अत्यंत आम है।"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|explain", "text": "'I understand' या शाब्दिक रूप से 'caught you' कहने का एक बहुत आम अनौपचारिक तरीका।"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|0", "text": "got you (understand) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|1", "text": "got you (caught) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|caution", "text": "केवल अनौपचारिक बोलचाल में — पेशेवर संदर्भों में 'I understand' या 'got it' कहें।"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|explain", "text": "अतीत के बारे में अनुमान लगाने के लिए प्रयुक्त modal-perfect संक्षिप्त रूप, coulda/woulda/shoulda के साथ।"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|0", "text": "must have → musta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|1", "text": "might have → mighta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|caution", "text": "केवल अनौपचारिक बोलचाल में — अन्यथा 'must have'/'might have' पूरा लिखें।"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|explain", "text": "coulda/woulda/shoulda के नकारात्मक रूप, पछतावे की बात करते समय आम।"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|0", "text": "shouldn't have → shouldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|1", "text": "couldn't have → couldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|caution", "text": "केवल अनौपचारिक बोलचाल में — औपचारिक संदर्भों में 'shouldn't have'/'couldn't have' पूरा लिखें।"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|explain", "text": "सहज बोलचाल में, अंतिम -ing ध्वनि अक्सर अपना 'g' छोड़ देती है, इसलिए यह -in' जैसी सुनाई देती है। यह लगभग किसी भी -ing क्रिया के साथ होता है। (, so it sounds like -in)"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|0", "text": "doing → doin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|1", "text": "going → goin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|2", "text": "talking → talkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|3", "text": "thinking → thinkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|caution", "text": "केवल अनौपचारिक बोलचाल में — presentations, interviews और exams में पूरा '-ing' स्पष्ट रूप से बोलें।"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|explain", "text": "-thing पर समाप्त होने वाले indefinite pronouns पर भी g-dropping का यही pattern लागू होता है।"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|0", "text": "something → somethin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|1", "text": "nothing → nothin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|2", "text": "anything → anythin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|caution", "text": "केवल अनौपचारिक बोलचाल में।"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|explain", "text": "बहुत आम अनौपचारिक बोलचाल में verb के बाद 'Them' घटकर 'em हो जाता है ('th' लुप्त हो जाता है)।"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|0", "text": "tell them → tell 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|1", "text": "get them → get 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|2", "text": "ask them → ask 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|caution", "text": "केवल अनौपचारिक बोलचाल में — लिखने या औपचारिक भाषण में पूरा 'them' कहें।"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|explain", "text": "दो निकट से जुड़े शब्दों के बीच 'And' घटकर तेज़ 'n' ध्वनि बन जाता है, विशेषकर set phrases में।"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|0", "text": "rock and roll → rock 'n' roll"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|1", "text": "fish and chips → fish 'n' chips"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|2", "text": "back and forth → back 'n' forth"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|caution", "text": "set phrases और तेज़ बोलचाल में आम — औपचारिक लेखन में 'and' स्पष्ट रूप से लिखें।"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|explain", "text": "अकेला 'Because' (केवल 'because of' नहीं) अनौपचारिक उत्तरों में अक्सर घटकर 'cause हो जाता है।"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|point|0", "text": "because → 'cause"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|caution", "text": "केवल अनौपचारिक बोलचाल में — अन्यथा पूरा 'because' लिखें।"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|explain", "text": "तेज़, अनौपचारिक उत्तरों में 'Of course' अक्सर अपना पहला शब्द छोड़ देता है।"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|point|0", "text": "of course → 'course"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|caution", "text": "केवल अनौपचारिक बोलचाल में।"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|explain", "text": "'all right' का एक बहुत आम अनौपचारिक उच्चारण, जो सहमति या स्वीकृति के लिए प्रयोग होता है।"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|point|0", "text": "all right → aight"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|caution", "text": "बहुत अनौपचारिक — professional contexts में 'all right' या 'okay' कहें।"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|explain", "text": "'Let you' उसी तरह घटता है जैसे 'want you'/'wantcha' घटता है।"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|point|0", "text": "let you → letcha"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|caution", "text": "केवल अनौपचारिक बोलचाल में।"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|explain", "text": "एक और अत्यधिक तेज़-भाषण मिश्रण, 'jeetyet' के समान — कई शब्द एक ध्वनि में सिकुड़ जाते हैं।"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|point|0", "text": "did you ever → jever"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|caution", "text": "तेज़ देशी भाषण को पहचानने के लिए, अपनी औपचारिक बोली के लिए नहीं।"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|explain", "text": "जब 'going to' और 'have to' साथ-साथ आते हैं तो दो संक्षेपण एक साथ जुड़ जाते हैं।"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|point|0", "text": "going to have to → gonna hafta"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|caution", "text": "केवल अनौपचारिक बोलचाल में — अन्यथा 'going to have to' पूरा लिखें।"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|explain", "text": "'gonna' संक्षेपण नकारात्मक और भूतकाल के साथ भी लागू होता है।"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|0", "text": "not going to → not gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|1", "text": "wasn't going to → wasn't gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|caution", "text": "केवल अनौपचारिक बोलचाल में।"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|explain", "text": "ब्रिटिश अंग्रेज़ी में एक बहुत आम tag question संक्षेपण, पुष्टि करने या ज़ोर देने के लिए प्रयुक्त।"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|point|0", "text": "isn't it → innit"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|caution", "text": "बहुत अनौपचारिक ब्रिटिश स्लैंग — औपचारिक भाषण में प्रयोग न करें, UK में भी नहीं।"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|explain", "text": "कुछ प्रस्तावित करने या सहमति माँगने का एक अनौपचारिक तरीका।"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|point|0", "text": "what do you say → whaddya say"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|caution", "text": "केवल अनौपचारिक बोलचाल में।"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|explain", "text": "अनौपचारिक बोलचाल की अंग्रेज़ी में एक अत्यंत आम भराव वाक्यांश, सोचते समय या ज़ोर देने के लिए प्रयुक्त।"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|point|0", "text": "you know → y'know"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|caution", "text": "केवल अनौपचारिक भराव — इसका अत्यधिक प्रयोग अनौपचारिक रूप से भी अशिष्ट लगता है।"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|explain", "text": "एक बहुत अनौपचारिक अभिवादन, 'what's up' से छोटा किया गया।"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|point|0", "text": "what's up → s'up"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|caution", "text": "केवल दोस्तों के बीच बहुत अनौपचारिक अभिवादन।"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|explain", "text": "'Him' और 'her' भी अनौपचारिक भाषण में कमज़ोर हो जाते हैं, जैसे 'them' → 'em।"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|0", "text": "tell him → tell 'im"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|1", "text": "ask her → ask 'er"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|caution", "text": "केवल अनौपचारिक बोलचाल में।"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|explain", "text": "बहुत अनौपचारिक भाषण में अतिरिक्त अनिश्चितता के लिए 'Kinda' और 'sorta' अक्सर संयुक्त किए जाते हैं।"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|point|0", "text": "kind of sort of → kinda sorta"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|caution", "text": "बहुत अनौपचारिक — किसी भी पेशेवर या परीक्षा संदर्भ में इससे बचें।"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|explain", "text": "एक और तेज़-बोली प्रश्न-आरंभकर्ता मिश्रण, 'dja' और 'wouldja' के साथ।"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|point|0", "text": "didn't you → dincha"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|caution", "text": "तेज़ देशी बोली को पहचानने के लिए, अपनी औपचारिक बोली के लिए नहीं।"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|explain", "text": "'have to' का भूतकाल रूप भी वर्तमान रूप की तरह ही संक्षिप्त होता है।"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|point|0", "text": "had to → hadta"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|caution", "text": "केवल अनौपचारिक बोली में।"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|explain", "text": "अनौपचारिक अनुरोधों में प्रयुक्त एक आम संक्षेपण, 'wouldja' और 'couldja' जैसे रूपों के साथ।"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|point|0", "text": "will you → willcha"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|caution", "text": "केवल अनौपचारिक बोली में।"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|explain", "text": "'of' वाले मात्रा-वाक्यांश उसी तरह संक्षिप्त होते हैं जैसे 'cuppa' में 'cup of' होता है।"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|0", "text": "lots of → lotsa"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|1", "text": "bunch of → buncha"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|caution", "text": "केवल अनौपचारिक बोली में।"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|explain", "text": "एक प्रबल अनौपचारिक तीव्रक जिसका अर्थ है 'a very impressive/big'।"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|point|0", "text": "hell of a → helluva"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|caution", "text": "हल्का अशिष्ट — दोस्तों के साथ ठीक, पेशेवर या शिष्ट परिस्थितियों में टालें।"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|explain", "text": "पुराने अभिवादन 'how do you do' का ऐतिहासिक संक्षेपण, अब स्वयं एक अनौपचारिक, मैत्रीपूर्ण अभिवादन (विशेषकर दक्षिणी US में)।"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|point|0", "text": "how do you do → howdy"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|caution", "text": "केवल अनौपचारिक, मैत्रीपूर्ण अभिवादन।"}, {"key": "47538641-f573-4840-af35-02857a1d24de|explain", "text": "'I suppose' अनौपचारिक बोली में आमतौर पर अपनी बीच की अक्षरांश छोड़ देता है, हल्की अनिश्चितता या अनिच्छुक सहमति व्यक्त करने के लिए प्रयुक्त — 'supposed to' → s'posed to से अलग।"}, {"key": "47538641-f573-4840-af35-02857a1d24de|point|0", "text": "I suppose → I s'pose"}, {"key": "47538641-f573-4840-af35-02857a1d24de|caution", "text": "केवल अनौपचारिक बोली में — अन्यथा पूरा 'I suppose' लिखें।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|explain", "text": "50 लक्षित अभ्यासों में संक्षेपणों में महारत हासिल करें। AI मॉडल को ध्यान से सुनें, दोहराएँ, और विस्तृत वास्तविक-समय उच्चारण स्कोरिंग और प्रतिक्रिया प्राप्त करने के लिए अपनी आवाज़ रिकॉर्ड करें।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|0", "text": "प्रत्येक अभ्यास में हाइलाइट की गई लय, बल और प्रवाह पर ध्यान दें।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|1", "text": "प्रत्येक रिकॉर्डिंग प्रयास से पहले संदर्भ मॉडल ऑडियो सुनें।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|2", "text": "सुधार के क्षेत्रों को इंगित करने के लिए अपने AI स्कोर और स्वनिम-स्तरीय प्रतिक्रिया की समीक्षा करें।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|caution", "text": "अभ्यासों में जल्दबाज़ी न करें; स्पष्टता, स्वाभाविक लय और सटीक उच्चारण को प्राथमिकता दें।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|0", "text": "सहायक शब्दों का स्वाभाविक प्रवाह में अत्यधिक संक्षेपण।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|1", "text": "'going to' -> 'gonna'; 'him' -> ''im'।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|2", "text": "'have got to' 'gotta' में संक्षिप्त होता है।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|3", "text": "'want a' -> 'wanna'; 'of' -> 'a' /ə/।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|4", "text": "'has to' -> 'hasta' /hæstə/; 'for' -> /fər/।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|5", "text": "'let me' -> 'lemme'; 'you' -> 'ya'।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|6", "text": "'give me' -> 'gimme'।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|7", "text": "'could you' -> 'couldja' /kʊdʒə/।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|8", "text": "'would you' -> 'wouldja'।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|9", "text": "'what did you' -> 'whaddya'; 'him' -> ''im'।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|10", "text": "'should have' -> 'shoulda' /ʃʊdə/।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|11", "text": "'could have' -> 'coulda' /kʊdə/।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|12", "text": "'would have' -> 'woulda' /wʊdə/।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|13", "text": "'must have' -> 'musta' /mʌstə/।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|14", "text": "'might have' -> 'mighta' /maɪtə/।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|15", "text": "'used to' -> 'usta' /juːstə/।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|16", "text": "'supposed to' -> 'sposta' /spoʊstə/।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|17", "text": "'need to' -> 'needa'; 'to' -> /də/।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|18", "text": "'to' -> /də/; 'for' -> /fər/।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|19", "text": "'kind of' -> 'kinda' /kaɪndə/।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|20", "text": "'sort of' -> 'sorta' /sɔːrtə/।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|21", "text": "'lots of' -> 'lotsa' /lɒtsə/।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|22", "text": "'out of' -> 'outta' /aʊtə/।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|23", "text": "'front of' -> 'fronta'।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|24", "text": "अनौपचारिक बोलचाल में 'I am going to' घटकर 'I'mma' हो जाता है।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|25", "text": "'don't you' -> 'doncha'; 'want to' -> 'wanna'।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|26", "text": "'didn't you' -> 'didn'tcha'।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|27", "text": "'haven't you' -> 'haven'tcha'।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|28", "text": "'and' घटकर syllabic 'n' /n/ हो जाता है।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|29", "text": "'day and night' -> 'day 'n night'।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|30", "text": "'or' घटकर /ər/ हो जाता है; 'it or' सहज रूप से flap हो जाता है।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|31", "text": "'or' घटकर unstressed /ər/ हो जाता है।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|32", "text": "stops के बीच 'and' घटकर /n/ हो जाता है।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|33", "text": "Relative 'that' का उच्चारण schwa के साथ /ðət/ हो जाता है।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|34", "text": "Conjunction 'that' weak और short होता है।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|35", "text": "'that' का उच्चारण /ðət/ होता है।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|36", "text": "'them' का उच्चारण ''em' /əm/ हो जाता है।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|37", "text": "'them' -> ''em'।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|38", "text": "'them' -> ''em'।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|39", "text": "'some' -> /səm/; 'for' -> /fər/।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|40", "text": "'for' -> /fər/; 'you' -> /jə/।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|41", "text": "'are' -> /ər/; 'you' -> /jə/; 'to' -> /tə/।"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|42", "text": "'were' का उच्चारण /wər/ हो जाता है।"}]
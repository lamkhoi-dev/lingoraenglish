[{"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|point|3", "text": "got to → gotta"}, {"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|caution", "text": "Jde o neformální mluvené tvary. Nepište je v esejích, e-mailech ani u formálních zkoušek a vyhněte se jim při formální prezentaci."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|explain", "text": "Další hovorové redukce, které neustále uslyšíte ve filmech i v běžné konverzaci."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|0", "text": "kind of → kinda"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|1", "text": "sort of → sorta"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|2", "text": "let me → lemme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|3", "text": "give me → gimme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|4", "text": "what do you → whaddaya"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|caution", "text": "Pouze pro neformální situace. U zkoušky IELTS nebo na pracovním pohovoru používejte plné tvary."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|explain", "text": "Další redukce vyjadřující povinnost nebo zvyk, běžné v uvolněné mluvené angličtině."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|0", "text": "have to → hafta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|1", "text": "need to → needa"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|2", "text": "used to → useta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|caution", "text": "Pouze neformální mluvené tvary — v psaném projevu je nikdy nepoužívejte."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|explain", "text": "Redukce minulých modálních sloves — velmi časté při mluvení o lítosti nebo hypotetických situacích."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|0", "text": "could have → coulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|1", "text": "would have → woulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|2", "text": "should have → shoulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|caution", "text": "Pouze pro neformální mluvený projev — ve formálním psaném projevu pište 'could have' v plném tvaru."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|explain", "text": "Velmi hovorové redukce, běžné v písničkách, filmech a uvolněné konverzaci mezi přáteli."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|0", "text": "don't know → dunno"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|1", "text": "don't you → dontcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|2", "text": "what are you → whatcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|caution", "text": "Velmi neformální — pouze s blízkými přáteli, nikdy ne v profesním kontextu nebo u zkoušek."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|explain", "text": "Běžné redukce spojené s předložkami v neformální mluvě."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|0", "text": "out of → outta"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|1", "text": "off of → offa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|2", "text": "cup of → cuppa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|caution", "text": "Pouze neformální."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|explain", "text": "Každodenní zvolání a běžné fráze s výraznou redukcí."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|0", "text": "come on → c'mon"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|1", "text": "going to be → gonna be"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|2", "text": "some more → s'more"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|caution", "text": "Pouze neformální."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|explain", "text": "Začátky otázek se v rychlé, neformální konverzaci výrazně redukují."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|0", "text": "did you → dja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|1", "text": "do you → dya"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|2", "text": "would you → wouldja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|caution", "text": "Pouze pro neformální, mluvený projev."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|explain", "text": "V neformální mluvě se často redukují i časové výrazy."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|0", "text": "a couple of → a couple"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|1", "text": "in a minute → in a min"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|caution", "text": "Vhodné v neformálním hovoru, ne v psaném projevu."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|explain", "text": "Další běžné neformální redukce, které neustále uslyšíte v uvolněné konverzaci."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|0", "text": "probably → prolly"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|1", "text": "trying to → tryna"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|2", "text": "supposed to → s'posed to"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|caution", "text": "Pouze v neformální mluvě."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|explain", "text": "Neformální redukce běžné mezi přáteli a v neformální americké angličtině."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|0", "text": "let's go → less go"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|1", "text": "give it to me → gimme that"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|2", "text": "you all → y'all"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|caution", "text": "Velmi neformální – výraz 'y'all' je regionální (jih US), ale široce srozumitelný."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|explain", "text": "Zaokrouhlená čísla v rychlé, neformální americké angličtině redukují své prostřední souhlásky."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|0", "text": "twenty → twenny"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|1", "text": "hundred → hunnerd"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|caution", "text": "Pouze v neformální mluvě – ve formálním kontextu vždy vyslovujte plný tvar."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|explain", "text": "Další skupina běžných slov, která v rychlé a uvolněné mluvě pravidelně ztrácejí slabiku."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|0", "text": "different → diff'rent"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|1", "text": "general → gen'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|2", "text": "several → sev'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|3", "text": "camera → cam'ra"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|caution", "text": "V běžné mluvě naprosto v pořádku; při formálních prezentacích vyslovujte zřetelně plný tvar."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|explain", "text": "Velmi neformální redukce, které uslyšíte v písních a běžné americké mluvě, ale v profesionálním prostředí byste je nikdy neměli používat."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|0", "text": "I'm going to → I'ma"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|1", "text": "kind of like → kinda like"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|caution", "text": "Extrémně neformální – vhodné pouze mezi přáteli nebo v textech písní, nikdy ne v profesionálním kontextu."}, {"key": "551b9527-f712-421d-966c-24644f360746|explain", "text": "Další redukce běžných pozdravů kromě what's up / how's it going."}, {"key": "551b9527-f712-421d-966c-24644f360746|point|0", "text": "how are you → how ya doin'"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|1", "text": "good to see you → good to see ya"}, {"key": "551b9527-f712-421d-966c-24644f360746|caution", "text": "Pouze pro neformální mluvený projev."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|explain", "text": "Další redukce vyjadřující povinnost a přání, běžné v uvolněné americké angličtině."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|0", "text": "ought to → oughta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|1", "text": "don't have to → don't hafta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|2", "text": "want you → wantcha"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|caution", "text": "Pouze v neformální mluvě."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|explain", "text": "Klasický příklad toho, jak daleko může v neformální americké angličtině redukce zajít – několik slov splyne v jedno zdánlivé slovo."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|0", "text": "Did you eat yet? → Jeetyet?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|1", "text": "Did you already? → Jeetalready?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|caution", "text": "Extrémně neformální – slouží k porozumění rychlé mluvě rodilých mluvčích, nikoli pro váš vlastní formální projev."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|explain", "text": "Další dvě běžné redukce celých frází v neformální konverzaci."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|0", "text": "because of → 'cause of"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|1", "text": "sort of a → sorta a"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|caution", "text": "Pouze v neformální mluvené angličtině."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|explain", "text": "Velmi běžné neformální alternativy ke slovům 'yes' a 'no' v uvolněné mluvené angličtině."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|0", "text": "yes → yep / uh-huh"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|1", "text": "no → nope / nah"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|caution", "text": "Pouze v neformální konverzaci – ve formálním prostředí nebo u zkoušek používejte 'yes'/'no'."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|explain", "text": "Obě vazby se redukují na podobně znějící 'wanna', po jedné však následuje podstatné jméno a po druhé sloveso – tohoto rozdílu stojí za to si všimnout."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|0", "text": "want a (coffee) → wanna coffee"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|1", "text": "want to (go) → wanna go"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|caution", "text": "Pouze v neformální mluvené angličtině."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|0", "text": "'want a' + podstatné jméno → wanna"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|1", "text": "'want to' + sloveso → wanna"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|explain", "text": "Záporná varianta od 'would have' se redukuje stejným způsobem jako kladná forma."}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|point|0", "text": "wouldn't have → wouldn'ta"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|caution", "text": "Pouze v neformální mluvené angličtině – jinak pište celé 'wouldn't have'."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|explain", "text": "Další dvě běžné redukce, s nimiž se často setkáte při neformálním vysvětlování a žádostech."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|0", "text": "just because → just 'cause"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|1", "text": "going to need → gonna need"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|caution", "text": "Pouze v neformální mluvené angličtině."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|explain", "text": "'Ain't' ve velmi neformální mluvě nahrazuje am not/is not/are not/has not/have not a běžně se objevuje v písních i každodenním hovoru."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|0", "text": "I am not → I ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|1", "text": "that is not → that ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|2", "text": "you have not → you ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|caution", "text": "Nikdy nepoužívejte v písmu ani ve formálním projevu – jedná se o nespisovnou gramatiku, ačkoli je v neformální angličtině extrémně rozšířená."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|explain", "text": "Velmi běžný neformální způsob, jak říci 'I understand' nebo doslova 'caught you'."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|0", "text": "got you (rozumím) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|1", "text": "got you (mám tě) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|caution", "text": "Pouze v neformální mluvené angličtině – v profesním prostředí použijte 'I understand' nebo 'got it'."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|explain", "text": "Redukce modálních sloves s minulým infinitivem používané při odhadech minulosti, podobně jako coulda/woulda/shoulda."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|0", "text": "must have → musta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|1", "text": "might have → mighta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|caution", "text": "Pouze v neformální mluvené angličtině – jinak pište plné tvary 'must have'/'might have'."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|explain", "text": "Záporné protějšky tvarů coulda/woulda/shoulda, běžné při vyjadřování lítosti či výčitek."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|0", "text": "shouldn't have → shouldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|1", "text": "couldn't have → couldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|caution", "text": "Pouze v neformální mluvené angličtině – ve formálním kontextu pište 'shouldn't have'/'couldn't have' v plném tvaru."}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|explain", "text": "V uvolněné mluvě koncové -ing často ztrácí své 'g', takže zní jako -in'. K tomu dochází téměř u všech sloves s koncovkou -ing. (, so it sounds like -in)"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|0", "text": "doing → doin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|1", "text": "going → goin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|2", "text": "talking → talkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|3", "text": "thinking → thinkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|caution", "text": "Pouze v neformální řeči — při prezentacích, pohovorech a zkouškách vyslovujte celé '-ing' zřetelně."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|explain", "text": "Stejné vypouštění g platí i pro neurčitá zájmena končící na -thing."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|0", "text": "something → somethin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|1", "text": "nothing → nothin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|2", "text": "anything → anythin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|caution", "text": "Pouze v neformální řeči."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|explain", "text": "'Them' se po slovesu ve velmi běžné neformální řeči redukuje na 'em (vypadává 'th')."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|0", "text": "tell them → tell 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|1", "text": "get them → get 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|2", "text": "ask them → ask 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|caution", "text": "Pouze v neformální mluvené angličtině — v písmu nebo formálním projevu vyslovujte plné 'them'."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|explain", "text": "'And' se mezi dvěma úzce spojenými slovy redukuje na rychlý zvuk 'n', zejména v ustálených frázích."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|0", "text": "rock and roll → rock 'n' roll"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|1", "text": "fish and chips → fish 'n' chips"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|2", "text": "back and forth → back 'n' forth"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|caution", "text": "Běžné v ustálených frázích a rychlé řeči — ve formálním psaném projevu pište 'and' celé."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|explain", "text": "Samotné 'Because' (nejen 'because of') se v neformálních odpovědích často zkracuje na 'cause."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|point|0", "text": "because → 'cause"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|caution", "text": "Pouze v neformální mluvené angličtině — jinak pište celé slovo 'because'."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|explain", "text": "V rychlých, neformálních odpovědích se z 'Of course' často vypouští první slovo."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|point|0", "text": "of course → 'course"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|caution", "text": "Pouze v neformální mluvě."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|explain", "text": "Velmi běžná neformální výslovnost výrazu 'all right', používaná k vyjádření souhlasu nebo porozumění."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|point|0", "text": "all right → aight"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|caution", "text": "Velmi neformální — v profesionálním prostředí říkejte 'all right' nebo 'okay'."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|explain", "text": "'Let you' se redukuje stejným způsobem jako 'want you'/'wantcha'."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|point|0", "text": "let you → letcha"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|caution", "text": "Pouze v neformální mluvené angličtině."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|explain", "text": "Další extrémní splynutí v rychlé řeči, podobné jako 'jeetyet' — několik slov se stáhne do jediného zvuku."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|point|0", "text": "did you ever → jever"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|caution", "text": "Slouží k rozpoznání rychlé řeči rodilých mluvčích, nikoli pro váš vlastní formální projev."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|explain", "text": "Když se 'going to' a 'have to' objeví vedle sebe, obě redukce se spojí dohromady."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|point|0", "text": "going to have to → gonna hafta"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|caution", "text": "Pouze v neformální mluvené angličtině — v ostatních případech pište celé 'going to have to'."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|explain", "text": "Redukce 'gonna' funguje i v záporu a minulém čase."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|0", "text": "not going to → not gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|1", "text": "wasn't going to → wasn't gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|caution", "text": "Pouze v neformální mluvené řeči."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|explain", "text": "Velmi běžná redukce tázacího dovětku v britské angličtině, která se používá pro potvrzení nebo dodání důrazu."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|point|0", "text": "isn't it → innit"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|caution", "text": "Velmi neformální britský slang – nepoužívejte ve formálním projevu, a to ani ve Spojeném království (UK)."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|explain", "text": "Neformální způsob, jak něco navrhnout nebo požádat o souhlas."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|point|0", "text": "what do you say → whaddya say"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|caution", "text": "Pouze v neformální mluvené řeči."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|explain", "text": "Mimořádně běžná vycpávková fráze v neformální mluvené angličtině, používaná při přemýšlení nebo pro zdůraznění."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|point|0", "text": "you know → y'know"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|caution", "text": "Pouze neformální vycpávkové slovo – jeho nadužívání působí nekultivovaně i v neformálním kontextu."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|explain", "text": "Velmi neformální pozdrav, zkrácený z 'what's up'."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|point|0", "text": "what's up → s'up"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|caution", "text": "Velmi neformální pozdrav výhradně mezi přáteli."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|explain", "text": "'Him' a 'her' se v neformální řeči také redukují, podobně jako 'them' → 'em."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|0", "text": "tell him → tell 'im"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|1", "text": "ask her → ask 'er"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|caution", "text": "Pouze v neformální mluvené řeči."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|explain", "text": "'Kinda' a 'sorta' se ve velmi neformální řeči často kombinují pro ještě větší zmírnění významu (hedging)."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|point|0", "text": "kind of sort of → kinda sorta"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|caution", "text": "Velmi neformální – vyhněte se tomuto výrazu v jakémkoli profesním či zkouškovém kontextu."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|explain", "text": "Další splynutí slov na začátku otázky v rychlé mluvě, podobně jako dja a wouldja."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|point|0", "text": "didn't you → dincha"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|caution", "text": "Slouží k rozpoznání rychlé řeči rodilých mluvčích, nikoli pro váš vlastní formální projev."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|explain", "text": "Minulý čas slovesa 'have to' se redukuje stejným způsobem jako tvar v přítomném čase."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|point|0", "text": "had to → hadta"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|caution", "text": "Pouze v neformální mluvené řeči."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|explain", "text": "Neformální redukce používaná při neformálních žádostech, podobně jako tvary typu wouldja a couldja."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|point|0", "text": "will you → willcha"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|caution", "text": "Pouze v neformální mluvené řeči."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|explain", "text": "Výrazy množství s 'of' se redukují stejně jako 'cup of' na 'cuppa'."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|0", "text": "lots of → lotsa"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|1", "text": "bunch of → buncha"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|caution", "text": "Pouze v neformální mluvené řeči."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|explain", "text": "Silné neformální zdůrazňující slovo ve významu „pořádný / pořádně velký / úžasný“. (a very impressive/big)"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|point|0", "text": "hell of a → helluva"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|caution", "text": "Mírně hrubé – mezi přáteli je v pořádku, ale vyhněte se mu v profesním nebo formálním prostředí."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|explain", "text": "Historická redukce starého pozdravu 'how do you do', ze které se stal samostatný neformální a přátelský pozdrav (zejména na jihu USA)."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|point|0", "text": "how do you do → howdy"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|caution", "text": "Pouze neformální, přátelský pozdrav."}, {"key": "47538641-f573-4840-af35-02857a1d24de|explain", "text": "V neformální mluvě se u 'I suppose' běžně vypouští prostřední slabika; používá se k vyjádření mírné nejistoty nebo zdráhavého souhlasu – liší se od 'supposed to' → s'posed to."}, {"key": "47538641-f573-4840-af35-02857a1d24de|point|0", "text": "I suppose → I s'pose"}, {"key": "47538641-f573-4840-af35-02857a1d24de|caution", "text": "Pouze v neformální mluvené řeči – jinak pište 'I suppose' v plném tvaru."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|explain", "text": "Osvojte si redukce v 50 cílených cvičeních. Pozorně poslouchejte model AI, opakujte a nahrajte svůj hlas, abyste získali podrobné hodnocení výslovnosti a zpětnou vazbu v reálném čase."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|0", "text": "Soustřeďte se na rytmus, přízvuk a plynulost zvýrazněné v každém cvičení."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|1", "text": "Před každým pokusem o nahrávku si poslechněte vzorové audio."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|2", "text": "Zkontrolujte své skóre z AI a zpětnou vazbu na úrovni jednotlivých fonémů, abyste přesně věděli, co zlepšit."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|caution", "text": "Při cvičeních nespěchejte; upřednostněte srozumitelnost, přirozené tempo a přesnou artikulaci."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|0", "text": "Výrazná redukce pomocných slov pro dosažení přirozené plynulosti."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|1", "text": "'going to' -> 'gonna'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|2", "text": "'have got to' se redukuje na 'gotta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|3", "text": "'want a' -> 'wanna'; 'of' -> 'a' /ə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|4", "text": "'has to' -> 'hasta' /hæstə/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|5", "text": "'let me' -> 'lemme'; 'you' -> 'ya'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|6", "text": "'give me' -> 'gimme'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|7", "text": "'could you' -> 'couldja' /kʊdʒə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|8", "text": "'would you' -> 'wouldja'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|9", "text": "'what did you' -> 'whaddya'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|10", "text": "'should have' -> 'shoulda' /ʃʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|11", "text": "'could have' -> 'coulda' /kʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|12", "text": "'would have' -> 'woulda' /wʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|13", "text": "'must have' -> 'musta' /mʌstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|14", "text": "'might have' -> 'mighta' /maɪtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|15", "text": "'used to' -> 'usta' /juːstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|16", "text": "'supposed to' -> 'sposta' /spoʊstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|17", "text": "'need to' -> 'needa'; 'to' -> /də/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|18", "text": "'to' -> /də/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|19", "text": "'kind of' -> 'kinda' /kaɪndə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|20", "text": "'sort of' -> 'sorta' /sɔːrtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|21", "text": "'lots of' -> 'lotsa' /lɒtsə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|22", "text": "'out of' -> 'outta' /aʊtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|23", "text": "'front of' -> 'fronta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|24", "text": "V neformální mluvě se 'I am going to' redukuje na 'I'mma'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|25", "text": "'don't you' -> 'doncha'; 'want to' -> 'wanna'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|26", "text": "'didn't you' -> 'didn'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|27", "text": "'haven't you' -> 'haven'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|28", "text": "'and' se redukuje na slabikotvorné 'n' /n/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|29", "text": "'day and night' -> 'day 'n night'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|30", "text": "'or' se redukuje na /ər/; spojení 'it or' se plynule vyslovuje s flapem."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|31", "text": "'or' se redukuje na nepřízvučné /ər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|32", "text": "'and' se mezi závěrovými souhláskami redukuje na /n/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|33", "text": "Vztažné 'that' se redukuje na /ðət/ se schwa."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|34", "text": "Spojka 'that' je slabá a krátká."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|35", "text": "'that' se vyslovuje jako /ðət/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|36", "text": "'them' se redukuje na ''em' /əm/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|37", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|38", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|39", "text": "'some' -> /səm/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|40", "text": "'for' -> /fər/; 'you' -> /jə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|41", "text": "'are' -> /ər/; 'you' -> /jə/; 'to' -> /tə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|42", "text": "'were' se redukuje na /wər/."}]
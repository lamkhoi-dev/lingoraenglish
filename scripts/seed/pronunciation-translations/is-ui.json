[{"key": "pron.hero.title", "text": "Hljómaðu skýrar, eðlilegar og liprar"}, {"key": "pron.hero.description", "text": "Öll {{count}} ensk hljóð auk orðáherslu, setningsáherslu, tónfalls, samfellds máls, styttinga, takts, setningahluta og lipurðar — hver kennslustund endar með þinni eigin upptöku."}, {"key": "pron.imageAlt", "text": "Framburður, málbeining og IPA"}, {"key": "pron.progress.title", "text": "Framfarir þínar í framburði"}, {"key": "pron.progress.descUser", "text": "Mælt út frá orðunum sem þjálfarinn þekkti í þínum eigin upptökum."}, {"key": "pron.progress.descGuest", "text": "Búðu til ókeypis aðgang til að taka upp og byrja að fylgjast með framförum."}, {"key": "pron.recommended", "text": "Mælt með fyrir þig"}, {"key": "pron.soundLabel", "text": "{{symbol}} hljóð"}, {"key": "pron.skill.sounds", "text": "Hljóð"}, {"key": "pron.skill.sounds.blurb", "text": "Öll 44 ensk hljóð með lágmarkspörum."}, {"key": "pron.skill.wordStress", "text": "Orðáhersla"}, {"key": "pron.skill.wordStress.blurb", "text": "Atkvæði, aðal- og aukaáhersla."}, {"key": "pron.skill.sentenceStress", "text": "Setningsáhersla"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Innihaldsorð sterk, smáorð veik."}, {"key": "pron.skill.intonation", "text": "Tónfall"}, {"key": "pron.skill.intonation.blurb", "text": "Hækkandi, lækkandi, hækkandi-lækkandi og lækkandi-hækkandi."}, {"key": "pron.skill.connectedSpeech", "text": "Samfellt mál"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Tenging, brottfall, aðlögun, veikar myndir."}, {"key": "pron.skill.reductions", "text": "Styttingar"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — óformlegt talað mál."}, {"key": "pron.skill.rhythm", "text": "Taktur"}, {"key": "pron.skill.rhythm.blurb", "text": "Áherslutaktur, tímasetning og hlé."}, {"key": "pron.skill.chunking", "text": "Hlé og setningahlutar"}, {"key": "pron.skill.chunking.blurb", "text": "Hugsanahópar og eðlileg andardráttshlé."}, {"key": "pron.skill.fluency", "text": "Lipurð"}, {"key": "pron.skill.fluency.blurb", "text": "Hraði, hiki, fylliorð og tenging hugmynda."}, {"key": "pron.filter.searchPlaceholder", "text": "Leitaðu að hljóði, orði eða kennslustund"}, {"key": "pron.filter.allLevels", "text": "Öll stig"}, {"key": "pron.filter.beginner", "text": "Byrjandi"}, {"key": "pron.filter.intermediate", "text": "Miðstig"}, {"key": "pron.filter.advanced", "text": "Framhald"}, {"key": "pron.filter.allDifficulties", "text": "Allt erfiðleikastig"}, {"key": "pron.filter.gentle", "text": "Milt"}, {"key": "pron.filter.steady", "text": "Jafnt"}, {"key": "pron.filter.challenging", "text": "Krefjandi"}, {"key": "pron.filter.us", "text": "Bandarísk enska"}, {"key": "pron.filter.uk", "text": "Bresk enska"}, {"key": "pron.sounds.title", "text": "Ensku hljóðin {{count}}"}, {"key": "pron.sounds.shown", "text": "{{count}} sýnd"}, {"key": "pron.lessons.title", "text": "{{skill}} kennslustundir"}, {"key": "pron.lessons.none", "text": "Engin kennslustund passar við þessar síur. Prófaðu „Öll stig“ og „Allt erfiðleikastig“."}, {"key": "pron.how", "text": "Hvernig"}, {"key": "pron.commonMistakes", "text": "Algeng mistök"}, {"key": "pron.wordPractice", "text": "Orðæfing"}, {"key": "pron.sentencePractice", "text": "Setningaæfing"}, {"key": "pron.minimalPairs", "text": "Lágmarkspör"}, {"key": "pron.practise", "text": "Æfa"}, {"key": "pron.toast.signInModel", "text": "Skráðu þig inn til að heyra AI-fyrirmyndina."}, {"key": "pron.toast.playError", "text": "Gat ekki spilað hljóð."}, {"key": "pron.voicedDesc", "text": "Raddað — raddböndin titra"}, {"key": "pron.voicelessDesc", "text": "Óraddað — aðeins andi, engin titringur"}, {"key": "pron.soundPracticeHint", "text": "Ýttu á „1. Hlusta“ í æfingakortinu hér til hægri til að heyra AI-fyrirmyndina fyrir þetta hljóð og dæmi."}, {"key": "pron.paywall.soundLocked", "text": "Öll kennslustundin fyrir þetta hljóð — hvernig á að mynda það, munnstaða, dæmaorð, setningar og lágmarkspör — er hluti af Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "Fyrstu {{count}} hljóðin eru ókeypis. Uppfærðu til að opna öll 44 hljóðin og persónulega endurgjöf frá þjálfaranum."}, {"key": "pron.paywall.unlockAllSounds", "text": "Opna öll 44 hljóðin"}, {"key": "pron.wordPracticeHint", "text": "Smelltu á orð til að heyra AI og æfa"}, {"key": "pron.eg", "text": "t.d."}, {"key": "pron.playing", "text": "Spilar"}, {"key": "pron.listen", "text": "Hlusta"}, {"key": "pron.paywall.lessonLocked", "text": "Skýringin, æfingaratriðin og dæmin í þessari kennslustund eru hluti af Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "Fyrstu {{count}} kennslustundir hverrar færni eru ókeypis. Uppfærðu til að opna restina."}, {"key": "pron.paywall.unlockAllLessons", "text": "Opna allar kennslustundir"}, {"key": "pron.itemPracticeHint", "text": "Smelltu á atriði til að æfa með AI"}, {"key": "pron.practiceHint", "text": "Hlustaðu, endurtaktu, taktu upp og beraðu saman — þjálfarinn sýnir nákvæmlega hvaða orð komu skýrt fram."}, {"key": "pron.drillsCount", "text": "{{count}} æfingar"}, {"key": "pron.useInShadowing", "text": "Nota þessa færni í skuggatölu"}, {"key": "pron.backToCoach", "text": "Til baka í talþjálfarann"}, {"key": "pron.p.title", "text": "Æfa"}, {"key": "pron.p.step1.label", "text": "Hlusta"}, {"key": "pron.p.step1.hint", "text": "Spilaðu fyrirmyndarhljóðið tvisvar."}, {"key": "pron.p.step2.label", "text": "Skilja"}, {"key": "pron.p.step2.hint", "text": "Lestu hvað munnurinn á að gera."}, {"key": "pron.p.step3.label", "text": "Horfa / læra"}, {"key": "pron.p.step3.hint", "text": "Skoðaðu leiðbeiningar um munn, tungu og mynstur."}, {"key": "pron.p.step4.label", "text": "Endurtaka"}, {"key": "pron.p.step4.hint", "text": "Segðu það upphátt með hljóðinu, hægt fyrst."}, {"key": "pron.p.step5.label", "text": "Taka upp"}, {"key": "pron.p.step5.hint", "text": "Taktu upp þegar þú segir sömu línu."}, {"key": "pron.p.step6.label", "text": "AI endurgjöf"}, {"key": "pron.p.step6.hint", "text": "Sjáðu hvað þjálfarinn heyrði og hvað á að laga."}, {"key": "pron.p.step7.label", "text": "Reyna aftur"}, {"key": "pron.p.step7.hint", "text": "Lagaðu einn hlut og taktu upp einu sinni enn."}, {"key": "pron.p.step8.label", "text": "Náð tökum á"}, {"key": "pron.p.step8.hint", "text": "Skýr upplestur tvisvar í röð — haltu áfram."}, {"key": "pron.p.stepTap", "text": "{{hint}} Ýttu þegar þú hefur gert þetta."}, {"key": "pron.p.focusSound", "text": "Áhersluhljóð {{sound}}"}, {"key": "pron.p.eg", "text": "t.d. {{sentence}}"}, {"key": "pron.p.loading", "text": "Hleður…"}, {"key": "pron.p.speedNormal", "text": "Venjulegur"}, {"key": "pron.p.speedSlower", "text": "Hægari"}, {"key": "pron.p.speedSlow", "text": "Hægur"}, {"key": "pron.p.loop", "text": "Lykkja"}, {"key": "pron.p.stop", "text": "Stöðva"}, {"key": "pron.p.voiceNote", "text": "Fyrirmyndarhljóðið er bandarísk enska AI-rödd Lingora, ekki upptaka af manneskju."}, {"key": "pron.p.listenSentence", "text": "Hlusta spilar hljóðið tvisvar, svo dæmaorðið, svo setningu sem inniheldur það."}, {"key": "pron.p.listenExample", "text": "Hlusta spilar hljóðið tvisvar, svo dæmið."}, {"key": "pron.p.recordHint", "text": "Segðu línuna hér að ofan einu sinni, skýrt."}, {"key": "pron.p.signupToRecord", "text": "Búðu til ókeypis aðgang til að taka upp og fá endurgjöf."}, {"key": "pron.p.yourRecording", "text": "Upptakan þín"}, {"key": "pron.p.listeningRec", "text": "Hlusta á upptökuna þína…"}, {"key": "pron.p.wordsClear", "text": "Orð sögð skýrt"}, {"key": "pron.p.wpm", "text": "Talhraði (orð á mínútu)"}, {"key": "pron.p.heard", "text": "Lingora heyrði"}, {"key": "pron.p.tagClear", "text": "Skýrt"}, {"key": "pron.p.tagNeeds", "text": "Þarf úrbætur"}, {"key": "pron.p.measured", "text": "Mæld frammistaða"}, {"key": "pron.p.paceLabel", "text": "Tempo:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} orð á mínútu ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Eðlilegt samtal er um 120–160."}, {"key": "pron.p.pace.slow", "text": "hægt"}, {"key": "pron.p.pace.natural", "text": "eðlilegt"}, {"key": "pron.p.pace.fast", "text": "hratt"}, {"key": "pron.p.fillersLabel", "text": "Fylliorð:"}, {"key": "pron.p.repeatedLabel", "text": "Endurtekin orð:"}, {"key": "pron.p.noneDetected", "text": "ekkert fannst"}, {"key": "pron.p.measuredNote", "text": "Tempo, fylliorð og endurtekningar eru talin út frá raunverulegum uppskrift þínum og lengd upptökunnar. Tónhæð, hljóðstyrkur og lengd hljóðþagna eru ekki mæld, svo við metum ekki tónfall eða hlé sjálfkrafa."}, {"key": "pron.p.mastered", "text": "Náð tökum á — tvær skýrar tilraunir"}, {"key": "pron.p.attempt", "text": "Tilraun {{n}} — tvö skýr upplestur í röð merkja þessa línu sem náð tökum á."}, {"key": "pron.p.toShadowing", "text": "Æfðu þetta í raunverulegu tali → Skuggatal"}, {"key": "pron.p.toCoach", "text": "Notaðu það með talþjálfaranum"}]
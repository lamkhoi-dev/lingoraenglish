[{"key": "pron.hero.title", "text": "Klinker helderder, natuurlijker en vloeiender"}, {"key": "pron.hero.description", "text": "Alle {{count}} Engelse klanken plus klemtoon in woorden, klemtoon in zinnen, intonatie, verbonden spraak, reducties, ritme, chunking en vloeiendheid — elke les eindigt met je eigen opname."}, {"key": "pron.imageAlt", "text": "Uitspraak, articulatie & IPA"}, {"key": "pron.progress.title", "text": "Jouw uitspraakvoortgang"}, {"key": "pron.progress.descUser", "text": "Gemeten op basis van de woorden die de coach herkende in jouw eigen opnames."}, {"key": "pron.progress.descGuest", "text": "Maak een gratis account aan om jezelf op te nemen en je voortgang bij te houden."}, {"key": "pron.recommended", "text": "Aanbevolen voor jou"}, {"key": "pron.soundLabel", "text": "{{symbol}}-klank"}, {"key": "pron.skill.sounds", "text": "Klanken"}, {"key": "pron.skill.sounds.blurb", "text": "Alle 44 Engelse fonemen met minimale paren."}, {"key": "pron.skill.wordStress", "text": "Klemtoon in woorden"}, {"key": "pron.skill.wordStress.blurb", "text": "Lettergrepen, primaire en secundaire klemtoon."}, {"key": "pron.skill.sentenceStress", "text": "Klemtoon in zinnen"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Inhoudswoorden sterk, functiewoorden zwak."}, {"key": "pron.skill.intonation", "text": "Intonatie"}, {"key": "pron.skill.intonation.blurb", "text": "Stijgend, dalend, stijgend-dalend en dalend-stijgend."}, {"key": "pron.skill.connectedSpeech", "text": "Verbonden spraak"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Verbinding, elisie, assimilatie, zwakke vormen."}, {"key": "pron.skill.reductions", "text": "Reducties"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — informeel gesproken Engels."}, {"key": "pron.skill.rhythm", "text": "Ritme"}, {"key": "pron.skill.rhythm.blurb", "text": "Klemtoongebonden ritme, timing en pauzes."}, {"key": "pron.skill.chunking", "text": "Pauzeren & chunking"}, {"key": "pron.skill.chunking.blurb", "text": "Gedachtegroepen en natuurlijke adempauzes."}, {"key": "pron.skill.fluency", "text": "Vloeiendheid"}, {"key": "pron.skill.fluency.blurb", "text": "Snelheid, aarzeling, stopwoorden en ideeën verbinden."}, {"key": "pron.filter.searchPlaceholder", "text": "Zoek een klank, woord of les"}, {"key": "pron.filter.allLevels", "text": "Alle niveaus"}, {"key": "pron.filter.beginner", "text": "Beginner"}, {"key": "pron.filter.intermediate", "text": "Gevorderd"}, {"key": "pron.filter.advanced", "text": "Expert"}, {"key": "pron.filter.allDifficulties", "text": "Alle moeilijkheidsgraden"}, {"key": "pron.filter.gentle", "text": "Makkelijk"}, {"key": "pron.filter.steady", "text": "Gemiddeld"}, {"key": "pron.filter.challenging", "text": "Uitdagend"}, {"key": "pron.filter.us", "text": "Amerikaans Engels"}, {"key": "pron.filter.uk", "text": "Brits Engels"}, {"key": "pron.sounds.title", "text": "De {{count}} Engelse klanken"}, {"key": "pron.sounds.shown", "text": "{{count}} weergegeven"}, {"key": "pron.lessons.title", "text": "{{skill}}-lessen"}, {"key": "pron.lessons.none", "text": "Geen les voldoet aan deze filters. Probeer \"Alle niveaus\" en \"Alle moeilijkheidsgraden\"."}, {"key": "pron.how", "text": "Hoe"}, {"key": "pron.commonMistakes", "text": "Veelgemaakte fouten"}, {"key": "pron.wordPractice", "text": "Woordoefening"}, {"key": "pron.sentencePractice", "text": "Zinoefening"}, {"key": "pron.minimalPairs", "text": "Minimale paren"}, {"key": "pron.practise", "text": "Oefenen"}, {"key": "pron.toast.signInModel", "text": "Log in om het AI-model te horen."}, {"key": "pron.toast.playError", "text": "Audio kon niet worden afgespeeld."}, {"key": "pron.voicedDesc", "text": "Stemhebbend — je stembanden trillen"}, {"key": "pron.voicelessDesc", "text": "Stemloos — alleen adem, geen trilling"}, {"key": "pron.soundPracticeHint", "text": "Tik op \"1. Luisteren\" in de oefenkaart rechts om het AI-model deze klank en een voorbeeld te horen zeggen."}, {"key": "pron.paywall.soundLocked", "text": "De volledige les van deze klank — hoe je hem maakt, mondpositie, voorbeeldwoorden, zinnen en minimale paren — maakt deel uit van Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "De eerste {{count}} klanken zijn gratis. Upgrade om alle 44 klanken en persoonlijke coachfeedback te ontgrendelen."}, {"key": "pron.paywall.unlockAllSounds", "text": "Ontgrendel alle 44 klanken"}, {"key": "pron.wordPracticeHint", "text": "Klik op een woord om AI te horen & te oefenen"}, {"key": "pron.eg", "text": "bijv."}, {"key": "pron.playing", "text": "Speelt af"}, {"key": "pron.listen", "text": "Luisteren"}, {"key": "pron.paywall.lessonLocked", "text": "De uitleg, oefenpunten en voorbeelden van deze les maken deel uit van Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "De eerste {{count}} lessen van elke vaardigheid zijn gratis. Upgrade om de rest te ontgrendelen."}, {"key": "pron.paywall.unlockAllLessons", "text": "Alle lessen ontgrendelen"}, {"key": "pron.itemPracticeHint", "text": "Klik op een item om te oefenen met AI"}, {"key": "pron.practiceHint", "text": "Luister, herhaal, neem op en vergelijk — de coach laat precies zien welke woorden duidelijk overkwamen."}, {"key": "pron.drillsCount", "text": "{{count}} oefeningen"}, {"key": "pron.useInShadowing", "text": "Gebruik deze vaardigheid in Shadowing"}, {"key": "pron.backToCoach", "text": "Terug naar de Speaking Coach"}, {"key": "pron.p.title", "text": "Oefenen"}, {"key": "pron.p.step1.label", "text": "Luisteren"}, {"key": "pron.p.step1.hint", "text": "Speel de voorbeeldaudio twee keer af."}, {"key": "pron.p.step2.label", "text": "Begrijpen"}, {"key": "pron.p.step2.hint", "text": "Lees wat je mond moet doen."}, {"key": "pron.p.step3.label", "text": "Kijken / leren"}, {"key": "pron.p.step3.hint", "text": "Bekijk de gids voor mond, tong en patroon."}, {"key": "pron.p.step4.label", "text": "Herhalen"}, {"key": "pron.p.step4.hint", "text": "Zeg het hardop mee met de audio, eerst langzaam."}, {"key": "pron.p.step5.label", "text": "Opnemen"}, {"key": "pron.p.step5.hint", "text": "Neem jezelf op terwijl je dezelfde zin zegt."}, {"key": "pron.p.step6.label", "text": "AI-feedback"}, {"key": "pron.p.step6.hint", "text": "Zie wat de coach hoorde en wat je kunt verbeteren."}, {"key": "pron.p.step7.label", "text": "Opnieuw proberen"}, {"key": "pron.p.step7.hint", "text": "Verbeter één ding en neem nog eens op."}, {"key": "pron.p.step8.label", "text": "Beheerst"}, {"key": "pron.p.step8.hint", "text": "Twee keer achter elkaar duidelijk voorlezen — ga verder."}, {"key": "pron.p.stepTap", "text": "{{hint}} Tik zodra je dit hebt gedaan."}, {"key": "pron.p.focusSound", "text": "Focusklank {{sound}}"}, {"key": "pron.p.eg", "text": "bv. {{sentence}}"}, {"key": "pron.p.loading", "text": "Laden…"}, {"key": "pron.p.speedNormal", "text": "Normaal"}, {"key": "pron.p.speedSlower", "text": "Langzamer"}, {"key": "pron.p.speedSlow", "text": "Langzaam"}, {"key": "pron.p.loop", "text": "Herhalen"}, {"key": "pron.p.stop", "text": "Stoppen"}, {"key": "pron.p.voiceNote", "text": "De voorbeeldaudio is Lingora's Amerikaans-Engelse AI-stem, geen menselijke opname."}, {"key": "pron.p.listenSentence", "text": "Luisteren speelt de klank twee keer af, dan het voorbeeldwoord en dan een zin met dat woord."}, {"key": "pron.p.listenExample", "text": "Luisteren speelt de klank twee keer af, dan het voorbeeld."}, {"key": "pron.p.recordHint", "text": "Zeg de zin hierboven één keer duidelijk."}, {"key": "pron.p.signupToRecord", "text": "Maak een gratis account aan om op te nemen en feedback te krijgen."}, {"key": "pron.p.yourRecording", "text": "Jouw opname"}, {"key": "pron.p.listeningRec", "text": "Je opname wordt beluisterd…"}, {"key": "pron.p.wordsClear", "text": "Duidelijk uitgesproken woorden"}, {"key": "pron.p.wpm", "text": "Spreeksnelheid (wpm)"}, {"key": "pron.p.heard", "text": "Lingora hoorde"}, {"key": "pron.p.tagClear", "text": "Duidelijk"}, {"key": "pron.p.tagNeeds", "text": "Kan beter"}, {"key": "pron.p.measured", "text": "Gemeten spraak"}, {"key": "pron.p.paceLabel", "text": "Tempo:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} woorden per minuut ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Een natuurlijk gesprek is ongeveer 120–160."}, {"key": "pron.p.pace.slow", "text": "langzaam"}, {"key": "pron.p.pace.natural", "text": "natuurlijk"}, {"key": "pron.p.pace.fast", "text": "snel"}, {"key": "pron.p.fillersLabel", "text": "Vulwoorden:"}, {"key": "pron.p.repeatedLabel", "text": "Herhaalde woorden:"}, {"key": "pron.p.noneDetected", "text": "geen gevonden"}, {"key": "pron.p.measuredNote", "text": "Tempo, vulwoorden en herhaling worden geteld op basis van je echte transcript en opnameduur. Toonhoogte, luidheid en lengte van stiltes worden niet gemeten, dus we beoordelen intonatie en pauzes niet automatisch."}, {"key": "pron.p.mastered", "text": "Beheerst — twee duidelijke pogingen"}, {"key": "pron.p.attempt", "text": "Poging {{n}} — twee duidelijke leesbeurten op rij markeert deze zin als beheerst."}, {"key": "pron.p.toShadowing", "text": "Oefen dit in echte spraak → Shadowing"}, {"key": "pron.p.toCoach", "text": "Gebruik het met de Speaking Coach"}]
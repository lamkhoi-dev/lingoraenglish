[{"key": "pron.hero.title", "text": "發音更清晰、更自然、更流利"}, {"key": "pron.hero.description", "text": "涵蓋全部 {{count}} 個英語發音，以及單字重音、句子重音、語調、連音、縮讀、節奏、斷句與流利度——每堂課都以你自己的錄音作結。"}, {"key": "pron.imageAlt", "text": "發音口型與國際音標"}, {"key": "pron.progress.title", "text": "你的發音進度"}, {"key": "pron.progress.descUser", "text": "根據教練在你錄音中辨識出的單字來評估。"}, {"key": "pron.progress.descGuest", "text": "建立免費帳戶即可錄音，開始追蹤進度。"}, {"key": "pron.recommended", "text": "為你推薦"}, {"key": "pron.soundLabel", "text": "{{symbol}} 音"}, {"key": "pron.skill.sounds", "text": "發音"}, {"key": "pron.skill.sounds.blurb", "text": "全部 44 個英語音素，附最小對比詞組。"}, {"key": "pron.skill.wordStress", "text": "單字重音"}, {"key": "pron.skill.wordStress.blurb", "text": "音節、主要重音與次要重音。"}, {"key": "pron.skill.sentenceStress", "text": "句子重音"}, {"key": "pron.skill.sentenceStress.blurb", "text": "實詞重讀，虛詞弱讀。"}, {"key": "pron.skill.intonation", "text": "語調"}, {"key": "pron.skill.intonation.blurb", "text": "升調、降調、升降調與降升調。"}, {"key": "pron.skill.connectedSpeech", "text": "連音"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "連讀、省略、同化、弱讀形式。"}, {"key": "pron.skill.reductions", "text": "縮讀"}, {"key": "pron.skill.reductions.blurb", "text": "gonna、wanna、hafta——非正式口語英語。"}, {"key": "pron.skill.rhythm", "text": "節奏"}, {"key": "pron.skill.rhythm.blurb", "text": "重音計時節拍、時間掌控與停頓。"}, {"key": "pron.skill.chunking", "text": "停頓與斷句"}, {"key": "pron.skill.chunking.blurb", "text": "意群與自然的換氣停頓。"}, {"key": "pron.skill.fluency", "text": "流利度"}, {"key": "pron.skill.fluency.blurb", "text": "語速、猶豫、填充詞與串連想法。"}, {"key": "pron.filter.searchPlaceholder", "text": "搜尋發音、單字或課程"}, {"key": "pron.filter.allLevels", "text": "所有程度"}, {"key": "pron.filter.beginner", "text": "初級"}, {"key": "pron.filter.intermediate", "text": "中級"}, {"key": "pron.filter.advanced", "text": "高級"}, {"key": "pron.filter.allDifficulties", "text": "所有難度"}, {"key": "pron.filter.gentle", "text": "輕鬆"}, {"key": "pron.filter.steady", "text": "適中"}, {"key": "pron.filter.challenging", "text": "挑戰"}, {"key": "pron.filter.us", "text": "美式英語"}, {"key": "pron.filter.uk", "text": "英式英語"}, {"key": "pron.sounds.title", "text": "{{count}} 個英語發音"}, {"key": "pron.sounds.shown", "text": "顯示 {{count}} 個"}, {"key": "pron.lessons.title", "text": "{{skill}}課程"}, {"key": "pron.lessons.none", "text": "沒有符合這些篩選條件的課程。試試「所有程度」和「所有難度」。"}, {"key": "pron.how", "text": "發音方式"}, {"key": "pron.commonMistakes", "text": "常見錯誤"}, {"key": "pron.wordPractice", "text": "單字練習"}, {"key": "pron.sentencePractice", "text": "句子練習"}, {"key": "pron.minimalPairs", "text": "最小對比詞組"}, {"key": "pron.practise", "text": "練習"}, {"key": "pron.toast.signInModel", "text": "登入即可聆聽 AI 示範發音。"}, {"key": "pron.toast.playError", "text": "無法播放音訊。"}, {"key": "pron.voicedDesc", "text": "濁音——聲帶會振動"}, {"key": "pron.voicelessDesc", "text": "清音——只有氣流，不振動"}, {"key": "pron.soundPracticeHint", "text": "點擊右側練習卡中的「1. 聆聽」，即可聽 AI 示範這個發音和一個範例。"}, {"key": "pron.paywall.soundLocked", "text": "這個發音的完整課程——發音方式、嘴型、範例單字、句子和最小對比詞組——屬於 Lingora English Premium 的內容。"}, {"key": "pron.paywall.freeLimit", "text": "前 {{count}} 個發音免費。升級即可解鎖全部 44 個發音和個人化教練回饋。"}, {"key": "pron.paywall.unlockAllSounds", "text": "解鎖全部 44 個發音"}, {"key": "pron.wordPracticeHint", "text": "點擊單字即可聆聽 AI 並練習"}, {"key": "pron.eg", "text": "例如"}, {"key": "pron.playing", "text": "播放中"}, {"key": "pron.listen", "text": "聆聽"}, {"key": "pron.paywall.lessonLocked", "text": "這堂課的解說、練習重點和範例屬於 Lingora English Premium 的內容。"}, {"key": "pron.paywall.lessonFreeLimit", "text": "每個技能的前 {{count}} 堂課免費。升級即可解鎖其餘課程。"}, {"key": "pron.paywall.unlockAllLessons", "text": "解鎖所有課程"}, {"key": "pron.itemPracticeHint", "text": "點擊項目與 AI 練習"}, {"key": "pron.practiceHint", "text": "聆聽、跟讀、錄音並比較——教練會顯示哪些字詞唸得清晰。"}, {"key": "pron.drillsCount", "text": "{{count}} 個練習"}, {"key": "pron.useInShadowing", "text": "在跟讀練習中使用此技能"}, {"key": "pron.backToCoach", "text": "返回口說教練"}, {"key": "pron.p.title", "text": "練習"}, {"key": "pron.p.step1.label", "text": "聆聽"}, {"key": "pron.p.step1.hint", "text": "播放示範音檔兩次。"}, {"key": "pron.p.step2.label", "text": "理解"}, {"key": "pron.p.step2.hint", "text": "閱讀嘴部應如何動作。"}, {"key": "pron.p.step3.label", "text": "觀看／學習"}, {"key": "pron.p.step3.hint", "text": "查看嘴形、舌位與發音模式指南。"}, {"key": "pron.p.step4.label", "text": "跟讀"}, {"key": "pron.p.step4.hint", "text": "跟著音檔大聲說出來，先慢慢來。"}, {"key": "pron.p.step5.label", "text": "錄音"}, {"key": "pron.p.step5.hint", "text": "錄下自己說同一句話。"}, {"key": "pron.p.step6.label", "text": "AI 回饋"}, {"key": "pron.p.step6.hint", "text": "看看教練聽到什麼，以及需要修正的地方。"}, {"key": "pron.p.step7.label", "text": "再試一次"}, {"key": "pron.p.step7.hint", "text": "修正一個問題，再錄一次。"}, {"key": "pron.p.step8.label", "text": "已精通"}, {"key": "pron.p.step8.hint", "text": "連續兩次清晰朗讀——繼續下一句。"}, {"key": "pron.p.stepTap", "text": "{{hint}} 完成後點一下。"}, {"key": "pron.p.focusSound", "text": "重點發音 {{sound}}"}, {"key": "pron.p.eg", "text": "例如：{{sentence}}"}, {"key": "pron.p.loading", "text": "載入中…"}, {"key": "pron.p.speedNormal", "text": "正常"}, {"key": "pron.p.speedSlower", "text": "稍慢"}, {"key": "pron.p.speedSlow", "text": "慢速"}, {"key": "pron.p.loop", "text": "循環"}, {"key": "pron.p.stop", "text": "停止"}, {"key": "pron.p.voiceNote", "text": "示範音檔為 Lingora 的美式英語 AI 語音，並非真人錄音。"}, {"key": "pron.p.listenSentence", "text": "聆聽會播放發音兩次，接著是範例單字，再來是包含該發音的句子。"}, {"key": "pron.p.listenExample", "text": "聆聽會播放發音兩次，接著是範例。"}, {"key": "pron.p.recordHint", "text": "清晰地說出上方句子一次。"}, {"key": "pron.p.signupToRecord", "text": "建立免費帳號即可錄音並獲得回饋。"}, {"key": "pron.p.yourRecording", "text": "你的錄音"}, {"key": "pron.p.listeningRec", "text": "正在聆聽你的錄音…"}, {"key": "pron.p.wordsClear", "text": "清晰說出的字詞"}, {"key": "pron.p.wpm", "text": "說話速度（每分鐘字數）"}, {"key": "pron.p.heard", "text": "Lingora 聽到"}, {"key": "pron.p.tagClear", "text": "清晰"}, {"key": "pron.p.tagNeeds", "text": "需要改進"}, {"key": "pron.p.measured", "text": "實測表現"}, {"key": "pron.p.paceLabel", "text": "語速："}, {"key": "pron.p.paceValue", "text": "每分鐘 {{wpm}} 字（{{pace}}）"}, {"key": "pron.p.paceNote", "text": "自然對話約為每分鐘 120–160 字。"}, {"key": "pron.p.pace.slow", "text": "偏慢"}, {"key": "pron.p.pace.natural", "text": "自然"}, {"key": "pron.p.pace.fast", "text": "偏快"}, {"key": "pron.p.fillersLabel", "text": "填充詞："}, {"key": "pron.p.repeatedLabel", "text": "重複字詞："}, {"key": "pron.p.noneDetected", "text": "未偵測到"}, {"key": "pron.p.measuredNote", "text": "語速、填充詞與重複次數是根據你的實際逐字稿與錄音長度計算。音調、音量與停頓長度並未測量，因此我們不會自動為語調或停頓評分。"}, {"key": "pron.p.mastered", "text": "已精通——兩次清晰朗讀"}, {"key": "pron.p.attempt", "text": "第 {{n}} 次嘗試——連續兩次清晰朗讀即標記此句為已精通。"}, {"key": "pron.p.toShadowing", "text": "在真實口說中練習 → 跟讀"}, {"key": "pron.p.toCoach", "text": "搭配口說教練使用"}]
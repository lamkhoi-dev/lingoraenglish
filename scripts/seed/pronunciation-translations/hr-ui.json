y": "pron.p.paceNote", "text": "Prirodan razgovor je oko 120–160."}, {"key": "pron.p.pace.slow", "text": "spor"}, {"key": "pron.p.pace.natural", "text": "prirodan"}, {"key": "pron.p.pace.fast", "text": "brz"}, {"key": "pron.p.fillersLabel", "text": "Poštapalice:"}, {"key": "pron.p.repeatedLabel", "text": "Ponovljene riječi:"}, {"key": "pron.p.noneDetected", "text": "nije pronađeno"}, {"key": "pron.p.measuredNote", "text": "Tempo, poštapalice i ponavljanja broje se iz tvog stvarnog transkripta i trajanja snimke. Visina tona, glasnoća i trajanje stanki se ne mjere, pa ne ocjenjujemo intonaciju ni stanke automatski."}, {"key": "pron.p.mastered", "text": "Savladano — dva jasna pokušaja"}, {"key": "pron.p.attempt", "text": "Pokušaj {{n}} — dva jasna čitanja zaredom označavaju ovaj redak kao savladan."}, {"key": "pron.p.toShadowing", "text": "Vježbaj ovo u stvarnom govoru → Shadowing"}, {"key": "pron.p.toCoach", "text": "Koristi s govornim trenerom"}]
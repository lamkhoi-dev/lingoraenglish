[{"key": "pron.hero.title", "text": "Zvučite jasnije, prirodnije i tečnije"}, {"key": "pron.hero.description", "text": "Svih {{count}} engleskih glasova plus naglasak riječi, naglasak rečenice, intonacija, povezani govor, redukcije, ritam, segmentacija i tečnost — svaka lekcija završava vašom vlastitom snimkom."}, {"key": "pron.imageAlt", "text": "Izgovor, artikulacija i IPA"}, {"key": "pron.progress.title", "text": "Vaš napredak u izgovoru"}, {"key": "pron.progress.descUser", "text": "Mjereno prema riječima koje je trener prepoznao u vašim snimkama."}, {"key": "pron.progress.descGuest", "text": "Izradite besplatan račun, snimite se i počnite pratiti napredak."}, {"key": "pron.recommended", "text": "Preporučeno za vas"}, {"key": "pron.soundLabel", "text": "Glas {{symbol}}"}, {"key": "pron.skill.sounds", "text": "Glasovi"}, {"key": "pron.skill.sounds.blurb", "text": "Svih 44 engleskih fonema s minimalnim parovima."}, {"key": "pron.skill.wordStress", "text": "Naglasak riječi"}, {"key": "pron.skill.wordStress.blurb", "text": "Slogovi, primarni i sekundarni naglasak."}, {"key": "pron.skill.sentenceStress", "text": "Naglasak rečenice"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Sadržajne riječi naglašene, funkcijske riječi nenaglašene."}, {"key": "pron.skill.intonation", "text": "Intonacija"}, {"key": "pron.skill.intonation.blurb", "text": "Rastuća, padajuća, rastuće-padajuća i padajuće-rastuća."}, {"key": "pron.skill.connectedSpeech", "text": "Povezani govor"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Povezivanje, elizija, asimilacija, slabi oblici."}, {"key": "pron.skill.reductions", "text": "Redukcije"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — neformalni govorni engleski."}, {"key": "pron.skill.rhythm", "text": "Ritam"}, {"key": "pron.skill.rhythm.blurb", "text": "Naglasni taktovi, tajming i pauze."}, {"key": "pron.skill.chunking", "text": "Pauze i segmentacija"}, {"key": "pron.skill.chunking.blurb", "text": "Misaone
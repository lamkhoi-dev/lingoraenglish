[{"key": "pron.hero.title", "text": "واضح‌تر، طبیعی‌تر و روان‌تر صحبت کنید"}, {"key": "pron.hero.description", "text": "همه {{count}} صدای انگلیسی به‌همراه تکیه کلمه، تکیه جمله، آهنگ کلام، گفتار پیوسته، کاهش‌ها، ریتم، تقطیع و روانی — هر درس با ضبط صدای خودتان پایان می‌یابد."}, {"key": "pron.imageAlt", "text": "تلفظ، بیان و الفبای آوایی"}, {"key": "pron.progress.title", "text": "پیشرفت تلفظ شما"}, {"key": "pron.progress.descUser", "text": "بر اساس کلماتی که مربی در ضبط‌های خودتان تشخیص داده اندازه‌گیری می‌شود."}, {"key": "pron.progress.descGuest", "text": "یک حساب رایگان بسازید تا صدای خود را ضبط کنید و پیشرفت را پیگیری کنید."}, {"key": "pron.recommended", "text": "پیشنهاد ویژه شما"}, {"key": "pron.soundLabel", "text": "صدای {{symbol}}"}, {"key": "pron.skill.sounds", "text": "صداها"}, {"key": "pron.skill.sounds.blurb", "text": "همه ۴۴ واج انگلیسی همراه با جفت‌های کمینه."}, {"key": "pron.skill.wordStress", "text": "تکیه کلمه"}, {"key": "pron.skill.wordStress.blurb", "text": "هجاها، تکیه اصلی و فرعی."}, {"key": "pron.skill.sentenceStress", "text": "تکیه جمله"}, {"key": "pron.skill.sentenceStress.blurb", "text": "کلمات محتوایی قوی، کلمات نقشی ضعیف."}, {"key": "pron.skill.intonation", "text": "آهنگ کلام"}, {"key": "pron.skill.intonation.blurb", "text": "صعودی، نزولی، صعودی-نزولی و نزولی-صعودی."}, {"key": "pron.skill.connectedSpeech", "text": "گفتار پیوسته"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "اتصال، حذف، همگون‌سازی، شکل‌های ضعیف."}, {"key": "pron.skill.reductions", "text": "کاهش‌ها"}, {"key": "pron.skill.reductions.blurb", "text": "gonna، wanna، hafta — انگلیسی محاوره‌ای غیررسمی."}, {"key": "pron.skill.rhythm", "text": "ریتم"}, {"key": "pron.skill.rhythm.blurb", "text": "ضرب‌آهنگ تکیه‌محور، زمان‌بندی و مکث‌ها."}, {"key": "pron.skill.chunking", "text": "مکث و تقطیع"}, {"key": "pron.skill.chunking.blurb", "text": "گروه‌های معنایی و مکث‌های طبیعی تنفس."}, {"key": "pron.skill.fluency", "text": "روانی"}, {"key": "pron.skill.fluency.blurb", "text": "سرعت، تردید، پرکننده‌ها و اتصال ایده‌ها."}, {"key": "pron.filter.searchPlaceholder", "text": "جستجوی صدا، کلمه یا درس"}, {"key": "pron.filter.allLevels", "text": "همه سطوح"}, {"key": "pron.filter.beginner", "text": "مبتدی"}, {"key": "pron.filter.intermediate", "text": "متوسط"}, {"key": "pron.filter.advanced", "text": "پیشرفته"}, {"key": "pron.filter.allDifficulties", "text": "همه سختی‌ها"}, {"key": "pron.filter.gentle", "text": "آسان"}, {"key": "pron.filter.steady", "text": "متوسط"}, {"key": "pron.filter.challenging", "text": "چالش‌برانگیز"}, {"key": "pron.filter.us", "text": "انگلیسی آمریکایی"}, {"key": "pron.filter.uk", "text": "انگلیسی بریتانیایی"}, {"key": "pron.sounds.title", "text": "{{count}} صدای انگلیسی"}, {"key": "pron.sounds.shown", "text": "{{count}} نمایش داده شده"}, {"key": "pron.lessons.title", "text": "درس‌های {{skill}}"}, {"key": "pron.lessons.none", "text": "هیچ درسی با این فیلترها مطابقت ندارد. «همه سطوح» و «همه سختی‌ها» را امتحان کنید."}, {"key": "pron.how", "text": "نحوه"}, {"key": "pron.commonMistakes", "text": "اشتباهات رایج"}, {"key": "pron.wordPractice", "text": "تمرین کلمه"}, {"key": "pron.sentencePractice", "text": "تمرین جمله"}, {"key": "pron.minimalPairs", "text": "جفت‌های کمینه"}, {"key": "pron.practise", "text": "تمرین"}, {"key": "pron.toast.signInModel", "text": "برای شنیدن صدای مدل هوش مصنوعی وارد شوید."}, {"key": "pron.toast.playError", "text": "پخش صدا ممکن نشد."}, {"key": "pron.voicedDesc", "text": "واکدار — تارهای صوتی شما می‌لرزند"}, {"key": "pron.voicelessDesc", "text": "بی‌واک — فقط نفس، بدون لرزش"}, {"key": "pron.soundPracticeHint", "text": "برای شنیدن این صدا و یک مثال از مدل هوش مصنوعی، روی «۱. گوش دادن» در کارت تمرین سمت راست ضربه بزنید."}, {"key": "pron.paywall.soundLocked", "text": "درس کامل این صدا — نحوه تولید، وضعیت دهان، کلمات مثال، جملات و جفت‌های کمینه — بخشی از لینگورا انگلیسی پریمیوم است."}, {"key": "pron.paywall.freeLimit", "text": "اولین {{count}} صدا رایگان است. برای باز کردن همه ۴۴ صدا و بازخورد شخصی مربی، ارتقا دهید."}, {"key": "pron.paywall.unlockAllSounds", "text": "باز کردن همه ۴۴ صدا"}, {"key": "pron.wordPracticeHint", "text": "برای شنیدن هوش مصنوعی و تمرین، روی کلمه کلیک کنید"}, {"key": "pron.eg", "text": "مثلاً"}, {"key": "pron.playing", "text": "در حال پخش"}, {"key": "pron.listen", "text": "گوش دادن"}, {"key": "pron.paywall.lessonLocked", "text": "توضیحات، نکات تمرینی و مثال‌های این درس بخشی از لینگورا انگلیسی پریمیوم است."}, {"key": "pron.paywall.lessonFreeLimit", "text": "{{count}} درس اول هر مهارت رایگان است. برای باز کردن بقیه، ارتقا دهید."}, {"key": "pron.paywall.unlockAllLessons", "text": "باز کردن همه درس‌ها"}, {"key": "pron.itemPracticeHint", "text": "برای تمرین با هوش مصنوعی روی آیتم کلیک کنید"}, {"key": "pron.practiceHint", "text": "گوش کنید، تکرار کنید، ضبط کنید و مقایسه کنید — مربی دقیقاً نشان می‌دهد کدام کلمات واضح ادا شده‌اند."}, {"key": "pron.drillsCount", "text": "{{count}} تمرین"}, {"key": "pron.useInShadowing", "text": "استفاده از این مهارت در سایه‌گویی"}, {"key": "pron.backToCoach", "text": "بازگشت به مربی گفتار"}, {"key": "pron.p.title", "text": "تمرین"}, {"key": "pron.p.step1.label", "text": "گوش دادن"}, {"key": "pron.p.step1.hint", "text": "صدای نمونه را دو بار پخش کنید."}, {"key": "pron.p.step2.label", "text": "درک کردن"}, {"key": "pron.p.step2.hint", "text": "بخوانید که دهان شما چه کاری باید انجام دهد."}, {"key": "pron.p.step3.label", "text": "تماشا / یادگیری"}, {"key": "pron.p.step3.hint", "text": "راهنمای دهان، زبان و الگو را بررسی کنید."}, {"key": "pron.p.step4.label", "text": "تکرار"}, {"key": "pron.p.step4.hint", "text": "با صدا بلند بگویید، ابتدا آهسته."}, {"key": "pron.p.step5.label", "text": "ضبط"}, {"key": "pron.p.step5.hint", "text": "خودتان را هنگام گفتن همان جمله ضبط کنید."}, {"key": "pron.p.step6.label", "text": "بازخورد هوش مصنوعی"}, {"key": "pron.p.step6.hint", "text": "ببینید مربی چه شنیده و چه چیزی باید اصلاح شود."}, {"key": "pron.p.step7.label", "text": "دوباره تلاش کنید"}, {"key": "pron.p.step7.hint", "text": "یک مورد را اصلاح کنید و یک بار دیگر ضبط کنید."}, {"key": "pron.p.step8.label", "text": "تسلط یافت"}, {"key": "pron.p.step8.hint", "text": "دو بار پشت سر هم واضح بخوانید — ادامه دهید."}, {"key": "pron.p.stepTap", "text": "{{hint}} پس از انجام، یک بار ضربه بزنید."}, {"key": "pron.p.focusSound", "text": "صدای تمرکز {{sound}}"}, {"key": "pron.p.eg", "text": "مثلاً {{sentence}}"}, {"key": "pron.p.loading", "text": "در حال بارگذاری…"}, {"key": "pron.p.speedNormal", "text": "عادی"}, {"key": "pron.p.speedSlower", "text": "آهسته‌تر"}, {"key": "pron.p.speedSlow", "text": "آهسته"}, {"key": "pron.p.loop", "text": "حلقه"}, {"key": "pron.p.stop", "text": "توقف"}, {"key": "pron.p.voiceNote", "text": "صدای نمونه، صدای هوش مصنوعی انگلیسی آمریکایی Lingora است، نه ضبط انسانی."}, {"key": "pron.p.listenSentence", "text": "گوش دادن صدا را دو بار پخش می‌کند، سپس کلمه نمونه و بعد جمله‌ای که آن را دربر دارد."}, {"key": "pron.p.listenExample", "text": "گوش دادن صدا را دو بار پخش می‌کند، سپس مثال."}, {"key": "pron.p.recordHint", "text": "جمله بالا را یک بار واضح بگویید."}, {"key": "pron.p.signupToRecord", "text": "برای ضبط و دریافت بازخورد، حساب رایگان بسازید."}, {"key": "pron.p.yourRecording", "text": "ضبط شما"}, {"key": "pron.p.listeningRec", "text": "در حال گوش دادن به ضبط شما…"}, {"key": "pron.p.wordsClear", "text": "کلمات واضح ادا شده"}, {"key": "pron.p.wpm", "text": "سرعت گفتار (کلمه در دقیقه)"}, {"key": "pron.p.heard", "text": "Lingora شنید"}, {"key": "pron.p.tagClear", "text": "واضح"}, {"key": "pron.p.tagNeeds", "text": "نیاز به بهبود"}, {"key": "pron.p.measured", "text": "ادای اندازه‌گیری‌شده"}, {"key": "pron.p.paceLabel", "text": "سرعت:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} کلمه در دقیقه ({{pace}})"}, {"key": "pron.p.paceNote", "text": "گفتگوی طبیعی حدود ۱۲۰ تا ۱۶۰ است."}, {"key": "pron.p.pace.slow", "text": "آهسته"}, {"key": "pron.p.pace.natural", "text": "طبیعی"}, {"key": "pron.p.pace.fast", "text": "سریع"}, {"key": "pron.p.fillersLabel", "text": "کلمات پرکننده:"}, {"key": "pron.p.repeatedLabel", "text": "کلمات تکرارشده:"}, {"key": "pron.p.noneDetected", "text": "موردی یافت نشد"}, {"key": "pron.p.measuredNote", "text": "سرعت، کلمات پرکننده و تکرار از متن واقعی و طول ضبط شما محاسبه می‌شود. زیر و بمی، بلندی صدا و طول سکوت اندازه‌گیری نمی‌شود، بنابراین آهنگ کلام یا سکوت‌ها را به‌طور خودکار امتیازدهی نمی‌کنیم."}, {"key": "pron.p.mastered", "text": "تسلط یافت — دو تلاش واضح"}, {"key": "pron.p.attempt", "text": "تلاش {{n}} — دو بار پشت سر هم خواندن واضح، این جمله را به‌عنوان تسلط‌یافته علامت می‌زند."}, {"key": "pron.p.toShadowing", "text": "این را در گفتار واقعی تمرین کنید → سایه‌گویی"}, {"key": "pron.p.toCoach", "text": "با مربی گفتار استفاده کنید"}]
[{"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|point|3", "text": "got to → gotta"}, {"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|caution", "text": "Dette er uformelle muntlige former. Ikke skriv dem i stiler, e-poster eller formelle eksamener, og unngå dem i en formell presentasjon."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|explain", "text": "Mer uformelle sammentrekninger som du stadig vil høre i filmer og virkelige samtaler."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|0", "text": "kind of → kinda"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|1", "text": "sort of → sorta"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|2", "text": "let me → lemme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|3", "text": "give me → gimme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|4", "text": "what do you → whaddaya"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|caution", "text": "Kun uformelt. I en IELTS eller jobbintervju, hold på de fulle formene."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|explain", "text": "Flere sammentrekninger for plikt og vane som er vanlige i avslappet muntlig engelsk."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|0", "text": "have to → hafta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|1", "text": "need to → needa"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|2", "text": "used to → useta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|caution", "text": "Kun uformelle muntlige former — skriv dem aldri."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|explain", "text": "Sammentrekninger av modale hjelpeverb i preteritum — svært vanlige når man snakker om anger eller hypotetiske situasjoner."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|0", "text": "could have → coulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|1", "text": "would have → woulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|2", "text": "should have → shoulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|caution", "text": "Kun uformelt muntlig — skriv 'could have' i sin fulle form i formell skrift."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|explain", "text": "Svært uformelle sammentrekninger som er vanlige i sanger, filmer og avslappet samtale mellom venner."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|0", "text": "don't know → dunno"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|1", "text": "don't you → dontcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|2", "text": "what are you → whatcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|caution", "text": "Svært uformelt — kun med nære venner, aldri i profesjonelle sammenhenger eller eksamener."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|explain", "text": "Vanlige sammentrekninger knyttet til preposisjoner i uformell tale."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|0", "text": "out of → outta"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|1", "text": "off of → offa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|2", "text": "cup of → cuppa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|caution", "text": "Kun uformelt."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|explain", "text": "Hverdagslige utrop og uformelle fraser med kraftig sammentrekning."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|0", "text": "come on → c'mon"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|1", "text": "going to be → gonna be"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|2", "text": "some more → s'more"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|caution", "text": "Kun uformelt."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|explain", "text": "Spørsmålsåpnere reduseres kraftig i rask, uformell samtale."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|0", "text": "did you → dja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|1", "text": "do you → dya"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|2", "text": "would you → wouldja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|caution", "text": "Kun i uformelle, muntlige sammenhenger."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|explain", "text": "Uformell tale reduserer ofte tidsuttrykk også."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|0", "text": "a couple of → a couple"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|1", "text": "in a minute → in a min"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|caution", "text": "Greit i uformell tale, ikke i skrift."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|explain", "text": "Vanligere uformelle reduksjoner som høres hele tiden i avslappet samtale."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|0", "text": "probably → prolly"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|1", "text": "trying to → tryna"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|2", "text": "supposed to → s'posed to"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|caution", "text": "Kun uformelt, muntlig."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|explain", "text": "Uformelle reduksjoner som er vanlige blant venner og i amerikansk uformell tale."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|0", "text": "let's go → less go"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|1", "text": "give it to me → gimme that"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|2", "text": "you all → y'all"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|caution", "text": "Svært uformelt — 'y'all' er regionalt (sørlige USA), men forstås bredt."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|explain", "text": "Runde tall reduserer midtkonsonantene i rask, uformell amerikansk tale."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|0", "text": "twenty → twenny"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|1", "text": "hundred → hunnerd"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|caution", "text": "Kun uformelt, muntlig — si alltid full form i formelle sammenhenger."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|explain", "text": "En annen gruppe hverdagsord som jevnlig mister en stavelse i rask, avslappet tale."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|0", "text": "different → diff'rent"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|1", "text": "general → gen'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|2", "text": "several → sev'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|3", "text": "camera → cam'ra"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|caution", "text": "Greit i uformell tale; si den fulle formen tydelig i formelle presentasjoner."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|explain", "text": "Svært uformelle reduksjoner du hører i sanger og uformell amerikansk tale, men som aldri bør brukes i profesjonelle sammenhenger."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|0", "text": "I'm going to → I'ma"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|1", "text": "kind of like → kinda like"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|caution", "text": "Ekstremt uformelt — kun venner/sangtekster, aldri profesjonelle sammenhenger."}, {"key": "551b9527-f712-421d-966c-24644f360746|explain", "text": "Flere hverdagslige hilsener i redusert form, utover what's up / how's it going."}, {"key": "551b9527-f712-421d-966c-24644f360746|point|0", "text": "how are you → how ya doin'"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|1", "text": "good to see you → good to see ya"}, {"key": "551b9527-f712-421d-966c-24644f360746|caution", "text": "Kun uformelle muntlige former."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|explain", "text": "Flere reduksjoner av plikt og ønske som er vanlige i avslappet amerikansk tale."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|0", "text": "ought to → oughta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|1", "text": "don't have to → don't hafta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|2", "text": "want you → wantcha"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|caution", "text": "Kun uformelt muntlig."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|explain", "text": "Dette er et klassisk eksempel på hvor langt uformell amerikansk reduksjon kan gå — flere ord smelter sammen til det som høres ut som ett."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|0", "text": "Did you eat yet? → Jeetyet?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|1", "text": "Did you already? → Jeetalready?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|caution", "text": "Ekstremt uformelt — for å gjenkjenne rask morsmålstale, ikke for din egen formelle tale."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|explain", "text": "To flere vanlige reduksjoner på frasenivå i uformell samtale."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|0", "text": "because of → 'cause of"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|1", "text": "sort of a → sorta a"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|caution", "text": "Kun uformelt muntlig."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|explain", "text": "Svært vanlige uformelle alternativer til 'yes' og 'no' i avslappet muntlig engelsk."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|0", "text": "yes → yep / uh-huh"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|1", "text": "no → nope / nah"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|caution", "text": "Kun uformell samtale — bruk 'yes'/'no' i formelle sammenhenger eller på eksamen."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|explain", "text": "Begge reduseres til et liknende 'wanna', men den ene etterfølges av et substantiv og den andre av et verb — verdt å merke seg forskjellen."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|0", "text": "want a (coffee) → wanna coffee"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|1", "text": "want to (go) → wanna go"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|caution", "text": "Kun uformelt i talespråk."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|0", "text": "'want a' + substantiv → wanna"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|1", "text": "'want to' + verb → wanna"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|explain", "text": "Den negative formen av 'would have' reduseres på samme måte som den positive formen."}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|point|0", "text": "wouldn't have → wouldn'ta"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|caution", "text": "Kun uformelt i talespråk — skriv 'wouldn't have' i sin helhet ellers."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|explain", "text": "To flere hverdagslige reduksjoner som er vanlige i uformelle forklaringer og forespørsler."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|0", "text": "just because → just 'cause"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|1", "text": "going to need → gonna need"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|caution", "text": "Kun uformelt i talespråk."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|explain", "text": "'Ain't' erstatter am not/is not/are not/has not/have not i svært uformelt talespråk og høres overalt i sanger og uformell samtale."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|0", "text": "I am not → I ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|1", "text": "that is not → that ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|2", "text": "you have not → you ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|caution", "text": "Bruk det aldri i skrift eller formell tale — regnes som ugrammatikalsk, selv om det er ekstremt vanlig uformelt."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|explain", "text": "En svært vanlig uformell måte å si 'I understand' eller bokstavelig talt 'caught you'."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|0", "text": "got you (understand) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|1", "text": "got you (caught) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|caution", "text": "Kun uformelt i talespråk — si 'I understand' eller 'got it' i profesjonelle sammenhenger."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|explain", "text": "Modal-perfektum-reduksjoner brukt for gjetninger om fortiden, sammen med coulda/woulda/shoulda."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|0", "text": "must have → musta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|1", "text": "might have → mighta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|caution", "text": "Kun uformelt i talespråk — skriv 'must have'/'might have' i sin helhet ellers."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|explain", "text": "De negative motstykkene til coulda/woulda/shoulda, vanlige når man snakker om anger."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|0", "text": "shouldn't have → shouldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|1", "text": "couldn't have → couldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|caution", "text": "Kun uformelt i talespråk — skriv 'shouldn't have'/'couldn't have' i sin helhet i formelle sammenhenger."}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|explain", "text": "I avslappet tale mister den siste -ing-lyden ofte 'g', slik at det høres ut som -in'. Dette skjer med nesten alle -ing-verb. (, so it sounds like -in)"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|0", "text": "doing → doin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|1", "text": "going → goin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|2", "text": "talking → talkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|3", "text": "thinking → thinkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|caution", "text": "Bare i uformell tale — uttal hele '-ing' tydelig i presentasjoner, intervjuer og eksamener."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|explain", "text": "Det samme mønsteret med bortfall av g gjelder for ubestemte pronomen som ender på -thing."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|0", "text": "something → somethin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|1", "text": "nothing → nothin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|2", "text": "anything → anythin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|caution", "text": "Bare i uformell tale."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|explain", "text": "'Them' reduseres til 'em ('th' faller bort) etter et verb, i svært vanlig uformell tale."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|0", "text": "tell them → tell 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|1", "text": "get them → get 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|2", "text": "ask them → ask 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|caution", "text": "Bare i uformell muntlig tale — si 'them' i sin helhet i skrift eller formell tale."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|explain", "text": "'And' reduseres til en rask 'n'-lyd mellom to tett sammenknyttede ord, særlig i faste uttrykk."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|0", "text": "rock and roll → rock 'n' roll"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|1", "text": "fish and chips → fish 'n' chips"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|2", "text": "back and forth → back 'n' forth"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|caution", "text": "Vanlig i faste uttrykk og rask tale — skriv 'and' tydelig i formell skrift."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|explain", "text": "'Because' alene (ikke bare 'because of') forkortes ofte til 'cause i uformelle svar."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|point|0", "text": "because → 'cause"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|caution", "text": "Bare i uformell muntlig tale — skriv 'because' i sin helhet ellers."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|explain", "text": "'Of course' mister ofte det første ordet i raske, uformelle svar."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|point|0", "text": "of course → 'course"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|caution", "text": "Bare i uformell muntlig tale."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|explain", "text": "En svært vanlig uformell uttale av 'all right', brukt for å samtykke eller bekrefte."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|point|0", "text": "all right → aight"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|caution", "text": "Svært uformelt — si 'all right' eller 'okay' i profesjonelle sammenhenger."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|explain", "text": "'Let you' reduseres på samme måte som 'want you'/'wantcha'."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|point|0", "text": "let you → letcha"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|caution", "text": "Kun uformelt i tale."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|explain", "text": "Nok en ekstrem hurtigtale-sammensmelting, lik 'jeetyet' — flere ord komprimeres til én lyd."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|point|0", "text": "did you ever → jever"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|caution", "text": "For å gjenkjenne rask innfødt tale, ikke for din egen formelle tale."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|explain", "text": "To reduksjoner stablet sammen når 'going to' og 'have to' opptrer side om side."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|point|0", "text": "going to have to → gonna hafta"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|caution", "text": "Kun uformelt i tale — skriv 'going to have to' i sin helhet ellers."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|explain", "text": "Reduksjonen 'gonna' gjelder fortsatt med nektelser og fortid."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|0", "text": "not going to → not gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|1", "text": "wasn't going to → wasn't gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|caution", "text": "Kun uformelt i tale."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|explain", "text": "En svært vanlig britisk-engelsk reduksjon av spørsmålstagg, brukt for å bekrefte eller legge til ettertrykk."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|point|0", "text": "isn't it → innit"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|caution", "text": "Svært uformelt britisk slang — ikke bruk i formell tale, selv ikke i Storbritannia. (UK)"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|explain", "text": "En uformell måte å foreslå noe eller be om enighet."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|point|0", "text": "what do you say → whaddya say"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|caution", "text": "Kun uformelt i tale."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|explain", "text": "En ekstremt vanlig utfyllingsfrase i uformell engelsk tale, brukt mens man tenker eller for ettertrykk."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|point|0", "text": "you know → y'know"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|caution", "text": "Kun uformell utfylling — for mye bruk høres upolert ut selv uformelt."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|explain", "text": "En svært uformell hilsen, forkortet fra 'what's up'."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|point|0", "text": "what's up → s'up"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|caution", "text": "Kun svært uformell hilsen mellom venner."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|explain", "text": "'Him' og 'her' svekkes også i uformell tale, likt 'them' → 'em."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|0", "text": "tell him → tell 'im"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|1", "text": "ask her → ask 'er"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|caution", "text": "Kun uformelt i tale."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|explain", "text": "'Kinda' og 'sorta' kombineres ofte for ekstra forbehold i svært uformell tale."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|point|0", "text": "kind of sort of → kinda sorta"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|caution", "text": "Svært uformelt — unngå i enhver profesjonell eller eksamenssammenheng."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|explain", "text": "Nok en sammenslåing av spørsmålsstartere i rask tale, sammen med dja og wouldja."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|point|0", "text": "didn't you → dincha"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|caution", "text": "For å gjenkjenne rask innfødt tale, ikke for din egen formelle muntlige fremføring."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|explain", "text": "Fortidsformen av 'have to' reduseres på samme måte som presensformen."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|point|0", "text": "had to → hadta"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|caution", "text": "Kun uformelt i tale."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|explain", "text": "En uformell reduksjon brukt i uformelle forespørsler, sammen med former som wouldja og couldja."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|point|0", "text": "will you → willcha"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|caution", "text": "Kun uformelt i tale."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|explain", "text": "Mengdeuttrykk med 'of' reduseres på samme måte som 'cup of' i 'cuppa'."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|0", "text": "lots of → lotsa"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|1", "text": "bunch of → buncha"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|caution", "text": "Kun uformelt i tale."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|explain", "text": "En sterk uformell forsterker som betyr 'en svært imponerende/stor'. (a very impressive/big)"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|point|0", "text": "hell of a → helluva"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|caution", "text": "Lett grov — greit blant venner, unngå i profesjonelle eller høflige sammenhenger."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|explain", "text": "En historisk reduksjon av den gamle hilsenen 'how do you do', nå en egen uformell, vennlig hilsen (spesielt i det sørlige USA)."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|point|0", "text": "how do you do → howdy"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|caution", "text": "Kun uformell, vennlig hilsen."}, {"key": "47538641-f573-4840-af35-02857a1d24de|explain", "text": "'I suppose' mister ofte midtstavelsen i uformell tale, brukt for å uttrykke mild usikkerhet eller motvillig enighet — forskjellig fra 'supposed to' → s'posed to."}, {"key": "47538641-f573-4840-af35-02857a1d24de|point|0", "text": "I suppose → I s'pose"}, {"key": "47538641-f573-4840-af35-02857a1d24de|caution", "text": "Kun uformelt i tale — skriv 'I suppose' i sin helhet ellers."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|explain", "text": "Mestre reduksjoner gjennom 50 målrettede øvelser. Lytt nøye til AI-modellen, gjenta, og ta opp stemmen din for å få detaljert sanntids uttalescoring og tilbakemelding."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|0", "text": "Fokuser på rytmen, trykket og flyten som fremheves i hver øvelse."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|1", "text": "Lytt til referansemodellens lyd før hvert opptaksforsøk."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|2", "text": "Gå gjennom AI-scoren din og tilbakemelding på fonemnivå for å finne områder som kan forbedres."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|caution", "text": "Ikke skynd deg gjennom øvelsene; prioriter klarhet, naturlig kadens og nøyaktig artikulasjon."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|0", "text": "Ekstrem reduksjon av hjelpeord til naturlig flyt."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|1", "text": "'going to' -> 'gonna'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|2", "text": "'have got to' reduseres til 'gotta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|3", "text": "'want a' -> 'wanna'; 'of' -> 'a' /ə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|4", "text": "'has to' -> 'hasta' /hæstə/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|5", "text": "'let me' -> 'lemme'; 'you' -> 'ya'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|6", "text": "'give me' -> 'gimme'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|7", "text": "'could you' -> 'couldja' /kʊdʒə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|8", "text": "'would you' -> 'wouldja'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|9", "text": "'what did you' -> 'whaddya'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|10", "text": "'should have' -> 'shoulda' /ʃʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|11", "text": "'could have' -> 'coulda' /kʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|12", "text": "'would have' -> 'woulda' /wʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|13", "text": "'must have' -> 'musta' /mʌstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|14", "text": "'might have' -> 'mighta' /maɪtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|15", "text": "'used to' -> 'usta' /juːstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|16", "text": "'supposed to' -> 'sposta' /spoʊstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|17", "text": "'need to' -> 'needa'; 'to' -> /də/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|18", "text": "'to' -> /də/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|19", "text": "'kind of' -> 'kinda' /kaɪndə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|20", "text": "'sort of' -> 'sorta' /sɔːrtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|21", "text": "'lots of' -> 'lotsa' /lɒtsə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|22", "text": "'out of' -> 'outta' /aʊtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|23", "text": "'front of' -> 'fronta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|24", "text": "'I am going to' reduseres til 'I'mma' i uformell tale."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|25", "text": "'don't you' -> 'doncha'; 'want to' -> 'wanna'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|26", "text": "'didn't you' -> 'didn'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|27", "text": "'haven't you' -> 'haven'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|28", "text": "'and' reduseres til stavelsesdannende 'n' /n/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|29", "text": "'day and night' -> 'day 'n night'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|30", "text": "'or' reduseres til /ər/; 'it or' smelter sømløst sammen."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|31", "text": "'or' reduseres til trykksvak /ər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|32", "text": "'and' reduseres til /n/ mellom lukkelyder."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|33", "text": "Relativt 'that' reduseres til /ðət/ med schwa."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|34", "text": "Konjunksjonen 'that' er svak og kort."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|35", "text": "'that' uttales som /ðət/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|36", "text": "'them' reduseres til ''em' /əm/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|37", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|38", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|39", "text": "'some' -> /səm/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|40", "text": "'for' -> /fər/; 'you' -> /jə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|41", "text": "'are' -> /ər/; 'you' -> /jə/; 'to' -> /tə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|42", "text": "'were' reduseres til /wər/."}]
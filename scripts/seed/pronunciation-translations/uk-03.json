[{"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|point|3", "text": "got to → gotta"}, {"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|caution", "text": "Це розмовні неформальні форми. Не пишіть їх в есе, електронних листах чи на офіційних іспитах, а також уникайте їх під час офіційних презентацій."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|explain", "text": "Більше повсякденних редукцій, які ви постійно чутимете у фільмах та живих розмовах."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|0", "text": "kind of → kinda"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|1", "text": "sort of → sorta"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|2", "text": "let me → lemme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|3", "text": "give me → gimme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|4", "text": "what do you → whaddaya"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|caution", "text": "Тільки для неформального спілкування. На IELTS або співбесіді вживайте повні форми."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|explain", "text": "Ще кілька редукцій для вираження обов'язку та звички, типових для невимушеного розмовного мовлення."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|0", "text": "have to → hafta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|1", "text": "need to → needa"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|2", "text": "used to → useta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|caution", "text": "Лише розмовні неформальні форми — ніколи не пишіть їх."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|explain", "text": "Редукції минулих форм модальних дієслів — дуже поширені, коли йдеться про жаль або гіпотетичні ситуації."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|0", "text": "could have → coulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|1", "text": "would have → woulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|2", "text": "should have → shoulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|caution", "text": "Тільки для неформального розмовного мовлення — на письмі в офіційному стилі пишіть 'could have' повністю."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|explain", "text": "Дуже розмовні редукції, поширені в піснях, фільмах та невимушених бесідах серед друзів."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|0", "text": "don't know → dunno"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|1", "text": "don't you → dontcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|2", "text": "what are you → whatcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|caution", "text": "Дуже неформально — лише з близькими друзями, ніколи в професійному контексті чи на іспитах."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|explain", "text": "Поширені редукції прийменникових сполучень у розмовному мовленні."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|0", "text": "out of → outta"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|1", "text": "off of → offa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|2", "text": "cup of → cuppa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|caution", "text": "Тільки для неформального спілкування."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|explain", "text": "Повсякденні вигуки та розмовні фрази з сильним скороченням."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|0", "text": "come on → c'mon"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|1", "text": "going to be → gonna be"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|2", "text": "some more → s'more"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|caution", "text": "Тільки для неформального спілкування."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|explain", "text": "Початок запитань сильно редукується у швидкій розмовній мові."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|0", "text": "did you → dja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|1", "text": "do you → dya"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|2", "text": "would you → wouldja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|caution", "text": "Лише для невимушеного розмовного контексту."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|explain", "text": "У розмовному мовленні фрази, що позначають час, також часто скорочуються."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|0", "text": "a couple of → a couple"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|1", "text": "in a minute → in a min"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|caution", "text": "Цілком підходить для невимушеної розмови, але не для письма."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|explain", "text": "Більше поширених розмовних редукцій, які постійно можна почути в невимушеному спілкуванні."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|0", "text": "probably → prolly"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|1", "text": "trying to → tryna"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|2", "text": "supposed to → s'posed to"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|caution", "text": "Тільки для розмовного неформального мовлення."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|explain", "text": "Розмовні редукції, типові для спілкування з друзями та неформального американського мовлення."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|0", "text": "let's go → less go"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|1", "text": "give it to me → gimme that"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|2", "text": "you all → y'all"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|caution", "text": "Дуже неформально — 'y'all' є регіональним виразом (південь US), але його розуміють усюди."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|explain", "text": "У швидкому та невимушеному американському мовленні круглі числа редукують середні приголосні звуки."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|0", "text": "twenty → twenny"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|1", "text": "hundred → hunnerd"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|caution", "text": "Тільки для розмовного неформального мовлення — в офіційних контекстах завжди вимовляйте повну форму."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|explain", "text": "Інша група повсякденних слів, які регулярно втрачають склад у швидкому, невимушеному мовленні."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|0", "text": "different → diff'rent"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|1", "text": "general → gen'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|2", "text": "several → sev'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|3", "text": "camera → cam'ra"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|caution", "text": "Цілком прийнятно в розмовній мові; під час офіційних презентацій чітко вимовляйте повну форму."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|explain", "text": "Вкрай неформальні редукції, які можна почути в піснях і невимушеному американському мовленні, проте їх ніколи не слід уживати в професійному середовищі."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|0", "text": "I'm going to → I'ma"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|1", "text": "kind of like → kinda like"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|caution", "text": "Вкрай неформально — лише для спілкування з друзями або текстів пісень, ніколи не вживайте в професійних контекстах."}, {"key": "551b9527-f712-421d-966c-24644f360746|explain", "text": "Додаткові повсякденні редукції привітань, крім what's up / how's it going."}, {"key": "551b9527-f712-421d-966c-24644f360746|point|0", "text": "how are you → how ya doin'"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|1", "text": "good to see you → good to see ya"}, {"key": "551b9527-f712-421d-966c-24644f360746|caution", "text": "Тільки для розмовного повсякденного мовлення."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|explain", "text": "Більше редукцій вираження зобов’язання та бажання, типових для невимушеного американського мовлення."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|0", "text": "ought to → oughta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|1", "text": "don't have to → don't hafta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|2", "text": "want you → wantcha"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|caution", "text": "Тільки для розмовного неформального мовлення."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|explain", "text": "Це класичний приклад того, як далеко може заходити американська розмовна редукція: кілька слів зливаються в одне ціле на слух."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|0", "text": "Did you eat yet? → Jeetyet?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|1", "text": "Did you already? → Jeetalready?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|caution", "text": "Вкрай неформально — потрібно для розпізнавання швидкого мовлення носіїв, а не для власного формального спілкування."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|explain", "text": "Ще два поширених фразових скорочення в невимушеній розмові."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|0", "text": "because of → 'cause of"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|1", "text": "sort of a → sorta a"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|caution", "text": "Лише для неформального розмовного мовлення."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|explain", "text": "Дуже поширені розмовні альтернативи до 'yes' та 'no' у невимушеному англійському мовленні."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|0", "text": "yes → yep / uh-huh"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|1", "text": "no → nope / nah"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|caution", "text": "Тільки для невимушеної розмови — використовуйте 'yes'/'no' у формальних або екзаменаційних ситуаціях."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|explain", "text": "Обидва варіанти скорочуються до схожого за звучанням 'wanna', але після одного вживається іменник, а після іншого — дієслово; на цю різницю варто звернути увагу."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|0", "text": "want a (coffee) → wanna coffee"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|1", "text": "want to (go) → wanna go"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|caution", "text": "Лише для неформального розмовного мовлення."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|0", "text": "'want a' + іменник → wanna"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|1", "text": "'want to' + дієслово → wanna"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|explain", "text": "Заперечна форма 'would have' скорочується так само, як і стверджувальна."}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|point|0", "text": "wouldn't have → wouldn'ta"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|caution", "text": "Лише для неформального розмовного мовлення — в інших випадках пишіть 'wouldn't have' повністю."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|explain", "text": "Ще два повсякденних скорочення, поширених у невимушених поясненнях і проханнях."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|0", "text": "just because → just 'cause"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|1", "text": "going to need → gonna need"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|caution", "text": "Лише для неформального розмовного мовлення."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|explain", "text": "'Ain't' замінює am not/is not/are not/has not/have not у дуже невимушеному мовленні та часто звучить у піснях і неформальних розмовах."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|0", "text": "I am not → I ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|1", "text": "that is not → that ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|2", "text": "you have not → you ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|caution", "text": "Ніколи не вживайте на письмі або в офіційному мовленні — це вважається нестандартною граматикою, хоча й надзвичайно поширене в неформальному спілкуванні."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|explain", "text": "Дуже поширений розмовний спосіб сказати 'I understand' або буквально 'caught you'."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|0", "text": "got you (розумію) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|1", "text": "got you (спіймав) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|caution", "text": "Лише для неформального розмовного мовлення — у професійному контексті кажіть 'I understand' або 'got it'."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|explain", "text": "Скорочення модальних дієслів у перфекті, які вживаються для здогадок про минуле, нарівні з coulda/woulda/shoulda."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|0", "text": "must have → musta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|1", "text": "might have → mighta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|caution", "text": "Лише для неформального розмовного мовлення — в інших випадках пишіть 'must have'/'might have' повністю."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|explain", "text": "Заперечні відповідники до coulda/woulda/shoulda, поширені під час розмов про жаль."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|0", "text": "shouldn't have → shouldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|1", "text": "couldn't have → couldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|caution", "text": "Лише для неформального розмовного мовлення — в офіційних ситуаціях пишіть 'shouldn't have'/'couldn't have' повністю."}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|explain", "text": "У невимушеному мовленні кінцевий звук -ing часто втрачає 'g', тому звучить як -in'. Це трапляється майже з будь-яким дієсловом на -ing. (, so it sounds like -in)"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|0", "text": "doing → doin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|1", "text": "going → goin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|2", "text": "talking → talkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|3", "text": "thinking → thinkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|caution", "text": "Тільки для розмовного мовлення — вимовляйте повне '-ing' чітко під час презентацій, співбесід та іспитів."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|explain", "text": "Така ж закономірність випадання звука g застосовується до неозначених займенників, що закінчуються на -thing."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|0", "text": "something → somethin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|1", "text": "nothing → nothin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|2", "text": "anything → anythin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|caution", "text": "Тільки для розмовного мовлення."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|explain", "text": "'Them' скорочується до 'em (звук 'th' випадає) після дієслова в дуже поширеному розмовному мовленні."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|0", "text": "tell them → tell 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|1", "text": "get them → get 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|2", "text": "ask them → ask 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|caution", "text": "Тільки для неформального усного мовлення — на письмі або в офіційному мовленні вимовляйте 'them' повністю."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|explain", "text": "'And' редукується до швидкого звука 'n' між двома тісно пов'язаними словами, особливо в сталих виразах."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|0", "text": "rock and roll → rock 'n' roll"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|1", "text": "fish and chips → fish 'n' chips"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|2", "text": "back and forth → back 'n' forth"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|caution", "text": "Поширено в сталих виразах і швидкому мовленні — чітко вживайте та пишіть 'and' в офіційному стилі."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|explain", "text": "'Because' саме по собі (не лише 'because of') часто скорочується до 'cause у невимушених відповідях."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|point|0", "text": "because → 'cause"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|caution", "text": "Лише для неформального усного мовлення — в інших випадках пишіть 'because' повністю."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|explain", "text": "У виразі 'Of course' часто випадає перше слово під час швидких розмовних відповідей."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|point|0", "text": "of course → 'course"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|caution", "text": "Тільки для розмовного мовлення."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|explain", "text": "Дуже поширена розмовна вимова виразу 'all right', яка використовується для вираження згоди чи підтвердження."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|point|0", "text": "all right → aight"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|caution", "text": "Дуже неформально — у професійному контексті кажіть 'all right' або 'okay'."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|explain", "text": "'Let you' редукується так само, як і 'want you'/'wantcha'."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|point|0", "text": "let you → letcha"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|caution", "text": "Лише для неформального усного мовлення."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|explain", "text": "Ще один випадок сильного злиття в швидкому мовленні, подібний до 'jeetyet' — кілька слів стискаються в один звук."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|point|0", "text": "did you ever → jever"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|caution", "text": "Для розпізнавання швидкого мовлення носіїв, а не для власного офіційного спілкування."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|explain", "text": "Два скорочення нашаровуються одне на одне, коли 'going to' і 'have to' стоять поруч."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|point|0", "text": "going to have to → gonna hafta"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|caution", "text": "Лише для неформального усного мовлення — в інших випадках пишіть 'going to have to' повністю."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|explain", "text": "Скорочення 'gonna' зберігається також із запереченнями та в минулому часі."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|0", "text": "not going to → not gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|1", "text": "wasn't going to → wasn't gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|caution", "text": "Лише для неформального розмовного мовлення."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|explain", "text": "Дуже поширене скорочення розділового запитання в британській англійській, яке використовується для підтвердження або підсилення висловлювання."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|point|0", "text": "isn't it → innit"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|caution", "text": "Дуже неформальний британський сленг — не використовуйте в офіційному мовленні, навіть у UK."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|explain", "text": "Неформальний спосіб щось запропонувати або запитати про згоду."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|point|0", "text": "what do you say → whaddya say"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|caution", "text": "Лише для неформального розмовного мовлення."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|explain", "text": "Надзвичайно поширена фраза-паразит у розмовній англійській, яка використовується під час роздумів або для підсилення."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|point|0", "text": "you know → y'know"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|caution", "text": "Лише неформальне слово-паразит — його надмірне вживання звучить невишукано навіть у невимушеній розмові."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|explain", "text": "Дуже неформальне привітання, утворене скороченням від 'what's up'."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|point|0", "text": "what's up → s'up"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|caution", "text": "Дуже неформальне привітання, лише для спілкування між друзями."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|explain", "text": "'Him' та 'her' також редукуються в розмовному мовленні подібно до 'them' → 'em."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|0", "text": "tell him → tell 'im"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|1", "text": "ask her → ask 'er"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|caution", "text": "Лише для неформального розмовного мовлення."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|explain", "text": "'Kinda' та 'sorta' часто поєднуються для додаткового пом'якшення твердження в дуже невимушеній розмові."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|point|0", "text": "kind of sort of → kinda sorta"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|caution", "text": "Дуже неформально — уникайте в будь-якому професійному контексті або на іспитах."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|explain", "text": "Ще одне злиття на початку запитання у швидкому мовленні, поряд із dja та wouldja."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|point|0", "text": "didn't you → dincha"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|caution", "text": "Для розпізнавання швидкого мовлення носіїв, а не для власного офіційного мовлення."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|explain", "text": "Форма минулого часу від 'have to' редукується так само, як і форма теперішнього часу."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|point|0", "text": "had to → hadta"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|caution", "text": "Лише для неформального розмовного мовлення."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|explain", "text": "Розмовне скорочення, що використовується в неформальних проханнях, поряд із формами на кшталт wouldja та couldja."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|point|0", "text": "will you → willcha"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|caution", "text": "Лише для неформального розмовного мовлення."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|explain", "text": "Кількісні фрази з 'of' редукуються так само, як 'cup of' у 'cuppa'."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|0", "text": "lots of → lotsa"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|1", "text": "bunch of → buncha"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|caution", "text": "Лише для неформального розмовного мовлення."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|explain", "text": "Виразний розмовний підсилювач зі значенням 'a very impressive/big'."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|point|0", "text": "hell of a → helluva"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|caution", "text": "Дещо грубувато — підходить для друзів, але уникайте в професійній чи ввічливій розмові."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|explain", "text": "Історичне скорочення старого привітання 'how do you do', яке зараз стало самостійним невимушеним, дружнім вітанням (особливо на півдні US)."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|point|0", "text": "how do you do → howdy"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|caution", "text": "Лише невимушене, дружнє привітання."}, {"key": "47538641-f573-4840-af35-02857a1d24de|explain", "text": "У фрази 'I suppose' у розмовному мовленні часто випадає середній склад; вона вживається для вираження незначної невпевненості або неохочої згоди — на відміну від 'supposed to' → s'posed to."}, {"key": "47538641-f573-4840-af35-02857a1d24de|point|0", "text": "I suppose → I s'pose"}, {"key": "47538641-f573-4840-af35-02857a1d24de|caution", "text": "Лише для неформальної розмовної мови — в інших випадках пишіть 'I suppose' повністю."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|explain", "text": "Опануйте редукції у 50 цільових вправах. Уважно слухайте модель AI, повторюйте та записуйте свій голос, щоб отримувати детальне оцінювання вимови та зворотний зв’язок у реальному часі."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|0", "text": "Зосередьтеся на ритмі, наголосі та плавності мовлення, виділених у кожній вправі."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|1", "text": "Слухайте зразковий аудіозапис перед кожною спробою запису."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|2", "text": "Аналізуйте свою оцінку від AI та коментарі на рівні окремих фонем, щоб точно визначати аспекти для покращення."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|caution", "text": "Не поспішайте під час виконання вправ; віддавайте перевагу чіткості, природному ритму та точній артикуляції."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|0", "text": "Максимальна редукція допоміжних слів для природного плавного потоку мовлення."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|1", "text": "'going to' -> 'gonna'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|2", "text": "'have got to' редукується до 'gotta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|3", "text": "'want a' -> 'wanna'; 'of' -> 'a' /ə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|4", "text": "'has to' -> 'hasta' /hæstə/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|5", "text": "'let me' -> 'lemme'; 'you' -> 'ya'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|6", "text": "'give me' -> 'gimme'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|7", "text": "'could you' -> 'couldja' /kʊdʒə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|8", "text": "'would you' -> 'wouldja'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|9", "text": "'what did you' -> 'whaddya'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|10", "text": "'should have' -> 'shoulda' /ʃʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|11", "text": "'could have' -> 'coulda' /kʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|12", "text": "'would have' -> 'woulda' /wʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|13", "text": "'must have' -> 'musta' /mʌstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|14", "text": "'might have' -> 'mighta' /maɪtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|15", "text": "'used to' -> 'usta' /juːstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|16", "text": "'supposed to' -> 'sposta' /spoʊstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|17", "text": "'need to' -> 'needa'; 'to' -> /də/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|18", "text": "'to' -> /də/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|19", "text": "'kind of' -> 'kinda' /kaɪndə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|20", "text": "'sort of' -> 'sorta' /sɔːrtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|21", "text": "'lots of' -> 'lotsa' /lɒtsə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|22", "text": "'out of' -> 'outta' /aʊtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|23", "text": "'front of' -> 'fronta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|24", "text": "'I am going to' редукується до 'I'mma' у неформальному мовленні."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|25", "text": "'don't you' -> 'doncha'; 'want to' -> 'wanna'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|26", "text": "'didn't you' -> 'didn'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|27", "text": "'haven't you' -> 'haven'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|28", "text": "'and' редукується до складового 'n' /n/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|29", "text": "'day and night' -> 'day 'n night'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|30", "text": "'or' редукується до /ər/; 'it or' плавно вимовляється через одноударний звук."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|31", "text": "'or' редукується до ненаголошеного /ər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|32", "text": "'and' редукується до /n/ між проривними звуками."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|33", "text": "Відносний займенник 'that' редукується до /ðət/ зі звуком шва."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|34", "text": "Сполучник 'that' звучить редуковано й коротко."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|35", "text": "'that' вимовляється як /ðət/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|36", "text": "'them' редукується до ''em' /əm/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|37", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|38", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|39", "text": "'some' -> /səm/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|40", "text": "'for' -> /fər/; 'you' -> /jə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|41", "text": "'are' -> /ər/; 'you' -> /jə/; 'to' -> /tə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|42", "text": "'were' редукується до /wər/."}]
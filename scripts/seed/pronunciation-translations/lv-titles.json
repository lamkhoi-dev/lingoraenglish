s"}, {"key": "a84020fb-902a-41a7-9e7a-a5523a131e39|title", "text": "Ritma kontrasts: formāla pret neformālu runu"}, {"key": "3a700d29-5193-47fc-a056-26b9b1ef7583|title", "text": "Ritms ar līdzskaņu kopu mēles mežģiem"}, {"key": "84ec965f-393a-45cc-a6da-2df8b61cfb17|title", "text": "Ritms divu teikumu mini dialogā"}, {"key": "35ef36eb-21f2-4b5e-bc5f-587978092b46|title", "text": "Ritms, dodot komandas"}, {"key": "9595f308-42c1-48d7-a50b-032a1087c2c9|title", "text": "Ritms, skaļi lasot ēdienkarti"}, {"key": "26a471ad-bfa0-458b-8e6e-7f13f5bfcaf4|title", "text": "Ritms vienkāršā bērnu dziesmā"}, {"key": "8009dff8-bbd3-489e-931a-5cc9216391e8|title", "text": "Ritma mini dialogs ar kontrastīvo uzsvaru"}, {"key": "ec8806a9-e3b6-4d4c-9d3f-41488659a00a|title", "text": "Ritms un saistīšana kopā"}, {"key": "689ca526-7140-4982-b7f3-9fb91eade14a|title", "text": "Ritms slavenos filmu citātos"}, {"key": "93bcce1e-e9b7-4b88-8c61-7bdf363b6deb|title", "text": "Ritma intensitātes veidošana īsā runā"}, {"key": "8226101c-fcf1-4fd6-a265-4e7e06acc6d1|title", "text": "Ritms grupu skandējumos un saucienos"}, {"key": "5922001b-6484-4846-91ab-5d6968f44a85|title", "text": "Ritms ar aliterāciju"}, {"key": "3ca06cf5-723a-4164-b991-7bca05c5bd99|title", "text": "Ritms, aprakstot laika karti"}, {"key": "45642f39-6b74-42e4-b8ef-b83aa98e7f7b|title", "text": "Ritms, soli pa solim lasot recepti"}, {"key": "edc166d1-b22a-49a9-af4d-0a7f8b1667cc|title", "text": "Ritma un paužu apvienotais vingrinājums"}, {"key": "67f0acc3-d7cd-4264-bd71-920dbe6b6669|title", "text": "Ritms, sakot patiesus komplimentus"}, {"key": "a3c1806d-487c-4a0f-9f36-60c1bc8120bf|title", "text": "Ritms, skaitot priekšmetus"}, {"key": "dd0c00fe-bbbc-4659-9128-0510c502b8a2|title", "text": "Ritms, aprakstot dienas grafiku"}, {"key": "3e002123-3541-431f-9e6d-2dbf5eda669b|title", "text": "Ritms īsās izsauksmes reakcijās"}, {"key": "4959fa71-73b4-43e2-9096-2ae38c5928b4|title", "text": "Ritms atbildēs ar minimālu vārdu skaitu"}, {"key": "9c546bc
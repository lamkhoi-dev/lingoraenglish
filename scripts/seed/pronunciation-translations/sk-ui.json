[{"key": "pron.hero.title", "text": "Znejte jasnejšie, prirodzenejšie a plynulejšie"}, {"key": "pron.hero.description", "text": "Všetkých {{count}} anglických hlások plus slovný prízvuk, vetný prízvuk, intonácia, viazaná reč, redukcie, rytmus, členenie a plynulosť — každá lekcia končí vaším vlastným nahrávaním."}, {"key": "pron.imageAlt", "text": "Výslovnosť, artikulácia a IPA"}, {"key": "pron.progress.title", "text": "Váš pokrok vo výslovnosti"}, {"key": "pron.progress.descUser", "text": "Merané podľa slov, ktoré kouč rozpoznal vo vašich vlastných nahrávkach."}, {"key": "pron.progress.descGuest", "text": "Vytvorte si bezplatný účet, nahrávajte sa a začnite sledovať pokrok."}, {"key": "pron.recommended", "text": "Odporúčané pre vás"}, {"key": "pron.soundLabel", "text": "Hláska {{symbol}}"}, {"key": "pron.skill.sounds", "text": "Hlásky"}, {"key": "pron.skill.sounds.blurb", "text": "Všetkých 44 anglických foném s minimálnymi pármi."}, {"key": "pron.skill.wordStress", "text": "Slovný prízvuk"}, {"key": "pron.skill.wordStress.blurb", "text": "Slabiky, hlavný a vedľajší prízvuk."}, {"key": "pron.skill.sentenceStress", "text": "Vetný prízvuk"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Plnovýznamové slová silné, funkčné slová slabé."}, {"key": "pron.skill.intonation", "text": "Intonácia"}, {"key": "pron.skill.intonation.blurb", "text": "Stúpavá, klesavá, stúpavo-klesavá a klesavo-stúpavá."}, {"key": "pron.skill.connectedSpeech", "text": "Viazaná reč"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Spájanie, elízia, asimilácia, slabé formy."}, {"key": "pron.skill.reductions", "text": "Redukcie"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — neformálna hovorová angličtina."}, {"key": "pron.skill.rhythm", "text": "Rytmus"}, {"key": "pron.skill.rhythm.blurb", "text": "Prízvučné takty, časovanie a pauzy."}, {"key": "pron.skill.chunking", "text": "Pauzy a členenie"}, {"key": "pron.skill.chunking.blurb", "text": "Myšlienkové celky a prirodzené dýchacie pauzy."}, {"key": "pron.skill.fluency", "text": "Plynulosť"}, {"key": "pron.skill.fluency.blurb", "text": "Rýchlosť, váhanie, výplňové slová a spájanie myšlienok."}, {"key": "pron.filter.searchPlaceholder", "text": "Hľadať hlásku, slovo alebo lekciu"}, {"key": "pron.filter.allLevels", "text": "Všetky úrovne"}, {"key": "pron.filter.beginner", "text": "Začiatočník"}, {"key": "pron.filter.intermediate", "text": "Stredne pokročilý"}, {"key": "pron.filter.advanced", "text": "Pokročilý"}, {"key": "pron.filter.allDifficulties", "text": "Všetky obtiažnosti"}, {"key": "pron.filter.gentle", "text": "Mierna"}, {"key": "pron.filter.steady", "text": "Vyrovnaná"}, {"key": "pron.filter.challenging", "text": "Náročná"}, {"key": "pron.filter.us", "text": "Americká angličtina"}, {"key": "pron.filter.uk", "text": "Britská angličtina"}, {"key": "pron.sounds.title", "text": "{{count}} anglických hlások"}, {"key": "pron.sounds.shown", "text": "Zobrazených: {{count}}"}, {"key": "pron.lessons.title", "text": "Lekcie: {{skill}}"}, {"key": "pron.lessons.none", "text": "Žiadna lekcia nezodpovedá týmto filtrom. Skúste „Všetky úrovne“ a „Všetky obtiažnosti“."}, {"key": "pron.how", "text": "Ako"}, {"key": "pron.commonMistakes", "text": "Časté chyby"}, {"key": "pron.wordPractice", "text": "Nácvik slov"}, {"key": "pron.sentencePractice", "text": "Nácvik viet"}, {"key": "pron.minimalPairs", "text": "Minimálne páry"}, {"key": "pron.practise", "text": "Cvičiť"}, {"key": "pron.toast.signInModel", "text": "Prihláste sa, aby ste počuli zvuk AI modelu."}, {"key": "pron.toast.playError", "text": "Zvuk sa nepodarilo prehrať."}, {"key": "pron.voicedDesc", "text": "Znelá — hlasivky vibrujú"}, {"key": "pron.voicelessDesc", "text": "Neznelá — iba výdych, žiadne vibrácie"}, {"key": "pron.soundPracticeHint", "text": "Kliknutím na „1. Počúvať“ v karte Cvičenie vpravo si vypočujete AI model tejto hlásky a príklad."}, {"key": "pron.paywall.soundLocked", "text": "Kompletná lekcia tejto hlásky — ako ju vysloviť, postavenie úst, príkladové slová, vety a minimálne páry — je súčasťou Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "Prvých {{count}} hlások je zadarmo. Prejdite na Premium a odomknite všetkých 44 hlások a personalizovanú spätnú väzbu kouča."}, {"key": "pron.paywall.unlockAllSounds", "text": "Odomknúť všetkých 44 hlások"}, {"key": "pron.wordPracticeHint", "text": "Kliknutím na slovo si vypočujete AI a precvičíte výslovnosť"}, {"key": "pron.eg", "text": "napr."}, {"key": "pron.playing", "text": "Prehráva sa"}, {"key": "pron.listen", "text": "Počúvať"}, {"key": "pron.paywall.lessonLocked", "text": "Vysvetlenie tejto lekcie, cvičebné body a príklady sú súčasťou Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "Prvých {{count}} lekcií z každej zručnosti je zadarmo. Odomkni si zvyšok."}, {"key": "pron.paywall.unlockAllLessons", "text": "Odomknúť všetky lekcie"}, {"key": "pron.itemPracticeHint", "text": "Klikni na položku a precvič si ju s AI"}, {"key": "pron.practiceHint", "text": "Počúvaj, opakuj, nahrávaj a porovnávaj — kouč ti ukáže, ktoré slová zazneli jasne."}, {"key": "pron.drillsCount", "text": "{{count}} cvičení"}, {"key": "pron.useInShadowing", "text": "Použiť túto zručnosť v Shadowingu"}, {"key": "pron.backToCoach", "text": "Späť na Speaking Coach"}, {"key": "pron.p.title", "text": "Cvičenie"}, {"key": "pron.p.step1.label", "text": "Počúvaj"}, {"key": "pron.p.step1.hint", "text": "Prehraj vzorovú nahrávku dvakrát."}, {"key": "pron.p.step2.label", "text": "Pochop"}, {"key": "pron.p.step2.hint", "text": "Prečítaj si, čo má tvoje ústa robiť."}, {"key": "pron.p.step3.label", "text": "Sleduj / uč sa"}, {"key": "pron.p.step3.hint", "text": "Pozri si sprievodcu pre ústa, jazyk a vzor."}, {"key": "pron.p.step4.label", "text": "Opakuj"}, {"key": "pron.p.step4.hint", "text": "Povedz to nahlas spolu s nahrávkou, najprv pomaly."}, {"key": "pron.p.step5.label", "text": "Nahraj"}, {"key": "pron.p.step5.hint", "text": "Nahraj sa, ako hovoríš ten istý riadok."}, {"key": "pron.p.step6.label", "text": "AI spätná väzba"}, {"key": "pron.p.step6.hint", "text": "Pozri, čo kouč počul a čo treba opraviť."}, {"key": "pron.p.step7.label", "text": "Skús znova"}, {"key": "pron.p.step7.hint", "text": "Oprav jednu vec a nahraj sa ešte raz."}, {"key": "pron.p.step8.label", "text": "Zvládnuté"}, {"key": "pron.p.step8.hint", "text": "Dvakrát za sebou jasné prečítanie — pokračuj ďalej."}, {"key": "pron.p.stepTap", "text": "{{hint}} Ťukni, keď to máš hotové."}, {"key": "pron.p.focusSound", "text": "Zameranie na zvuk {{sound}}"}, {"key": "pron.p.eg", "text": "napr. {{sentence}}"}, {"key": "pron.p.loading", "text": "Načítava sa…"}, {"key": "pron.p.speedNormal", "text": "Normálne"}, {"key": "pron.p.speedSlower", "text": "Pomalšie"}, {"key": "pron.p.speedSlow", "text": "Pomaly"}, {"key": "pron.p.loop", "text": "Slučka"}, {"key": "pron.p.stop", "text": "Zastaviť"}, {"key": "pron.p.voiceNote", "text": "Vzorová nahrávka je americký anglický AI hlas Lingora, nie nahrávka človeka."}, {"key": "pron.p.listenSentence", "text": "Počúvaj prehrá zvuk dvakrát, potom vzorové slovo a nakoniec vetu, ktorá ho obsahuje."}, {"key": "pron.p.listenExample", "text": "Počúvaj prehrá zvuk dvakrát, potom príklad."}, {"key": "pron.p.recordHint", "text": "Povedz riadok vyššie raz, jasne."}, {"key": "pron.p.signupToRecord", "text": "Vytvor si bezplatný účet, aby si sa mohol nahrávať a získať spätnú väzbu."}, {"key": "pron.p.yourRecording", "text": "Tvoja nahrávka"}, {"key": "pron.p.listeningRec", "text": "Počúvam tvoju nahrávku…"}, {"key": "pron.p.wordsClear", "text": "Slová povedané jasne"}, {"key": "pron.p.wpm", "text": "Rýchlosť hovorenia (slová/min)"}, {"key": "pron.p.heard", "text": "Lingora počul"}, {"key": "pron.p.tagClear", "text": "Jasné"}, {"key": "pron.p.tagNeeds", "text": "Treba zlepšiť"}, {"key": "pron.p.measured", "text": "Meraný prejav"}, {"key": "pron.p.paceLabel", "text": "Tempo:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} slov za minútu ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Prirodzená konverzácia je približne 120–160."}, {"key": "pron.p.pace.slow", "text": "pomalé"}, {"key": "pron.p.pace.natural", "text": "prirodzené"}, {"key": "pron.p.pace.fast", "text": "rýchle"}, {"key": "pron.p.fillersLabel", "text": "Výplňové slová:"}, {"key": "pron.p.repeatedLabel", "text": "Zopakované slová:"}, {"key": "pron.p.noneDetected", "text": "žiadne nezistené"}, {"key": "pron.p.measuredNote", "text": "Tempo, výplňové slová a opakovanie sa počítajú z tvojho skutočného prepisu a dĺžky nahrávky. Výška hlasu, hlasitosť a dĺžka tichých prestávok sa nemerajú, preto automaticky nehodnotíme intonáciu ani prestávky."}, {"key": "pron.p.mastered", "text": "Zvládnuté — dva jasné pokusy"}, {"key": "pron.p.attempt", "text": "Pokus {{n}} — dve jasné prečítania za sebou označia tento riadok ako zvládnutý."}, {"key": "pron.p.toShadowing", "text": "Precvič si to v reálnej reči → Shadowing"}, {"key": "pron.p.toCoach", "text": "Použi to so Speaking Coach"}]
[{"key": "pron.hero.title", "text": "Kedengaran lebih jelas, lebih alami, lebih lancar"}, {"key": "pron.hero.description", "text": "Semua {{count}} bunyi bahasa Inggris plus tekanan kata, tekanan kalimat, intonasi, ucapan tersambung, reduksi, ritme, pemenggalan frasa, dan kelancaran — setiap pelajaran diakhiri dengan rekaman suara Anda sendiri."}, {"key": "pron.imageAlt", "text": "Artikulasi Pengucapan & IPA"}, {"key": "pron.progress.title", "text": "Kemajuan pengucapan Anda"}, {"key": "pron.progress.descUser", "text": "Diukur dari kata-kata yang dikenali pelatih dalam rekaman Anda sendiri."}, {"key": "pron.progress.descGuest", "text": "Buat akun gratis untuk merekam suara Anda dan mulai melacak kemajuan."}, {"key": "pron.recommended", "text": "Direkomendasikan untuk Anda"}, {"key": "pron.soundLabel", "text": "Bunyi {{symbol}}"}, {"key": "pron.skill.sounds", "text": "Bunyi"}, {"key": "pron.skill.sounds.blurb", "text": "Semua 44 fonem bahasa Inggris dengan pasangan minimal."}, {"key": "pron.skill.wordStress", "text": "Tekanan kata"}, {"key": "pron.skill.wordStress.blurb", "text": "Suku kata, tekanan utama dan sekunder."}, {"key": "pron.skill.sentenceStress", "text": "Tekanan kalimat"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Kata isi ditekankan, kata fungsi dilemahkan."}, {"key": "pron.skill.intonation", "text": "Intonasi"}, {"key": "pron.skill.intonation.blurb", "text": "Nada naik, turun, naik-turun, dan turun-naik."}, {"key": "pron.skill.connectedSpeech", "text": "Ucapan tersambung"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Penghubungan, penghilangan, asimilasi, bentuk lemah."}, {"key": "pron.skill.reductions", "text": "Reduksi"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — bahasa Inggris lisan informal."}, {"key": "pron.skill.rhythm", "text": "Ritme"}, {"key": "pron.skill.rhythm.blurb", "text": "Ketukan berbasis tekanan, waktu, dan jeda."}, {"key": "pron.skill.chunking", "text": "Jeda & pemenggalan frasa"}, {"key": "pron.skill.chunking.blurb", "text": "Kelompok gagasan dan jeda napas alami."}, {"key": "pron.skill.fluency", "text": "Kelancaran"}, {"key": "pron.skill.fluency.blurb", "text": "Kecepatan, keraguan, kata pengisi, dan penghubungan gagasan."}, {"key": "pron.filter.searchPlaceholder", "text": "Cari bunyi, kata, atau pelajaran"}, {"key": "pron.filter.allLevels", "text": "Semua level"}, {"key": "pron.filter.beginner", "text": "Pemula"}, {"key": "pron.filter.intermediate", "text": "Menengah"}, {"key": "pron.filter.advanced", "text": "Mahir"}, {"key": "pron.filter.allDifficulties", "text": "Semua tingkat kesulitan"}, {"key": "pron.filter.gentle", "text": "Santai"}, {"key": "pron.filter.steady", "text": "Stabil"}, {"key": "pron.filter.challenging", "text": "Menantang"}, {"key": "pron.filter.us", "text": "Bahasa Inggris AS"}, {"key": "pron.filter.uk", "text": "Bahasa Inggris UK"}, {"key": "pron.sounds.title", "text": "{{count}} bunyi bahasa Inggris"}, {"key": "pron.sounds.shown", "text": "{{count}} ditampilkan"}, {"key": "pron.lessons.title", "text": "Pelajaran {{skill}}"}, {"key": "pron.lessons.none", "text": "Tidak ada pelajaran yang cocok dengan filter ini. Coba \"Semua level\" dan \"Semua tingkat kesulitan\"."}, {"key": "pron.how", "text": "Cara"}, {"key": "pron.commonMistakes", "text": "Kesalahan umum"}, {"key": "pron.wordPractice", "text": "Latihan kata"}, {"key": "pron.sentencePractice", "text": "Latihan kalimat"}, {"key": "pron.minimalPairs", "text": "Pasangan minimal"}, {"key": "pron.practise", "text": "Latihan"}, {"key": "pron.toast.signInModel", "text": "Masuk untuk mendengar suara model AI."}, {"key": "pron.toast.playError", "text": "Tidak dapat memutar audio."}, {"key": "pron.voicedDesc", "text": "Bersuara — pita suara Anda bergetar"}, {"key": "pron.voicelessDesc", "text": "Tak bersuara — hanya napas, tanpa getaran"}, {"key": "pron.soundPracticeHint", "text": "Ketuk \"1. Dengarkan\" di kartu Latihan di sebelah kanan untuk mendengar model AI membunyikan ini dan sebuah contoh."}, {"key": "pron.paywall.soundLocked", "text": "Pelajaran lengkap bunyi ini — cara membuatnya, posisi mulut, contoh kata, kalimat, dan pasangan minimal — adalah bagian dari Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "{{count}} bunyi pertama gratis. Tingkatkan untuk membuka semua 44 bunyi dan umpan balik pelatih yang dipersonalisasi."}, {"key": "pron.paywall.unlockAllSounds", "text": "Buka semua 44 bunyi"}, {"key": "pron.wordPracticeHint", "text": "Klik kata untuk mendengar AI & berlatih"}, {"key": "pron.eg", "text": "mis."}, {"key": "pron.playing", "text": "Memutar"}, {"key": "pron.listen", "text": "Dengarkan"}, {"key": "pron.paywall.lessonLocked", "text": "Penjelasan, poin latihan, dan contoh pelajaran ini adalah bagian dari Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "{{count}} pelajaran pertama dari setiap skill gratis. Upgrade untuk membuka sisanya."}, {"key": "pron.paywall.unlockAllLessons", "text": "Buka semua pelajaran"}, {"key": "pron.itemPracticeHint", "text": "Klik item untuk berlatih dengan AI"}, {"key": "pron.practiceHint", "text": "Dengarkan, ulangi, rekam, dan bandingkan — coach menunjukkan dengan tepat kata mana yang terdengar jelas."}, {"key": "pron.drillsCount", "text": "{{count}} latihan"}, {"key": "pron.useInShadowing", "text": "Gunakan skill ini di Shadowing"}, {"key": "pron.backToCoach", "text": "Kembali ke Speaking Coach"}, {"key": "pron.p.title", "text": "Latihan"}, {"key": "pron.p.step1.label", "text": "Dengarkan"}, {"key": "pron.p.step1.hint", "text": "Putar audio model dua kali."}, {"key": "pron.p.step2.label", "text": "Pahami"}, {"key": "pron.p.step2.hint", "text": "Baca apa yang harus dilakukan mulutmu."}, {"key": "pron.p.step3.label", "text": "Tonton / pelajari"}, {"key": "pron.p.step3.hint", "text": "Periksa panduan mulut, lidah, dan pola."}, {"key": "pron.p.step4.label", "text": "Ulangi"}, {"key": "pron.p.step4.hint", "text": "Ucapkan dengan lantang mengikuti audio, pelan dulu."}, {"key": "pron.p.step5.label", "text": "Rekam"}, {"key": "pron.p.step5.hint", "text": "Rekam dirimu mengucapkan kalimat yang sama."}, {"key": "pron.p.step6.label", "text": "Umpan balik AI"}, {"key": "pron.p.step6.hint", "text": "Lihat apa yang didengar coach dan apa yang perlu diperbaiki."}, {"key": "pron.p.step7.label", "text": "Coba lagi"}, {"key": "pron.p.step7.hint", "text": "Perbaiki satu hal dan rekam sekali lagi."}, {"key": "pron.p.step8.label", "text": "Dikuasai"}, {"key": "pron.p.step8.hint", "text": "Bacaan jelas dua kali berturut-turut — lanjut."}, {"key": "pron.p.stepTap", "text": "{{hint}} Ketuk setelah kamu melakukannya."}, {"key": "pron.p.focusSound", "text": "Fokus bunyi {{sound}}"}, {"key": "pron.p.eg", "text": "mis. {{sentence}}"}, {"key": "pron.p.loading", "text": "Memuat…"}, {"key": "pron.p.speedNormal", "text": "Normal"}, {"key": "pron.p.speedSlower", "text": "Lebih lambat"}, {"key": "pron.p.speedSlow", "text": "Lambat"}, {"key": "pron.p.loop", "text": "Ulang"}, {"key": "pron.p.stop", "text": "Berhenti"}, {"key": "pron.p.voiceNote", "text": "Audio model adalah suara AI American English Lingora, bukan rekaman manusia."}, {"key": "pron.p.listenSentence", "text": "Dengarkan memutar bunyi dua kali, lalu kata contoh, lalu kalimat yang memuatnya."}, {"key": "pron.p.listenExample", "text": "Dengarkan memutar bunyi dua kali, lalu contohnya."}, {"key": "pron.p.recordHint", "text": "Ucapkan kalimat di atas sekali dengan jelas."}, {"key": "pron.p.signupToRecord", "text": "Buat akun gratis untuk merekam dan mendapat umpan balik."}, {"key": "pron.p.yourRecording", "text": "Rekamanmu"}, {"key": "pron.p.listeningRec", "text": "Mendengarkan rekamanmu…"}, {"key": "pron.p.wordsClear", "text": "Kata yang diucapkan jelas"}, {"key": "pron.p.wpm", "text": "Kecepatan bicara (wpm)"}, {"key": "pron.p.heard", "text": "Lingora mendengar"}, {"key": "pron.p.tagClear", "text": "Jelas"}, {"key": "pron.p.tagNeeds", "text": "Perlu perbaikan"}, {"key": "pron.p.measured", "text": "Pengucapan terukur"}, {"key": "pron.p.paceLabel", "text": "Tempo:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} kata per menit ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Percakapan alami sekitar 120–160."}, {"key": "pron.p.pace.slow", "text": "lambat"}, {"key": "pron.p.pace.natural", "text": "alami"}, {"key": "pron.p.pace.fast", "text": "cepat"}, {"key": "pron.p.fillersLabel", "text": "Kata pengisi:"}, {"key": "pron.p.repeatedLabel", "text": "Kata berulang:"}, {"key": "pron.p.noneDetected", "text": "tidak ada terdeteksi"}, {"key": "pron.p.measuredNote", "text": "Tempo, kata pengisi, dan pengulangan dihitung dari transkrip asli dan durasi rekamanmu. Nada, kenyaringan, dan panjang jeda hening tidak diukur, jadi kami tidak menilai intonasi atau jeda secara otomatis."}, {"key": "pron.p.mastered", "text": "Dikuasai — dua percobaan jelas"}, {"key": "pron.p.attempt", "text": "Percobaan {{n}} — dua bacaan jelas berturut-turut menandai kalimat ini sebagai dikuasai."}, {"key": "pron.p.toShadowing", "text": "Latih ini dalam ucapan nyata → Shadowing"}, {"key": "pron.p.toCoach", "text": "Gunakan dengan Speaking Coach"}]
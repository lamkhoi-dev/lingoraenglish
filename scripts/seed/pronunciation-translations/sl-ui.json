[{"key": "pron.hero.title", "text": "Zveni jasneje, bolj naravno, bolj tekoče"}, {"key": "pron.hero.description", "text": "Vseh {{count}} angleških glasov ter naglas v besedi, naglas v stavku, intonacija, povezan govor, redukcije, ritem, členjenje in tekočnost — vsaka lekcija se konča z vašim lastnim posnetkom."}, {"key": "pron.imageAlt", "text": "Izgovorjava, artikulacija in IPA"}, {"key": "pron.progress.title", "text": "Vaš napredek pri izgovorjavi"}, {"key": "pron.progress.descUser", "text": "Izmerjeno na podlagi besed, ki jih je trener prepoznal v vaših posnetkih."}, {"key": "pron.progress.descGuest", "text": "Ustvarite brezplačen račun, da se posnamete in začnete spremljati napredek."}, {"key": "pron.recommended", "text": "Priporočeno za vas"}, {"key": "pron.soundLabel", "text": "Glas {{symbol}}"}, {"key": "pron.skill.sounds", "text": "Glasovi"}, {"key": "pron.skill.sounds.blurb", "text": "Vseh 44 angleških fonemov z minimalnimi pari."}, {"key": "pron.skill.wordStress", "text": "Naglas v besedi"}, {"key": "pron.skill.wordStress.blurb", "text": "Zlogi, primarni in sekundarni naglas."}, {"key": "pron.skill.sentenceStress", "text": "Naglas v stavku"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Polnopomenske besede poudarjene, funkcijske šibke."}, {"key": "pron.skill.intonation", "text": "Intonacija"}, {"key": "pron.skill.intonation.blurb", "text": "Rastoča, padajoča, rastoče-padajoča in padajoče-rastoča."}, {"key": "pron.skill.connectedSpeech", "text": "Povezan govor"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Povezovanje, izpuščanje, asimilacija, šibke oblike."}, {"key": "pron.skill.reductions", "text": "Redukcije"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — neformalna govorjena angleščina."}, {"key": "pron.skill.rhythm", "text": "Ritem"}, {"key": "pron.skill.rhythm.blurb", "text": "Naglašeni takti, čas in premori."}, {"key": "pron.skill.chunking", "text": "Premori in členjenje"}, {"key": "pron.skill.chunking.blurb", "text": "Miselne skupine in naravni premori za dih."}, {"key": "pron.skill.fluency", "text": "Tekočnost"}, {"key": "pron.skill.fluency.blurb", "text": "Hitrost, obotavljanje, mašila in povezovanje idej."}, {"key": "pron.filter.searchPlaceholder", "text": "Išči glas, besedo ali lekcijo"}, {"key": "pron.filter.allLevels", "text": "Vse ravni"}, {"key": "pron.filter.beginner", "text": "Začetnik"}, {"key": "pron.filter.intermediate", "text": "Srednja raven"}, {"key": "pron.filter.advanced", "text": "Napredna raven"}, {"key": "pron.filter.allDifficulties", "text": "Vse težavnosti"}, {"key": "pron.filter.gentle", "text": "Nežno"}, {"key": "pron.filter.steady", "text": "Umirjeno"}, {"key": "pron.filter.challenging", "text": "Zahtevno"}, {"key": "pron.filter.us", "text": "Ameriška angleščina"}, {"key": "pron.filter.uk", "text": "Britanska angleščina"}, {"key": "pron.sounds.title", "text": "{{count}} angleških glasov"}, {"key": "pron.sounds.shown", "text": "Prikazanih: {{count}}"}, {"key": "pron.lessons.title", "text": "Lekcije: {{skill}}"}, {"key": "pron.lessons.none", "text": "Nobena lekcija ne ustreza tem filtrom. Poskusite »Vse ravni« in »Vse težavnosti«."}, {"key": "pron.how", "text": "Kako"}, {"key": "pron.commonMistakes", "text": "Pogoste napake"}, {"key": "pron.wordPractice", "text": "Vadba besed"}, {"key": "pron.sentencePractice", "text": "Vadba stavkov"}, {"key": "pron.minimalPairs", "text": "Minimalni pari"}, {"key": "pron.practise", "text": "Vadi"}, {"key": "pron.toast.signInModel", "text": "Prijavite se, da slišite zven modela AI."}, {"key": "pron.toast.playError", "text": "Predvajanje zvoka ni uspelo."}, {"key": "pron.voicedDesc", "text": "Zveneče — glasilke vibrirajo"}, {"key": "pron.voicelessDesc", "text": "Nezveneče — samo dih, brez vibracij"}, {"key": "pron.soundPracticeHint", "text": "Dotaknite se »1. Poslušaj« v kartici za vadbo na desni, da slišite model AI za ta glas in primer."}, {"key": "pron.paywall.soundLocked", "text": "Celotna lekcija za ta glas — kako ga izgovoriti, položaj ust, primeri besed, stavki in minimalni pari — je del Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "Prvih {{count}} glasov je brezplačnih. Nadgradite, da odklenete vseh 44 glasov in osebne povratne informacije trenerja."}, {"key": "pron.paywall.unlockAllSounds", "text": "Odkleni vseh 44 glasov"}, {"key": "pron.wordPracticeHint", "text": "Kliknite besedo za poslušanje AI in vadbo"}, {"key": "pron.eg", "text": "npr."}, {"key": "pron.playing", "text": "Predvajanje"}, {"key": "pron.listen", "text": "Poslušaj"}, {"key": "pron.paywall.lessonLocked", "text": "Razlaga te lekcije, vadbene točke in primeri so del Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "Prvih {{count}} lekcij vsake veščine je brezplačnih. Nadgradi za odklep ostalih."}, {"key": "pron.paywall.unlockAllLessons", "text": "Odkleni vse lekcije"}, {"key": "pron.itemPracticeHint", "text": "Klikni element za vadbo z AI"}, {"key": "pron.practiceHint", "text": "Poslušaj, ponovi, posnami in primerjaj — trener pokaže, katere besede so bile jasno izgovorjene."}, {"key": "pron.drillsCount", "text": "{{count}} vaj"}, {"key": "pron.useInShadowing", "text": "Uporabi to veščino v senčenju"}, {"key": "pron.backToCoach", "text": "Nazaj na govornega trenerja"}, {"key": "pron.p.title", "text": "Vadba"}, {"key": "pron.p.step1.label", "text": "Poslušaj"}, {"key": "pron.p.step1.hint", "text": "Predvajaj vzorčni posnetek dvakrat."}, {"key": "pron.p.step2.label", "text": "Razumi"}, {"key": "pron.p.step2.hint", "text": "Preberi, kaj naj bi tvoja usta naredila."}, {"key": "pron.p.step3.label", "text": "Glej / uči se"}, {"key": "pron.p.step3.hint", "text": "Preveri vodnik za usta, jezik in vzorec."}, {"key": "pron.p.step4.label", "text": "Ponovi"}, {"key": "pron.p.step4.hint", "text": "Izgovori na glas s posnetkom, najprej počasi."}, {"key": "pron.p.step5.label", "text": "Posnami"}, {"key": "pron.p.step5.hint", "text": "Posnami se, ko izgovoriš isto vrstico."}, {"key": "pron.p.step6.label", "text": "AI povratna informacija"}, {"key": "pron.p.step6.hint", "text": "Poglej, kaj je trener slišal in kaj popraviti."}, {"key": "pron.p.step7.label", "text": "Poskusi znova"}, {"key": "pron.p.step7.hint", "text": "Popravi eno stvar in posnami še enkrat."}, {"key": "pron.p.step8.label", "text": "Osvojeno"}, {"key": "pron.p.step8.hint", "text": "Dvakrat zapored jasno prebrano — nadaljuj."}, {"key": "pron.p.stepTap", "text": "{{hint}} Dotakni se, ko to opraviš."}, {"key": "pron.p.focusSound", "text": "Ciljni glas {{sound}}"}, {"key": "pron.p.eg", "text": "npr. {{sentence}}"}, {"key": "pron.p.loading", "text": "Nalaganje…"}, {"key": "pron.p.speedNormal", "text": "Normalno"}, {"key": "pron.p.speedSlower", "text": "Počasneje"}, {"key": "pron.p.speedSlow", "text": "Počasi"}, {"key": "pron.p.loop", "text": "Zanka"}, {"key": "pron.p.stop", "text": "Ustavi"}, {"key": "pron.p.voiceNote", "text": "Vzorčni posnetek je Lingorin AI glas ameriške angleščine, ne človeški posnetek."}, {"key": "pron.p.listenSentence", "text": "Poslušaj predvaja glas dvakrat, nato primer besede, nato stavek, ki jo vsebuje."}, {"key": "pron.p.listenExample", "text": "Poslušaj predvaja glas dvakrat, nato primer."}, {"key": "pron.p.recordHint", "text": "Izgovori zgornjo vrstico enkrat, jasno."}, {"key": "pron.p.signupToRecord", "text": "Ustvari brezplačen račun za snemanje in povratne informacije."}, {"key": "pron.p.yourRecording", "text": "Tvoj posnetek"}, {"key": "pron.p.listeningRec", "text": "Poslušanje tvojega posnetka…"}, {"key": "pron.p.wordsClear", "text": "Jasno izgovorjene besede"}, {"key": "pron.p.wpm", "text": "Hitrost govora (bpm)"}, {"key": "pron.p.heard", "text": "Lingora je slišala"}, {"key": "pron.p.tagClear", "text": "Jasno"}, {"key": "pron.p.tagNeeds", "text": "Potrebno izboljšave"}, {"key": "pron.p.measured", "text": "Izmerjena izvedba"}, {"key": "pron.p.paceLabel", "text": "Tempo:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} besed na minuto ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Naravni pogovor je približno 120–160."}, {"key": "pron.p.pace.slow", "text": "počasen"}, {"key": "pron.p.pace.natural", "text": "naraven"}, {"key": "pron.p.pace.fast", "text": "hiter"}, {"key": "pron.p.fillersLabel", "text": "Mašila:"}, {"key": "pron.p.repeatedLabel", "text": "Ponovljene besede:"}, {"key": "pron.p.noneDetected", "text": "ni zaznanih"}, {"key": "pron.p.measuredNote", "text": "Tempo, mašila in ponavljanja se štejejo iz tvojega dejanskega prepisa in dolžine posnetka. Višina tona, glasnost in dolžina tihih premorov se ne merijo, zato intonacije in premorov ne ocenjujemo samodejno."}, {"key": "pron.p.mastered", "text": "Osvojeno — dva jasna poskusa"}, {"key": "pron.p.attempt", "text": "Poskus {{n}} — dva jasna branja zapored označita to vrstico kot osvojeno."}, {"key": "pron.p.toShadowing", "text": "Vadi to v resničnem govoru → Senčenje"}, {"key": "pron.p.toCoach", "text": "Uporabi z govornim trenerjem"}]
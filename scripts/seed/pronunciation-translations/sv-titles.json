ellt ja/nej: yep, nope, uh-huh"},{"key":"d0dc977b-e24c-46c3-a2a1-6a98544f014f|title","text":"'want a' (sak) eller 'want to' (handling)"},{"key":"6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|title","text":"wouldn't have → wouldn'ta"},{"key":"2856e155-9edf-4a4e-9b05-c66ea6dac7d1|title","text":"just 'cause, gonna need"},{"key":"233cf355-0eca-4443-9a49-65fb7f9946ac|title","text":"ain't — am not, is not, are not"},{"key":"dc20f314-54fe-4dbd-a7f9-1b8af815d3af|title","text":"gotcha — got you"},{"key":"83e44703-96d2-48c4-8303-0bc0b0bbb6ed|title","text":"musta, mighta — must have, might have"},{"key":"ae8c9220-fd86-4c54-a3d7-97ceb131af9a|title","text":"shouldn'ta, couldn'ta — negativa modala verb i dåtid"},{"key":"7c1b096d-60ed-4c34-b500-ab3afab592fa|title","text":"g-bortfall: doin', goin', talkin'"},{"key":"0269fc6d-11c6-4667-9e5f-34ff1033bcf6|title","text":"somethin', nothin', anythin'"},{"key":"cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|title","text":"'em — them"},{"key":"66b204c8-d0cb-4469-a82c-7416aa6f96b6|title","text":"'n' — and"},{"key":"74f83968-80ee-48d6-8255-ecd4ed9c9028|title","text":"fristående 'cause — because"},{"key":"f8740e37-88d7-4e64-a74d-762766ff4593|title","text":"'course — of course"},{"key":"a1c62d96-731e-4d96-803e-33f2cd732fc7|title","text":"aight — all right"},{"key":"fd275dbf-ca1f-489e-93aa-a7928df2aa76|title","text":"letcha — let you"},{"key":"9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|title","text":"jever — did you ever"},{"key":"82a1afdf-f024-41d9-bb83-15d15e39a5cf|title","text":"gonna hafta — going to have to"},{"key":"d7d2b06f-c8dd-444a-ba6e-638346e18810|title","text":"not gonna, wasn't gonna"},{"key":"b0c3028d-02d0-4b69-b6b0-310ed3468566|title","text":"innit — isn't it (brittiskt)"},{"key":"ddb8cc83-dc22-4690-8bab-748461e813e9|title","text":"whaddya say — what do you say"},{"key":"16f619b1-adfc-405e-a120-14925cf94795|title","text":"y'know — you know (utfyllnadsord)"},{"key":"3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|title","text":"s'up — what's up"},{"key":"6f674595-f
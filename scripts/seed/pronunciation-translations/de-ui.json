": "Sprich es laut mit dem Audio mit, zuerst langsam."}, {"key": "pron.p.step5.label", "text": "Aufnehmen"}, {"key": "pron.p.step5.hint", "text": "Nimm dich selbst auf, wie du dieselbe Zeile sagst."}, {"key": "pron.p.step6.label", "text": "KI-Feedback"}, {"key": "pron.p.step6.hint", "text": "Sieh, was der Coach gehört hat und was du verbessern kannst."}, {"key": "pron.p.step7.label", "text": "Nochmal versuchen"}, {"key": "pron.p.step7.hint", "text": "Verbessere eine Sache und nimm noch einmal auf."}, {"key": "pron.p.step8.label", "text": "Gemeistert"}, {"key": "pron.p.step8.hint", "text": "Zweimal hintereinander klar vorgelesen — weiter geht's."}, {"key": "pron.p.stepTap", "text": "{{hint}} Tippe, sobald du das erledigt hast."}, {"key": "pron.p.focusSound", "text": "Fokuslaut {{sound}}"}, {"key": "pron.p.eg", "text": "z. B. {{sentence}}"}, {"key": "pron.p.loading", "text": "Wird geladen…"}, {"key": "pron.p.speedNormal", "text": "Normal"}, {"key": "pron.p.speedSlower", "text": "Langsamer"}, {"key": "pron.p.speedSlow", "text": "Langsam"}, {"key": "pron.p.loop", "text": "Wiederholen"}, {"key": "pron.p.stop", "text": "Stopp"}, {"key": "pron.p.voiceNote", "text": "Das Modell-Audio ist Lingoras amerikanische Englisch-KI-Stimme, keine menschliche Aufnahme."}, {"key": "pron.p.listenSentence", "text": "Hören spielt den Laut zweimal ab, dann das Beispielwort, dann einen Satz damit."}, {"key": "pron.p.listenExample", "text": "Hören spielt den Laut zweimal ab, dann das Beispiel."}, {"key": "pron.p.recordHint", "text": "Sag die Zeile oben einmal klar."}, {"key": "pron.p.signupToRecord", "text": "Erstelle ein kostenloses Konto, um aufzunehmen und Feedback zu erhalten."}, {"key": "pron.p.yourRecording", "text": "Deine Aufnahme"}, {"key": "pron.p.listeningRec", "text": "Deine Aufnahme wird angehört…"}, {"key": "pron.p.wordsClear", "text": "Klar gesprochene Wörter"}, {"key": "pron.p.wpm", "text": "Sprechgeschwindigkeit (WPM)"}, {"key": "pron.p.heard", "text": "Lingora hat gehört"}, 
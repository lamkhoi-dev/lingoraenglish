[{"key": "pron.hero.title", "text": "Lyd klarere, mer naturlig, mer flytende"}, {"key": "pron.hero.description", "text": "Alle {{count}} engelske lydene pluss ordtrykk, setningstrykk, intonasjon, sammenhengende tale, reduksjoner, rytme, inndeling i fraser og flyt — hver leksjon avsluttes med din egen innspilling."}, {"key": "pron.imageAlt", "text": "Uttale, artikulasjon og IPA"}, {"key": "pron.progress.title", "text": "Din uttalefremgang"}, {"key": "pron.progress.descUser", "text": "Målt ut fra ordene coachen gjenkjente i dine egne innspillinger."}, {"key": "pron.progress.descGuest", "text": "Opprett en gratis konto for å ta opp deg selv og begynne å følge fremgangen."}, {"key": "pron.recommended", "text": "Anbefalt for deg"}, {"key": "pron.soundLabel", "text": "{{symbol}}-lyden"}, {"key": "pron.skill.sounds", "text": "Lyder"}, {"key": "pron.skill.sounds.blurb", "text": "Alle 44 engelske fonemer med minimale par."}, {"key": "pron.skill.wordStress", "text": "Ordtrykk"}, {"key": "pron.skill.wordStress.blurb", "text": "Stavelser, hovedtrykk og bitrykk."}, {"key": "pron.skill.sentenceStress", "text": "Setningstrykk"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Innholdsord sterke, funksjonsord svake."}, {"key": "pron.skill.intonation", "text": "Intonasjon"}, {"key": "pron.skill.intonation.blurb", "text": "Stigende, fallende, stigende-fallende og fallende-stigende."}, {"key": "pron.skill.connectedSpeech", "text": "Sammenhengende tale"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Sammenkobling, elisjon, assimilasjon, svake former."}, {"key": "pron.skill.reductions", "text": "Reduksjoner"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — uformell talt engelsk."}, {"key": "pron.skill.rhythm", "text": "Rytme"}, {"key": "pron.skill.rhythm.blurb", "text": "Trykkbaserte takter, timing og pauser."}, {"key": "pron.skill.chunking", "text": "Pausering og frasering"}, {"key": "pron.skill.chunking.blurb", "text": "Tankegrupper og naturlige pustepauser."}, {"key": "pron.skill.fluency", "text": "Flyt"}, {"key": "pron.skill.fluency.blurb", "text": "Tempo, nøling, fyllord og sammenkobling av ideer."}, {"key": "pron.filter.searchPlaceholder", "text": "Søk etter en lyd, et ord eller en leksjon"}, {"key": "pron.filter.allLevels", "text": "Alle nivåer"}, {"key": "pron.filter.beginner", "text": "Nybegynner"}, {"key": "pron.filter.intermediate", "text": "Viderekommen"}, {"key": "pron.filter.advanced", "text": "Avansert"}, {"key": "pron.filter.allDifficulties", "text": "Alle vanskelighetsgrader"}, {"key": "pron.filter.gentle", "text": "Rolig"}, {"key": "pron.filter.steady", "text": "Jevn"}, {"key": "pron.filter.challenging", "text": "Utfordrende"}, {"key": "pron.filter.us", "text": "Amerikansk engelsk"}, {"key": "pron.filter.uk", "text": "Britisk engelsk"}, {"key": "pron.sounds.title", "text": "De {{count}} engelske lydene"}, {"key": "pron.sounds.shown", "text": "{{count}} vist"}, {"key": "pron.lessons.title", "text": "Leksjoner i {{skill}}"}, {"key": "pron.lessons.none", "text": "Ingen leksjoner samsvarer med disse filtrene. Prøv «Alle nivåer» og «Alle vanskelighetsgrader»."}, {"key": "pron.how", "text": "Hvordan"}, {"key": "pron.commonMistakes", "text": "Vanlige feil"}, {"key": "pron.wordPractice", "text": "Ordøving"}, {"key": "pron.sentencePractice", "text": "Setningsøving"}, {"key": "pron.minimalPairs", "text": "Minimale par"}, {"key": "pron.practise", "text": "Øv"}, {"key": "pron.toast.signInModel", "text": "Logg inn for å høre AI-modellens lyd."}, {"key": "pron.toast.playError", "text": "Kunne ikke spille av lyd."}, {"key": "pron.voicedDesc", "text": "Stemt — stemmebåndene vibrerer"}, {"key": "pron.voicelessDesc", "text": "Ustemt — bare pust, ingen vibrasjon"}, {"key": "pron.soundPracticeHint", "text": "Trykk på «1. Lytt» i øvingskortet til høyre for å høre AI-modellen si denne lyden og et eksempel."}, {"key": "pron.paywall.soundLocked", "text": "Den fullstendige leksjonen for denne lyden — hvordan du lager den, munnstilling, eksempelord, setninger og minimale par — er en del av Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "De første {{count}} lydene er gratis. Oppgrader for å låse opp alle 44 lydene og personlig tilbakemelding fra coachen."}, {"key": "pron.paywall.unlockAllSounds", "text": "Lås opp alle 44 lydene"}, {"key": "pron.wordPracticeHint", "text": "Klikk på ordet for å høre AI og øve"}, {"key": "pron.eg", "text": "f.eks."}, {"key": "pron.playing", "text": "Spiller av"}, {"key": "pron.listen", "text": "Lytt"}, {"key": "pron.paywall.lessonLocked", "text": "Denne leksjonens forklaring, øvingspunkter og eksempler er en del av Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "De første {{count}} leksjonene i hver ferdighet er gratis. Oppgrader for å låse opp resten."}, {"key": "pron.paywall.unlockAllLessons", "text": "Lås opp alle leksjoner"}, {"key": "pron.itemPracticeHint", "text": "Klikk på elementet for å øve med AI"}, {"key": "pron.practiceHint", "text": "Lytt, gjenta, ta opp og sammenlign — coachen viser nøyaktig hvilke ord som ble tydelige."}, {"key": "pron.drillsCount", "text": "{{count}} øvelser"}, {"key": "pron.useInShadowing", "text": "Bruk denne ferdigheten i Shadowing"}, {"key": "pron.backToCoach", "text": "Tilbake til tale-coachen"}, {"key": "pron.p.title", "text": "Øv"}, {"key": "pron.p.step1.label", "text": "Lytt"}, {"key": "pron.p.step1.hint", "text": "Spill av modell-lyden to ganger."}, {"key": "pron.p.step2.label", "text": "Forstå"}, {"key": "pron.p.step2.hint", "text": "Les hva munnen din skal gjøre."}, {"key": "pron.p.step3.label", "text": "Se / lær"}, {"key": "pron.p.step3.hint", "text": "Sjekk guiden for munn, tunge og mønster."}, {"key": "pron.p.step4.label", "text": "Gjenta"}, {"key": "pron.p.step4.hint", "text": "Si det høyt sammen med lyden, sakte først."}, {"key": "pron.p.step5.label", "text": "Ta opp"}, {"key": "pron.p.step5.hint", "text": "Ta opp deg selv mens du sier den samme linjen."}, {"key": "pron.p.step6.label", "text": "AI-tilbakemelding"}, {"key": "pron.p.step6.hint", "text": "Se hva coachen hørte og hva du bør fikse."}, {"key": "pron.p.step7.label", "text": "Prøv igjen"}, {"key": "pron.p.step7.hint", "text": "Fiks én ting og ta opp en gang til."}, {"key": "pron.p.step8.label", "text": "Mestret"}, {"key": "pron.p.step8.hint", "text": "Tydelig opplesing to ganger på rad — gå videre."}, {"key": "pron.p.stepTap", "text": "{{hint}} Trykk når du har gjort dette."}, {"key": "pron.p.focusSound", "text": "Fokuslyd {{sound}}"}, {"key": "pron.p.eg", "text": "f.eks. {{sentence}}"}, {"key": "pron.p.loading", "text": "Laster …"}, {"key": "pron.p.speedNormal", "text": "Normal"}, {"key": "pron.p.speedSlower", "text": "Saktere"}, {"key": "pron.p.speedSlow", "text": "Sakte"}, {"key": "pron.p.loop", "text": "Gjenta"}, {"key": "pron.p.stop", "text": "Stopp"}, {"key": "pron.p.voiceNote", "text": "Modell-lyden er Lingoras amerikansk-engelske AI-stemme, ikke en menneskelig innspilling."}, {"key": "pron.p.listenSentence", "text": "Lytt spiller av lyden to ganger, deretter eksempelordet, så en setning som inneholder det."}, {"key": "pron.p.listenExample", "text": "Lytt spiller av lyden to ganger, deretter eksempelet."}, {"key": "pron.p.recordHint", "text": "Si linjen ovenfor én gang, tydelig."}, {"key": "pron.p.signupToRecord", "text": "Opprett en gratis konto for å ta opp og få tilbakemelding."}, {"key": "pron.p.yourRecording", "text": "Opptaket ditt"}, {"key": "pron.p.listeningRec", "text": "Lytter til opptaket ditt …"}, {"key": "pron.p.wordsClear", "text": "Ord sagt tydelig"}, {"key": "pron.p.wpm", "text": "Taletempo (ord per minutt)"}, {"key": "pron.p.heard", "text": "Lingora hørte"}, {"key": "pron.p.tagClear", "text": "Tydelig"}, {"key": "pron.p.tagNeeds", "text": "Bør forbedres"}, {"key": "pron.p.measured", "text": "Målt fremføring"}, {"key": "pron.p.paceLabel", "text": "Tempo:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} ord per minutt ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Naturlig samtale er rundt 120–160."}, {"key": "pron.p.pace.slow", "text": "sakte"}, {"key": "pron.p.pace.natural", "text": "naturlig"}, {"key": "pron.p.pace.fast", "text": "raskt"}, {"key": "pron.p.fillersLabel", "text": "Fyllord:"}, {"key": "pron.p.repeatedLabel", "text": "Gjentatte ord:"}, {"key": "pron.p.noneDetected", "text": "ingen funnet"}, {"key": "pron.p.measuredNote", "text": "Tempo, fyllord og gjentakelser telles fra din faktiske transkripsjon og opptakets lengde. Tonehøyde, lydstyrke og lengde på stille pauser måles ikke, så vi vurderer ikke intonasjon eller pauser automatisk."}, {"key": "pron.p.mastered", "text": "Mestret — to tydelige forsøk"}, {"key": "pron.p.attempt", "text": "Forsøk {{n}} — to tydelige opplesinger på rad markerer denne linjen som mestret."}, {"key": "pron.p.toShadowing", "text": "Øv på dette i virkelig tale → Shadowing"}, {"key": "pron.p.toCoach", "text": "Bruk det med tale-coachen"}]
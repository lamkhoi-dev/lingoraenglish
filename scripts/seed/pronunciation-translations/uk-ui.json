[{"key": "pron.hero.title", "text": "Говоріть чіткіше, природніше, вільніше"}, {"key": "pron.hero.description", "text": "Усі {{count}} звуків англійської, а також наголос у словах, наголос у реченнях, інтонація, зв'язне мовлення, редукції, ритм, поділ на фрази та швидкість — кожен урок завершується вашим власним записом."}, {"key": "pron.imageAlt", "text": "Вимова, артикуляція та МФА"}, {"key": "pron.progress.title", "text": "Ваш прогрес у вимові"}, {"key": "pron.progress.descUser", "text": "Вимірюється за словами, які тренер розпізнав у ваших власних записах."}, {"key": "pron.progress.descGuest", "text": "Створіть безкоштовний акаунт, щоб записувати себе та відстежувати прогрес."}, {"key": "pron.recommended", "text": "Рекомендовано для вас"}, {"key": "pron.soundLabel", "text": "Звук {{symbol}}"}, {"key": "pron.skill.sounds", "text": "Звуки"}, {"key": "pron.skill.sounds.blurb", "text": "Усі 44 фонеми англійської з мінімальними парами."}, {"key": "pron.skill.wordStress", "text": "Наголос у словах"}, {"key": "pron.skill.wordStress.blurb", "text": "Склади, головний і другорядний наголос."}, {"key": "pron.skill.sentenceStress", "text": "Наголос у реченнях"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Повнозначні слова — сильні, службові — слабкі."}, {"key": "pron.skill.intonation", "text": "Інтонація"}, {"key": "pron.skill.intonation.blurb", "text": "Висхідна, низхідна, висхідно-низхідна та низхідно-висхідна."}, {"key": "pron.skill.connectedSpeech", "text": "Зв'язне мовлення"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Злиття, елізія, асиміляція, слабкі форми."}, {"key": "pron.skill.reductions", "text": "Редукції"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — неформальне розмовне мовлення."}, {"key": "pron.skill.rhythm", "text": "Ритм"}, {"key": "pron.skill.rhythm.blurb", "text": "Наголошений такт, темп і паузи."}, {"key": "pron.skill.chunking", "text": "Паузи та поділ на фрази"}, {"key": "pron.skill.chunking.blurb", "text": "Смислові групи та природні паузи для дихання."}, {"key": "pron.skill.fluency", "text": "Швидкість мовлення"}, {"key": "pron.skill.fluency.blurb", "text": "Темп, вагання, слова-заповнювачі та зв'язування думок."}, {"key": "pron.filter.searchPlaceholder", "text": "Пошук звуку, слова або уроку"}, {"key": "pron.filter.allLevels", "text": "Усі рівні"}, {"key": "pron.filter.beginner", "text": "Початковий"}, {"key": "pron.filter.intermediate", "text": "Середній"}, {"key": "pron.filter.advanced", "text": "Просунутий"}, {"key": "pron.filter.allDifficulties", "text": "Усі складності"}, {"key": "pron.filter.gentle", "text": "Легка"}, {"key": "pron.filter.steady", "text": "Помірна"}, {"key": "pron.filter.challenging", "text": "Складна"}, {"key": "pron.filter.us", "text": "Американська англійська"}, {"key": "pron.filter.uk", "text": "Британська англійська"}, {"key": "pron.sounds.title", "text": "{{count}} звуків англійської"}, {"key": "pron.sounds.shown", "text": "Показано {{count}}"}, {"key": "pron.lessons.title", "text": "Уроки: {{skill}}"}, {"key": "pron.lessons.none", "text": "Жоден урок не відповідає цим фільтрам. Спробуйте «Усі рівні» та «Усі складності»."}, {"key": "pron.how", "text": "Як"}, {"key": "pron.commonMistakes", "text": "Типові помилки"}, {"key": "pron.wordPractice", "text": "Практика слів"}, {"key": "pron.sentencePractice", "text": "Практика речень"}, {"key": "pron.minimalPairs", "text": "Мінімальні пари"}, {"key": "pron.practise", "text": "Практикувати"}, {"key": "pron.toast.signInModel", "text": "Увійдіть, щоб почути зразок ШІ."}, {"key": "pron.toast.playError", "text": "Не вдалося відтворити аудіо."}, {"key": "pron.voicedDesc", "text": "Дзвінкий — голосові зв'язки вібрують"}, {"key": "pron.voicelessDesc", "text": "Глухий — лише видих, без вібрації"}, {"key": "pron.soundPracticeHint", "text": "Натисніть «1. Слухати» на картці практики праворуч, щоб почути, як ШІ вимовляє цей звук і приклад."}, {"key": "pron.paywall.soundLocked", "text": "Повний урок цього звуку — як його вимовляти, положення рота, приклади слів, речення та мінімальні пари — є частиною Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "Перші {{count}} звуків безкоштовні. Оновіть план, щоб відкрити всі 44 звуки та персоналізований зворотний зв'язок від тренера."}, {"key": "pron.paywall.unlockAllSounds", "text": "Відкрити всі 44 звуки"}, {"key": "pron.wordPracticeHint", "text": "Натисніть на слово, щоб почути ШІ та потренуватися"}, {"key": "pron.eg", "text": "напр."}, {"key": "pron.playing", "text": "Відтворення"}, {"key": "pron.listen", "text": "Слухати"}, {"key": "pron.paywall.lessonLocked", "text": "Пояснення, практичні поради та приклади цього уроку є частиною Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "Перші {{count}} уроків кожної навички безкоштовні. Оновіть план, щоб відкрити решту."}, {"key": "pron.paywall.unlockAllLessons", "text": "Відкрити всі уроки"}, {"key": "pron.itemPracticeHint", "text": "Натисніть на елемент, щоб потренуватися зі ШІ"}, {"key": "pron.practiceHint", "text": "Слухайте, повторюйте, записуйте та порівнюйте — тренер показує, які саме слова прозвучали чітко."}, {"key": "pron.drillsCount", "text": "{{count}} вправ"}, {"key": "pron.useInShadowing", "text": "Використати цю навичку в Shadowing"}, {"key": "pron.backToCoach", "text": "Назад до розмовного тренера"}, {"key": "pron.p.title", "text": "Практика"}, {"key": "pron.p.step1.label", "text": "Слухайте"}, {"key": "pron.p.step1.hint", "text": "Прослухайте зразок аудіо двічі."}, {"key": "pron.p.step2.label", "text": "Зрозумійте"}, {"key": "pron.p.step2.hint", "text": "Прочитайте, що має робити ваш рот."}, {"key": "pron.p.step3.label", "text": "Дивіться / вчіться"}, {"key": "pron.p.step3.hint", "text": "Перегляньте посібник із положення рота, язика та артикуляції."}, {"key": "pron.p.step4.label", "text": "Повторюйте"}, {"key": "pron.p.step4.hint", "text": "Промовляйте вголос разом з аудіо, спочатку повільно."}, {"key": "pron.p.step5.label", "text": "Записуйте"}, {"key": "pron.p.step5.hint", "text": "Запишіть себе, промовляючи ту саму фразу."}, {"key": "pron.p.step6.label", "text": "Відгук ШІ"}, {"key": "pron.p.step6.hint", "text": "Подивіться, що почув тренер і що потрібно виправити."}, {"key": "pron.p.step7.label", "text": "Спробуйте ще"}, {"key": "pron.p.step7.hint", "text": "Виправте одну річ і запишіть ще раз."}, {"key": "pron.p.step8.label", "text": "Засвоєно"}, {"key": "pron.p.step8.hint", "text": "Двічі поспіль чітко прочитано — переходьте далі."}, {"key": "pron.p.stepTap", "text": "{{hint}} Натисніть, коли виконаєте."}, {"key": "pron.p.focusSound", "text": "Цільовий звук {{sound}}"}, {"key": "pron.p.eg", "text": "напр. {{sentence}}"}, {"key": "pron.p.loading", "text": "Завантаження…"}, {"key": "pron.p.speedNormal", "text": "Звичайна"}, {"key": "pron.p.speedSlower", "text": "Повільніше"}, {"key": "pron.p.speedSlow", "text": "Повільно"}, {"key": "pron.p.loop", "text": "Повтор"}, {"key": "pron.p.stop", "text": "Стоп"}, {"key": "pron.p.voiceNote", "text": "Зразок аудіо — це американський англійський ШІ-голос Lingora, а не запис людини."}, {"key": "pron.p.listenSentence", "text": "Слухати відтворює звук двічі, потім приклад слова, а потім речення з ним."}, {"key": "pron.p.listenExample", "text": "Слухати відтворює звук двічі, потім приклад."}, {"key": "pron.p.recordHint", "text": "Промовте фразу вище один раз, чітко."}, {"key": "pron.p.signupToRecord", "text": "Створіть безкоштовний акаунт, щоб записувати та отримувати відгуки."}, {"key": "pron.p.yourRecording", "text": "Ваш запис"}, {"key": "pron.p.listeningRec", "text": "Прослуховуємо ваш запис…"}, {"key": "pron.p.wordsClear", "text": "Слова, сказані чітко"}, {"key": "pron.p.wpm", "text": "Швидкість мовлення (слів/хв)"}, {"key": "pron.p.heard", "text": "Lingora почула"}, {"key": "pron.p.tagClear", "text": "Чітко"}, {"key": "pron.p.tagNeeds", "text": "Потребує покращення"}, {"key": "pron.p.measured", "text": "Виміряна вимова"}, {"key": "pron.p.paceLabel", "text": "Темп:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} слів за хвилину ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Природна розмова — близько 120–160."}, {"key": "pron.p.pace.slow", "text": "повільний"}, {"key": "pron.p.pace.natural", "text": "природний"}, {"key": "pron.p.pace.fast", "text": "швидкий"}, {"key": "pron.p.fillersLabel", "text": "Слова-заповнювачі:"}, {"key": "pron.p.repeatedLabel", "text": "Повторені слова:"}, {"key": "pron.p.noneDetected", "text": "не виявлено"}, {"key": "pron.p.measuredNote", "text": "Темп, слова-заповнювачі та повторення рахуються з вашого реального транскрипту й тривалості запису. Висота тону, гучність і тривалість пауз не вимірюються, тому ми не оцінюємо інтонацію чи паузи автоматично."}, {"key": "pron.p.mastered", "text": "Засвоєно — дві чіткі спроби"}, {"key": "pron.p.attempt", "text": "Спроба {{n}} — дві чіткі вимови поспіль позначають цю фразу як засвоєну."}, {"key": "pron.p.toShadowing", "text": "Потренуйте це в реальному мовленні → Shadowing"}, {"key": "pron.p.toCoach", "text": "Використайте це з розмовним тренером"}]
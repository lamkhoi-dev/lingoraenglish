[{"key": "pron.hero.title", "text": "स्पष्ट, स्वाभाविक और प्रवाहपूर्ण बोलें"}, {"key": "pron.hero.description", "text": "सभी {{count}} अंग्रेज़ी ध्वनियाँ, साथ में शब्द बल, वाक्य बल, स्वर-उतार-चढ़ाव, जुड़ी हुई वाणी, संक्षेपण, लय, खंडन और प्रवाह — हर पाठ आपकी अपनी रिकॉर्डिंग के साथ समाप्त होता है।"}, {"key": "pron.imageAlt", "text": "उच्चारण अभिव्यक्ति और IPA"}, {"key": "pron.progress.title", "text": "आपकी उच्चारण प्रगति"}, {"key": "pron.progress.descUser", "text": "कोच द्वारा आपकी रिकॉर्डिंग में पहचाने गए शब्दों से मापा गया।"}, {"key": "pron.progress.descGuest", "text": "अपनी रिकॉर्डिंग करने और प्रगति ट्रैक करने के लिए मुफ़्त खाता बनाएँ।"}, {"key": "pron.recommended", "text": "आपके लिए अनुशंसित"}, {"key": "pron.soundLabel", "text": "{{symbol}} ध्वनि"}, {"key": "pron.skill.sounds", "text": "ध्वनियाँ"}, {"key": "pron.skill.sounds.blurb", "text": "न्यूनतम युग्मों के साथ सभी 44 अंग्रेज़ी स्वनिम।"}, {"key": "pron.skill.wordStress", "text": "शब्द बल"}, {"key": "pron.skill.wordStress.blurb", "text": "अक्षर, प्राथमिक और द्वितीयक बल।"}, {"key": "pron.skill.sentenceStress", "text": "वाक्य बल"}, {"key": "pron.skill.sentenceStress.blurb", "text": "सार्थक शब्द प्रबल, सहायक शब्द दुर्बल।"}, {"key": "pron.skill.intonation", "text": "स्वर-उतार-चढ़ाव"}, {"key": "pron.skill.intonation.blurb", "text": "चढ़ता, गिरता, चढ़ता-गिरता और गिरता-चढ़ता।"}, {"key": "pron.skill.connectedSpeech", "text": "जुड़ी हुई वाणी"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "जोड़ना, लोप, समीकरण, दुर्बल रूप।"}, {"key": "pron.skill.reductions", "text": "संक्षेपण"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — अनौपचारिक बोलचाल की अंग्रेज़ी।"}, {"key": "pron.skill.rhythm", "text": "लय"}, {"key": "pron.skill.rhythm.blurb", "text": "बल-आधारित ताल, समय और विराम।"}, {"key": "pron.skill.chunking", "text": "विराम और खंडन"}, {"key": "pron.skill.chunking.blurb", "text": "विचार-समूह और स्वाभाविक श्वास विराम।"}, {"key": "pron.skill.fluency", "text": "प्रवाह"}, {"key": "pron.skill.fluency.blurb", "text": "गति, झिझक, भराव शब्द और विचार जोड़ना।"}, {"key": "pron.filter.searchPlaceholder", "text": "ध्वनि, शब्द या पाठ खोजें"}, {"key": "pron.filter.allLevels", "text": "सभी स्तर"}, {"key": "pron.filter.beginner", "text": "शुरुआती"}, {"key": "pron.filter.intermediate", "text": "मध्यम"}, {"key": "pron.filter.advanced", "text": "उन्नत"}, {"key": "pron.filter.allDifficulties", "text": "सभी कठिनाइयाँ"}, {"key": "pron.filter.gentle", "text": "सरल"}, {"key": "pron.filter.steady", "text": "संतुलित"}, {"key": "pron.filter.challenging", "text": "चुनौतीपूर्ण"}, {"key": "pron.filter.us", "text": "अमेरिकी अंग्रेज़ी"}, {"key": "pron.filter.uk", "text": "ब्रिटिश अंग्रेज़ी"}, {"key": "pron.sounds.title", "text": "{{count}} अंग्रेज़ी ध्वनियाँ"}, {"key": "pron.sounds.shown", "text": "{{count}} दिखाई गईं"}, {"key": "pron.lessons.title", "text": "{{skill}} पाठ"}, {"key": "pron.lessons.none", "text": "इन फ़िल्टरों से कोई पाठ मेल नहीं खाता। \"सभी स्तर\" और \"कोई भी कठिनाई\" आज़माएँ।"}, {"key": "pron.how", "text": "कैसे"}, {"key": "pron.commonMistakes", "text": "सामान्य गलतियाँ"}, {"key": "pron.wordPractice", "text": "शब्द अभ्यास"}, {"key": "pron.sentencePractice", "text": "वाक्य अभ्यास"}, {"key": "pron.minimalPairs", "text": "न्यूनतम युग्म"}, {"key": "pron.practise", "text": "अभ्यास करें"}, {"key": "pron.toast.signInModel", "text": "AI मॉडल की ध्वनि सुनने के लिए साइन इन करें।"}, {"key": "pron.toast.playError", "text": "ऑडियो चलाया नहीं जा सका।"}, {"key": "pron.voicedDesc", "text": "सघोष — आपके स्वर-तंतु कंपन करते हैं"}, {"key": "pron.voicelessDesc", "text": "अघोष — केवल श्वास, कोई कंपन नहीं"}, {"key": "pron.soundPracticeHint", "text": "इस ध्वनि और एक उदाहरण के लिए AI मॉडल सुनने हेतु दाईं ओर अभ्यास कार्ड में \"1. सुनें\" पर टैप करें।"}, {"key": "pron.paywall.soundLocked", "text": "इस ध्वनि का पूरा पाठ — इसे कैसे बनाएँ, मुँह की स्थिति, उदाहरण शब्द, वाक्य और न्यूनतम युग्म — Lingora English Premium का हिस्सा है।"}, {"key": "pron.paywall.freeLimit", "text": "पहली {{count}} ध्वनियाँ मुफ़्त हैं। सभी 44 ध्वनियाँ और व्यक्तिगत कोच प्रतिक्रिया अनलॉक करने के लिए अपग्रेड करें।"}, {"key": "pron.paywall.unlockAllSounds", "text": "सभी 44 ध्वनियाँ अनलॉक करें"}, {"key": "pron.wordPracticeHint", "text": "AI सुनने और अभ्यास के लिए शब्द पर क्लिक करें"}, {"key": "pron.eg", "text": "जैसे"}, {"key": "pron.playing", "text": "चल रहा है"}, {"key": "pron.listen", "text": "सुनें"}, {"key": "pron.paywall.lessonLocked", "text": "इस पाठ की व्याख्या, अभ्यास बिंदु और उदाहरण Lingora English Premium का हिस्सा हैं।"}, {"key": "pron.paywall.lessonFreeLimit", "text": "हर स्किल के पहले {{count}} पाठ मुफ़्त हैं। बाकी अनलॉक करने के लिए अपग्रेड करें।"}, {"key": "pron.paywall.unlockAllLessons", "text": "सभी पाठ अनलॉक करें"}, {"key": "pron.itemPracticeHint", "text": "AI के साथ अभ्यास करने के लिए आइटम पर क्लिक करें"}, {"key": "pron.practiceHint", "text": "सुनें, दोहराएँ, रिकॉर्ड करें और तुलना करें — कोच बताता है कि कौन से शब्द स्पष्ट आए।"}, {"key": "pron.drillsCount", "text": "{{count}} ड्रिल"}, {"key": "pron.useInShadowing", "text": "इस स्किल का Shadowing में उपयोग करें"}, {"key": "pron.backToCoach", "text": "Speaking Coach पर वापस जाएँ"}, {"key": "pron.p.title", "text": "अभ्यास"}, {"key": "pron.p.step1.label", "text": "सुनें"}, {"key": "pron.p.step1.hint", "text": "मॉडल ऑडियो दो बार चलाएँ।"}, {"key": "pron.p.step2.label", "text": "समझें"}, {"key": "pron.p.step2.hint", "text": "पढ़ें कि आपके मुँह को क्या करना चाहिए।"}, {"key": "pron.p.step3.label", "text": "देखें / सीखें"}, {"key": "pron.p.step3.hint", "text": "मुँह, जीभ और पैटर्न गाइड देखें।"}, {"key": "pron.p.step4.label", "text": "दोहराएँ"}, {"key": "pron.p.step4.hint", "text": "ऑडियो के साथ ज़ोर से बोलें, पहले धीरे।"}, {"key": "pron.p.step5.label", "text": "रिकॉर्ड करें"}, {"key": "pron.p.step5.hint", "text": "वही लाइन बोलकर खुद को रिकॉर्ड करें।"}, {"key": "pron.p.step6.label", "text": "AI फ़ीडबैक"}, {"key": "pron.p.step6.hint", "text": "देखें कि कोच ने क्या सुना और क्या सुधारना है।"}, {"key": "pron.p.step7.label", "text": "फिर कोशिश करें"}, {"key": "pron.p.step7.hint", "text": "एक चीज़ सुधारें और एक बार फिर रिकॉर्ड करें।"}, {"key": "pron.p.step8.label", "text": "महारत हासिल"}, {"key": "pron.p.step8.hint", "text": "लगातार दो बार स्पष्ट पढ़ें — आगे बढ़ें।"}, {"key": "pron.p.stepTap", "text": "{{hint}} यह कर लेने पर टैप करें।"}, {"key": "pron.p.focusSound", "text": "फ़ोकस ध्वनि {{sound}}"}, {"key": "pron.p.eg", "text": "जैसे {{sentence}}"}, {"key": "pron.p.loading", "text": "लोड हो रहा है…"}, {"key": "pron.p.speedNormal", "text": "सामान्य"}, {"key": "pron.p.speedSlower", "text": "धीमा"}, {"key": "pron.p.speedSlow", "text": "बहुत धीमा"}, {"key": "pron.p.loop", "text": "लूप"}, {"key": "pron.p.stop", "text": "रोकें"}, {"key": "pron.p.voiceNote", "text": "मॉडल ऑडियो Lingora की अमेरिकी अंग्रेज़ी AI आवाज़ है, मानव रिकॉर्डिंग नहीं।"}, {"key": "pron.p.listenSentence", "text": "सुनें ध्वनि को दो बार चलाता है, फिर उदाहरण शब्द, फिर उसे शामिल करने वाला वाक्य।"}, {"key": "pron.p.listenExample", "text": "सुनें ध्वनि को दो बार चलाता है, फिर उदाहरण।"}, {"key": "pron.p.recordHint", "text": "ऊपर की लाइन एक बार स्पष्ट बोलें।"}, {"key": "pron.p.signupToRecord", "text": "रिकॉर्ड करने और फ़ीडबैक पाने के लिए मुफ़्त खाता बनाएँ।"}, {"key": "pron.p.yourRecording", "text": "आपकी रिकॉर्डिंग"}, {"key": "pron.p.listeningRec", "text": "आपकी रिकॉर्डिंग सुनी जा रही है…"}, {"key": "pron.p.wordsClear", "text": "स्पष्ट बोले गए शब्द"}, {"key": "pron.p.wpm", "text": "बोलने की गति (wpm)"}, {"key": "pron.p.heard", "text": "Lingora ने सुना"}, {"key": "pron.p.tagClear", "text": "स्पष्ट"}, {"key": "pron.p.tagNeeds", "text": "सुधार चाहिए"}, {"key": "pron.p.measured", "text": "मापी गई प्रस्तुति"}, {"key": "pron.p.paceLabel", "text": "गति:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} शब्द प्रति मिनट ({{pace}})"}, {"key": "pron.p.paceNote", "text": "स्वाभाविक बातचीत लगभग 120–160 होती है।"}, {"key": "pron.p.pace.slow", "text": "धीमी"}, {"key": "pron.p.pace.natural", "text": "स्वाभाविक"}, {"key": "pron.p.pace.fast", "text": "तेज़"}, {"key": "pron.p.fillersLabel", "text": "भरने वाले शब्द:"}, {"key": "pron.p.repeatedLabel", "text": "दोहराए गए शब्द:"}, {"key": "pron.p.noneDetected", "text": "कोई नहीं मिला"}, {"key": "pron.p.measuredNote", "text": "गति, भरने वाले शब्द और पुनरावृत्ति आपकी वास्तविक ट्रांसक्रिप्ट और रिकॉर्डिंग अवधि से गिने जाते हैं। पिच, आवाज़ की तेज़ी और मौन-विराम की अवधि नहीं मापी जाती, इसलिए हम इंटोनेशन या विराम को स्वतः स्कोर नहीं करते।"}, {"key": "pron.p.mastered", "text": "महारत हासिल — दो स्पष्ट प्रयास"}, {"key": "pron.p.attempt", "text": "प्रयास {{n}} — लगातार दो स्पष्ट रीड-बैक इस लाइन को महारत हासिल के रूप में चिह्नित करते हैं।"}, {"key": "pron.p.toShadowing", "text": "इसका असली बोली में अभ्यास करें → Shadowing"}, {"key": "pron.p.toCoach", "text": "इसे Speaking Coach के साथ उपयोग करें"}]
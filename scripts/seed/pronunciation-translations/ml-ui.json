[{"key": "pron.hero.title", "text": "കൂടുതൽ വ്യക്തവും സ്വാഭാവികവും ഒഴുക്കുള്ളതുമായ ഉച്ചാരണം"}, {"key": "pron.hero.description", "text": "എല്ലാ {{count}} ഇംഗ്ലീഷ് ശബ്ദങ്ങളും കൂടാതെ വാക്ക് സ്ട്രെസ്, വാക്യ സ്ട്രെസ്, സ്വരഭേദം, ബന്ധിപ്പിച്ച സംസാരം, ചുരുക്കങ്ങൾ, താളം, ചങ്കിംഗ്, ഒഴുക്ക് — ഓരോ പാഠവും നിങ്ങളുടെ സ്വന്തം റെക്കോർഡിംഗോടെ അവസാനിക്കുന്നു."}, {"key": "pron.imageAlt", "text": "ഉച്ചാരണവും IPA-യും"}, {"key": "pron.progress.title", "text": "നിങ്ങളുടെ ഉച്ചാരണ പുരോഗതി"}, {"key": "pron.progress.descUser", "text": "നിങ്ങളുടെ സ്വന്തം റെക്കോർഡിംഗുകളിൽ കോച്ച് തിരിച്ചറിഞ്ഞ വാക്കുകളിൽ നിന്ന് അളക്കുന്നു."}, {"key": "pron.progress.descGuest", "text": "സ്വയം റെക്കോർഡ് ചെയ്യാനും പുരോഗതി ട്രാക്ക് ചെയ്യാനും ഒരു സൗജന്യ അക്കൗണ്ട് സൃഷ്ടിക്കുക."}, {"key": "pron.recommended", "text": "നിങ്ങൾക്കായി ശുപാർശ ചെയ്യുന്നത്"}, {"key": "pron.soundLabel", "text": "{{symbol}} ശബ്ദം"}, {"key": "pron.skill.sounds", "text": "ശബ്ദങ്ങൾ"}, {"key": "pron.skill.sounds.blurb", "text": "44 ഇംഗ്ലീഷ് ഫോണീമുകളും മിനിമൽ പെയറുകളും."}, {"key": "pron.skill.wordStress", "text": "വാക്ക് സ്ട്രെസ്"}, {"key": "pron.skill.wordStress.blurb", "text": "അക്ഷരങ്ങൾ, പ്രധാന, ദ്വിതീയ സ്ട്രെസ്."}, {"key": "pron.skill.sentenceStress", "text": "വാക്യ സ്ട്രെസ്"}, {"key": "pron.skill.sentenceStress.blurb", "text": "ഉള്ളടക്ക വാക്കുകൾ ശക്തം, ഫങ്ഷൻ വാക്കുകൾ ദുർബലം."}, {"key": "pron.skill.intonation", "text": "സ്വരഭേദം"}, {"key": "pron.skill.intonation.blurb", "text": "ഉയരുന്ന, താഴുന്ന, ഉയർന്ന്-താഴുന്ന, താഴ്ന്ന്-ഉയരുന്ന."}, {"key": "pron.skill.connectedSpeech", "text": "ബന്ധിപ്പിച്ച സംസാരം"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "ലിങ്കിംഗ്, എലിഷൻ, അസിമിലേഷൻ, ദുർബല രൂപങ്ങൾ."}, {"key": "pron.skill.reductions", "text": "ചുരുക്കങ്ങൾ"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — അനൗപചാരിക സംസാര ഇംഗ്ലീഷ്."}, {"key": "pron.skill.rhythm", "text": "താളം"}, {"key": "pron.skill.rhythm.blurb", "text": "സ്ട്രെസ്-ടൈംഡ് ബീറ്റുകൾ, സമയം, ഇടവേളകൾ."}, {"key": "pron.skill.chunking", "text": "നിർത്തലും ചങ്കിംഗും"}, {"key": "pron.skill.chunking.blurb", "text": "ചിന്താ ഗ്രൂപ്പുകളും സ്വാഭാവിക ശ്വാസ ഇടവേളകളും."}, {"key": "pron.skill.fluency", "text": "ഒഴുക്ക്"}, {"key": "pron.skill.fluency.blurb", "text": "വേഗത, സംശയം, ഫില്ലറുകൾ, ആശയങ്ങൾ ബന്ധിപ്പിക്കൽ."}, {"key": "pron.filter.searchPlaceholder", "text": "ഒരു ശബ്ദം, വാക്ക് അല്ലെങ്കിൽ പാഠം തിരയുക"}, {"key": "pron.filter.allLevels", "text": "എല്ലാ നിലകളും"}, {"key": "pron.filter.beginner", "text": "തുടക്കക്കാരൻ"}, {"key": "pron.filter.intermediate", "text": "ഇടത്തരം"}, {"key": "pron.filter.advanced", "text": "വിദഗ്ധൻ"}, {"key": "pron.filter.allDifficulties", "text": "എല്ലാ ബുദ്ധിമുട്ടുകളും"}, {"key": "pron.filter.gentle", "text": "മൃദുവായ"}, {"key": "pron.filter.steady", "text": "സ്ഥിരമായ"}, {"key": "pron.filter.challenging", "text": "വെല്ലുവിളിക്കുന്ന"}, {"key": "pron.filter.us", "text": "US ഇംഗ്ലീഷ്"}, {"key": "pron.filter.uk", "text": "UK ഇംഗ്ലീഷ്"}, {"key": "pron.sounds.title", "text": "{{count}} ഇംഗ്ലീഷ് ശബ്ദങ്ങൾ"}, {"key": "pron.sounds.shown", "text": "{{count}} കാണിച്ചിരിക്കുന്നു"}, {"key": "pron.lessons.title", "text": "{{skill}} പാഠങ്ങൾ"}, {"key": "pron.lessons.none", "text": "ഈ ഫിൽട്ടറുകളുമായി പൊരുത്തപ്പെടുന്ന പാഠമില്ല. \"എല്ലാ നിലകളും\", \"ഏത് ബുദ്ധിമുട്ടും\" പരീക്ഷിക്കുക."}, {"key": "pron.how", "text": "എങ്ങനെ"}, {"key": "pron.commonMistakes", "text": "സാധാരണ തെറ്റുകൾ"}, {"key": "pron.wordPractice", "text": "വാക്ക് പരിശീലനം"}, {"key": "pron.sentencePractice", "text": "വാക്യ പരിശീലനം"}, {"key": "pron.minimalPairs", "text": "മിനിമൽ പെയറുകൾ"}, {"key": "pron.practise", "text": "പരിശീലിക്കുക"}, {"key": "pron.toast.signInModel", "text": "AI മോഡൽ ശബ്ദം കേൾക്കാൻ സൈൻ ഇൻ ചെയ്യുക."}, {"key": "pron.toast.playError", "text": "ഓഡിയോ പ്ലേ ചെയ്യാനായില്ല."}, {"key": "pron.voicedDesc", "text": "വോയ്സ്ഡ് — നിങ്ങളുടെ വോക്കൽ കോർഡുകൾ കമ്പനം ചെയ്യുന്നു"}, {"key": "pron.voicelessDesc", "text": "വോയ്സ്ലെസ് — ശ്വാസം മാത്രം, കമ്പനമില്ല"}, {"key": "pron.soundPracticeHint", "text": "ഈ ശബ്ദവും ഒരു ഉദാഹരണവും AI മോഡൽ കേൾക്കാൻ വലതുവശത്തുള്ള പ്രാക്ടീസ് കാർഡിലെ \"1. കേൾക്കുക\" ടാപ്പ് ചെയ്യുക."}, {"key": "pron.paywall.soundLocked", "text": "ഈ ശബ്ദത്തിന്റെ പൂർണ്ണ പാഠം — അത് എങ്ങനെ ഉണ്ടാക്കാം, വായുടെ സ്ഥാനം, ഉദാഹരണ വാക്കുകൾ, വാക്യങ്ങൾ, മിനിമൽ പെയറുകൾ — Lingora English Premium-ന്റെ ഭാഗമാണ്."}, {"key": "pron.paywall.freeLimit", "text": "ആദ്യ {{count}} ശബ്ദങ്ങൾ സൗജന്യമാണ്. എല്ലാ 44 ശബ്ദങ്ങളും വ്യക്തിഗത കോച്ച് ഫീഡ്ബാക്കും അൺലോക്ക് ചെയ്യാൻ അപ്ഗ്രേഡ് ചെയ്യുക."}, {"key": "pron.paywall.unlockAllSounds", "text": "എല്ലാ 44 ശബ്ദങ്ങളും അൺലോക്ക് ചെയ്യുക"}, {"key": "pron.wordPracticeHint", "text": "AI കേൾക്കാനും പരിശീലിക്കാനും വാക്കിൽ ക്ലിക്ക് ചെയ്യുക"}, {"key": "pron.eg", "text": "ഉദാ."}, {"key": "pron.playing", "text": "പ്ലേ ചെയ്യുന്നു"}, {"key": "pron.listen", "text": "കേൾക്കുക"}, {"key": "pron.paywall.lessonLocked", "text": "ഈ പാഠത്തിന്റെ വിശദീകരണം, പരിശീലന പോയിന്റുകൾ, ഉദാഹരണങ്ങൾ എന്നിവ Lingora English Premium-ന്റെ ഭാഗമാണ്."}, {"key": "pron.paywall.lessonFreeLimit", "text": "ഓരോ സ്കില്ലിന്റെയും ആദ്യത്തെ {{count}} പാഠങ്ങൾ സൗജന്യമാണ്. ബാക്കിയുള്ളവ അൺലോക്ക് ചെയ്യാൻ അപ്ഗ്രേഡ് ചെയ്യുക."}, {"key": "pron.paywall.unlockAllLessons", "text": "എല്ലാ പാഠങ്ങളും അൺലോക്ക് ചെയ്യുക"}, {"key": "pron.itemPracticeHint", "text": "AI-യോടൊപ്പം പരിശീലിക്കാൻ ഇനത്തിൽ ക്ലിക്ക് ചെയ്യുക"}, {"key": "pron.practiceHint", "text": "കേൾക്കുക, ആവർത്തിക്കുക, റെക്കോർഡ് ചെയ്യുക, താരതമ്യം ചെയ്യുക — ഏതൊക്കെ വാക്കുകൾ വ്യക്തമായി പറഞ്ഞു എന്ന് കോച്ച് കൃത്യമായി കാണിക്കും."}, {"key": "pron.drillsCount", "text": "{{count}} ഡ്രിൽസ്"}, {"key": "pron.useInShadowing", "text": "ഈ സ്കിൽ ഷാഡോയിംഗിൽ ഉപയോഗിക്കുക"}, {"key": "pron.backToCoach", "text": "സ്പീക്കിംഗ് കോച്ചിലേക്ക് മടങ്ങുക"}, {"key": "pron.p.title", "text": "പരിശീലനം"}, {"key": "pron.p.step1.label", "text": "കേൾക്കുക"}, {"key": "pron.p.step1.hint", "text": "മാതൃകാ ഓഡിയോ രണ്ടുതവണ പ്ലേ ചെയ്യുക."}, {"key": "pron.p.step2.label", "text": "മനസ്സിലാക്കുക"}, {"key": "pron.p.step2.hint", "text": "നിങ്ങളുടെ വായ എന്ത് ചെയ്യണം എന്ന് വായിക്കുക."}, {"key": "pron.p.step3.label", "text": "കാണുക / പഠിക്കുക"}, {"key": "pron.p.step3.hint", "text": "വായ, നാവ്, പാറ്റേൺ ഗൈഡ് പരിശോധിക്കുക."}, {"key": "pron.p.step4.label", "text": "ആവർത്തിക്കുക"}, {"key": "pron.p.step4.hint", "text": "ഓഡിയോയോടൊപ്പം ഉറക്കെ പറയുക, ആദ്യം പതുക്കെ."}, {"key": "pron.p.step5.label", "text": "റെക്കോർഡ് ചെയ്യുക"}, {"key": "pron.p.step5.hint", "text": "അതേ വരി പറയുന്നത് സ്വയം റെക്കോർഡ് ചെയ്യുക."}, {"key": "pron.p.step6.label", "text": "AI ഫീഡ്ബാക്ക്"}, {"key": "pron.p.step6.hint", "text": "കോച്ച് എന്ത് കേട്ടു, എന്ത് തിരുത്തണം എന്ന് കാണുക."}, {"key": "pron.p.step7.label", "text": "വീണ്ടും ശ്രമിക്കുക"}, {"key": "pron.p.step7.hint", "text": "ഒരു കാര്യം തിരുത്തി ഒരിക്കൽ കൂടി റെക്കോർഡ് ചെയ്യുക."}, {"key": "pron.p.step8.label", "text": "കൈവശമായി"}, {"key": "pron.p.step8.hint", "text": "തുടർച്ചയായി രണ്ടുതവണ വ്യക്തമായി വായിച്ചാൽ — അടുത്തതിലേക്ക് പോകുക."}, {"key": "pron.p.stepTap", "text": "{{hint}} ഇത് ചെയ്തശേഷം ഒരിക്കൽ ടാപ്പ് ചെയ്യുക."}, {"key": "pron.p.focusSound", "text": "ഫോക്കസ് ശബ്ദം {{sound}}"}, {"key": "pron.p.eg", "text": "ഉദാ. {{sentence}}"}, {"key": "pron.p.loading", "text": "ലോഡ് ചെയ്യുന്നു…"}, {"key": "pron.p.speedNormal", "text": "സാധാരണ"}, {"key": "pron.p.speedSlower", "text": "കുറച്ച് പതുക്കെ"}, {"key": "pron.p.speedSlow", "text": "പതുക്കെ"}, {"key": "pron.p.loop", "text": "ലൂപ്പ്"}, {"key": "pron.p.stop", "text": "നിർത്തുക"}, {"key": "pron.p.voiceNote", "text": "മാതൃകാ ഓഡിയോ ലിംഗോറയുടെ അമേരിക്കൻ ഇംഗ്ലീഷ് AI ശബ്ദമാണ്, മനുഷ്യന്റെ റെക്കോർഡിംഗ് അല്ല."}, {"key": "pron.p.listenSentence", "text": "കേൾക്കുക എന്നത് ശബ്ദം രണ്ടുതവണ, പിന്നെ ഉദാഹരണ വാക്ക്, പിന്നെ അത് അടങ്ങിയ ഒരു വാക്യം എന്നിവ പ്ലേ ചെയ്യും."}, {"key": "pron.p.listenExample", "text": "കേൾക്കുക എന്നത് ശബ്ദം രണ്ടുതവണ, പിന്നെ ഉദാഹരണം പ്ലേ ചെയ്യും."}, {"key": "pron.p.recordHint", "text": "മുകളിലുള്ള വരി ഒരിക്കൽ വ്യക്തമായി പറയുക."}, {"key": "pron.p.signupToRecord", "text": "റെക്കോർഡ് ചെയ്ത് ഫീഡ്ബാക്ക് ലഭിക്കാൻ സൗജന്യ അക്കൗണ്ട് സൃഷ്ടിക്കുക."}, {"key": "pron.p.yourRecording", "text": "നിങ്ങളുടെ റെക്കോർഡിംഗ്"}, {"key": "pron.p.listeningRec", "text": "നിങ്ങളുടെ റെക്കോർഡിംഗ് കേൾക്കുന്നു…"}, {"key": "pron.p.wordsClear", "text": "വ്യക്തമായി പറഞ്ഞ വാക്കുകൾ"}, {"key": "pron.p.wpm", "text": "സംസാര വേഗത (wpm)"}, {"key": "pron.p.heard", "text": "ലിംഗോറ കേട്ടത്"}, {"key": "pron.p.tagClear", "text": "വ്യക്തം"}, {"key": "pron.p.tagNeeds", "text": "മെച്ചപ്പെടുത്തണം"}, {"key": "pron.p.measured", "text": "അളന്ന അവതരണം"}, {"key": "pron.p.paceLabel", "text": "വേഗത:"}, {"key": "pron.p.paceValue", "text": "മിനിറ്റിൽ {{wpm}} വാക്കുകൾ ({{pace}})"}, {"key": "pron.p.paceNote", "text": "സ്വാഭാവിക സംഭാഷണം ഏകദേശം 120–160 ആണ്."}, {"key": "pron.p.pace.slow", "text": "പതുക്കെ"}, {"key": "pron.p.pace.natural", "text": "സ്വാഭാവികം"}, {"key": "pron.p.pace.fast", "text": "വേഗം"}, {"key": "pron.p.fillersLabel", "text": "ഫില്ലറുകൾ:"}, {"key": "pron.p.repeatedLabel", "text": "ആവർത്തിച്ച വാക്കുകൾ:"}, {"key": "pron.p.noneDetected", "text": "ഒന്നും കണ്ടെത്തിയില്ല"}, {"key": "pron.p.measuredNote", "text": "വേഗത, ഫില്ലറുകൾ, ആവർത്തനം എന്നിവ നിങ്ങളുടെ യഥാർത്ഥ ട്രാൻസ്ക്രിപ്റ്റിൽ നിന്നും റെക്കോർഡിംഗ് ദൈർഘ്യത്തിൽ നിന്നും കണക്കാക്കുന്നു. പിച്ച്, ഉച്ചത്തിൽ, നിശ്ശബ്ദ ഇടവേളകളുടെ ദൈർഘ്യം എന്നിവ അളക്കുന്നില്ല, അതിനാൽ ഇന്റണേഷനോ ഇടവേളകളോ ഞങ്ങൾ സ്വയമേവ സ്കോർ ചെയ്യുന്നില്ല."}, {"key": "pron.p.mastered", "text": "കൈവശമായി — രണ്ട് വ്യക്തമായ ശ്രമങ്ങൾ"}, {"key": "pron.p.attempt", "text": "ശ്രമം {{n}} — തുടർച്ചയായി രണ്ട് വ്യക്തമായ വായനകൾ ഈ വരി കൈവശമായതായി അടയാളപ്പെടുത്തും."}, {"key": "pron.p.toShadowing", "text": "ഇത് യഥാർത്ഥ സംസാരത്തിൽ പരിശീലിക്കുക → ഷാഡോയിംഗ്"}, {"key": "pron.p.toCoach", "text": "സ്പീക്കിംഗ് കോച്ചിനൊപ്പം ഇത് ഉപയോഗിക്കുക"}]
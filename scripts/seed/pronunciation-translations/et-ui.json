[{"key": "pron.hero.title", "text": "Kõla selgemalt, loomulikumalt ja ladusamalt"}, {"key": "pron.hero.description", "text": "Kõik {{count}} inglise keele häälikut ning sõnarõhk, lauserõhk, intonatsioon, seotud kõne, redutseerimine, rütm, mõttegrupitamine ja ladusus — iga õppetund lõpeb sinu enda salvestusega."}, {"key": "pron.imageAlt", "text": "Hääldus, artikulatsioon ja IPA"}, {"key": "pron.progress.title", "text": "Sinu häälduse edenemine"}, {"key": "pron.progress.descUser", "text": "Mõõdetud sõnadest, mille treener sinu enda salvestustes ära tundis."}, {"key": "pron.progress.descGuest", "text": "Loo tasuta konto, et end salvestada ja edenemist jälgida."}, {"key": "pron.recommended", "text": "Soovitatud sinule"}, {"key": "pron.soundLabel", "text": "Häälik {{symbol}}"}, {"key": "pron.skill.sounds", "text": "Häälikud"}, {"key": "pron.skill.sounds.blurb", "text": "Kõik 44 inglise foneemi koos minimaalpaaridega."}, {"key": "pron.skill.wordStress", "text": "Sõnarõhk"}, {"key": "pron.skill.wordStress.blurb", "text": "Silbid, pearõhk ja kõrvalrõhk."}, {"key": "pron.skill.sentenceStress", "text": "Lauserõhk"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Sisusõnad tugevalt, abisõnad nõrgalt."}, {"key": "pron.skill.intonation", "text": "Intonatsioon"}, {"key": "pron.skill.intonation.blurb", "text": "Tõusev, langev, tõusev-langev ja langev-tõusev."}, {"key": "pron.skill.connectedSpeech", "text": "Seotud kõne"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Sidumine, elisioon, assimilatsioon, nõrgad vormid."}, {"key": "pron.skill.reductions", "text": "Redutseerimine"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — mitteametlik kõnekeel."}, {"key": "pron.skill.rhythm", "text": "Rütm"}, {"key": "pron.skill.rhythm.blurb", "text": "Rõhupõhised taktid, ajastus ja pausid."}, {"key": "pron.skill.chunking", "text": "Pausid ja mõttegrupitamine"}, {"key": "pron.skill.chunking.blurb", "text": "Mõtterühmad ja loomulikud hingamispausid."}, {"key": 
asiside"}, {"key": "pron.p.step6.hint", "text": "Vaata, mida treener kuulis ja mida parandada."}, {"key": "pron.p.step7.label", "text": "Proovi uuesti"}, {"key": "pron.p.step7.hint", "text": "Paranda üks asi ja salvesta veel kord."}, {"key": "pron.p.step8.label", "text": "Omandatud"}, {"key": "pron.p.step8.hint", "text": "Selge kordamine kaks korda järjest — liigu edasi."}, {"key": "pron.p.stepTap", "text": "{{hint}} Puuduta, kui oled selle teinud."}, {"key": "pron.p.focusSound", "text": "Fookusheli {{sound}}"}, {"key": "pron.p.eg", "text": "nt {{sentence}}"}, {"key": "pron.p.loading", "text": "Laadimine…"}, {"key": "pron.p.speedNormal", "text": "Tavaline"}, {"key": "pron.p.speedSlower", "text": "Aeglasem"}, {"key": "pron.p.speedSlow", "text": "Aeglane"}, {"key": "pron.p.loop", "text": "Kordus"}, {"key": "pron.p.stop", "text": "Peata"}, {"key": "pron.p.voiceNote", "text": "Näidisheli on Lingora Ameerika inglise keele AI hääl, mitte inimhääl."}, {"key": "pron.p.listenSentence", "text": "Kuula esitab heli kaks korda, seejärel näidissõna ja siis selle sisaldava lause."}, {"key": "pron.p.listenExample", "text": "Kuula esitab heli kaks korda, seejärel näidise."}, {"key": "pron.p.recordHint", "text": "Ütle ülaltoodud lause üks kord selgelt."}, {"key": "pron.p.signupToRecord", "text": "Loo tasuta konto, et salvestada ja tagasisidet saada."}, {"key": "pron.p.yourRecording", "text": "Sinu salvestis"}, {"key": "pron.p.listeningRec", "text": "Sinu salvestise kuulamine…"}, {"key": "pron.p.wordsClear", "text": "Selgelt öeldud sõnad"}, {"key": "pron.p.wpm", "text": "Kõnekiirus (sõnu/min)"}, {"key": "pron.p.heard", "text": "Lingora kuulis"}, {"key": "pron.p.tagClear", "text": "Selge"}, {"key": "pron.p.tagNeeds", "text": "Vajab parandamist"}, {"key": "pron.p.measured", "text": "Mõõdetud esitus"}, {"key": "pron.p.paceLabel", "text": "Tempo:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} sõna minutis ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Loomulik vestlus on umbes 120–160."}, {"key": "pron.p.pace.slow", "text": "aeglane"}, {"key": "pron.p.pace.natural", "text": "loomulik"}, {"key": "pron.p.pace.fast", "text": "kiire"}, {"key": "pron.p.fillersLabel", "text": "Täitesõnad:"}, {"key": "pron.p.repeatedLabel", "text": "Korduvad sõnad:"}, {"key": "pron.p.noneDetected", "text": "ei tuvastatud"}, {"key": "pron.p.measuredNote", "text": "Tempo, täitesõnad ja kordused loetakse sinu tegelikust transkriptsioonist ja salvestise pikkusest. Helikõrgust, valjust ja vaikuse pikkust ei mõõdeta, seega me ei hinda intonatsiooni ega pause automaatselt."}, {"key": "pron.p.mastered", "text": "Omandatud — kaks selget katset"}, {"key": "pron.p.attempt", "text": "Katse {{n}} — kaks selget kordamist järjest märgib selle rea omandatuks."}, {"key": "pron.p.toShadowing", "text": "Harjuta seda päris kõnes → Varjutamine"}, {"key": "pron.p.toCoach", "text": "Kasuta seda kõnetreeneriga"}]
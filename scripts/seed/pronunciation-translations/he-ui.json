[{"key": "pron.hero.title", "text": "נשמע ברור יותר, טבעי יותר, שוטף יותר"}, {"key": "pron.hero.description", "text": "כל {{count}} הצלילים באנגלית וגם הטעמת מילים, הטעמת משפטים, אינטונציה, דיבור מחובר, קיצורים, קצב, חלוקה למקטעים ושוטף — כל שיעור מסתיים בהקלטה שלך."}, {"key": "pron.imageAlt", "text": "הגייה, הבעה ו-IPA"}, {"key": "pron.progress.title", "text": "ההתקדמות שלך בהגייה"}, {"key": "pron.progress.descUser", "text": "נמדד לפי המילים שהמאמן זיהה בהקלטות שלך."}, {"key": "pron.progress.descGuest", "text": "צור חשבון חינם כדי להקליט את עצמך ולהתחיל לעקוב אחרי ההתקדמות."}, {"key": "pron.recommended", "text": "מומלץ עבורך"}, {"key": "pron.soundLabel", "text": "צליל {{symbol}}"}, {"key": "pron.skill.sounds", "text": "צלילים"}, {"key": "pron.skill.sounds.blurb", "text": "כל 44 הפונמות באנגלית עם זוגות מינימליים."}, {"key": "pron.skill.wordStress", "text": "הטעמת מילים"}, {"key": "pron.skill.wordStress.blurb", "text": "הברות, הטעמה ראשית ומשנית."}, {"key": "pron.skill.sentenceStress", "text": "הטעמת משפטים"}, {"key": "pron.skill.sentenceStress.blurb", "text": "מילות תוכן חזקות, מילות תפקוד חלשות."}, {"key": "pron.skill.intonation", "text": "אינטונציה"}, {"key": "pron.skill.intonation.blurb", "text": "עולה, יורדת, עולה-יורדת ויורדת-עולה."}, {"key": "pron.skill.connectedSpeech", "text": "דיבור מחובר"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "חיבור, השמטה, התבוללות, צורות חלשות."}, {"key": "pron.skill.reductions", "text": "קיצורים"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — אנגלית מדוברת לא רשמית."}, {"key": "pron.skill.rhythm", "text": "קצב"}, {"key": "pron.skill.rhythm.blurb", "text": "פעימות לפי הטעמה, תזמון והפסקות."}, {"key": "pron.skill.chunking", "text": "הפסקות וחלוקה למקטעים"}, {"key": "pron.skill.chunking.blurb", "text": "קבוצות מחשבה והפסקות נשימה טבעיות."}, {"key": "pron.skill.fluency", "text": "שוטף"}, {"key": "pron.skill.fluency.blurb", "text": "מהירות, היסוס, מילות מילוי וחיבור רעיונות."}, {"key": "pron.filter.searchPlaceholder", "text": "חפש צליל, מילה או שיעור"}, {"key": "pron.filter.allLevels", "text": "כל הרמות"}, {"key": "pron.filter.beginner", "text": "מתחיל"}, {"key": "pron.filter.intermediate", "text": "בינוני"}, {"key": "pron.filter.advanced", "text": "מתקדם"}, {"key": "pron.filter.allDifficulties", "text": "כל הרמות קושי"}, {"key": "pron.filter.gentle", "text": "קל"}, {"key": "pron.filter.steady", "text": "בינוני"}, {"key": "pron.filter.challenging", "text": "מאתגר"}, {"key": "pron.filter.us", "text": "אנגלית אמריקאית"}, {"key": "pron.filter.uk", "text": "אנגלית בריטית"}, {"key": "pron.sounds.title", "text": "{{count}} הצלילים באנגלית"}, {"key": "pron.sounds.shown", "text": "{{count}} מוצגים"}, {"key": "pron.lessons.title", "text": "שיעורי {{skill}}"}, {"key": "pron.lessons.none", "text": "אין שיעור שמתאים למסננים האלה. נסה \"כל הרמות\" ו\"כל הרמות קושי\"."}, {"key": "pron.how", "text": "איך"}, {"key": "pron.commonMistakes", "text": "טעויות נפוצות"}, {"key": "pron.wordPractice", "text": "תרגול מילים"}, {"key": "pron.sentencePractice", "text": "תרגול משפטים"}, {"key": "pron.minimalPairs", "text": "זוגות מינימליים"}, {"key": "pron.practise", "text": "תרגל"}, {"key": "pron.toast.signInModel", "text": "התחבר כדי לשמוע את מודל ה-AI."}, {"key": "pron.toast.playError", "text": "לא ניתן היה להשמיע אודיו."}, {"key": "pron.voicedDesc", "text": "קולי — מיתרי הקול רוטטים"}, {"key": "pron.voicelessDesc", "text": "אטום — נשימה בלבד, ללא רטט"}, {"key": "pron.soundPracticeHint", "text": "הקש על \"1. האזן\" בכרטיס התרגול מימין כדי לשמוע את מודל ה-AI מבטא את הצליל הזה ודוגמה."}, {"key": "pron.paywall.soundLocked", "text": "השיעור המלא של הצליל הזה — איך לבטא אותו, תנוחת הפה, מילים לדוגמה, משפטים וזוגות מינימליים — הוא חלק מ-Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "{{count}} הצלילים הראשונים בחינם. שדרג כדי לפתוח את כל 44 הצלילים ומשוב אישי מהמאמן."}, {"key": "pron.paywall.unlockAllSounds", "text": "פתח את כל 44 הצלילים"}, {"key": "pron.wordPracticeHint", "text": "לחץ על מילה כדי לשמוע AI ולתרגל"}, {"key": "pron.eg", "text": "למשל"}, {"key": "pron.playing", "text": "מתנגן"}, {"key": "pron.listen", "text": "האזן"}, {"key": "pron.paywall.lessonLocked", "text": "ההסבר, נקודות התרגול והדוגמאות של השיעור הזה הם חלק מ-Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "{{count}} השיעורים הראשונים בכל מיומנות חינם. שדרגו כדי לפתוח את השאר."}, {"key": "pron.paywall.unlockAllLessons", "text": "פתחו את כל השיעורים"}, {"key": "pron.itemPracticeHint", "text": "לחצו על פריט כדי להתאמן עם AI"}, {"key": "pron.practiceHint", "text": "הקשיבו, חזרו, הקליטו והשוו — המאמן מראה בדיוק אילו מילים נשמעו ברור."}, {"key": "pron.drillsCount", "text": "{{count}} תרגולים"}, {"key": "pron.useInShadowing", "text": "השתמשו במיומנות זו ב-Shadowing"}, {"key": "pron.backToCoach", "text": "חזרה למאמן הדיבור"}, {"key": "pron.p.title", "text": "תרגול"}, {"key": "pron.p.step1.label", "text": "הקשבה"}, {"key": "pron.p.step1.hint", "text": "השמיעו את השמע לדוגמה פעמיים."}, {"key": "pron.p.step2.label", "text": "הבנה"}, {"key": "pron.p.step2.hint", "text": "קראו מה הפה שלכם צריך לעשות."}, {"key": "pron.p.step3.label", "text": "צפייה / למידה"}, {"key": "pron.p.step3.hint", "text": "בדקו את מדריך הפה, הלשון והתבנית."}, {"key": "pron.p.step4.label", "text": "חזרה"}, {"key": "pron.p.step4.hint", "text": "אמרו בקול עם השמע, קודם לאט."}, {"key": "pron.p.step5.label", "text": "הקלטה"}, {"key": "pron.p.step5.hint", "text": "הקליטו את עצמכם אומרים את אותו המשפט."}, {"key": "pron.p.step6.label", "text": "משוב AI"}, {"key": "pron.p.step6.hint", "text": "ראו מה המאמן שמע ומה לתקן."}, {"key": "pron.p.step7.label", "text": "נסו שוב"}, {"key": "pron.p.step7.hint", "text": "תקנו דבר אחד והקליטו שוב."}, {"key": "pron.p.step8.label", "text": "נשלט"}, {"key": "pron.p.step8.hint", "text": "קריאה ברורה פעמיים ברצף — המשיכו הלאה."}, {"key": "pron.p.stepTap", "text": "{{hint}} הקישו לאחר שסיימתם."}, {"key": "pron.p.focusSound", "text": "צליל מיקוד {{sound}}"}, {"key": "pron.p.eg", "text": "למשל {{sentence}}"}, {"key": "pron.p.loading", "text": "טוען…"}, {"key": "pron.p.speedNormal", "text": "רגיל"}, {"key": "pron.p.speedSlower", "text": "איטי יותר"}, {"key": "pron.p.speedSlow", "text": "איטי"}, {"key": "pron.p.loop", "text": "לולאה"}, {"key": "pron.p.stop", "text": "עצור"}, {"key": "pron.p.voiceNote", "text": "השמע לדוגמה הוא קול AI אמריקאי של Lingora, לא הקלטה אנושית."}, {"key": "pron.p.listenSentence", "text": "ההקשבה משמיעה את הצליל פעמיים, אחר כך את מילת הדוגמה, ואז משפט שמכיל אותה."}, {"key": "pron.p.listenExample", "text": "ההקשבה משמיעה את הצליל פעמיים, אחר כך את הדוגמה."}, {"key": "pron.p.recordHint", "text": "אמרו את השורה שלמעלה פעם אחת, בבירור."}, {"key": "pron.p.signupToRecord", "text": "צרו חשבון חינם כדי להקליט ולקבל משוב."}, {"key": "pron.p.yourRecording", "text": "ההקלטה שלכם"}, {"key": "pron.p.listeningRec", "text": "מקשיב להקלטה שלכם…"}, {"key": "pron.p.wordsClear", "text": "מילים שנאמרו ברור"}, {"key": "pron.p.wpm", "text": "מהירות דיבור (מילים בדקה)"}, {"key": "pron.p.heard", "text": "Lingora שמע"}, {"key": "pron.p.tagClear", "text": "ברור"}, {"key": "pron.p.tagNeeds", "text": "דורש שיפור"}, {"key": "pron.p.measured", "text": "מדידה בפועל"}, {"key": "pron.p.paceLabel", "text": "קצב:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} מילים בדקה ({{pace}})"}, {"key": "pron.p.paceNote", "text": "שיחה טבעית היא בערך 120–160."}, {"key": "pron.p.pace.slow", "text": "איטי"}, {"key": "pron.p.pace.natural", "text": "טבעי"}, {"key": "pron.p.pace.fast", "text": "מהיר"}, {"key": "pron.p.fillersLabel", "text": "מילות מילוי:"}, {"key": "pron.p.repeatedLabel", "text": "מילים חוזרות:"}, {"key": "pron.p.noneDetected", "text": "לא זוהו"}, {"key": "pron.p.measuredNote", "text": "קצב, מילות מילוי וחזרות נספרים מהתמלול האמיתי ומאורך ההקלטה. גובה צליל, עוצמה ואורך הפסקות שקט לא נמדדים, ולכן אנחנו לא מדרגים אינטונציה או הפסקות אוטומטית."}, {"key": "pron.p.mastered", "text": "נשלט — שני ניסיונות ברורים"}, {"key": "pron.p.attempt", "text": "ניסיון {{n}} — שתי קריאות ברורות ברצף יסמנו את השורה כנשלטת."}, {"key": "pron.p.toShadowing", "text": "תרגלו את זה בדיבור אמיתי → Shadowing"}, {"key": "pron.p.toCoach", "text": "השתמשו בזה עם מאמן הדיבור"}]
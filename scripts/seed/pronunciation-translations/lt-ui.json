[{"key": "pron.hero.title", "text": "Kalbėk aiškiau, natūraliau, sklandžiau"}, {"key": "pron.hero.description", "text": "Visi {{count}} anglų kalbos garsai, taip pat žodžių kirtis, sakinio kirtis, intonacija, susietoji kalba, redukcijos, ritmas, skaidymas ir sklandumas — kiekviena pamoka baigiasi jūsų pačių įrašu."}, {"key": "pron.imageAlt", "text": "Tarimas, artikuliacija ir TFA"}, {"key": "pron.progress.title", "text": "Jūsų tarimo pažanga"}, {"key": "pron.progress.descUser", "text": "Matuojama pagal žodžius, kuriuos treneris atpažino jūsų įrašuose."}, {"key": "pron.progress.descGuest", "text": "Susikurkite nemokamą paskyrą, įrašykite save ir pradėkite stebėti pažangą."}, {"key": "pron.recommended", "text": "Rekomenduojama jums"}, {"key": "pron.soundLabel", "text": "{{symbol}} garsas"}, {"key": "pron.skill.sounds", "text": "Garsai"}, {"key": "pron.skill.sounds.blurb", "text": "Visi 44 anglų kalbos fonemai su minimaliomis poromis."}, {"key": "pron.skill.wordStress", "text": "Žodžių kirtis"}, {"key": "pron.skill.wordStress.blurb", "text": "Skiemenys, pagrindinis ir šalutinis kirtis."}, {"key": "pron.skill.sentenceStress", "text": "Sakinio kirtis"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Reikšminiai žodžiai kirčiuojami, funkciniai — ne."}, {"key": "pron.skill.intonation", "text": "Intonacija"}, {"key": "pron.skill.intonation.blurb", "text": "Kylanti, krentanti, kylanti-krentanti ir krentanti-kylanti."}, {"key": "pron.skill.connectedSpeech", "text": "Susietoji kalba"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Sujungimas, elizija, asimiliacija, silpnosios formos."}, {"key": "pron.skill.reductions", "text": "Redukcijos"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — neformali šnekamoji anglų kalba."}, {"key": "pron.skill.rhythm", "text": "Ritmas"}, {"key": "pron.skill.rhythm.blurb", "text": "Kirčiuoti taktai, laikas ir pauzės."}, {"key": "pron.skill.chunking", "text": "Pauzės ir skaidymas"}, {"key": "pron.skill.chunking.blurb", "text": "Minties grupės ir natūralios kvėpavimo pauzės."}, {"key": "pron.skill.fluency", "text": "Sklandumas"}, {"key": "pron.skill.fluency.blurb", "text": "Greitis, dvejonės, įterpiniai ir minčių siejimas."}, {"key": "pron.filter.searchPlaceholder", "text": "Ieškoti garso, žodžio ar pamokos"}, {"key": "pron.filter.allLevels", "text": "Visi lygiai"}, {"key": "pron.filter.beginner", "text": "Pradedantysis"}, {"key": "pron.filter.intermediate", "text": "Vidutinis"}, {"key": "pron.filter.advanced", "text": "Pažengęs"}, {"key": "pron.filter.allDifficulties", "text": "Visi sunkumai"}, {"key": "pron.filter.gentle", "text": "Lengvas"}, {"key": "pron.filter.steady", "text": "Vidutinis"}, {"key": "pron.filter.challenging", "text": "Sudėtingas"}, {"key": "pron.filter.us", "text": "JAV anglų kalba"}, {"key": "pron.filter.uk", "text": "JK anglų kalba"}, {"key": "pron.sounds.title", "text": "{{count}} anglų kalbos garsai"}, {"key": "pron.sounds.shown", "text": "Rodoma: {{count}}"}, {"key": "pron.lessons.title", "text": "{{skill}} pamokos"}, {"key": "pron.lessons.none", "text": "Nė viena pamoka neatitinka šių filtrų. Pabandykite „Visi lygiai“ ir „Visi sunkumai“."}, {"key": "pron.how", "text": "Kaip"}, {"key": "pron.commonMistakes", "text": "Dažnos klaidos"}, {"key": "pron.wordPractice", "text": "Žodžių praktika"}, {"key": "pron.sentencePractice", "text": "Sakinių praktika"}, {"key": "pron.minimalPairs", "text": "Minimalios poros"}, {"key": "pron.practise", "text": "Praktikuotis"}, {"key": "pron.toast.signInModel", "text": "Prisijunkite, kad išgirstumėte AI modelio garsą."}, {"key": "pron.toast.playError", "text": "Nepavyko paleisti garso."}, {"key": "pron.voicedDesc", "text": "Skardusis — balso stygos vibruoja"}, {"key": "pron.voicelessDesc", "text": "Duslusis — tik kvėpavimas, jokios vibracijos"}, {"key": "pron.soundPracticeHint", "text": "Bakstelėkite „1. Klausytis“ praktikos kortelėje dešinėje, kad išgirstumėte AI modelio šį garsą ir pavyzdį."}, {"key": "pron.paywall.soundLocked", "text": "Šio garso visa pamoka — kaip jį ištarti, burnos padėtis, pavyzdiniai žodžiai, sakiniai ir minimalios poros — yra „Lingora English Premium“ dalis."}, {"key": "pron.paywall.freeLimit", "text": "Pirmieji {{count}} garsai yra nemokami. Atnaujinkite, kad atrakintumėte visus 44 garsus ir suasmenintą trenerio grįžtamąjį ryšį."}, {"key": "pron.paywall.unlockAllSounds", "text": "Atrakinti visus 44 garsus"}, {"key": "pron.wordPracticeHint", "text": "Spustelėkite žodį, kad išgirstumėte AI ir praktikuotumėtės"}, {"key": "pron.eg", "text": "pvz."}, {"key": "pron.playing", "text": "Groja"}, {"key": "pron.listen", "text": "Klausytis"}, {"key": "pron.paywall.lessonLocked", "text": "Šios pamokos paaiškinimas, praktikos punktai ir pavyzdžiai yra „Lingora English Premium“ dalis."}, {"key": "pron.paywall.lessonFreeLimit", "text": "Pirmos {{count}} pamokos kiekvienam įgūdžiui yra nemokamos. Atnaujinkite, kad atrakintumėte likusias."}, {"key": "pron.paywall.unlockAllLessons", "text": "Atrakinti visas pamokas"}, {"key": "pron.itemPracticeHint", "text": "Spustelėkite elementą, kad praktikuotumėtės su AI"}, {"key": "pron.practiceHint", "text": "Klausykitės, kartokite, įrašykite ir palyginkite — treneris parodo, kurie žodžiai buvo ištarti aiškiai."}, {"key": "pron.drillsCount", "text": "{{count}} pratimai"}, {"key": "pron.useInShadowing", "text": "Naudoti šį įgūdį šešėliavime"}, {"key": "pron.backToCoach", "text": "Atgal į kalbėjimo trenerį"}, {"key": "pron.p.title", "text": "Praktika"}, {"key": "pron.p.step1.label", "text": "Klausykis"}, {"key": "pron.p.step1.hint", "text": "Paklausykite pavyzdinio garso įrašo du kartus."}, {"key": "pron.p.step2.label", "text": "Suprask"}, {"key": "pron.p.step2.hint", "text": "Perskaitykite, ką turėtų daryti jūsų burna."}, {"key": "pron.p.step3.label", "text": "Žiūrėk / mokykis"}, {"key": "pron.p.step3.hint", "text": "Patikrinkite burnos, liežuvio ir tarimo modelio vadovą."}, {"key": "pron.p.step4.label", "text": "Kartok"}, {"key": "pron.p.step4.hint", "text": "Pasakykite garsiai kartu su garso įrašu, iš pradžių lėtai."}, {"key": "pron.p.step5.label", "text": "Įrašyk"}, {"key": "pron.p.step5.hint", "text": "Įrašykite save sakant tą pačią eilutę."}, {"key": "pron.p.step6.label", "text": "AI atsiliepimas"}, {"key": "pron.p.step6.hint", "text": "Pažiūrėkite, ką treneris išgirdo ir ką reikia pataisyti."}, {"key": "pron.p.step7.label", "text": "Bandyk dar kartą"}, {"key": "pron.p.step7.hint", "text": "Pataisykite vieną dalyką ir įrašykite dar kartą."}, {"key": "pron.p.step8.label", "text": "Įvaldyta"}, {"key": "pron.p.step8.hint", "text": "Du kartus iš eilės aiškiai perskaitykite — ir tęskite."}, {"key": "pron.p.stepTap", "text": "{{hint}} Bakstelėkite, kai tai padarysite."}, {"key": "pron.p.focusSound", "text": "Tiriamasis garsas {{sound}}"}, {"key": "pron.p.eg", "text": "pvz. {{sentence}}"}, {"key": "pron.p.loading", "text": "Kraunama…"}, {"key": "pron.p.speedNormal", "text": "Normalus"}, {"key": "pron.p.speedSlower", "text": "Lėtesnis"}, {"key": "pron.p.speedSlow", "text": "Lėtas"}, {"key": "pron.p.loop", "text": "Kartoti"}, {"key": "pron.p.stop", "text": "Stabdyti"}, {"key": "pron.p.voiceNote", "text": "Pavyzdinis garso įrašas yra Lingora amerikiečių anglų kalbos AI balsas, o ne žmogaus įrašas."}, {"key": "pron.p.listenSentence", "text": "Klausymas paleidžia garsą du kartus, tada pavyzdinį žodį, tada sakinį su juo."}, {"key": "pron.p.listenExample", "text": "Klausymas paleidžia garsą du kartus, tada pavyzdį."}, {"key": "pron.p.recordHint", "text": "Pasakykite aukščiau esančią eilutę vieną kartą, aiškiai."}, {"key": "pron.p.signupToRecord", "text": "Susikurkite nemokamą paskyrą, kad galėtumėte įrašyti ir gauti atsiliepimą."}, {"key": "pron.p.yourRecording", "text": "Jūsų įrašas"}, {"key": "pron.p.listeningRec", "text": "Klausomasi jūsų įrašo…"}, {"key": "pron.p.wordsClear", "text": "Aiškiai ištarti žodžiai"}, {"key": "pron.p.wpm", "text": "Kalbėjimo greitis (žodžiai/min.)"}, {"key": "pron.p.heard", "text": "Lingora išgirdo"}, {"key": "pron.p.tagClear", "text": "Aišku"}, {"key": "pron.p.tagNeeds", "text": "Reikia patobulinti"}, {"key": "pron.p.measured", "text": "Išmatuotas kalbėjimas"}, {"key": "pron.p.paceLabel", "text": "Tempas:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} žodžių per minutę ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Natūralus pokalbis yra apie 120–160."}, {"key": "pron.p.pace.slow", "text": "lėtas"}, {"key": "pron.p.pace.natural", "text": "natūralus"}, {"key": "pron.p.pace.fast", "text": "greitas"}, {"key": "pron.p.fillersLabel", "text": "Užpildai:"}, {"key": "pron.p.repeatedLabel", "text": "Pasikartojantys žodžiai:"}, {"key": "pron.p.noneDetected", "text": "neaptikta"}, {"key": "pron.p.measuredNote", "text": "Tempas, užpildai ir pasikartojimai skaičiuojami pagal jūsų tikrąją transkripciją ir įrašo trukmę. Aukštis, garsumas ir tylių pauzių trukmė nematuojami, todėl intonacijos ar pauzių automatiškai nevertiname."}, {"key": "pron.p.mastered", "text": "Įvaldyta — du aiškūs bandymai"}, {"key": "pron.p.attempt", "text": "Bandymas {{n}} — du aiškūs perskaitymai iš eilės žymi šią eilutę kaip įvaldytą."}, {"key": "pron.p.toShadowing", "text": "Praktikuokite tai tikroje kalboje → Šešėliavimas"}, {"key": "pron.p.toCoach", "text": "Naudokite tai su kalbėjimo treneriu"}]
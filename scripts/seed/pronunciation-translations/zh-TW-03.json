[{"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|point|3", "text": "got to → gotta"}, {"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|caution", "text": "這些都是非正式的口語形式。不要在論文、電子郵件或正式考試中寫出這些形式，在正式演講中也應避免使用。"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|explain", "text": "更多你在電影和真實對話中會不斷聽到的隨性縮略形式。"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|0", "text": "kind of → kinda"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|1", "text": "sort of → sorta"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|2", "text": "let me → lemme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|3", "text": "give me → gimme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|4", "text": "what do you → whaddaya"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|caution", "text": "僅限非正式場合。在 IELTS 或求職面試中，請保留完整形式。"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|explain", "text": "更多在輕鬆口語英語中常見的義務和習慣縮略形式。"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|0", "text": "have to → hafta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|1", "text": "need to → needa"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|2", "text": "used to → useta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|caution", "text": "僅限非正式口語形式——絕對不要寫出來。"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|explain", "text": "過去情態動詞的縮略形式——在談論遺憾或假設情境時非常常見。"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|0", "text": "could have → coulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|1", "text": "would have → woulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|2", "text": "should have → shoulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|caution", "text": "僅限非正式口語——在正式寫作中請完整寫出 'could have'。"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|explain", "text": "非常隨性的縮略形式，常見於歌曲、電影和朋友之間的輕鬆對話。"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|0", "text": "don't know → dunno"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|1", "text": "don't you → dontcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|2", "text": "what are you → whatcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|caution", "text": "非常非正式——只對親近的朋友使用，絕不要在專業或考試情境中使用。"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|explain", "text": "在隨性口語中常見的與介系詞連結的縮略形式。"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|0", "text": "out of → outta"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|1", "text": "off of → offa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|2", "text": "cup of → cuppa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|caution", "text": "僅限非正式場合。"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|explain", "text": "日常感嘆語和帶有大量縮略的隨性用語。"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|0", "text": "come on → c'mon"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|1", "text": "going to be → gonna be"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|2", "text": "some more → s'more"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|caution", "text": "僅限非正式場合。"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|explain", "text": "在快速、隨意的對話中，疑問句開頭詞會大幅縮減。"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|0", "text": "did you → dja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|1", "text": "do you → dya"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|2", "text": "would you → wouldja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|caution", "text": "僅適用於隨意的口語情境。"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|explain", "text": "隨意口語中也常縮減時間片語。"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|0", "text": "a couple of → a couple"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|1", "text": "in a minute → in a min"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|caution", "text": "在隨意交談中沒問題，但不用於書寫。"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|explain", "text": "在輕鬆對話中不斷聽到的更常見隨意縮減。"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|0", "text": "probably → prolly"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|1", "text": "trying to → tryna"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|2", "text": "supposed to → s'posed to"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|caution", "text": "僅限非正式口語。"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|explain", "text": "朋友之間及美式非正式口語中常見的隨意縮減。"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|0", "text": "let's go → less go"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|1", "text": "give it to me → gimme that"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|2", "text": "you all → y'all"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|caution", "text": "非常非正式——'y'all' 具有地域性（美國南方），但廣為人理解。 (US)"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|explain", "text": "在快速、隨意的美式口語中，整數會縮減其中間的輔音。"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|0", "text": "twenty → twenny"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|1", "text": "hundred → hunnerd"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|caution", "text": "僅限非正式口語——在正式場合中務必使用完整形式。"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|explain", "text": "另一組在日常中經常於快速、輕鬆的口語裡失去一個音節的常用詞。"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|0", "text": "different → diff'rent"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|1", "text": "general → gen'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|2", "text": "several → sev'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|3", "text": "camera → cam'ra"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|caution", "text": "在口語中這樣說沒問題；但在正式簡報中，請清楚地說出完整形式。"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|explain", "text": "這些是非常不正式的縮減形式，你會在各類歌曲和隨意的美式口語中聽到，但絕不該在專業場合中使用。"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|0", "text": "I'm going to → I'ma"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|1", "text": "kind of like → kinda like"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|caution", "text": "極度不正式——僅限朋友之間或歌詞中使用，絕不可用於專業場合。"}, {"key": "551b9527-f712-421d-966c-24644f360746|explain", "text": "除了 what's up / how's it going 之外，更多日常問候的縮減形式。"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|0", "text": "how are you → how ya doin'"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|1", "text": "good to see you → good to see ya"}, {"key": "551b9527-f712-421d-966c-24644f360746|caution", "text": "僅限於隨意的口語形式。"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|explain", "text": "更多在輕鬆美式口語中常見的義務與意願縮減形式。"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|0", "text": "ought to → oughta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|1", "text": "don't have to → don't hafta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|2", "text": "want you → wantcha"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|caution", "text": "僅限非正式口語。"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|explain", "text": "這是美式隨意縮減能達到何種程度的經典範例——好幾個詞模糊成聽起來像一個詞。"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|0", "text": "Did you eat yet? → Jeetyet?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|1", "text": "Did you already? → Jeetalready?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|caution", "text": "極度不正式——用於聽懂母語者的快速口語，而非你自己的正式發言。"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|explain", "text": "另外兩個在隨意對話中常見的片語層級縮減。"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|0", "text": "because of → 'cause of"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|1", "text": "sort of a → sorta a"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|caution", "text": "僅限非正式口語。"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|explain", "text": "在輕鬆英語口語中，非常常見的 'yes' 和 'no' 的隨意替代說法。"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|0", "text": "yes → yep / uh-huh"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|1", "text": "no → nope / nah"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|caution", "text": "僅限隨意對話——在正式或考試情境中請使用 'yes'/'no'。"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|explain", "text": "兩者都縮減成聽起來相似的 'wanna'，但一個後面接名詞，另一個後面接動詞——值得注意其中的差異。"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|0", "text": "want a (coffee) → wanna coffee"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|1", "text": "want to (go) → wanna go"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|caution", "text": "僅限非正式口語。"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|0", "text": "'want a' + 名詞 → wanna"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|1", "text": "'want to' + 動詞 → wanna"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|explain", "text": "'would have' 的否定形式與肯定形式的縮減方式相同。"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|point|0", "text": "wouldn't have → wouldn'ta"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|caution", "text": "僅限非正式口語——其他情況下請完整寫出 'wouldn't have'。"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|explain", "text": "另外兩個在日常解釋和請求中常見的縮減形式。"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|0", "text": "just because → just 'cause"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|1", "text": "going to need → gonna need"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|caution", "text": "僅限非正式口語。"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|explain", "text": "'Ain't' 在非常隨意的口語中取代 am not/is not/are not/has not/have not，在歌曲和非正式對話中隨處可見。"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|0", "text": "I am not → I ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|1", "text": "that is not → that ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|2", "text": "you have not → you ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|caution", "text": "切勿用於書面或正式場合——即使非正式場合極為常見，仍被視為不標準文法。"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|explain", "text": "表達 'I understand' 或字面意思 'caught you' 的常見隨意說法。"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|0", "text": "got you（理解）→ gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|1", "text": "got you（抓到）→ gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|caution", "text": "僅限非正式口語——在專業場合請說 'I understand' 或 'got it'。"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|explain", "text": "用於猜測過去的語氣助動詞完成式縮減，與 coulda/woulda/shoulda 並列。"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|0", "text": "must have → musta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|1", "text": "might have → mighta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|caution", "text": "僅限非正式口語——其他情況下請完整寫出 'must have'/'might have'。"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|explain", "text": "coulda/woulda/shoulda 的否定對應形式，談論後悔時很常見。"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|0", "text": "shouldn't have → shouldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|1", "text": "couldn't have → couldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|caution", "text": "僅限非正式口語——正式場合請完整寫出 'shouldn't have'/'couldn't have'。"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|explain", "text": "在輕鬆的口語中，字尾的 -ing 音常省略 'g'，聽起來像 -in'。幾乎所有 -ing 動詞都會這樣。 (, so it sounds like -in)"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|0", "text": "doing → doin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|1", "text": "going → goin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|2", "text": "talking → talkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|3", "text": "thinking → thinkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|caution", "text": "僅限於日常口語——在簡報、面試和考試中，請將 '-ing' 完整清晰地發音。"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|explain", "text": "相同的 g 音省略模式也適用於以 -thing 結尾的不定代名詞。"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|0", "text": "something → somethin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|1", "text": "nothing → nothin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|2", "text": "anything → anythin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|caution", "text": "僅限於日常口語。"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|explain", "text": "在非常常見的日常口語中，'Them' 接在動詞後會縮減為 'em（'th' 音脫落）。"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|0", "text": "tell them → tell 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|1", "text": "get them → get 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|2", "text": "ask them → ask 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|caution", "text": "僅限於非正式口語——在書面或正式談話中請完整說出 'them'。"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|explain", "text": "'And' 在兩個緊密相連的詞之間會縮減為快速的 'n' 音，尤其是在固定片語中。"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|0", "text": "rock and roll → rock 'n' roll"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|1", "text": "fish and chips → fish 'n' chips"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|2", "text": "back and forth → back 'n' forth"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|caution", "text": "常見於固定片語和快速語速中——在正式寫作中請清楚寫出 'and'。"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|explain", "text": "在隨意的回答中，單獨使用的 'Because'（不只是 'because of'）經常縮短為 'cause。"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|point|0", "text": "because → 'cause"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|caution", "text": "僅限於非正式口語——其他情況下請完整寫出 'because'。"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|explain", "text": "在快速、隨意的回答中，'Of course' 經常省略第一個詞。"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|point|0", "text": "of course → 'course"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|caution", "text": "僅限於日常口語。"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|explain", "text": "'all right' 一種非常常見的日常口語發音，用於表示同意或回應。"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|point|0", "text": "all right → aight"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|caution", "text": "非常不正式——在專業場合請說 'all right' 或 'okay'。"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|explain", "text": "'Let you' 的縮減方式與 'want you'/'wantcha' 相同。"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|point|0", "text": "let you → letcha"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|caution", "text": "僅限非正式口語。"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|explain", "text": "另一個極端的快速語音融合，類似 'jeetyet'——多個詞壓縮成一個音。"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|point|0", "text": "did you ever → jever"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|caution", "text": "用於辨識母語者的快速語音，不適用於你自己的正式口說。"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|explain", "text": "當 'going to' 和 'have to' 並列出現在一起時，兩個縮減會疊加。"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|point|0", "text": "going to have to → gonna hafta"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|caution", "text": "僅限非正式口語——其他情況下請完整寫出 'going to have to'。"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|explain", "text": "'gonna' 縮減在否定句和過去式中同樣適用。"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|0", "text": "not going to → not gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|1", "text": "wasn't going to → wasn't gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|caution", "text": "僅限非正式口語。"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|explain", "text": "非常常見的英式英語附加問句縮減，用於確認或加強語氣。"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|point|0", "text": "isn't it → innit"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|caution", "text": "非常非正式的英式俚語——即使在英國也不要於正式場合使用。 (UK)"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|explain", "text": "一種隨意提出建議或徵求同意的說法。"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|point|0", "text": "what do you say → whaddya say"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|caution", "text": "僅限非正式口語。"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|explain", "text": "英語口語中極為常見的填充語，用於思考時或加強語氣。"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|point|0", "text": "you know → y'know"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|caution", "text": "僅限隨意填充語——過度使用即使是非正式場合也會顯得不通順。"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|explain", "text": "非常隨意的問候語，由 'what's up' 縮短而來。"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|point|0", "text": "what's up → s'up"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|caution", "text": "非常非正式的問候語，僅限朋友之間使用。"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|explain", "text": "'Him' 和 'her' 在隨意口語中也會弱化，類似 'them' → 'em'。"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|0", "text": "tell him → tell 'im"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|1", "text": "ask her → ask 'er"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|caution", "text": "僅限非正式口語。"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|explain", "text": "'Kinda' 和 'sorta' 在非常隨意的口語中常結合使用，以增加模糊語氣。"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|point|0", "text": "kind of sort of → kinda sorta"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|caution", "text": "非常非正式——在任何專業或考試情境中請避免使用。"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|explain", "text": "另一個快速語音的問句開頭縮合形式，與 dja 和 wouldja 並列。"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|point|0", "text": "didn't you → dincha"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|caution", "text": "用於辨識母語者的快速語音，不適用於你自己的正式口說。"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|explain", "text": "'have to' 的過去式形式和現在式一樣會弱化。"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|point|0", "text": "had to → hadta"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|caution", "text": "僅限非正式口語。"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|explain", "text": "用於非正式請求的隨性縮減形式，與 wouldja 和 couldja 類形式並列。"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|point|0", "text": "will you → willcha"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|caution", "text": "僅限非正式口語。"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|explain", "text": "含有 'of' 的數量詞組，其縮減方式與 'cuppa' 中 'cup of' 的縮減相同。"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|0", "text": "lots of → lotsa"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|1", "text": "bunch of → buncha"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|caution", "text": "僅限非正式口語。"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|explain", "text": "語氣強烈的非正式強調詞，意思是「非常了不起的／很大的」。 (a very impressive/big)"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|point|0", "text": "hell of a → helluva"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|caution", "text": "略顯粗俗——和朋友之間無妨，但避免在專業或禮貌場合使用。"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|explain", "text": "舊問候語 'how do you do' 的歷史縮減形式，現已成為獨立、隨性且友善的問候語（尤其在美國南部）。 (US)"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|point|0", "text": "how do you do → howdy"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|caution", "text": "僅限隨性、友善的問候。"}, {"key": "47538641-f573-4840-af35-02857a1d24de|explain", "text": "'I suppose' 在隨性口語中常省略中間音節，用於表達輕微的不確定或勉強同意——與 'supposed to' → s'posed to 不同。"}, {"key": "47538641-f573-4840-af35-02857a1d24de|point|0", "text": "I suppose → I s'pose"}, {"key": "47538641-f573-4840-af35-02857a1d24de|caution", "text": "僅限非正式口語——其他情況下請完整寫出 'I suppose'。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|explain", "text": "透過 50 個針對性練習精通縮減發音。仔細聆聽 AI 示範，跟著複誦並錄下你的聲音，以獲得詳細的即時發音評分與回饋。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|0", "text": "專注於每個練習中所強調的節奏、重音和語流。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|1", "text": "每次錄音前先聆聽參考示範音檔。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|2", "text": "檢視你的 AI 分數和音素級回饋，找出需要改進的地方。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|caution", "text": "不要急著做完練習；優先注重清晰度、自然的語調和準確的發音。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|0", "text": "將輔助詞極度縮減以融入自然語流。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|1", "text": "'going to' -> 'gonna'；'him' -> ''im'。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|2", "text": "'have got to' 縮減為 'gotta'。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|3", "text": "'want a' -> 'wanna'；'of' -> 'a' /ə/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|4", "text": "'has to' -> 'hasta' /hæstə/；'for' -> /fər/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|5", "text": "'let me' -> 'lemme'；'you' -> 'ya'。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|6", "text": "'give me' -> 'gimme'。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|7", "text": "'could you' -> 'couldja' /kʊdʒə/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|8", "text": "'would you' -> 'wouldja'。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|9", "text": "'what did you' -> 'whaddya'；'him' -> ''im'。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|10", "text": "'should have' -> 'shoulda' /ʃʊdə/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|11", "text": "'could have' -> 'coulda' /kʊdə/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|12", "text": "'would have' -> 'woulda' /wʊdə/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|13", "text": "'must have' -> 'musta' /mʌstə/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|14", "text": "'might have' -> 'mighta' /maɪtə/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|15", "text": "'used to' -> 'usta' /juːstə/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|16", "text": "'supposed to' -> 'sposta' /spoʊstə/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|17", "text": "'need to' -> 'needa'；'to' -> /də/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|18", "text": "'to' -> /də/；'for' -> /fər/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|19", "text": "'kind of' -> 'kinda' /kaɪndə/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|20", "text": "'sort of' -> 'sorta' /sɔːrtə/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|21", "text": "'lots of' -> 'lotsa' /lɒtsə/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|22", "text": "'out of' -> 'outta' /aʊtə/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|23", "text": "'front of' -> 'fronta'。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|24", "text": "在非正式口語中，'I am going to' 縮減為 'I'mma'。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|25", "text": "'don't you' -> 'doncha'；'want to' -> 'wanna'。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|26", "text": "'didn't you' -> 'didn'tcha'。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|27", "text": "'haven't you' -> 'haven'tcha'。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|28", "text": "'and' 縮減為成音節的 'n' /n/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|29", "text": "'day and night' -> 'day 'n night'。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|30", "text": "'or' 縮減為 /ər/；'it or' 順暢地彈舌連讀。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|31", "text": "'or' 縮減為非重讀的 /ər/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|32", "text": "'and' 在塞音之間縮減為 /n/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|33", "text": "關係代名詞 'that' 弱化為 /ðət/，帶有 schwa。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|34", "text": "連接詞 'that' 弱讀且簡短。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|35", "text": "'that' 讀作 /ðət/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|36", "text": "'them' 弱化為 ''em' /əm/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|37", "text": "'them' -> ''em'。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|38", "text": "'them' -> ''em'。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|39", "text": "'some' -> /səm/；'for' -> /fər/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|40", "text": "'for' -> /fər/；'you' -> /jə/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|41", "text": "'are' -> /ər/；'you' -> /jə/；'to' -> /tə/。"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|42", "text": "'were' 弱化為 /wər/。"}]
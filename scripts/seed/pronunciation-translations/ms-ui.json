[{"key": "pron.hero.title", "text": "Kedengaran lebih jelas, lebih semula jadi, lebih fasih"}, {"key": "pron.hero.description", "text": "Semua {{count}} bunyi bahasa Inggeris serta tekanan perkataan, tekanan ayat, intonasi, pertuturan bersambung, pengurangan, irama, pemotongan dan kefasihan — setiap pelajaran berakhir dengan rakaman anda sendiri."}, {"key": "pron.imageAlt", "text": "Sebutan Artikulasi & IPA"}, {"key": "pron.progress.title", "text": "Kemajuan sebutan anda"}, {"key": "pron.progress.descUser", "text": "Diukur daripada perkataan yang dikenal pasti oleh jurulatih dalam rakaman anda sendiri."}, {"key": "pron.progress.descGuest", "text": "Cipta akaun percuma untuk merakam diri anda dan mula menjejak kemajuan."}, {"key": "pron.recommended", "text": "Disyorkan untuk anda"}, {"key": "pron.soundLabel", "text": "Bunyi {{symbol}}"}, {"key": "pron.skill.sounds", "text": "Bunyi"}, {"key": "pron.skill.sounds.blurb", "text": "Semua 44 fonem bahasa Inggeris dengan pasangan minimal."}, {"key": "pron.skill.wordStress", "text": "Tekanan perkataan"}, {"key": "pron.skill.wordStress.blurb", "text": "Suku kata, tekanan utama dan sekunder."}, {"key": "pron.skill.sentenceStress", "text": "Tekanan ayat"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Kata kandungan kuat, kata fungsi lemah."}, {"key": "pron.skill.intonation", "text": "Intonasi"}, {"key": "pron.skill.intonation.blurb", "text": "Menaik, menurun, naik-turun dan turun-naik."}, {"key": "pron.skill.connectedSpeech", "text": "Pertuturan bersambung"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Penghubungan, elisi, asimilasi, bentuk lemah."}, {"key": "pron.skill.reductions", "text": "Pengurangan"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — bahasa Inggeris lisan tidak formal."}, {"key": "pron.skill.rhythm", "text": "Irama"}, {"key": "pron.skill.rhythm.blurb", "text": "Detik berasaskan tekanan, masa dan jeda."}, {"key": "pron.skill.chunking", "text": "Jeda & pemotongan"}, {"key": "pron.skill.chunking.blurb", "text": "Kumpulan fikiran dan jeda nafas semula jadi."}, {"key": "pron.skill.fluency", "text": "Kefasihan"}, {"key": "pron.skill.fluency.blurb", "text": "Kelajuan, keraguan, pengisi dan penghubungan idea."}, {"key": "pron.filter.searchPlaceholder", "text": "Cari bunyi, perkataan atau pelajaran"}, {"key": "pron.filter.allLevels", "text": "Semua tahap"}, {"key": "pron.filter.beginner", "text": "Pemula"}, {"key": "pron.filter.intermediate", "text": "Pertengahan"}, {"key": "pron.filter.advanced", "text": "Lanjutan"}, {"key": "pron.filter.allDifficulties", "text": "Semua kesukaran"}, {"key": "pron.filter.gentle", "text": "Lembut"}, {"key": "pron.filter.steady", "text": "Sederhana"}, {"key": "pron.filter.challenging", "text": "Mencabar"}, {"key": "pron.filter.us", "text": "Bahasa Inggeris AS"}, {"key": "pron.filter.uk", "text": "Bahasa Inggeris UK"}, {"key": "pron.sounds.title", "text": "{{count}} bunyi bahasa Inggeris"}, {"key": "pron.sounds.shown", "text": "{{count}} dipaparkan"}, {"key": "pron.lessons.title", "text": "Pelajaran {{skill}}"}, {"key": "pron.lessons.none", "text": "Tiada pelajaran sepadan dengan penapis ini. Cuba \"Semua tahap\" dan \"Semua kesukaran\"."}, {"key": "pron.how", "text": "Cara"}, {"key": "pron.commonMistakes", "text": "Kesilapan biasa"}, {"key": "pron.wordPractice", "text": "Latihan perkataan"}, {"key": "pron.sentencePractice", "text": "Latihan ayat"}, {"key": "pron.minimalPairs", "text": "Pasangan minimal"}, {"key": "pron.practise", "text": "Berlatih"}, {"key": "pron.toast.signInModel", "text": "Log masuk untuk mendengar bunyi model AI."}, {"key": "pron.toast.playError", "text": "Tidak dapat memainkan audio."}, {"key": "pron.voicedDesc", "text": "Bersuara — pita suara anda bergetar"}, {"key": "pron.voicelessDesc", "text": "Tidak bersuara — nafas sahaja, tiada getaran"}, {"key": "pron.soundPracticeHint", "text": "Ketik \"1. Dengar\" dalam kad Latihan di sebelah kanan untuk mendengar model AI bagi bunyi ini dan satu contoh."}, {"key": "pron.paywall.soundLocked", "text": "Pelajaran penuh bunyi ini — cara menghasilkannya, kedudukan mulut, contoh perkataan, ayat dan pasangan minimal — adalah sebahagian daripada Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "{{count}} bunyi pertama adalah percuma. Naik taraf untuk membuka semua 44 bunyi dan maklum balas jurulatih yang diperibadikan."}, {"key": "pron.paywall.unlockAllSounds", "text": "Buka semua 44 bunyi"}, {"key": "pron.wordPracticeHint", "text": "Klik perkataan untuk mendengar AI & berlatih"}, {"key": "pron.eg", "text": "cth."}, {"key": "pron.playing", "text": "Sedang dimainkan"}, {"key": "pron.listen", "text": "Dengar"}, {"key": "pron.paywall.lessonLocked", "text": "Penjelasan, titik latihan dan contoh pelajaran ini adalah sebahagian daripada Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "{{count}} pelajaran pertama bagi setiap kemahiran adalah percuma. Naik taraf untuk membuka yang lain."}, {"key": "pron.paywall.unlockAllLessons", "text": "Buka semua pelajaran"}, {"key": "pron.itemPracticeHint", "text": "Klik item untuk berlatih dengan AI"}, {"key": "pron.practiceHint", "text": "Dengar, ulang, rakam dan bandingkan — jurulatih menunjukkan dengan tepat perkataan mana yang disebut dengan jelas."}, {"key": "pron.drillsCount", "text": "{{count}} latihan"}, {"key": "pron.useInShadowing", "text": "Guna kemahiran ini dalam Shadowing"}, {"key": "pron.backToCoach", "text": "Kembali ke Jurulatih Pertuturan"}, {"key": "pron.p.title", "text": "Latihan"}, {"key": "pron.p.step1.label", "text": "Dengar"}, {"key": "pron.p.step1.hint", "text": "Mainkan audio contoh dua kali."}, {"key": "pron.p.step2.label", "text": "Fahami"}, {"key": "pron.p.step2.hint", "text": "Baca apa yang mulut anda perlu lakukan."}, {"key": "pron.p.step3.label", "text": "Tonton / pelajari"}, {"key": "pron.p.step3.hint", "text": "Periksa panduan mulut, lidah dan corak."}, {"key": "pron.p.step4.label", "text": "Ulang"}, {"key": "pron.p.step4.hint", "text": "Sebut dengan kuat bersama audio, perlahan dahulu."}, {"key": "pron.p.step5.label", "text": "Rakam"}, {"key": "pron.p.step5.hint", "text": "Rakam diri anda menyebut baris yang sama."}, {"key": "pron.p.step6.label", "text": "Maklum balas AI"}, {"key": "pron.p.step6.hint", "text": "Lihat apa yang jurulatih dengar dan apa yang perlu diperbaiki."}, {"key": "pron.p.step7.label", "text": "Cuba lagi"}, {"key": "pron.p.step7.hint", "text": "Betulkan satu perkara dan rakam sekali lagi."}, {"key": "pron.p.step8.label", "text": "Dikuasai"}, {"key": "pron.p.step8.hint", "text": "Bacaan jelas dua kali berturut-turut — teruskan."}, {"key": "pron.p.stepTap", "text": "{{hint}} Ketik setelah anda selesai."}, {"key": "pron.p.focusSound", "text": "Bunyi fokus {{sound}}"}, {"key": "pron.p.eg", "text": "cth. {{sentence}}"}, {"key": "pron.p.loading", "text": "Memuatkan…"}, {"key": "pron.p.speedNormal", "text": "Normal"}, {"key": "pron.p.speedSlower", "text": "Lebih perlahan"}, {"key": "pron.p.speedSlow", "text": "Perlahan"}, {"key": "pron.p.loop", "text": "Ulang"}, {"key": "pron.p.stop", "text": "Berhenti"}, {"key": "pron.p.voiceNote", "text": "Audio contoh ialah suara AI Bahasa Inggeris Amerika Lingora, bukan rakaman manusia."}, {"key": "pron.p.listenSentence", "text": "Dengar memainkan bunyi dua kali, kemudian perkataan contoh, kemudian ayat yang mengandunginya."}, {"key": "pron.p.listenExample", "text": "Dengar memainkan bunyi dua kali, kemudian contoh."}, {"key": "pron.p.recordHint", "text": "Sebut baris di atas sekali dengan jelas."}, {"key": "pron.p.signupToRecord", "text": "Cipta akaun percuma untuk merakam dan mendapat maklum balas."}, {"key": "pron.p.yourRecording", "text": "Rakaman anda"}, {"key": "pron.p.listeningRec", "text": "Mendengar rakaman anda…"}, {"key": "pron.p.wordsClear", "text": "Perkataan disebut dengan jelas"}, {"key": "pron.p.wpm", "text": "Kelajuan bertutur (wpm)"}, {"key": "pron.p.heard", "text": "Lingora dengar"}, {"key": "pron.p.tagClear", "text": "Jelas"}, {"key": "pron.p.tagNeeds", "text": "Perlu diperbaiki"}, {"key": "pron.p.measured", "text": "Penyampaian yang diukur"}, {"key": "pron.p.paceLabel", "text": "Tempo:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} perkataan seminit ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Perbualan semula jadi adalah sekitar 120–160."}, {"key": "pron.p.pace.slow", "text": "perlahan"}, {"key": "pron.p.pace.natural", "text": "semula jadi"}, {"key": "pron.p.pace.fast", "text": "laju"}, {"key": "pron.p.fillersLabel", "text": "Pengisi:"}, {"key": "pron.p.repeatedLabel", "text": "Perkataan berulang:"}, {"key": "pron.p.noneDetected", "text": "tiada dikesan"}, {"key": "pron.p.measuredNote", "text": "Tempo, pengisi dan pengulangan dikira daripada transkrip sebenar dan panjang rakaman anda. Nada, kenyaringan dan panjang jeda senyap tidak diukur, jadi kami tidak menilai intonasi atau jeda secara automatik."}, {"key": "pron.p.mastered", "text": "Dikuasai — dua percubaan yang jelas"}, {"key": "pron.p.attempt", "text": "Percubaan {{n}} — dua bacaan jelas berturut-turut menandakan baris ini sebagai dikuasai."}, {"key": "pron.p.toShadowing", "text": "Latih ini dalam pertuturan sebenar → Shadowing"}, {"key": "pron.p.toCoach", "text": "Gunakannya dengan Jurulatih Pertuturan"}]
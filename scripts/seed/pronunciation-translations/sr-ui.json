[{"key": "pron.hero.title", "text": "Zvuči jasnije, prirodnije, tečnije"}, {"key": "pron.hero.description", "text": "Svih {{count}} engleskih glasova plus akcenat reči, akcenat rečenice, intonacija, povezani govor, redukcije, ritam, segmentacija i tečnost — svaka lekcija se završava tvojim snimkom."}, {"key": "pron.imageAlt", "text": "Izgovor, artikulacija i IPA"}, {"key": "pron.progress.title", "text": "Tvoj napredak u izgovoru"}, {"key": "pron.progress.descUser", "text": "Meri se na osnovu reči koje je trener prepoznao u tvojim snimcima."}, {"key": "pron.progress.descGuest", "text": "Napravi besplatan nalog da snimiš sebe i počneš da pratiš napredak."}, {"key": "pron.recommended", "text": "Preporučeno za tebe"}, {"key": "pron.soundLabel", "text": "Glas {{symbol}}"}, {"key": "pron.skill.sounds", "text": "Glasovi"}, {"key": "pron.skill.sounds.blurb", "text": "Svih 44 engleskih fonema sa minimalnim parovima."}, {"key": "pron.skill.wordStress", "text": "Akcenat reči"}, {"key": "pron.skill.wordStress.blurb", "text": "Slogovi, primarni i sekundarni akcenat."}, {"key": "pron.skill.sentenceStress", "text": "Akcenat rečenice"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Sadržajne reči jake, funkcijske reči slabe."}, {"key": "pron.skill.intonation", "text": "Intonacija"}, {"key": "pron.skill.intonation.blurb", "text": "Rastuća, opadajuća, rastuće-opadajuća i opadajuće-rastuća."}, {"key": "pron.skill.connectedSpeech", "text": "Povezani govor"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Povezivanje, elizija, asimilacija, slabi oblici."}, {"key": "pron.skill.reductions", "text": "Redukcije"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — neformalni govorni engleski."}, {"key": "pron.skill.rhythm", "text": "Ritam"}, {"key": "pron.skill.rhythm.blurb", "text": "Takti zasnovani na akcentu, tajming i pauze."}, {"key": "pron.skill.chunking", "text": "Pauze i segmentacija"}, {"key": "pron.skill.chunking.blurb", "text": "Misaone grupe i prirodne pauze za dah."}, {"key": "pron.skill.fluency", "text": "Tečnost"}, {"key": "pron.skill.fluency.blurb", "text": "Brzina, oklevanje, poštapalice i povezivanje ideja."}, {"key": "pron.filter.searchPlaceholder", "text": "Pretraži glas, reč ili lekciju"}, {"key": "pron.filter.allLevels", "text": "Svi nivoi"}, {"key": "pron.filter.beginner", "text": "Početni"}, {"key": "pron.filter.intermediate", "text": "Srednji"}, {"key": "pron.filter.advanced", "text": "Napredni"}, {"key": "pron.filter.allDifficulties", "text": "Sve težine"}, {"key": "pron.filter.gentle", "text": "Lagano"}, {"key": "pron.filter.steady", "text": "Umereno"}, {"key": "pron.filter.challenging", "text": "Izazovno"}, {"key": "pron.filter.us", "text": "Američki engleski"}, {"key": "pron.filter.uk", "text": "Britanski engleski"}, {"key": "pron.sounds.title", "text": "{{count}} engleskih glasova"}, {"key": "pron.sounds.shown", "text": "Prikazano {{count}}"}, {"key": "pron.lessons.title", "text": "Lekcije: {{skill}}"}, {"key": "pron.lessons.none", "text": "Nijedna lekcija ne odgovara ovim filterima. Probaj „Svi nivoi“ i „Sve težine“."}, {"key": "pron.how", "text": "Kako"}, {"key": "pron.commonMistakes", "text": "Česte greške"}, {"key": "pron.wordPractice", "text": "Vežba reči"}, {"key": "pron.sentencePractice", "text": "Vežba rečenica"}, {"key": "pron.minimalPairs", "text": "Minimalni parovi"}, {"key": "pron.practise", "text": "Vežbaj"}, {"key": "pron.toast.signInModel", "text": "Prijavi se da čuješ AI model."}, {"key": "pron.toast.playError", "text": "Nije moguće pustiti zvuk."}, {"key": "pron.voicedDesc", "text": "Zvučno — glasne žice vibriraju"}, {"key": "pron.voicelessDesc", "text": "Bezvučno — samo dah, bez vibracije"}, {"key": "pron.soundPracticeHint", "text": "Dodirni „1. Slušaj“ u kartici za vežbu desno da čuješ AI model ovog glasa i primer."}, {"key": "pron.paywall.soundLocked", "text": "Kompletna lekcija za ovaj glas — kako se izgovara, položaj usta, primeri reči, rečenice i minimalni parovi — deo je Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "Prvih {{count}} glasova je besplatno. Nadogradi paket da otključaš svih 44 glasa i personalizovane povratne informacije trenera."}, {"key": "pron.paywall.unlockAllSounds", "text": "Otključaj svih 44 glasa"}, {"key": "pron.wordPracticeHint", "text": "Klikni na reč da čuješ AI i vežbaš"}, {"key": "pron.eg", "text": "npr."}, {"key": "pron.playing", "text": "Reprodukcija"}, {"key": "pron.listen", "text": "Slušaj"}, {"key": "pron.paywall.lessonLocked", "text": "Objašnjenje ove lekcije, tačke za vežbu i primeri deo su Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "Prvih {{count}} lekcija svake veštine je besplatno. Nadogradi nalog da otključaš ostalo."}, {"key": "pron.paywall.unlockAllLessons", "text": "Otključaj sve lekcije"}, {"key": "pron.itemPracticeHint", "text": "Klikni na stavku za vežbu sa AI"}, {"key": "pron.practiceHint", "text": "Slušaj, ponavljaj, snimaj i uporedi — trener ti pokazuje tačno koje su reči bile jasne."}, {"key": "pron.drillsCount", "text": "{{count}} vežbi"}, {"key": "pron.useInShadowing", "text": "Koristi ovu veštinu u Shadowingu"}, {"key": "pron.backToCoach", "text": "Nazad na Speaking Coach"}, {"key": "pron.p.title", "text": "Vežba"}, {"key": "pron.p.step1.label", "text": "Slušaj"}, {"key": "pron.p.step1.hint", "text": "Pusti model audio dva puta."}, {"key": "pron.p.step2.label", "text": "Razumi"}, {"key": "pron.p.step2.hint", "text": "Pročitaj šta tvoja usta treba da rade."}, {"key": "pron.p.step3.label", "text": "Gledaj / uči"}, {"key": "pron.p.step3.hint", "text": "Pogledaj vodič za usta, jezik i obrazac."}, {"key": "pron.p.step4.label", "text": "Ponavljaj"}, {"key": "pron.p.step4.hint", "text": "Izgovori naglas uz audio, prvo polako."}, {"key": "pron.p.step5.label", "text": "Snimi"}, {"key": "pron.p.step5.hint", "text": "Snimi sebe kako izgovaraš istu rečenicu."}, {"key": "pron.p.step6.label", "text": "AI povratna informacija"}, {"key": "pron.p.step6.hint", "text": "Vidi šta je trener čuo i šta treba popraviti."}, {"key": "pron.p.step7.label", "text": "Pokušaj ponovo"}, {"key": "pron.p.step7.hint", "text": "Popravi jednu stvar i snimi još jednom."}, {"key": "pron.p.step8.label", "text": "Savladano"}, {"key": "pron.p.step8.hint", "text": "Jasno pročitano dva puta zaredom — idi dalje."}, {"key": "pron.p.stepTap", "text": "{{hint}} Klikni kada završiš."}, {"key": "pron.p.focusSound", "text": "Fokus na glas {{sound}}"}, {"key": "pron.p.eg", "text": "npr. {{sentence}}"}, {"key": "pron.p.loading", "text": "Učitavanje…"}, {"key": "pron.p.speedNormal", "text": "Normalno"}, {"key": "pron.p.speedSlower", "text": "Sporije"}, {"key": "pron.p.speedSlow", "text": "Sporo"}, {"key": "pron.p.loop", "text": "Ponavljanje"}, {"key": "pron.p.stop", "text": "Zaustavi"}, {"key": "pron.p.voiceNote", "text": "Model audio je Lingora AI glas američkog engleskog, nije ljudski snimak."}, {"key": "pron.p.listenSentence", "text": "Slušaj pušta glas dva puta, zatim primer reči, pa rečenicu koja je sadrži."}, {"key": "pron.p.listenExample", "text": "Slušaj pušta glas dva puta, zatim primer."}, {"key": "pron.p.recordHint", "text": "Izgovori gornju rečenicu jednom, jasno."}, {"key": "pron.p.signupToRecord", "text": "Napravi besplatan nalog da snimaš i dobiješ povratnu informaciju."}, {"key": "pron.p.yourRecording", "text": "Tvoj snimak"}, {"key": "pron.p.listeningRec", "text": "Slušam tvoj snimak…"}, {"key": "pron.p.wordsClear", "text": "Jasno izgovorene reči"}, {"key": "pron.p.wpm", "text": "Brzina govora (reči/min)"}, {"key": "pron.p.heard", "text": "Lingora je čula"}, {"key": "pron.p.tagClear", "text": "Jasno"}, {"key": "pron.p.tagNeeds", "text": "Treba poboljšanje"}, {"key": "pron.p.measured", "text": "Izmereno izlaganje"}, {"key": "pron.p.paceLabel", "text": "Tempo:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} reči u minuti ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Prirodan razgovor je oko 120–160."}, {"key": "pron.p.pace.slow", "text": "sporo"}, {"key": "pron.p.pace.natural", "text": "prirodno"}, {"key": "pron.p.pace.fast", "text": "brzo"}, {"key": "pron.p.fillersLabel", "text": "Poštapalice:"}, {"key": "pron.p.repeatedLabel", "text": "Ponovljene reči:"}, {"key": "pron.p.noneDetected", "text": "nije pronađeno"}, {"key": "pron.p.measuredNote", "text": "Tempo, poštapalice i ponavljanja se računaju iz tvog stvarnog transkripta i dužine snimka. Visina tona, glasnoća i dužina tihih pauza se ne mere, pa ne ocenjujemo intonaciju ni pauze automatski."}, {"key": "pron.p.mastered", "text": "Savladano — dva jasna pokušaja"}, {"key": "pron.p.attempt", "text": "Pokušaj {{n}} — dva jasna čitanja zaredom označavaju ovu rečenicu kao savladanu."}, {"key": "pron.p.toShadowing", "text": "Vežbaj ovo u stvarnom govoru → Shadowing"}, {"key": "pron.p.toCoach", "text": "Koristi to sa Speaking Coach"}]
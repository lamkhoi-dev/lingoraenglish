[{"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|point|3", "text": "got to → gotta"}, {"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|caution", "text": "Estas são formas informais da fala. Não as escreva em redações, e-mails ou exames formais, e evite-as em uma apresentação formal."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|explain", "text": "Mais reduções casuais que você ouvirá constantemente em filmes e conversas reais."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|0", "text": "kind of → kinda"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|1", "text": "sort of → sorta"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|2", "text": "let me → lemme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|3", "text": "give me → gimme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|4", "text": "what do you → whaddaya"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|caution", "text": "Apenas informal. Em um IELTS ou entrevista de emprego, mantenha as formas completas."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|explain", "text": "Mais reduções de obrigação e hábito comuns no inglês falado descontraído."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|0", "text": "have to → hafta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|1", "text": "need to → needa"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|2", "text": "used to → useta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|caution", "text": "Apenas formas informais da fala — nunca as escreva."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|explain", "text": "Reduções de modais no passado — muito comuns ao falar sobre arrependimentos ou situações hipotéticas."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|0", "text": "could have → coulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|1", "text": "would have → woulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|2", "text": "should have → shoulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|caution", "text": "Apenas informal falado — escreva 'could have' por extenso em textos formais."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|explain", "text": "Reduções muito casuais comuns em músicas, filmes e conversas descontraídas entre amigos."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|0", "text": "don't know → dunno"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|1", "text": "don't you → dontcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|2", "text": "what are you → whatcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|caution", "text": "Muito informal — apenas com amigos próximos, nunca em contextos profissionais ou de exame."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|explain", "text": "Reduções comuns ligadas a preposições na fala casual."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|0", "text": "out of → outta"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|1", "text": "off of → offa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|2", "text": "cup of → cuppa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|caution", "text": "Apenas informal."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|explain", "text": "Exclamações do dia a dia e frases casuais com forte redução."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|0", "text": "come on → c'mon"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|1", "text": "going to be → gonna be"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|2", "text": "some more → s'more"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|caution", "text": "Apenas informal."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|explain", "text": "Iniciadores de perguntas reduzem bastante em conversa rápida e casual."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|0", "text": "did you → dja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|1", "text": "do you → dya"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|2", "text": "would you → wouldja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|caution", "text": "Apenas para contextos casuais e falados."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|explain", "text": "A fala casual também costuma reduzir expressões de tempo."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|0", "text": "a couple of → a couple"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|1", "text": "in a minute → in a min"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|caution", "text": "Aceitável na fala casual, não na escrita."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|explain", "text": "Reduções casuais mais comuns, ouvidas constantemente em conversas descontraídas."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|0", "text": "probably → prolly"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|1", "text": "trying to → tryna"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|2", "text": "supposed to → s'posed to"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|caution", "text": "Apenas falado informal."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|explain", "text": "Reduções casuais comuns entre amigos e na fala informal americana."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|0", "text": "let's go → less go"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|1", "text": "give it to me → gimme that"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|2", "text": "you all → y'all"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|caution", "text": "Muito informal — 'y'all' é regional (Sul dos EUA), mas amplamente compreendido. (US)"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|explain", "text": "Números redondos reduzem os sons consonantais do meio na fala americana rápida e casual."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|0", "text": "twenty → twenny"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|1", "text": "hundred → hunnerd"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|caution", "text": "Apenas falado informal — diga sempre a forma completa em contextos formais."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|explain", "text": "Um outro conjunto de palavras do dia a dia que regularmente perdem uma sílaba na fala rápida e descontraída."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|0", "text": "different → diff'rent"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|1", "text": "general → gen'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|2", "text": "several → sev'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|3", "text": "camera → cam'ra"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|caution", "text": "Adequado na fala casual; diga a forma completa claramente em apresentações formais."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|explain", "text": "Reduções muito informais que você ouvirá em músicas e na fala americana casual, mas que nunca devem ser usadas em contextos profissionais."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|0", "text": "I'm going to → I'ma"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|1", "text": "kind of like → kinda like"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|caution", "text": "Extremamente informal — apenas entre amigos/em letras de música, nunca em contextos profissionais."}, {"key": "551b9527-f712-421d-966c-24644f360746|explain", "text": "Reduções extras de cumprimentos do dia a dia além de what's up / how's it going."}, {"key": "551b9527-f712-421d-966c-24644f360746|point|0", "text": "how are you → how ya doin'"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|1", "text": "good to see you → good to see ya"}, {"key": "551b9527-f712-421d-966c-24644f360746|caution", "text": "Apenas formas faladas casuais."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|explain", "text": "Mais reduções de obrigação e desejo comuns na fala americana descontraída."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|0", "text": "ought to → oughta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|1", "text": "don't have to → don't hafta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|2", "text": "want you → wantcha"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|caution", "text": "Apenas na fala informal."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|explain", "text": "Este é um exemplo clássico de até onde a redução casual americana pode chegar — várias palavras se fundem no que soa como uma só."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|0", "text": "Did you eat yet? → Jeetyet?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|1", "text": "Did you already? → Jeetalready?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|caution", "text": "Extremamente informal — para reconhecer a fala nativa rápida, não para a sua própria fala formal."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|explain", "text": "Mais duas reduções comuns em nível de frase na conversa casual."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|0", "text": "because of → 'cause of"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|1", "text": "sort of a → sorta a"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|caution", "text": "Apenas na fala informal."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|explain", "text": "Alternativas casuais muito comuns para 'yes' e 'no' no inglês falado descontraído."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|0", "text": "yes → yep / uh-huh"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|1", "text": "no → nope / nah"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|caution", "text": "Apenas em conversa casual — use 'yes'/'no' em contextos formais ou de exame."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|explain", "text": "Ambos se reduzem a um 'wanna' de som semelhante, mas um é seguido por um substantivo e o outro por um verbo — vale a pena notar a diferença."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|0", "text": "want a (coffee) → wanna coffee"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|1", "text": "want to (go) → wanna go"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|caution", "text": "Apenas na fala informal."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|0", "text": "'want a' + substantivo → wanna"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|1", "text": "'want to' + verbo → wanna"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|explain", "text": "A versão negativa de 'would have' reduz-se da mesma forma que a forma positiva."}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|point|0", "text": "wouldn't have → wouldn'ta"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|caution", "text": "Apenas na fala informal — caso contrário, escreva 'wouldn't have' por extenso."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|explain", "text": "Mais duas reduções do dia a dia comuns em explicações e pedidos casuais."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|0", "text": "just because → just 'cause"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|1", "text": "going to need → gonna need"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|caution", "text": "Apenas na fala informal."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|explain", "text": "'Ain't' substitui am not/is not/are not/has not/have not na fala muito casual e é ouvido em todo lugar em músicas e conversas informais."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|0", "text": "I am not → I ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|1", "text": "that is not → that ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|2", "text": "you have not → you ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|caution", "text": "Nunca use na escrita ou na fala formal — é considerado gramática não padrão, mesmo sendo extremamente comum informalmente."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|explain", "text": "Uma forma casual muito comum de dizer 'I understand' ou literalmente 'caught you'."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|0", "text": "got you (entender) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|1", "text": "got you (pegar) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|caution", "text": "Apenas na fala informal — diga 'I understand' ou 'got it' em contextos profissionais."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|explain", "text": "Reduções de modal-perfect usadas para suposições sobre o passado, junto com coulda/woulda/shoulda."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|0", "text": "must have → musta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|1", "text": "might have → mighta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|caution", "text": "Apenas na fala informal — caso contrário, escreva 'must have'/'might have' por extenso."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|explain", "text": "As contrapartes negativas de coulda/woulda/shoulda, comuns ao falar sobre arrependimentos."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|0", "text": "shouldn't have → shouldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|1", "text": "couldn't have → couldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|caution", "text": "Apenas na fala informal — escreva 'shouldn't have'/'couldn't have' por extenso em contextos formais."}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|explain", "text": "Na fala relaxada, o som final -ing frequentemente perde o 'g', soando como -in'. Isso acontece com quase qualquer verbo terminado em -ing. (, so it sounds like -in)"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|0", "text": "doing → doin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|1", "text": "going → goin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|2", "text": "talking → talkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|3", "text": "thinking → thinkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|caution", "text": "Apenas na fala casual — pronuncie o '-ing' completo e claro em apresentações, entrevistas e exames."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|explain", "text": "O mesmo padrão de omissão do g se aplica a pronomes indefinidos terminados em -thing."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|0", "text": "something → somethin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|1", "text": "nothing → nothin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|2", "text": "anything → anythin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|caution", "text": "Apenas na fala casual."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|explain", "text": "'Them' reduz para 'em (o 'th' cai) depois de um verbo, na fala casual muito comum."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|0", "text": "tell them → tell 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|1", "text": "get them → get 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|2", "text": "ask them → ask 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|caution", "text": "Apenas na fala informal — diga 'them' por extenso na escrita ou em fala formal."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|explain", "text": "'And' reduz para um som rápido de 'n' entre duas palavras estreitamente ligadas, especialmente em expressões fixas."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|0", "text": "rock and roll → rock 'n' roll"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|1", "text": "fish and chips → fish 'n' chips"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|2", "text": "back and forth → back 'n' forth"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|caution", "text": "Comum em expressões fixas e na fala rápida — diga 'and' claramente na escrita formal."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|explain", "text": "'Because' sozinho (não apenas 'because of') frequentemente encurta para 'cause em respostas casuais."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|point|0", "text": "because → 'cause"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|caution", "text": "Apenas na fala informal — escreva 'because' por extenso em outros contextos."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|explain", "text": "'Of course' frequentemente perde a primeira palavra em respostas rápidas e casuais."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|point|0", "text": "of course → 'course"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|caution", "text": "Apenas na fala casual."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|explain", "text": "Uma pronúncia casual muito comum de 'all right', usada para concordar ou reconhecer."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|point|0", "text": "all right → aight"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|caution", "text": "Muito informal — diga 'all right' ou 'okay' em contextos profissionais."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|explain", "text": "'Let you' reduz da mesma forma que 'want you'/'wantcha'."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|point|0", "text": "let you → letcha"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|caution", "text": "Apenas na fala informal."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|explain", "text": "Outra fusão extrema da fala rápida, semelhante a 'jeetyet' — várias palavras se comprimem em um único som."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|point|0", "text": "did you ever → jever"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|caution", "text": "Para reconhecer a fala nativa rápida, não para a sua própria fala formal."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|explain", "text": "Duas reduções se acumulam quando 'going to' e 'have to' aparecem lado a lado."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|point|0", "text": "going to have to → gonna hafta"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|caution", "text": "Apenas na fala informal — caso contrário, escreva 'going to have to' por extenso."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|explain", "text": "A redução 'gonna' também se aplica com negativas e no passado."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|0", "text": "not going to → not gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|1", "text": "wasn't going to → wasn't gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|caution", "text": "Apenas na fala informal."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|explain", "text": "Uma redução muito comum de tag question no inglês britânico, usada para confirmar ou dar ênfase."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|point|0", "text": "isn't it → innit"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|caution", "text": "Gíria britânica muito informal — não use em fala formal, nem mesmo no Reino Unido. (UK)"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|explain", "text": "Uma forma casual de propor algo ou pedir concordância."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|point|0", "text": "what do you say → whaddya say"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|caution", "text": "Apenas na fala informal."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|explain", "text": "Uma expressão de preenchimento extremamente comum no inglês falado casual, usada enquanto se pensa ou para dar ênfase."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|point|0", "text": "you know → y'know"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|caution", "text": "Apenas como muleta casual — usá-la em excesso soa deselegante até na informalidade."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|explain", "text": "Uma saudação bem casual, encurtada de 'what's up'."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|point|0", "text": "what's up → s'up"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|caution", "text": "Saudação muito informal, apenas entre amigos."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|explain", "text": "'Him' e 'her' também se enfraquecem na fala casual, semelhante a 'them' → 'em."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|0", "text": "tell him → tell 'im"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|1", "text": "ask her → ask 'er"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|caution", "text": "Apenas na fala informal."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|explain", "text": "'Kinda' e 'sorta' são frequentemente combinados para reforçar a hesitação na fala muito casual."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|point|0", "text": "kind of sort of → kinda sorta"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|caution", "text": "Muito informal — evite em qualquer contexto profissional ou de exame."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|explain", "text": "Outra fusão de início de pergunta na fala rápida, junto com dja e wouldja."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|point|0", "text": "didn't you → dincha"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|caution", "text": "Para reconhecer a fala nativa rápida, não para a sua própria fala formal."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|explain", "text": "A forma no passado de 'have to' reduz da mesma maneira que a forma no presente."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|point|0", "text": "had to → hadta"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|caution", "text": "Apenas na fala informal."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|explain", "text": "Uma redução casual usada em pedidos informais, junto com formas do tipo wouldja e couldja."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|point|0", "text": "will you → willcha"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|caution", "text": "Apenas na fala informal."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|explain", "text": "Expressões de quantidade com 'of' reduzem da mesma maneira que 'cup of' em 'cuppa'."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|0", "text": "lots of → lotsa"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|1", "text": "bunch of → buncha"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|caution", "text": "Apenas na fala informal."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|explain", "text": "Um intensificador informal forte que significa 'muito impressionante/grande'. (a very impressive/big)"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|point|0", "text": "hell of a → helluva"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|caution", "text": "Levemente vulgar — tudo bem com amigos, evite em contextos profissionais ou formais."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|explain", "text": "Uma redução histórica da antiga saudação 'how do you do', agora uma saudação casual e amigável por si só (especialmente no sul dos EUA). (US)"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|point|0", "text": "how do you do → howdy"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|caution", "text": "Apenas como saudação casual e amigável."}, {"key": "47538641-f573-4840-af35-02857a1d24de|explain", "text": "'I suppose' costuma perder a sílaba do meio na fala casual, usado para expressar leve incerteza ou concordância relutante — diferente de 'supposed to' → s'posed to."}, {"key": "47538641-f573-4840-af35-02857a1d24de|point|0", "text": "I suppose → I s'pose"}, {"key": "47538641-f573-4840-af35-02857a1d24de|caution", "text": "Apenas na fala informal — escreva 'I suppose' por extenso em outros casos."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|explain", "text": "Domine as reduções com 50 exercícios direcionados. Ouça com atenção o modelo de IA, repita e grave sua voz para receber pontuação e feedback detalhados de pronúncia em tempo real. (AI)"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|0", "text": "Concentre-se no ritmo, na tônica e na fluidez destacados em cada exercício."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|1", "text": "Ouça o áudio do modelo de referência antes de cada tentativa de gravação."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|2", "text": "Revise sua pontuação da IA e o feedback em nível de fonema para identificar pontos de melhoria. (AI)"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|caution", "text": "Não faça os exercícios com pressa; priorize a clareza, a cadência natural e a articulação precisa."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|0", "text": "Redução extrema de palavras auxiliares para uma fluidez natural."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|1", "text": "'going to' -> 'gonna'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|2", "text": "'have got to' reduz para 'gotta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|3", "text": "'want a' -> 'wanna'; 'of' -> 'a' /ə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|4", "text": "'has to' -> 'hasta' /hæstə/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|5", "text": "'let me' -> 'lemme'; 'you' -> 'ya'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|6", "text": "'give me' -> 'gimme'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|7", "text": "'could you' -> 'couldja' /kʊdʒə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|8", "text": "'would you' -> 'wouldja'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|9", "text": "'what did you' -> 'whaddya'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|10", "text": "'should have' -> 'shoulda' /ʃʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|11", "text": "'could have' -> 'coulda' /kʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|12", "text": "'would have' -> 'woulda' /wʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|13", "text": "'must have' -> 'musta' /mʌstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|14", "text": "'might have' -> 'mighta' /maɪtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|15", "text": "'used to' -> 'usta' /juːstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|16", "text": "'supposed to' -> 'sposta' /spoʊstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|17", "text": "'need to' -> 'needa'; 'to' -> /də/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|18", "text": "'to' -> /də/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|19", "text": "'kind of' -> 'kinda' /kaɪndə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|20", "text": "'sort of' -> 'sorta' /sɔːrtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|21", "text": "'lots of' -> 'lotsa' /lɒtsə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|22", "text": "'out of' -> 'outta' /aʊtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|23", "text": "'front of' -> 'fronta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|24", "text": "'I am going to' reduz-se a 'I'mma' na fala informal."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|25", "text": "'don't you' -> 'doncha'; 'want to' -> 'wanna'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|26", "text": "'didn't you' -> 'didn'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|27", "text": "'haven't you' -> 'haven'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|28", "text": "'and' reduz-se ao 'n' silábico /n/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|29", "text": "'day and night' -> 'day 'n night'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|30", "text": "'or' reduz-se a /ər/; 'it or' liga-se suavemente."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|31", "text": "'or' reduz-se a /ər/ átono."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|32", "text": "'and' reduz-se a /n/ entre oclusivas."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|33", "text": "O 'that' relativo reduz-se para /ðət/ com schwa."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|34", "text": "A conjunção 'that' é fraca e curta."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|35", "text": "'that' assume /ðət/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|36", "text": "'them' reduz-se para ''em' /əm/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|37", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|38", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|39", "text": "'some' -> /səm/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|40", "text": "'for' -> /fər/; 'you' -> /jə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|41", "text": "'are' -> /ər/; 'you' -> /jə/; 'to' -> /tə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|42", "text": "'were' reduz-se para /wər/."}]
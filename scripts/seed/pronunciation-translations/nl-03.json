[{"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|point|3", "text": "got to → gotta"}, {"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|caution", "text": "Dit zijn informele spreektaalvormen. Schrijf ze niet in essays, e-mails of formele examens, en vermijd ze in een formele presentatie."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|explain", "text": "Meer informele verkortingen die je voortdurend hoort in films en echte gesprekken."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|0", "text": "kind of → kinda"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|1", "text": "sort of → sorta"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|2", "text": "let me → lemme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|3", "text": "give me → gimme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|4", "text": "what do you → whaddaya"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|caution", "text": "Alleen informeel. In een IELTS of sollicitatiegesprek gebruik je de volledige vormen."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|explain", "text": "Meer verkortingen van verplichting en gewoonte die veel voorkomen in ontspannen spreektaal."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|0", "text": "have to → hafta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|1", "text": "need to → needa"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|2", "text": "used to → useta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|caution", "text": "Alleen informele spreektaalvormen — schrijf ze nooit."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|explain", "text": "Verkortingen van verleden modale werkwoorden — heel gebruikelijk bij het praten over spijt of hypothetische situaties."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|0", "text": "could have → coulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|1", "text": "would have → woulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|2", "text": "should have → shoulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|caution", "text": "Alleen informeel gesproken — schrijf 'could have' voluit in formeel schrijfwerk."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|explain", "text": "Zeer informele verkortingen die veel voorkomen in liedjes, films en ontspannen gesprekken tussen vrienden."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|0", "text": "don't know → dunno"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|1", "text": "don't you → dontcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|2", "text": "what are you → whatcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|caution", "text": "Zeer informeel — alleen met goede vrienden, nooit in professionele of examencontexten."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|explain", "text": "Veelvoorkomende verkortingen met voorzetsels in informele spraak."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|0", "text": "out of → outta"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|1", "text": "off of → offa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|2", "text": "cup of → cuppa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|caution", "text": "Alleen informeel."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|explain", "text": "Alledaagse uitroepen en informele zinnen met sterke verkorting."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|0", "text": "come on → c'mon"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|1", "text": "going to be → gonna be"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|2", "text": "some more → s'more"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|caution", "text": "Alleen informeel."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|explain", "text": "Vraagwoorden aan het begin worden sterk gereduceerd in snelle, informele gesprekken."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|0", "text": "did you → dja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|1", "text": "do you → dya"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|2", "text": "would you → wouldja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|caution", "text": "Alleen in informele, gesproken contexten."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|explain", "text": "In informeel taalgebruik worden tijdsaanduidingen vaak ook gereduceerd."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|0", "text": "a couple of → a couple"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|1", "text": "in a minute → in a min"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|caution", "text": "Prima in informele gesprekken, niet in schrijftaal."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|explain", "text": "Meer veelvoorkomende informele reducties die voortdurend te horen zijn in ontspannen gesprekken."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|0", "text": "probably → prolly"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|1", "text": "trying to → tryna"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|2", "text": "supposed to → s'posed to"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|caution", "text": "Alleen informeel gesproken."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|explain", "text": "Informele reducties die veel voorkomen onder vrienden en in Amerikaans informeel taalgebruik."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|0", "text": "let's go → less go"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|1", "text": "give it to me → gimme that"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|2", "text": "you all → y'all"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|caution", "text": "Zeer informeel — 'y'all' is regionaal (Zuidelijke VS) maar wordt breed begrepen. (US)"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|explain", "text": "Ronde getallen verliezen hun medeklinkers in het midden in snel, informeel Amerikaans taalgebruik."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|0", "text": "twenty → twenny"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|1", "text": "hundred → hunnerd"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|caution", "text": "Alleen informeel gesproken — zeg altijd de volledige vorm in formele contexten."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|explain", "text": "Een andere reeks alledaagse woorden die regelmatig een lettergreep verliezen in snel, ontspannen taalgebruik."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|0", "text": "different → diff'rent"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|1", "text": "general → gen'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|2", "text": "several → sev'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|3", "text": "camera → cam'ra"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|caution", "text": "Prima in informele spraak; zeg de volledige vorm duidelijk in formele presentaties."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|explain", "text": "Zeer informele reducties die je hoort in liedjes en informele Amerikaanse spraak, maar die je nooit in professionele situaties mag gebruiken."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|0", "text": "I'm going to → I'ma"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|1", "text": "kind of like → kinda like"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|caution", "text": "Extreem informeel — alleen onder vrienden of in songteksten, nooit in professionele contexten."}, {"key": "551b9527-f712-421d-966c-24644f360746|explain", "text": "Extra alledaagse begroetingsreducties naast what's up / how's it going."}, {"key": "551b9527-f712-421d-966c-24644f360746|point|0", "text": "how are you → how ya doin'"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|1", "text": "good to see you → good to see ya"}, {"key": "551b9527-f712-421d-966c-24644f360746|caution", "text": "Alleen informele gesproken vormen."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|explain", "text": "Meer reducties van verplichting en verlangen die veel voorkomen in ontspannen Amerikaanse spraak."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|0", "text": "ought to → oughta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|1", "text": "don't have to → don't hafta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|2", "text": "want you → wantcha"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|caution", "text": "Alleen informeel gesproken."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|explain", "text": "Dit is een klassiek voorbeeld van hoe ver informele Amerikaanse reductie kan gaan — meerdere woorden versmelten tot wat als één woord klinkt."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|0", "text": "Did you eat yet? → Jeetyet?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|1", "text": "Did you already? → Jeetalready?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|caution", "text": "Extreem informeel — om snelle moedertaalspraak te herkennen, niet voor je eigen formele spraak."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|explain", "text": "Nog twee veelvoorkomende reducties op zinsniveau in informele gesprekken."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|0", "text": "because of → 'cause of"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|1", "text": "sort of a → sorta a"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|caution", "text": "Alleen informeel gesproken."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|explain", "text": "Zeer gebruikelijke informele alternatieven voor 'yes' en 'no' in ontspannen gesproken Engels."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|0", "text": "yes → yep / uh-huh"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|1", "text": "no → nope / nah"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|caution", "text": "Alleen in informele gesprekken — gebruik 'yes'/'no' in formele of examencontexten."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|explain", "text": "Beide reduceren tot een gelijkaardig klinkende 'wanna', maar de ene wordt gevolgd door een zelfstandig naamwoord en de andere door een werkwoord — let op het verschil."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|0", "text": "want a (coffee) → wanna coffee"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|1", "text": "want to (go) → wanna go"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|caution", "text": "Alleen informeel gesproken."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|0", "text": "'want a' + zelfstandig naamwoord → wanna"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|1", "text": "'want to' + werkwoord → wanna"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|explain", "text": "De negatieve vorm van 'would have' wordt op dezelfde manier verkort als de positieve vorm."}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|point|0", "text": "wouldn't have → wouldn'ta"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|caution", "text": "Alleen informeel gesproken — schrijf anders 'wouldn't have' voluit."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|explain", "text": "Nog twee alledaagse verkortingen die veel voorkomen bij informele uitleg en verzoeken."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|0", "text": "just because → just 'cause"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|1", "text": "going to need → gonna need"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|caution", "text": "Alleen informeel gesproken."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|explain", "text": "'Ain't' vervangt am not/is not/are not/has not/have not in zeer informeel taalgebruik en is overal te horen in liedjes en informele gesprekken."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|0", "text": "I am not → I ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|1", "text": "that is not → that ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|2", "text": "you have not → you ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|caution", "text": "Gebruik dit nooit in schrijftaal of formele spraak — het wordt beschouwd als niet-standaard grammatica, ook al is het extreem gebruikelijk in informeel taalgebruik."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|explain", "text": "Een zeer gebruikelijke informele manier om 'I understand' te zeggen of letterlijk 'caught you'."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|0", "text": "got you (begrijpen) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|1", "text": "got you (betrappen) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|caution", "text": "Alleen informeel gesproken — zeg 'I understand' of 'got it' in professionele contexten."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|explain", "text": "Verkortingen van modaal + perfect die gebruikt worden voor gissingen over het verleden, naast coulda/woulda/shoulda."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|0", "text": "must have → musta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|1", "text": "might have → mighta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|caution", "text": "Alleen informeel gesproken — schrijf anders 'must have'/'might have' voluit."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|explain", "text": "De negatieve tegenhangers van coulda/woulda/shoulda, veelvoorkomend bij het praten over spijt."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|0", "text": "shouldn't have → shouldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|1", "text": "couldn't have → couldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|caution", "text": "Alleen informeel gesproken — schrijf 'shouldn't have'/'couldn't have' voluit in formele contexten."}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|explain", "text": "In ontspannen spraak laat de eindklank -ing vaak de 'g' weg, zodat het klinkt als -in'. Dit gebeurt bij bijna elk werkwoord op -ing. (, so it sounds like -in)"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|0", "text": "doing → doin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|1", "text": "going → goin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|2", "text": "talking → talkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|3", "text": "thinking → thinkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|caution", "text": "Alleen in informele spraak — spreek de volledige '-ing' duidelijk uit in presentaties, sollicitatiegesprekken en examens."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|explain", "text": "Hetzelfde patroon van het weglaten van de 'g' geldt voor onbepaalde voornaamwoorden die eindigen op -thing."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|0", "text": "something → somethin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|1", "text": "nothing → nothin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|2", "text": "anything → anythin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|caution", "text": "Alleen in informele spraak."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|explain", "text": "'Them' wordt 'em (de 'th' valt weg) na een werkwoord, in zeer alledaagse informele spraak."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|0", "text": "tell them → tell 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|1", "text": "get them → get 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|2", "text": "ask them → ask 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|caution", "text": "Alleen in informele gesproken taal — zeg 'them' voluit in schrijftaal of formele spraak."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|explain", "text": "'And' wordt een snelle 'n'-klank tussen twee nauw verbonden woorden, vooral in vaste uitdrukkingen."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|0", "text": "rock and roll → rock 'n' roll"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|1", "text": "fish and chips → fish 'n' chips"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|2", "text": "back and forth → back 'n' forth"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|caution", "text": "Gebruikelijk in vaste uitdrukkingen en snel spraak — schrijf 'and' duidelijk in formele teksten."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|explain", "text": "'Because' op zichzelf (niet alleen 'because of') wordt vaak verkort tot 'cause in informele antwoorden."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|point|0", "text": "because → 'cause"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|caution", "text": "Alleen in informele gesproken taal — schrijf anders 'because' voluit."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|explain", "text": "'Of course' laat in snelle, informele antwoorden vaak het eerste woord weg."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|point|0", "text": "of course → 'course"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|caution", "text": "Alleen in informele spraak."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|explain", "text": "Een zeer gebruikelijke informele uitspraak van 'all right', gebruikt om in te stemmen of te bevestigen."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|point|0", "text": "all right → aight"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|caution", "text": "Zeer informeel — zeg 'all right' of 'okay' in professionele contexten."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|explain", "text": "'Let you' wordt op dezelfde manier verkort als 'want you'/'wantcha'."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|point|0", "text": "let you → letcha"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|caution", "text": "Alleen informeel gesproken taal."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|explain", "text": "Nog een extreem snelle spraakversmelting, vergelijkbaar met 'jeetyet' — meerdere woorden worden tot één klank samengeperst."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|point|0", "text": "did you ever → jever"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|caution", "text": "Om snelle moedertaalspraak te herkennen, niet voor je eigen formele spraak."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|explain", "text": "Twee reducties stapelen zich op wanneer 'going to' en 'have to' naast elkaar staan."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|point|0", "text": "going to have to → gonna hafta"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|caution", "text": "Alleen informeel gesproken taal — schrijf anders 'going to have to' voluit."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|explain", "text": "De reductie 'gonna' geldt ook bij ontkenningen en de verleden tijd."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|0", "text": "not going to → not gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|1", "text": "wasn't going to → wasn't gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|caution", "text": "Alleen informeel gesproken taal."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|explain", "text": "Een zeer gangbare Brits-Engelse reductie van een tag question, gebruikt om te bevestigen of extra nadruk te leggen."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|point|0", "text": "isn't it → innit"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|caution", "text": "Zeer informeel Brits slang — gebruik het niet in formele spraak, zelfs niet in het Verenigd Koninkrijk. (UK)"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|explain", "text": "Een informele manier om iets voor te stellen of om instemming te vragen."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|point|0", "text": "what do you say → whaddya say"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|caution", "text": "Alleen informeel gesproken taal."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|explain", "text": "Een extreem gangbare stopwoordzin in informeel gesproken Engels, gebruikt tijdens het nadenken of voor nadruk."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|point|0", "text": "you know → y'know"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|caution", "text": "Alleen als informeel stopwoord — te veel gebruik klinkt slordig, zelfs informeel."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|explain", "text": "Een zeer informele begroeting, verkort van 'what's up'."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|point|0", "text": "what's up → s'up"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|caution", "text": "Zeer informele begroeting, alleen tussen vrienden."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|explain", "text": "'Him' en 'her' verzwakken ook in informele spraak, net als 'them' → 'em."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|0", "text": "tell him → tell 'im"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|1", "text": "ask her → ask 'er"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|caution", "text": "Alleen informeel gesproken taal."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|explain", "text": "'Kinda' en 'sorta' worden vaak gecombineerd voor extra verzachting in zeer informele spraak."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|point|0", "text": "kind of sort of → kinda sorta"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|caution", "text": "Zeer informeel — vermijd dit in elke professionele of examencontext."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|explain", "text": "Nog een snelle vraagwoordcombinatie in spraak, naast dja en wouldja."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|point|0", "text": "didn't you → dincha"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|caution", "text": "Om snelle moedertaalspraak te herkennen, niet voor je eigen formele spraak."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|explain", "text": "De verleden tijdsvorm van 'have to' wordt op dezelfde manier gereduceerd als de tegenwoordige tijd."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|point|0", "text": "had to → hadta"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|caution", "text": "Alleen informeel gesproken."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|explain", "text": "Een informele reductie gebruikt bij informele verzoeken, naast vormen zoals wouldja en couldja."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|point|0", "text": "will you → willcha"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|caution", "text": "Alleen informeel gesproken."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|explain", "text": "Hoeveelheidsuitdrukkingen met 'of' worden op dezelfde manier gereduceerd als 'cup of' in 'cuppa'."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|0", "text": "lots of → lotsa"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|1", "text": "bunch of → buncha"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|caution", "text": "Alleen informeel gesproken."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|explain", "text": "Een sterke informele versterker die 'een zeer indrukwekkende/grote' betekent. (a very impressive/big)"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|point|0", "text": "hell of a → helluva"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|caution", "text": "Enigszins grof — prima bij vrienden, vermijd in professionele of beleefde situaties."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|explain", "text": "Een historische reductie van de oude begroeting 'how do you do', nu een eigen informele, vriendelijke begroeting (vooral in het zuiden van de VS). (US)"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|point|0", "text": "how do you do → howdy"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|caution", "text": "Alleen als informele, vriendelijke begroeting."}, {"key": "47538641-f573-4840-af35-02857a1d24de|explain", "text": "'I suppose' laat in informele spraak vaak de middelste lettergreep weg; het drukt milde onzekerheid of tegenzin uit — te onderscheiden van 'supposed to' → s'posed to."}, {"key": "47538641-f573-4840-af35-02857a1d24de|point|0", "text": "I suppose → I s'pose"}, {"key": "47538641-f573-4840-af35-02857a1d24de|caution", "text": "Alleen informeel gesproken — schrijf anders 'I suppose' voluit."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|explain", "text": "Beheers reducties met 50 gerichte oefeningen. Luister aandachtig naar het AI-model, herhaal en neem je stem op om gedetailleerde real-time uitspraakscores en feedback te ontvangen."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|0", "text": "Focus op het ritme, de klemtoon en de flow die in elke oefening worden benadrukt."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|1", "text": "Luister naar de referentie-audio van het model voor elke opnamepoging."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|2", "text": "Bekijk je AI-score en feedback op foneemniveau om verbeterpunten te vinden."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|caution", "text": "Haast je niet door de oefeningen; geef prioriteit aan duidelijkheid, natuurlijk ritme en nauwkeurige articulatie."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|0", "text": "Extreme reductie van hulpwoorden tot een natuurlijke flow."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|1", "text": "'going to' -> 'gonna'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|2", "text": "'have got to' reduceert tot 'gotta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|3", "text": "'want a' -> 'wanna'; 'of' -> 'a' /ə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|4", "text": "'has to' -> 'hasta' /hæstə/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|5", "text": "'let me' -> 'lemme'; 'you' -> 'ya'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|6", "text": "'give me' -> 'gimme'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|7", "text": "'could you' -> 'couldja' /kʊdʒə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|8", "text": "'would you' -> 'wouldja'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|9", "text": "'what did you' -> 'whaddya'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|10", "text": "'should have' -> 'shoulda' /ʃʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|11", "text": "'could have' -> 'coulda' /kʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|12", "text": "'would have' -> 'woulda' /wʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|13", "text": "'must have' -> 'musta' /mʌstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|14", "text": "'might have' -> 'mighta' /maɪtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|15", "text": "'used to' -> 'usta' /juːstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|16", "text": "'supposed to' -> 'sposta' /spoʊstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|17", "text": "'need to' -> 'needa'; 'to' -> /də/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|18", "text": "'to' -> /də/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|19", "text": "'kind of' -> 'kinda' /kaɪndə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|20", "text": "'sort of' -> 'sorta' /sɔːrtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|21", "text": "'lots of' -> 'lotsa' /lɒtsə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|22", "text": "'out of' -> 'outta' /aʊtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|23", "text": "'front of' -> 'fronta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|24", "text": "'I am going to' wordt in informeel taalgebruik gereduceerd tot 'I'mma'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|25", "text": "'don't you' -> 'doncha'; 'want to' -> 'wanna'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|26", "text": "'didn't you' -> 'didn'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|27", "text": "'haven't you' -> 'haven'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|28", "text": "'and' wordt gereduceerd tot syllabische 'n' /n/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|29", "text": "'day and night' -> 'day 'n night'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|30", "text": "'or' wordt gereduceerd tot /ər/; 'it or' versmelt naadloos."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|31", "text": "'or' wordt gereduceerd tot onbeklemtoonde /ər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|32", "text": "'and' wordt gereduceerd tot /n/ tussen plosieven."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|33", "text": "Betrekkelijk 'that' reduceert tot /ðət/ met schwa."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|34", "text": "Voegwoord 'that' is zwak en kort."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|35", "text": "'that' krijgt /ðət/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|36", "text": "'them' reduceert tot ''em' /əm/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|37", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|38", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|39", "text": "'some' -> /səm/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|40", "text": "'for' -> /fər/; 'you' -> /jə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|41", "text": "'are' -> /ər/; 'you' -> /jə/; 'to' -> /tə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|42", "text": "'were' reduceert tot /wər/."}]
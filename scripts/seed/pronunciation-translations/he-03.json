[{"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|point|3", "text": "got to → gotta"}, {"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|caution", "text": "אלו צורות דיבור לא רשמיות. אל תכתבו אותן בחיבורים, במיילים או במבחנים רשמיים, והימנעו מהן בפרזנטציות רשמיות."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|explain", "text": "צמצומי דיבור יומיומיים נוספים שתשמעו ללא הרף בסרטים ובשיחות אמיתיות."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|0", "text": "kind of → kinda"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|1", "text": "sort of → sorta"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|2", "text": "let me → lemme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|3", "text": "give me → gimme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|4", "text": "what do you → whaddaya"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|caution", "text": "לשימוש לא רשמי בלבד. בבחינת IELTS או בראיון עבודה, השתמשו בצורות המלאות."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|explain", "text": "צמצומים נוספים של חובה והרגל הנפוצים באנגלית מדוברת ומשוחררת."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|0", "text": "have to → hafta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|1", "text": "need to → needa"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|2", "text": "used to → useta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|caution", "text": "צורות דיבור לא רשמיות בלבד — לעולם אל תכתבו אותן."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|explain", "text": "צמצומים של פועלי עזר בעבר — נפוצים מאוד כשמדברים על חרטות או מצבים היפותטיים."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|0", "text": "could have → coulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|1", "text": "would have → woulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|2", "text": "should have → shoulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|caution", "text": "לדיבור לא רשמי בלבד — בכתיבה רשמית כתבו 'could have' במלואו."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|explain", "text": "צמצומים יומיומיים מאוד הנפוצים בשירים, בסרטים ובשיחות קלילות בין חברים."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|0", "text": "don't know → dunno"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|1", "text": "don't you → dontcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|2", "text": "what are you → whatcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|caution", "text": "מאוד לא רשמי — לשימוש עם חברים קרובים בלבד, לעולם לא בהקשר מקצועי או במבחן."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|explain", "text": "צמצומים נפוצים הקשורים למילות יחס בדיבור יומיומי."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|0", "text": "out of → outta"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|1", "text": "off of → offa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|2", "text": "cup of → cuppa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|caution", "text": "לשימוש לא רשמי בלבד."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|explain", "text": "קריאות יומיומיות וביטויים ספונטניים עם צמצום כבד."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|0", "text": "come on → c'mon"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|1", "text": "going to be → gonna be"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|2", "text": "some more → s'more"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|caution", "text": "לשימוש לא רשמי בלבד."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|explain", "text": "מילות פתיחה של שאלות מצטמצמות במידה רבה בדיבור מהיר ויומיומי."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|0", "text": "did you → dja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|1", "text": "do you → dya"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|2", "text": "would you → wouldja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|caution", "text": "להקשרים מדוברים ויומיומיים בלבד."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|explain", "text": "בדיבור יומיומי מצמצמים לעיתים קרובות גם ביטויי זמן."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|0", "text": "a couple of → a couple"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|1", "text": "in a minute → in a min"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|caution", "text": "מתאים לשיחה יומיומית, לא לכתיבה."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|explain", "text": "קיצורים נפוצים נוספים שנשמעים ללא הרף בשיחה יומיומית משוחררת."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|0", "text": "probably → prolly"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|1", "text": "trying to → tryna"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|2", "text": "supposed to → s'posed to"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|caution", "text": "לדיבור לא רשמי בלבד."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|explain", "text": "קיצורים יומיומיים הנפוצים בין חברים ובדיבור אמריקאי לא רשמי."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|0", "text": "let's go → less go"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|1", "text": "give it to me → gimme that"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|2", "text": "you all → y'all"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|caution", "text": "מאוד לא רשמי — 'y'all' הוא מאפיין אזורי (דרום ה-US) אך מובן היטב."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|explain", "text": "במספרים עגולים, עיצורי האמצע מתקצרים או נעלמים בדיבור אמריקאי מהיר ויומיומי."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|0", "text": "twenty → twenny"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|1", "text": "hundred → hunnerd"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|caution", "text": "לדיבור לא רשמי בלבד — בהקשרים רשמיים הקפידו תמיד להגות את הצורה המלאה."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|explain", "text": "קבוצה נוספת של מילים יומיומיות שמשמיטות הברה באופן קבוע בדיבור מהיר ומשוחרר."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|0", "text": "different → diff'rent"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|1", "text": "general → gen'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|2", "text": "several → sev'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|3", "text": "camera → cam'ra"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|caution", "text": "מתאים לדיבור יומיומי; במצגות רשמיות הגו את הצורה המלאה בבירור."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|explain", "text": "קיצורים מאוד לא רשמיים שתשמעו בשירים ובדיבור אמריקאי יומיומי, אך לעולם אין להשתמש בהם במסגרות מקצועיות."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|0", "text": "I'm going to → I'ma"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|1", "text": "kind of like → kinda like"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|caution", "text": "לא רשמי במיוחד — מתאים לחברים או למילות שירים בלבד, לעולם לא בהקשר מקצועי."}, {"key": "551b9527-f712-421d-966c-24644f360746|explain", "text": "קיצורים יומיומיים נוספים לברכות שלום, מעבר ל-what's up / how's it going."}, {"key": "551b9527-f712-421d-966c-24644f360746|point|0", "text": "how are you → how ya doin'"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|1", "text": "good to see you → good to see ya"}, {"key": "551b9527-f712-421d-966c-24644f360746|caution", "text": "צורות דיבור יומיומיות בלבד."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|explain", "text": "קיצורים נוספים להבעת חובה ורצון הנפוצים בדיבור אמריקאי משוחרר."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|0", "text": "ought to → oughta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|1", "text": "don't have to → don't hafta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|2", "text": "want you → wantcha"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|caution", "text": "לדיבור לא רשמי בלבד."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|explain", "text": "זו דוגמה קלאסית עד כמה קיצורי דיבור אמריקאיים יכולים להרחיק לכת — כמה מילים מתמזגות למשהו שנשמע כמו מילה אחת."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|0", "text": "Did you eat yet? → Jeetyet?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|1", "text": "Did you already? → Jeetalready?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|caution", "text": "לא רשמי במיוחד — נועד לזיהוי דיבור מהיר של דוברי שפת אם, לא לשימוש בדיבור הרשמי שלכם."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|explain", "text": "עוד שני צמצומי ביטויים נפוצים בשיחה יומיומית."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|0", "text": "because of → 'cause of"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|1", "text": "sort of a → sorta a"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|caution", "text": "לדיבור בלתי-רשמי בלבד."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|explain", "text": "חלופות יומיומיות נפוצות מאוד ל-'yes' ול-'no' באנגלית מדוברת ומשוחררת."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|0", "text": "yes → yep / uh-huh"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|1", "text": "no → nope / nah"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|caution", "text": "לשיחה יומיומית בלבד — השתמשו ב-'yes'/'no' בהקשרים רשמיים או במבחנים."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|explain", "text": "שניהם מצטמצמים ל-'wanna' שנשמע דומה, אך אחרי האחד מגיע שם עצם ואחרי השני פועל — כדאי לשים לב להבדל."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|0", "text": "want a (coffee) → wanna coffee"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|1", "text": "want to (go) → wanna go"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|caution", "text": "לדיבור בלתי-רשמי בלבד."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|0", "text": "'want a' + שם עצם → wanna"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|1", "text": "'want to' + פועל → wanna"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|explain", "text": "צורת השלילה של 'would have' מצטמצמת באותו אופן כמו צורת החיוב."}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|point|0", "text": "wouldn't have → wouldn'ta"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|caution", "text": "לדיבור בלתי-רשמי בלבד — אחרת, כתבו 'wouldn't have' במלואו."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|explain", "text": "עוד שני צמצומים יומיומיים הנפוצים בהסברים ובבקשות לא רשמיות."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|0", "text": "just because → just 'cause"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|1", "text": "going to need → gonna need"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|caution", "text": "לדיבור בלתי-רשמי בלבד."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|explain", "text": "'Ain't' מחליף את am not/is not/are not/has not/have not בדיבור יומיומי מאוד, ונשמע בכל מקום בשירים ובשיחה בלתי-פורמלית."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|0", "text": "I am not → I ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|1", "text": "that is not → that ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|2", "text": "you have not → you ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|caution", "text": "לעולם אל תשתמשו בזה בכתיבה או בדיבור רשמי — נחשב לדקדוק לא תקני, אף שנפוץ ביותר בדיבור לא רשמי."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|explain", "text": "דרך יומיומית ונפוצה מאוד לומר 'I understand' או במובן המילולי 'caught you'."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|0", "text": "got you (הבנתי) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|1", "text": "got you (תפסתי אותך) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|caution", "text": "לדיבור בלתי-רשמי בלבד — בהקשרים מקצועיים השתמשו ב-'I understand' או 'got it'."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|explain", "text": "צמצומי מודאל-פרפקט המשמשים להשערות לגבי העבר, לצד coulda/woulda/shoulda."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|0", "text": "must have → musta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|1", "text": "might have → mighta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|caution", "text": "לדיבור בלתי-רשמי בלבד — אחרת, כתבו 'must have'/'might have' במלואם."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|explain", "text": "הגרסאות השליליות של coulda/woulda/shoulda, נפוצות כשמדברים על חרטות."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|0", "text": "shouldn't have → shouldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|1", "text": "couldn't have → couldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|caution", "text": "לדיבור בלתי-רשמי בלבד — בהקשרים רשמיים כתבו 'shouldn't have'/'couldn't have' במלואם."}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|explain", "text": "בדיבור משוחרר, צליל ה- -ing בסיום מילה משמיט לעיתים קרובות את ה-'g' שלו, כך שהוא נשמע כמו -in'. זה קורה כמעט בכל פועל שמסתיים ב- -ing. (, so it sounds like -in)"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|0", "text": "doing → doin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|1", "text": "going → goin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|2", "text": "talking → talkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|3", "text": "thinking → thinkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|caution", "text": "לדיבור יומיומי בלבד — הגו את ה-'-ing' המלא בבירור במצגות, ראיונות ומבחנים."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|explain", "text": "אותה תבנית של השמטת g חלה גם על כינויים בלתי מוגדרים המסתיימים ב--thing."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|0", "text": "something → somethin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|1", "text": "nothing → nothin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|2", "text": "anything → anythin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|caution", "text": "לדיבור יומיומי בלבד."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|explain", "text": "'Them' מצטמצמת ל-'em (ה-'th' מושמטת) אחרי פועל, בדיבור יומיומי נפוץ מאוד."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|0", "text": "tell them → tell 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|1", "text": "get them → get 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|2", "text": "ask them → ask 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|caution", "text": "לדיבור לא רשמי בלבד — אמרו 'them' במלואה בכתיבה או בדיבור רשמי."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|explain", "text": "'And' מצטמצמת לצליל 'n' מהיר בין שתי מילים קשורות, במיוחד בביטויים כבולים."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|0", "text": "rock and roll → rock 'n' roll"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|1", "text": "fish and chips → fish 'n' chips"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|2", "text": "back and forth → back 'n' forth"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|caution", "text": "נפוץ בביטויים כבולים ובדיבור מהיר — אמרו 'and' בבירור בכתיבה רשמית."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|explain", "text": "'Because' בפני עצמה (לא רק ב-'because of') מתקצרת לעיתים קרובות ל-'cause בתשובות יומיומיות."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|point|0", "text": "because → 'cause"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|caution", "text": "לדיבור לא רשמי בלבד — בכל מצב אחר כתבו 'because' במלואה."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|explain", "text": "'Of course' משמיטה לעיתים קרובות את המילה הראשונה שלה בתשובות מהירות ויומיומיות."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|point|0", "text": "of course → 'course"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|caution", "text": "לדיבור יומיומי בלבד."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|explain", "text": "הגייה יומיומית נפוצה מאוד של 'all right', המשמשת להבעת הסכמה או אישור."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|point|0", "text": "all right → aight"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|caution", "text": "לא רשמי במיוחד — בהקשרים מקצועיים אמרו 'all right' או 'okay'."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|explain", "text": "'Let you' מצטמצמת באותו אופן כמו 'want you'/'wantcha'."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|point|0", "text": "let you → letcha"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|caution", "text": "לדיבור לא רשמי בלבד."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|explain", "text": "מיזוג קיצוני נוסף בדיבור מהיר, בדומה ל-'jeetyet' — מספר מילים נדחסות לצליל אחד."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|point|0", "text": "did you ever → jever"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|caution", "text": "נועד לזיהוי דיבור מהיר של דוברי שפת אם, לא לשימוש בדיבור הרשמי שלכם."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|explain", "text": "שני צמצומים מצטברים יחד כאשר 'going to' ו-'have to' מופיעות זו לצד זו."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|point|0", "text": "going to have to → gonna hafta"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|caution", "text": "לדיבור לא רשמי בלבד — בכל מצב אחר כתבו 'going to have to' במלואה."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|explain", "text": "צמצום ה-'gonna' חל גם במשפטי שלילה ובזמן עבר."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|0", "text": "not going to → not gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|1", "text": "wasn't going to → wasn't gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|caution", "text": "לשפה מדוברת לא רשמית בלבד."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|explain", "text": "צמצום נפוץ מאוד של שאלת תגית באנגלית בריטית, המשמש לאישור או להוספת הדגשה."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|point|0", "text": "isn't it → innit"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|caution", "text": "סלנג בריטי מאוד לא רשמי — אין להשתמש בו בדיבור רשמי, אפילו ב-UK."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|explain", "text": "דרך יומיומית להציע משהו או לבקש הסכמה."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|point|0", "text": "what do you say → whaddya say"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|caution", "text": "לשפה מדוברת לא רשמית בלבד."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|explain", "text": "מילת מילוי נפוצה במיוחד באנגלית מדוברת יומיומית, המשמשת בזמן מחשבה או להדגשה."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|point|0", "text": "you know → y'know"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|caution", "text": "מילת מילוי לדיבור יומיומי בלבד — שימוש מופרז בה נשמע לא מלוטש, אפילו בשיחה לא רשמית."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|explain", "text": "ברכת שלום יומיומית מאוד, מקוצרת מ-'what's up'."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|point|0", "text": "what's up → s'up"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|caution", "text": "ברכת שלום מאוד לא רשמית, בין חברים בלבד."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|explain", "text": "המילים 'Him' ו-'her' נחלשות גם הן בדיבור יומיומי, בדומה ל-'them' → 'em."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|0", "text": "tell him → tell 'im"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|1", "text": "ask her → ask 'er"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|caution", "text": "לשפה מדוברת לא רשמית בלבד."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|explain", "text": "לעיתים קרובות משלבים את 'Kinda' ו-'sorta' לריכוך או לסיוג נוסף בדיבור יומיומי מאוד."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|point|0", "text": "kind of sort of → kinda sorta"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|caution", "text": "מאוד לא רשמי — הימנעו משימוש בהקשר מקצועי או במבחנים."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|explain", "text": "חיבור נוסף לתחילת שאלה בדיבור מהיר, לצד dja ו-wouldja."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|point|0", "text": "didn't you → dincha"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|caution", "text": "מיועד לזיהוי דיבור מהיר של דוברי שפת אם, לא לשימוש בדיבור הרשמי שלכם."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|explain", "text": "צורת העבר של 'have to' מצטמצמת באותו האופן שבו מצטמצמת צורת ההווה."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|point|0", "text": "had to → hadta"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|caution", "text": "לשפה מדוברת לא רשמית בלבד."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|explain", "text": "צמצום יומיומי המשמש בבקשות לא רשמיות, לצד צורות בסגנון wouldja ו-couldja."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|point|0", "text": "will you → willcha"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|caution", "text": "לשפה מדוברת לא רשמית בלבד."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|explain", "text": "ביטויי כמות עם 'of' מצטמצמים בדיוק כפי ש-'cup of' מצטמצם ב-'cuppa'."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|0", "text": "lots of → lotsa"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|1", "text": "bunch of → buncha"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|caution", "text": "לשפה מדוברת לא רשמית בלבד."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|explain", "text": "מילת העצמה חזקה ולא רשמית שמשמעותה 'a very impressive/big'."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|point|0", "text": "hell of a → helluva"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|caution", "text": "מעט גס — מתאים עם חברים, אך יש להימנע מכך במסגרות מקצועיות או מנומסות."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|explain", "text": "צמצום היסטורי של ברכת השלום הישנה 'how do you do', שכיום הפך לברכת שלום יומיומית וידידותית בפני עצמה (במיוחד בדרום ה-US)."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|point|0", "text": "how do you do → howdy"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|caution", "text": "ברכת שלום יומיומית וידידותית בלבד."}, {"key": "47538641-f573-4840-af35-02857a1d24de|explain", "text": "הביטוי 'I suppose' משמיט בדרך כלל את ההברה האמצעית בדיבור יומיומי, ומשמש להבעת חוסר ודאות קלה או הסכמה מסויגת — להבדיל מ-'supposed to' → s'posed to."}, {"key": "47538641-f573-4840-af35-02857a1d24de|point|0", "text": "I suppose → I s'pose"}, {"key": "47538641-f573-4840-af35-02857a1d24de|caution", "text": "לדיבור לא רשמי בלבד — בכל מצב אחר יש לכתוב 'I suppose' במלואה."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|explain", "text": "שלטו בצורות המצומצמות לאורך 50 תרגילים ממוקדים. הקשיבו היטב למודל ה-AI, חזרו אחריו והקליטו את קולכם כדי לקבל ציון ומשוב הגייה מפורטים בזמן אמת."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|0", "text": "התמקדו במקצב, בהטעמה ובשטף המודגשים בכל תרגיל."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|1", "text": "האזינו להקלטת המודל להדגמה לפני כל ניסיון הקלטה."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|2", "text": "עיינו בציון ה-AI שלכם ובמשוב ברמת הפונמות כדי לאתר נקודות לשיפור."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|caution", "text": "אל תמהרו בתרגילים; תנו עדיפות לבהירות, למקצב טבעי ולהגייה מדויקת."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|0", "text": "צמצום קיצוני של מילות עזר לכדי שטף דיבור טבעי."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|1", "text": "'going to' -> 'gonna'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|2", "text": "'have got to' מצטמצם ל-'gotta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|3", "text": "'want a' -> 'wanna'; 'of' -> 'a' /ə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|4", "text": "'has to' -> 'hasta' /hæstə/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|5", "text": "'let me' -> 'lemme'; 'you' -> 'ya'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|6", "text": "'give me' -> 'gimme'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|7", "text": "'could you' -> 'couldja' /kʊdʒə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|8", "text": "'would you' -> 'wouldja'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|9", "text": "'what did you' -> 'whaddya'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|10", "text": "'should have' -> 'shoulda' /ʃʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|11", "text": "'could have' -> 'coulda' /kʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|12", "text": "'would have' -> 'woulda' /wʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|13", "text": "'must have' -> 'musta' /mʌstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|14", "text": "'might have' -> 'mighta' /maɪtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|15", "text": "'used to' -> 'usta' /juːstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|16", "text": "'supposed to' -> 'sposta' /spoʊstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|17", "text": "'need to' -> 'needa'; 'to' -> /də/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|18", "text": "'to' -> /də/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|19", "text": "'kind of' -> 'kinda' /kaɪndə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|20", "text": "'sort of' -> 'sorta' /sɔːrtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|21", "text": "'lots of' -> 'lotsa' /lɒtsə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|22", "text": "'out of' -> 'outta' /aʊtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|23", "text": "'front of' -> 'fronta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|24", "text": "'I am going to' מצטמצם ל-'I'mma' בדיבור לא רשמי."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|25", "text": "'don't you' -> 'doncha'; 'want to' -> 'wanna'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|26", "text": "'didn't you' -> 'didn'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|27", "text": "'haven't you' -> 'haven'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|28", "text": "'and' מצטמצמת ל-'n' הברתית /n/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|29", "text": "'day and night' -> 'day 'n night'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|30", "text": "'or' מצטמצמת ל-/ər/; הצירוף 'it or' נהגה עם flap בצורה חלקה."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|31", "text": "'or' מצטמצמת ל-/ər/ לא מוטעמת."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|32", "text": "'and' מצטמצמת ל-/n/ בין עיצורים סותמים."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|33", "text": "כינוי הזיקה 'that' מצטמצם ל-/ðət/ עם תנועת שווא (schwa)."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|34", "text": "מילת החיבור 'that' נהגית בצורה חלשה וקצרה."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|35", "text": "'that' מקבלת את הצליל /ðət/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|36", "text": "'them' מצטמצמת ל-''em' /əm/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|37", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|38", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|39", "text": "'some' -> /səm/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|40", "text": "'for' -> /fər/; 'you' -> /jə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|41", "text": "'are' -> /ər/; 'you' -> /jə/; 'to' -> /tə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|42", "text": "'were' מצטמצמת ל-/wər/."}]
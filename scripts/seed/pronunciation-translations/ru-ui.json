[{"key": "pron.hero.title", "text": "Говорите чётче, естественнее и беглее"}, {"key": "pron.hero.description", "text": "Все {{count}} звуков английского, а также ударение в словах, фразовое ударение, интонация, связная речь, редукция, ритм, деление на смысловые группы и беглость — каждый урок завершается вашей собственной записью."}, {"key": "pron.imageAlt", "text": "Артикуляция и МФА"}, {"key": "pron.progress.title", "text": "Ваш прогресс в произношении"}, {"key": "pron.progress.descUser", "text": "Измеряется по словам, которые тренер распознал в ваших записях."}, {"key": "pron.progress.descGuest", "text": "Создайте бесплатный аккаунт, чтобы записывать себя и отслеживать прогресс."}, {"key": "pron.recommended", "text": "Рекомендовано для вас"}, {"key": "pron.soundLabel", "text": "Звук {{symbol}}"}, {"key": "pron.skill.sounds", "text": "Звуки"}, {"key": "pron.skill.sounds.blurb", "text": "Все 44 фонемы английского с минимальными парами."}, {"key": "pron.skill.wordStress", "text": "Ударение в словах"}, {"key": "pron.skill.wordStress.blurb", "text": "Слоги, основное и второстепенное ударение."}, {"key": "pron.skill.sentenceStress", "text": "Фразовое ударение"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Знаменательные слова — сильные, служебные — слабые."}, {"key": "pron.skill.intonation", "text": "Интонация"}, {"key": "pron.skill.intonation.blurb", "text": "Восходящий, нисходящий, восходяще-нисходящий и нисходяще-восходящий тоны."}, {"key": "pron.skill.connectedSpeech", "text": "Связная речь"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Связывание, элизия, ассимиляция, слабые формы."}, {"key": "pron.skill.reductions", "text": "Редукция"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — неформальная разговорная речь."}, {"key": "pron.skill.rhythm", "text": "Ритм"}, {"key": "pron.skill.rhythm.blurb", "text": "Тактовый ритм, timing и паузы."}, {"key": "pron.skill.chunking", "text": "Паузы и смысловые группы"}, {"key": "pron.skill.chunking.blurb", "text": "Смысловые группы и естественные паузы для дыхания."}, {"key": "pron.skill.fluency", "text": "Беглость"}, {"key": "pron.skill.fluency.blurb", "text": "Скорость, запинки, слова-заполнители и связывание идей."}, {"key": "pron.filter.searchPlaceholder", "text": "Поиск звука, слова или урока"}, {"key": "pron.filter.allLevels", "text": "Все уровни"}, {"key": "pron.filter.beginner", "text": "Начальный"}, {"key": "pron.filter.intermediate", "text": "Средний"}, {"key": "pron.filter.advanced", "text": "Продвинутый"}, {"key": "pron.filter.allDifficulties", "text": "Любая сложность"}, {"key": "pron.filter.gentle", "text": "Лёгкий"}, {"key": "pron.filter.steady", "text": "Умеренный"}, {"key": "pron.filter.challenging", "text": "Сложный"}, {"key": "pron.filter.us", "text": "Американский английский"}, {"key": "pron.filter.uk", "text": "Британский английский"}, {"key": "pron.sounds.title", "text": "{{count}} звуков английского"}, {"key": "pron.sounds.shown", "text": "Показано: {{count}}"}, {"key": "pron.lessons.title", "text": "Уроки: {{skill}}"}, {"key": "pron.lessons.none", "text": "Ни один урок не соответствует этим фильтрам. Попробуйте «Все уровни» и «Любая сложность»."}, {"key": "pron.how", "text": "Как"}, {"key": "pron.commonMistakes", "text": "Типичные ошибки"}, {"key": "pron.wordPractice", "text": "Отработка слов"}, {"key": "pron.sentencePractice", "text": "Отработка предложений"}, {"key": "pron.minimalPairs", "text": "Минимальные пары"}, {"key": "pron.practise", "text": "Практика"}, {"key": "pron.toast.signInModel", "text": "Войдите, чтобы услышать образец ИИ."}, {"key": "pron.toast.playError", "text": "Не удалось воспроизвести аудио."}, {"key": "pron.voicedDesc", "text": "Звонкий — голосовые связки вибрируют"}, {"key": "pron.voicelessDesc", "text": "Глухой — только выдох, без вибрации"}, {"key": "pron.soundPracticeHint", "text": "Нажмите «1. Слушать» в карточке практики справа, чтобы услышать образец ИИ для этого звука и пример."}, {"key": "pron.paywall.soundLocked", "text": "Полный урок по этому звуку — как его произносить, положение рта, примеры слов, предложения и минимальные пары — входит в Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "Первые {{count}} звуков бесплатны. Перейдите на Premium, чтобы открыть все 44 звука и персональные отзывы тренера."}, {"key": "pron.paywall.unlockAllSounds", "text": "Открыть все 44 звука"}, {"key": "pron.wordPracticeHint", "text": "Нажмите на слово, чтобы услышать ИИ и потренироваться"}, {"key": "pron.eg", "text": "напр."}, {"key": "pron.playing", "text": "Воспроизведение"}, {"key": "pron.listen", "text": "Слушать"}, {"key": "pron.paywall.lessonLocked", "text": "Объяснение, практические советы и примеры этого урока входят в Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "Первые {{count}} уроков каждого навыка бесплатны. Оформите подписку, чтобы открыть остальные."}, {"key": "pron.paywall.unlockAllLessons", "text": "Открыть все уроки"}, {"key": "pron.itemPracticeHint", "text": "Нажмите на элемент, чтобы потренироваться с ИИ"}, {"key": "pron.practiceHint", "text": "Слушайте, повторяйте, записывайте и сравнивайте — тренер покажет, какие слова прозвучали чётко."}, {"key": "pron.drillsCount", "text": "{{count}} упражнений"}, {"key": "pron.useInShadowing", "text": "Применить этот навык в Шедоуинге"}, {"key": "pron.backToCoach", "text": "Назад к Разговорному тренеру"}, {"key": "pron.p.title", "text": "Практика"}, {"key": "pron.p.step1.label", "text": "Слушайте"}, {"key": "pron.p.step1.hint", "text": "Прослушайте образец дважды."}, {"key": "pron.p.step2.label", "text": "Поймите"}, {"key": "pron.p.step2.hint", "text": "Прочитайте, что должны делать ваши губы."}, {"key": "pron.p.step3.label", "text": "Смотрите / изучайте"}, {"key": "pron.p.step3.hint", "text": "Изучите положение губ, языка и схему."}, {"key": "pron.p.step4.label", "text": "Повторяйте"}, {"key": "pron.p.step4.hint", "text": "Проговорите вслух вместе с аудио, сначала медленно."}, {"key": "pron.p.step5.label", "text": "Запишите"}, {"key": "pron.p.step5.hint", "text": "Запишите себя, произнося ту же фразу."}, {"key": "pron.p.step6.label", "text": "Обратная связь ИИ"}, {"key": "pron.p.step6.hint", "text": "Посмотрите, что услышал тренер и что нужно исправить."}, {"key": "pron.p.step7.label", "text": "Попробуйте снова"}, {"key": "pron.p.step7.hint", "text": "Исправьте одну вещь и запишите ещё раз."}, {"key": "pron.p.step8.label", "text": "Освоено"}, {"key": "pron.p.step8.hint", "text": "Два чётких прочтения подряд — переходите дальше."}, {"key": "pron.p.stepTap", "text": "{{hint}} Нажмите, когда выполните."}, {"key": "pron.p.focusSound", "text": "Отработка звука {{sound}}"}, {"key": "pron.p.eg", "text": "напр. {{sentence}}"}, {"key": "pron.p.loading", "text": "Загрузка…"}, {"key": "pron.p.speedNormal", "text": "Обычная"}, {"key": "pron.p.speedSlower", "text": "Медленнее"}, {"key": "pron.p.speedSlow", "text": "Медленно"}, {"key": "pron.p.loop", "text": "Повтор"}, {"key": "pron.p.stop", "text": "Стоп"}, {"key": "pron.p.voiceNote", "text": "Образец озвучен ИИ-голосом Lingora с американским английским, это не запись человека."}, {"key": "pron.p.listenSentence", "text": "«Слушать» воспроизводит звук дважды, затем пример-слово, затем предложение с ним."}, {"key": "pron.p.listenExample", "text": "«Слушать» воспроизводит звук дважды, затем пример."}, {"key": "pron.p.recordHint", "text": "Произнесите строку выше один раз, чётко."}, {"key": "pron.p.signupToRecord", "text": "Создайте бесплатный аккаунт, чтобы записывать и получать обратную связь."}, {"key": "pron.p.yourRecording", "text": "Ваша запись"}, {"key": "pron.p.listeningRec", "text": "Прослушиваем вашу запись…"}, {"key": "pron.p.wordsClear", "text": "Слова, сказанные чётко"}, {"key": "pron.p.wpm", "text": "Скорость речи (слов/мин)"}, {"key": "pron.p.heard", "text": "Lingora услышала"}, {"key": "pron.p.tagClear", "text": "Чётко"}, {"key": "pron.p.tagNeeds", "text": "Нужно улучшить"}, {"key": "pron.p.measured", "text": "Измеренные показатели"}, {"key": "pron.p.paceLabel", "text": "Темп:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} слов в минуту ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Естественный разговор — примерно 120–160."}, {"key": "pron.p.pace.slow", "text": "медленный"}, {"key": "pron.p.pace.natural", "text": "естественный"}, {"key": "pron.p.pace.fast", "text": "быстрый"}, {"key": "pron.p.fillersLabel", "text": "Слова-заполнители:"}, {"key": "pron.p.repeatedLabel", "text": "Повторяющиеся слова:"}, {"key": "pron.p.noneDetected", "text": "не обнаружено"}, {"key": "pron.p.measuredNote", "text": "Темп, слова-заполнители и повторы подсчитываются по вашей реальной расшифровке и длительности записи. Высота тона, громкость и длина пауз не измеряются, поэтому мы не оцениваем интонацию и паузы автоматически."}, {"key": "pron.p.mastered", "text": "Освоено — две чёткие попытки"}, {"key": "pron.p.attempt", "text": "Попытка {{n}} — две чётких записи подряд отмечают эту строку как освоенную."}, {"key": "pron.p.toShadowing", "text": "Отработайте это в реальной речи → Шедоуинг"}, {"key": "pron.p.toCoach", "text": "Примените с Разговорным тренером"}]
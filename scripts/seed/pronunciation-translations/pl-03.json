[{"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|point|3", "text": "got to → gotta"}, {"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|caution", "text": "To nieformalne formy mówione. Nie zapisuj ich w esejach, e-mailach ani na formalnych egzaminach i unikaj ich w formalnej prezentacji."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|explain", "text": "Kolejne swobodne redukcje, które stale usłyszysz w filmach i prawdziwych rozmowach."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|0", "text": "kind of → kinda"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|1", "text": "sort of → sorta"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|2", "text": "let me → lemme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|3", "text": "give me → gimme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|4", "text": "what do you → whaddaya"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|caution", "text": "Tylko nieformalnie. Na IELTS lub rozmowie kwalifikacyjnej używaj pełnych form."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|explain", "text": "Kolejne redukcje dotyczące obowiązku i nawyku, częste w swobodnej mówionej angielszczyźnie."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|0", "text": "have to → hafta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|1", "text": "need to → needa"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|2", "text": "used to → useta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|caution", "text": "Tylko nieformalne formy mówione — nigdy ich nie zapisuj."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|explain", "text": "Redukcje modalnych w czasie przeszłym — bardzo częste, gdy mówisz o żalu lub sytuacjach hipotetycznych."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|0", "text": "could have → coulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|1", "text": "would have → woulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|2", "text": "should have → shoulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|caution", "text": "Tylko nieformalnie mówione — w formalnym piśmie zapisuj 'could have' w pełnej formie."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|explain", "text": "Bardzo swobodne redukcje, częste w piosenkach, filmach i luźnych rozmowach między przyjaciółmi."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|0", "text": "don't know → dunno"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|1", "text": "don't you → dontcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|2", "text": "what are you → whatcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|caution", "text": "Bardzo nieformalne — tylko z bliskimi przyjaciółmi, nigdy w kontekstach zawodowych ani egzaminacyjnych."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|explain", "text": "Częste redukcje związane z przyimkami w swobodnej mowie."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|0", "text": "out of → outta"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|1", "text": "off of → offa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|2", "text": "cup of → cuppa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|caution", "text": "Tylko nieformalnie."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|explain", "text": "Codzienne okrzyki i swobodne zwroty z silną redukcją."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|0", "text": "come on → c'mon"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|1", "text": "going to be → gonna be"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|2", "text": "some more → s'more"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|caution", "text": "Tylko nieformalnie."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|explain", "text": "Zwroty rozpoczynające pytania ulegają silnej redukcji w szybkiej, swobodnej rozmowie."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|0", "text": "did you → dja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|1", "text": "do you → dya"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|2", "text": "would you → wouldja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|caution", "text": "Tylko w swobodnych, mówionych kontekstach."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|explain", "text": "W swobodnej mowie często redukuje się także określenia czasu."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|0", "text": "a couple of → a couple"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|1", "text": "in a minute → in a min"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|caution", "text": "W porządku w swobodnej rozmowie, nie w piśmie."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|explain", "text": "Częstsze swobodne redukcje słyszane nieustannie w zrelaksowanej rozmowie."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|0", "text": "probably → prolly"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|1", "text": "trying to → tryna"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|2", "text": "supposed to → s'posed to"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|caution", "text": "Tylko nieformalnie, w mowie."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|explain", "text": "Swobodne redukcje powszechne wśród znajomych i w nieformalnej amerykańskiej mowie."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|0", "text": "let's go → less go"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|1", "text": "give it to me → gimme that"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|2", "text": "you all → y'all"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|caution", "text": "Bardzo nieformalne — 'y'all' jest regionalne (południe USA), ale szeroko rozumiane."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|explain", "text": "Okrągłe liczby redukują środkowe spółgłoski w szybkiej, swobodnej amerykańskiej mowie."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|0", "text": "twenty → twenny"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|1", "text": "hundred → hunnerd"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|caution", "text": "Tylko nieformalnie, w mowie — w kontekstach formalnych zawsze używaj pełnej formy."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|explain", "text": "Inny zestaw codziennych słów, które regularnie tracą sylabę w szybkiej, swobodnej mowie."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|0", "text": "different → diff'rent"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|1", "text": "general → gen'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|2", "text": "several → sev'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|3", "text": "camera → cam'ra"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|caution", "text": "W porządku w mowie potocznej; w formalnych prezentacjach wymawiaj pełną formę wyraźnie."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|explain", "text": "Bardzo nieformalne redukcje, które usłyszysz w piosenkach i potocznej amerykańskiej mowie, ale których nigdy nie powinieneś używać w sytuacjach zawodowych."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|0", "text": "I'm going to → I'ma"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|1", "text": "kind of like → kinda like"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|caution", "text": "Wyjątkowo nieformalne — tylko wśród znajomych lub w tekstach piosenek, nigdy w kontekstach zawodowych."}, {"key": "551b9527-f712-421d-966c-24644f360746|explain", "text": "Dodatkowe codzienne redukcje powitań, wykraczające poza what's up / how's it going."}, {"key": "551b9527-f712-421d-966c-24644f360746|point|0", "text": "how are you → how ya doin'"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|1", "text": "good to see you → good to see ya"}, {"key": "551b9527-f712-421d-966c-24644f360746|caution", "text": "Tylko potoczne formy mówione."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|explain", "text": "Kolejne redukcje dotyczące obowiązku i pragnienia, częste w swobodnej amerykańskiej mowie."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|0", "text": "ought to → oughta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|1", "text": "don't have to → don't hafta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|2", "text": "want you → wantcha"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|caution", "text": "Tylko nieformalna mowa mówiona."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|explain", "text": "To klasyczny przykład tego, jak daleko może posunąć się potoczna amerykańska redukcja — kilka słów zlewa się w coś, co brzmi jak jedno."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|0", "text": "Did you eat yet? → Jeetyet?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|1", "text": "Did you already? → Jeetalready?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|caution", "text": "Wyjątkowo nieformalne — do rozpoznawania szybkiej mowy native speakerów, nie do własnych formalnych wypowiedzi."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|explain", "text": "Dwie kolejne częste redukcje na poziomie frazy w swobodnej rozmowie."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|0", "text": "because of → 'cause of"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|1", "text": "sort of a → sorta a"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|caution", "text": "Tylko nieformalna mowa mówiona."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|explain", "text": "Bardzo częste potoczne odpowiedniki 'yes' i 'no' w swobodnym mówionym angielskim."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|0", "text": "yes → yep / uh-huh"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|1", "text": "no → nope / nah"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|caution", "text": "Tylko w swobodnej rozmowie — w kontekstach formalnych lub egzaminacyjnych używaj 'yes'/'no'."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|explain", "text": "Oba redukują się do podobnie brzmiącego 'wanna', ale po jednym następuje rzeczownik, a po drugim czasownik — warto zauważyć tę różnicę."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|0", "text": "want a (coffee) → wanna coffee"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|1", "text": "want to (go) → wanna go"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|caution", "text": "Tylko nieformalna mowa."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|0", "text": "'want a' + rzeczownik → wanna"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|1", "text": "'want to' + czasownik → wanna"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|explain", "text": "Przecząca forma 'would have' ulega skróceniu w taki sam sposób jak forma twierdząca."}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|point|0", "text": "wouldn't have → wouldn'ta"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|caution", "text": "Tylko nieformalna mowa — w innych przypadkach pisz 'wouldn't have' w pełnej formie."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|explain", "text": "Dwa kolejne codzienne skróty często spotykane w swobodnych wyjaśnieniach i prośbach."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|0", "text": "just because → just 'cause"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|1", "text": "going to need → gonna need"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|caution", "text": "Tylko nieformalna mowa."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|explain", "text": "'Ain't' zastępuje am not/is not/are not/has not/have not w bardzo swobodnej mowie i słychać je wszędzie w piosenkach i nieformalnych rozmowach."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|0", "text": "I am not → I ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|1", "text": "that is not → that ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|2", "text": "you have not → you ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|caution", "text": "Nigdy nie używaj w piśmie ani w mowie formalnej — uznawane za gramatykę niestandardową, choć niezwykle częste w mowie nieformalnej."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|explain", "text": "Bardzo częsty swobodny sposób powiedzenia 'I understand' lub dosłownie 'caught you'."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|0", "text": "got you (understand) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|1", "text": "got you (caught) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|caution", "text": "Tylko nieformalna mowa — w kontekstach zawodowych mów 'I understand' lub 'got it'."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|explain", "text": "Skróty modalne z perfect, używane do przypuszczeń o przeszłości, obok coulda/woulda/shoulda."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|0", "text": "must have → musta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|1", "text": "might have → mighta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|caution", "text": "Tylko nieformalna mowa — w innych przypadkach pisz 'must have'/'might have' w pełnej formie."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|explain", "text": "Przeczące odpowiedniki coulda/woulda/shoulda, częste przy mówieniu o żalu."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|0", "text": "shouldn't have → shouldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|1", "text": "couldn't have → couldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|caution", "text": "Tylko nieformalna mowa — w kontekstach formalnych pisz 'shouldn't have'/'couldn't have' w pełnej formie."}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|explain", "text": "W swobodnej mowie końcowe -ing często gubi 'g', przez co brzmi jak -in'. Dotyczy to niemal każdego czasownika z -ing. (, so it sounds like -in)"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|0", "text": "doing → doin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|1", "text": "going → goin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|2", "text": "talking → talkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|3", "text": "thinking → thinkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|caution", "text": "Tylko w mowie potocznej — wyraźnie wymawiaj pełne '-ing' w prezentacjach, rozmowach kwalifikacyjnych i na egzaminach."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|explain", "text": "Ten sam wzorzec opuszczania g dotyczy zaimków nieokreślonych kończących się na -thing."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|0", "text": "something → somethin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|1", "text": "nothing → nothin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|2", "text": "anything → anythin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|caution", "text": "Tylko w mowie potocznej."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|explain", "text": "'Them' redukuje się do 'em (znika 'th') po czasowniku, w bardzo częstej mowie potocznej."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|0", "text": "tell them → tell 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|1", "text": "get them → get 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|2", "text": "ask them → ask 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|caution", "text": "Tylko w nieformalnej mowie — w piśmie i mowie formalnej mów i pisz pełne 'them'."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|explain", "text": "'And' redukuje się do szybkiego dźwięku 'n' między dwoma blisko powiązanymi słowami, zwłaszcza w utartych zwrotach."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|0", "text": "rock and roll → rock 'n' roll"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|1", "text": "fish and chips → fish 'n' chips"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|2", "text": "back and forth → back 'n' forth"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|caution", "text": "Częste w utartych zwrotach i szybkiej mowie — w formalnym piśmie pisz wyraźnie 'and'."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|explain", "text": "'Because' samo w sobie (nie tylko 'because of') często skraca się do 'cause w swobodnych odpowiedziach."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|point|0", "text": "because → 'cause"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|caution", "text": "Tylko w nieformalnej mowie — w pozostałych przypadkach pisz pełne 'because'."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|explain", "text": "'Of course' często traci pierwsze słowo w szybkich, swobodnych odpowiedziach."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|point|0", "text": "of course → 'course"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|caution", "text": "Tylko w swobodnej mowie."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|explain", "text": "Bardzo częsta potoczna wymowa 'all right', używana do wyrażenia zgody lub potwierdzenia."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|point|0", "text": "all right → aight"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|caution", "text": "Bardzo nieformalne — w kontekstach zawodowych mów 'all right' lub 'okay'."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|explain", "text": "'Let you' redukuje się tak samo jak 'want you'/'wantcha'."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|point|0", "text": "let you → letcha"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|caution", "text": "Tylko nieformalna mowa."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|explain", "text": "Kolejne ekstremalne zlanie się dźwięków w szybkiej mowie, podobne do 'jeetyet' — kilka słów ściska się w jeden dźwięk."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|point|0", "text": "did you ever → jever"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|caution", "text": "Do rozpoznawania szybkiej mowy native speakerów, nie do własnej formalnej wypowiedzi."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|explain", "text": "Dwie redukcje nakładają się na siebie, gdy 'going to' i 'have to' występują obok siebie."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|point|0", "text": "going to have to → gonna hafta"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|caution", "text": "Tylko nieformalna mowa — w innych przypadkach pisz 'going to have to' w pełnej formie."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|explain", "text": "Redukcja 'gonna' nadal obowiązuje w przeczeniach i czasie przeszłym."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|0", "text": "not going to → not gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|1", "text": "wasn't going to → wasn't gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|caution", "text": "Tylko nieformalna mowa."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|explain", "text": "Bardzo częsta redukcja brytyjskiego pytania doczepionego, używana do potwierdzenia lub podkreślenia."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|point|0", "text": "isn't it → innit"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|caution", "text": "Bardzo nieformalny brytyjski slang — nie używaj w formalnej mowie, nawet w UK."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|explain", "text": "Swobodny sposób na zaproponowanie czegoś lub zapytanie o zgodę."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|point|0", "text": "what do you say → whaddya say"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|caution", "text": "Tylko nieformalna mowa."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|explain", "text": "Niezwykle częste wtrącenie w swobodnej mowie, używane podczas namysłu lub dla podkreślenia."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|point|0", "text": "you know → y'know"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|caution", "text": "Tylko swobodne wtrącenie — nadużywane brzmi nieelegancko nawet nieformalnie."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|explain", "text": "Bardzo swobodne powitanie, skrócone od 'what's up'."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|point|0", "text": "what's up → s'up"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|caution", "text": "Bardzo nieformalne powitanie tylko między przyjaciółmi."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|explain", "text": "'Him' i 'her' również słabną w swobodnej mowie, podobnie jak 'them' → 'em."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|0", "text": "tell him → tell 'im"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|1", "text": "ask her → ask 'er"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|caution", "text": "Tylko nieformalna mowa."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|explain", "text": "'Kinda' i 'sorta' są często łączone dla dodatkowego złagodzenia w bardzo swobodnej mowie."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|point|0", "text": "kind of sort of → kinda sorta"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|caution", "text": "Bardzo nieformalne — unikaj w każdym kontekście zawodowym lub egzaminacyjnym."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|explain", "text": "Kolejne szybkie połączenie rozpoczynające pytanie, obok dja i wouldja."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|point|0", "text": "didn't you → dincha"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|caution", "text": "Do rozpoznawania szybkiej mowy native speakerów, nie do własnych formalnych wypowiedzi."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|explain", "text": "Forma przeszła 'have to' redukuje się tak samo jak forma teraźniejsza."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|point|0", "text": "had to → hadta"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|caution", "text": "Tylko w nieformalnej mowie."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|explain", "text": "Swobodna redukcja używana w nieformalnych prośbach, obok form typu wouldja i couldja."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|point|0", "text": "will you → willcha"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|caution", "text": "Tylko w nieformalnej mowie."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|explain", "text": "Frazy określające ilość z 'of' redukują się tak samo jak 'cup of' w 'cuppa'."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|0", "text": "lots of → lotsa"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|1", "text": "bunch of → buncha"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|caution", "text": "Tylko w nieformalnej mowie."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|explain", "text": "Mocny nieformalny wzmacniacz oznaczający 'bardzo imponujący/duży'. (a very impressive/big)"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|point|0", "text": "hell of a → helluva"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|caution", "text": "Lekko wulgarne — w porządku wśród znajomych, unikaj w sytuacjach zawodowych i oficjalnych."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|explain", "text": "Historyczna redukcja starego powitania 'how do you do', dziś samodzielne swobodne, przyjazne powitanie (zwłaszcza w południowych USA)."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|point|0", "text": "how do you do → howdy"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|caution", "text": "Tylko jako swobodne, przyjazne powitanie."}, {"key": "47538641-f573-4840-af35-02857a1d24de|explain", "text": "'I suppose' często gubi środkową sylabę w swobodnej mowie; wyraża lekką niepewność lub niechętną zgodę — inaczej niż 'supposed to' → s'posed to."}, {"key": "47538641-f573-4840-af35-02857a1d24de|point|0", "text": "I suppose → I s'pose"}, {"key": "47538641-f573-4840-af35-02857a1d24de|caution", "text": "Tylko w nieformalnej mowie — w piśmie zawsze pełne 'I suppose'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|explain", "text": "Opanuj redukcje dzięki 50 ukierunkowanym ćwiczeniom. Słuchaj uważnie modelu AI, powtarzaj i nagrywaj swój głos, aby otrzymać szczegółową ocenę wymowy i informację zwrotną w czasie rzeczywistym."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|0", "text": "Skup się na rytmie, akcencie i płynności podkreślonych w każdym ćwiczeniu."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|1", "text": "Przed każdą próbą nagrania posłuchaj wzorcowego audio modelu."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|2", "text": "Przejrzyj swoją ocenę AI i informację zwrotną na poziomie fonemów, aby wskazać obszary do poprawy."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|caution", "text": "Nie spiesz się podczas ćwiczeń; priorytetem jest klarowność, naturalna kadencja i dokładna artykulacja."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|0", "text": "Ekstremalna redukcja słów pomocniczych w naturalny przepływ mowy."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|1", "text": "'going to' -> 'gonna'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|2", "text": "'have got to' redukuje się do 'gotta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|3", "text": "'want a' -> 'wanna'; 'of' -> 'a' /ə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|4", "text": "'has to' -> 'hasta' /hæstə/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|5", "text": "'let me' -> 'lemme'; 'you' -> 'ya'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|6", "text": "'give me' -> 'gimme'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|7", "text": "'could you' -> 'couldja' /kʊdʒə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|8", "text": "'would you' -> 'wouldja'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|9", "text": "'what did you' -> 'whaddya'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|10", "text": "'should have' -> 'shoulda' /ʃʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|11", "text": "'could have' -> 'coulda' /kʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|12", "text": "'would have' -> 'woulda' /wʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|13", "text": "'must have' -> 'musta' /mʌstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|14", "text": "'might have' -> 'mighta' /maɪtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|15", "text": "'used to' -> 'usta' /juːstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|16", "text": "'supposed to' -> 'sposta' /spoʊstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|17", "text": "'need to' -> 'needa'; 'to' -> /də/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|18", "text": "'to' -> /də/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|19", "text": "'kind of' -> 'kinda' /kaɪndə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|20", "text": "'sort of' -> 'sorta' /sɔːrtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|21", "text": "'lots of' -> 'lotsa' /lɒtsə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|22", "text": "'out of' -> 'outta' /aʊtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|23", "text": "'front of' -> 'fronta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|24", "text": "'I am going to' w mowie nieformalnej redukuje się do 'I'mma'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|25", "text": "'don't you' -> 'doncha'; 'want to' -> 'wanna'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|26", "text": "'didn't you' -> 'didn'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|27", "text": "'haven't you' -> 'haven'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|28", "text": "'and' redukuje się do sylabicznego 'n' /n/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|29", "text": "'day and night' -> 'day 'n night'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|30", "text": "'or' redukuje się do /ər/; 'it or' łączy się płynnie."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|31", "text": "'or' redukuje się do nieakcentowanego /ər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|32", "text": "'and' redukuje się do /n/ między spółgłoskami zwartymi."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|33", "text": "Zaimkowe 'that' redukuje się do /ðət/ z szwą."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|34", "text": "Spójnik 'that' jest słaby i krótki."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|35", "text": "'that' przyjmuje /ðət/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|36", "text": "'them' redukuje się do ''em' /əm/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|37", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|38", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|39", "text": "'some' -> /səm/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|40", "text": "'for' -> /fər/; 'you' -> /jə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|41", "text": "'are' -> /ər/; 'you' -> /jə/; 'to' -> /tə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|42", "text": "'were' redukuje się do /wər/."}]
[{"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|point|3", "text": "got to → gotta"}, {"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|caution", "text": "Acestea sunt forme vorbite informale. Nu le scrie în eseuri, e-mailuri sau la examene oficiale și evită-le într-o prezentare formală."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|explain", "text": "Alte reduceri informale pe care le vei auzi frecvent în filme și în conversațiile reale."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|0", "text": "kind of → kinda"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|1", "text": "sort of → sorta"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|2", "text": "let me → lemme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|3", "text": "give me → gimme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|4", "text": "what do you → whaddaya"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|caution", "text": "Doar informal. La IELTS sau la un interviu de angajare, păstrează formele complete."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|explain", "text": "Alte reduceri pentru obligație și obișnuință, frecvente în engleza vorbită relaxată."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|0", "text": "have to → hafta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|1", "text": "need to → needa"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|2", "text": "used to → useta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|caution", "text": "Doar forme vorbite informale — nu le scrie niciodată."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|explain", "text": "Reduceri ale verbelor modale la trecut — foarte comune când se vorbește despre regrete sau situații ipotetice."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|0", "text": "could have → coulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|1", "text": "would have → woulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|2", "text": "should have → shoulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|caution", "text": "Doar vorbire informală — scrie 'could have' complet în scrierea formală."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|explain", "text": "Reduceri foarte informale, comune în cântece, filme și conversații relaxate între prieteni."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|0", "text": "don't know → dunno"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|1", "text": "don't you → dontcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|2", "text": "what are you → whatcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|caution", "text": "Foarte informal — doar cu prietenii apropiați, niciodată în contexte profesionale sau la examene."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|explain", "text": "Reduceri comune legate de prepoziții în vorbirea informală."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|0", "text": "out of → outta"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|1", "text": "off of → offa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|2", "text": "cup of → cuppa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|caution", "text": "Doar informal."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|explain", "text": "Exclamații de zi cu zi și expresii informale cu reducere accentuată."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|0", "text": "come on → c'mon"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|1", "text": "going to be → gonna be"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|2", "text": "some more → s'more"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|caution", "text": "Doar informal."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|explain", "text": "Formulele de început de întrebare se reduc considerabil în conversația rapidă și informală."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|0", "text": "did you → dja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|1", "text": "do you → dya"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|2", "text": "would you → wouldja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|caution", "text": "Doar pentru contexte vorbite, informale."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|explain", "text": "Vorbirea informală reduce adesea și expresiile legate de timp."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|0", "text": "a couple of → a couple"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|1", "text": "in a minute → in a min"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|caution", "text": "Potrivit în conversațiile informale, nu și în scris."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|explain", "text": "Alte reduceri informale frecvente, auzite constant în conversațiile relaxate."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|0", "text": "probably → prolly"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|1", "text": "trying to → tryna"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|2", "text": "supposed to → s'posed to"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|caution", "text": "Doar în vorbirea informală."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|explain", "text": "Reduceri informale obișnuite între prieteni și în vorbirea colocvială americană."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|0", "text": "let's go → less go"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|1", "text": "give it to me → gimme that"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|2", "text": "you all → y'all"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|caution", "text": "Foarte informal — 'y'all' este regional (sudul US), dar este înțeles pe scară largă."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|explain", "text": "Numerele rotunde își reduc sunetele consonantice din mijloc în vorbirea rapidă și informală americană."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|0", "text": "twenty → twenny"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|1", "text": "hundred → hunnerd"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|caution", "text": "Doar în vorbirea informală — folosiți întotdeauna forma completă în contexte formale."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|explain", "text": "Un alt set de cuvinte uzuale care pierd în mod regulat o silabă în vorbirea rapidă și relaxată."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|0", "text": "different → diff'rent"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|1", "text": "general → gen'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|2", "text": "several → sev'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|3", "text": "camera → cam'ra"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|caution", "text": "Potrivit în vorbirea informală; pronunțați clar forma completă în prezentările formale."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|explain", "text": "Reduceri extrem de informale pe care le veți auzi în melodii și în vorbirea colocvială americană, dar pe care nu ar trebui să le folosiți niciodată în cadre profesionale."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|0", "text": "I'm going to → I'ma"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|1", "text": "kind of like → kinda like"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|caution", "text": "Extrem de informal — doar între prieteni sau în versurile melodiilor, niciodată în contexte profesionale."}, {"key": "551b9527-f712-421d-966c-24644f360746|explain", "text": "Alte reduceri de zi cu zi pentru formule de salut, dincolo de what's up / how's it going."}, {"key": "551b9527-f712-421d-966c-24644f360746|point|0", "text": "how are you → how ya doin'"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|1", "text": "good to see you → good to see ya"}, {"key": "551b9527-f712-421d-966c-24644f360746|caution", "text": "Doar forme pentru vorbirea informală."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|explain", "text": "Alte reduceri pentru obligație și dorință, frecvente în vorbirea relaxată americană."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|0", "text": "ought to → oughta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|1", "text": "don't have to → don't hafta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|2", "text": "want you → wantcha"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|caution", "text": "Doar în vorbirea informală."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|explain", "text": "Acesta este un exemplu clasic al modului în care funcționează reducerile extreme în engleza americană informală — mai multe cuvinte se contopesc în ceva ce sună ca un singur cuvânt."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|0", "text": "Did you eat yet? → Jeetyet?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|1", "text": "Did you already? → Jeetalready?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|caution", "text": "Extrem de informal — util pentru recunoașterea vorbirii rapide a nativilor, nu pentru vorbirea formală proprie."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|explain", "text": "Încă două reduceri comune la nivel de expresie în conversația colocvială."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|0", "text": "because of → 'cause of"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|1", "text": "sort of a → sorta a"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|caution", "text": "Doar în vorbirea informală."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|explain", "text": "Alternative colocviale foarte frecvente pentru 'yes' și 'no' în limba engleză vorbită relaxată."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|0", "text": "yes → yep / uh-huh"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|1", "text": "no → nope / nah"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|caution", "text": "Doar în conversația colocvială — folosiți 'yes'/'no' în contexte formale sau la examene."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|explain", "text": "Ambele se reduc la un 'wanna' cu pronunție similară, dar una este urmată de un substantiv, iar cealaltă de un verb — merită să remarcați diferența."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|0", "text": "want a (coffee) → wanna coffee"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|1", "text": "want to (go) → wanna go"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|caution", "text": "Doar în vorbirea informală."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|0", "text": "'want a' + substantiv → wanna"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|1", "text": "'want to' + verb → wanna"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|explain", "text": "Varianta negativă a lui 'would have' se reduce în același mod ca forma afirmativă."}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|point|0", "text": "wouldn't have → wouldn'ta"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|caution", "text": "Doar în vorbirea informală — în caz contrar, scrieți 'wouldn't have' în întregime."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|explain", "text": "Încă două reduceri cotidiene, frecvente în explicații și cereri informale."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|0", "text": "just because → just 'cause"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|1", "text": "going to need → gonna need"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|caution", "text": "Doar în vorbirea informală."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|explain", "text": "'Ain't' înlocuiește am not/is not/are not/has not/have not în vorbirea foarte colocvială și se aude pretutindeni în cântece și conversații informale."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|0", "text": "I am not → I ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|1", "text": "that is not → that ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|2", "text": "you have not → you ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|caution", "text": "Nu folosiți niciodată în scris sau în vorbirea formală — este considerată gramatică nestandardizată, chiar dacă este extrem de comună informal."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|explain", "text": "O modalitate colocvială foarte răspândită de a spune 'I understand' sau, la propriu, 'caught you'."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|0", "text": "got you (understand) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|1", "text": "got you (caught) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|caution", "text": "Doar în vorbirea informală — folosiți 'I understand' sau 'got it' în contexte profesionale."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|explain", "text": "Reduceri ale verbelor modale la perfect utilizate pentru presupuneri legate de trecut, alături de coulda/woulda/shoulda."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|0", "text": "must have → musta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|1", "text": "might have → mighta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|caution", "text": "Doar în vorbirea informală — în caz contrar, scrieți 'must have'/'might have' în întregime."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|explain", "text": "Echivalentele negative pentru coulda/woulda/shoulda, frecvente când se vorbește despre regrete."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|0", "text": "shouldn't have → shouldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|1", "text": "couldn't have → couldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|caution", "text": "Doar în vorbirea informală — scrieți 'shouldn't have'/'couldn't have' în întregime în contexte formale."}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|explain", "text": "În vorbirea relaxată, sunetul final -ing își pierde adesea litera 'g', așa că sună ca -in'. Acest lucru se întâmplă la aproape orice verb cu -ing. (, so it sounds like -in)"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|0", "text": "doing → doin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|1", "text": "going → goin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|2", "text": "talking → talkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|3", "text": "thinking → thinkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|caution", "text": "Doar în vorbirea informală — pronunță terminația completă '-ing' clar în prezentări, interviuri și examene."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|explain", "text": "Același tipar de omitere a sunetului g se aplică și pronumelor nehotărâte care se termină în -thing."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|0", "text": "something → somethin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|1", "text": "nothing → nothin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|2", "text": "anything → anythin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|caution", "text": "Doar în vorbirea informală."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|explain", "text": "'Them' se reduce la 'em ('th' dispare) după un verb, în vorbirea informală foarte uzuală."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|0", "text": "tell them → tell 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|1", "text": "get them → get 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|2", "text": "ask them → ask 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|caution", "text": "Doar în vorbirea informală — folosește forma completă 'them' în scris sau în vorbirea formală."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|explain", "text": "'And' se reduce la un sunet scurt 'n' între două cuvinte strâns legate, mai ales în expresii consacrate."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|0", "text": "rock and roll → rock 'n' roll"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|1", "text": "fish and chips → fish 'n' chips"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|2", "text": "back and forth → back 'n' forth"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|caution", "text": "Frecvent în expresii consacrate și în vorbirea rapidă — folosește clar 'and' în scrisul formal."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|explain", "text": "'Because' de unul singur (nu doar 'because of') se scurtează adesea la 'cause în răspunsurile informale."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|point|0", "text": "because → 'cause"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|caution", "text": "Doar în vorbirea informală — altfel, scrie 'because' complet."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|explain", "text": "'Of course' pierde adesea primul cuvânt în răspunsurile rapide și informale."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|point|0", "text": "of course → 'course"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|caution", "text": "Doar în vorbirea informală."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|explain", "text": "O pronunție informală foarte comună a lui 'all right', folosită pentru a aproba sau confirma."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|point|0", "text": "all right → aight"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|caution", "text": "Foarte informal — spune 'all right' sau 'okay' în contexte profesionale."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|explain", "text": "'Let you' se reduce la fel ca 'want you'/'wantcha'."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|point|0", "text": "let you → letcha"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|caution", "text": "Doar în vorbirea informală."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|explain", "text": "O altă contracție extremă din vorbirea rapidă, similară cu 'jeetyet' — mai multe cuvinte se comprimă într-un singur sunet."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|point|0", "text": "did you ever → jever"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|caution", "text": "Util pentru recunoașterea vorbirii rapide a nativilor, nu pentru propria vorbire formală."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|explain", "text": "Două reduceri se combină atunci când 'going to' și 'have to' apar una lângă alta."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|point|0", "text": "going to have to → gonna hafta"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|caution", "text": "Doar în vorbirea informală — altfel, scrie 'going to have to' complet."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|explain", "text": "Reducerea 'gonna' se aplică în continuare la forma negativă și la timpul trecut."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|0", "text": "not going to → not gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|1", "text": "wasn't going to → wasn't gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|caution", "text": "Doar în vorbirea informală."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|explain", "text": "O reducere foarte frecventă a unei tag question în engleza britanică, folosită pentru a confirma sau a adăuga emfază."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|point|0", "text": "isn't it → innit"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|caution", "text": "Argou britanic foarte informal — nu folosiți în vorbirea formală, nici măcar în UK."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|explain", "text": "Un mod colocvial de a propune ceva sau de a cere acordul."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|point|0", "text": "what do you say → whaddya say"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|caution", "text": "Doar în vorbirea informală."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|explain", "text": "O expresie de umplutură extrem de frecventă în engleza vorbită colocvială, folosită în timp ce te gândești sau pentru emfază."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|point|0", "text": "you know → y'know"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|caution", "text": "Doar ca element de umplutură colocvial — folosirea excesivă sună neșlefuit chiar și informal."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|explain", "text": "Un salut foarte colocvial, prescurtat de la 'what's up'."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|point|0", "text": "what's up → s'up"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|caution", "text": "Salut foarte informal, doar între prieteni."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|explain", "text": "Și 'Him' și 'her' se reduc în vorbirea colocvială, similar cu 'them' → 'em."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|0", "text": "tell him → tell 'im"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|1", "text": "ask her → ask 'er"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|caution", "text": "Doar în vorbirea informală."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|explain", "text": "'Kinda' și 'sorta' sunt adesea combinate pentru o nuanțare suplimentară în vorbirea foarte colocvială."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|point|0", "text": "kind of sort of → kinda sorta"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|caution", "text": "Foarte informal — evitați în orice context profesional sau de examen."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|explain", "text": "O altă contragere de început de întrebare în vorbirea rapidă, alături de dja și wouldja."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|point|0", "text": "didn't you → dincha"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|caution", "text": "Pentru recunoașterea vorbirii rapide a vorbitorilor nativi, nu pentru propria vorbire formală."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|explain", "text": "Forma de trecut a lui 'have to' se reduce în același mod ca forma de prezent."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|point|0", "text": "had to → hadta"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|caution", "text": "Doar în vorbirea informală."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|explain", "text": "O reducere colocvială folosită în cereri informale, alături de forme de tip wouldja și couldja."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|point|0", "text": "will you → willcha"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|caution", "text": "Doar în vorbirea informală."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|explain", "text": "Sintagmele cantitative cu 'of' se reduc la fel cum o face 'cup of' în 'cuppa'."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|0", "text": "lots of → lotsa"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|1", "text": "bunch of → buncha"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|caution", "text": "Doar în vorbirea informală."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|explain", "text": "Un intensificator informal puternic cu sensul de 'a very impressive/big'."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|point|0", "text": "hell of a → helluva"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|caution", "text": "Ușor vulgar — acceptabil între prieteni, evitați în contexte profesionale sau politicoase."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|explain", "text": "O reducere istorică a vechiului salut 'how do you do', acum un salut prietenos și colocvial de sine stătător (în special în sudul US)."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|point|0", "text": "how do you do → howdy"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|caution", "text": "Doar ca salut colocvial și prietenos."}, {"key": "47538641-f573-4840-af35-02857a1d24de|explain", "text": "'I suppose' își pierde adesea silaba din mijloc în vorbirea colocvială, fiind folosit pentru a exprima o ușoară nesiguranță sau un acord reticent — distinct de 'supposed to' → s'posed to."}, {"key": "47538641-f573-4840-af35-02857a1d24de|point|0", "text": "I suppose → I s'pose"}, {"key": "47538641-f573-4840-af35-02857a1d24de|caution", "text": "Doar în vorbirea informală — altfel scrieți forma completă 'I suppose'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|explain", "text": "Perfecționează reducerile fonetice prin 50 de exerciții dedicate. Ascultă cu atenție modelul AI, repetă și înregistrează-ți vocea pentru a primi evaluare și feedback detaliat în timp real asupra pronunției."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|0", "text": "Concentrează-te pe ritmul, accentul și fluența evidențiate în fiecare exercițiu."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|1", "text": "Ascultă înregistrarea audio de referință înainte de fiecare încercare de înregistrare."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|2", "text": "Verifică scorul oferit de AI și feedbackul la nivel de fonem pentru a identifica aspectele ce necesită îmbunătățire."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|caution", "text": "Nu te grăbi în parcurgerea exercițiilor; prioritizează claritatea, cadența naturală și articularea corectă."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|0", "text": "Reducere extremă a cuvintelor ajutătoare pentru un flux natural."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|1", "text": "'going to' -> 'gonna'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|2", "text": "'have got to' se reduce la 'gotta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|3", "text": "'want a' -> 'wanna'; 'of' -> 'a' /ə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|4", "text": "'has to' -> 'hasta' /hæstə/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|5", "text": "'let me' -> 'lemme'; 'you' -> 'ya'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|6", "text": "'give me' -> 'gimme'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|7", "text": "'could you' -> 'couldja' /kʊdʒə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|8", "text": "'would you' -> 'wouldja'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|9", "text": "'what did you' -> 'whaddya'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|10", "text": "'should have' -> 'shoulda' /ʃʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|11", "text": "'could have' -> 'coulda' /kʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|12", "text": "'would have' -> 'woulda' /wʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|13", "text": "'must have' -> 'musta' /mʌstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|14", "text": "'might have' -> 'mighta' /maɪtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|15", "text": "'used to' -> 'usta' /juːstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|16", "text": "'supposed to' -> 'sposta' /spoʊstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|17", "text": "'need to' -> 'needa'; 'to' -> /də/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|18", "text": "'to' -> /də/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|19", "text": "'kind of' -> 'kinda' /kaɪndə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|20", "text": "'sort of' -> 'sorta' /sɔːrtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|21", "text": "'lots of' -> 'lotsa' /lɒtsə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|22", "text": "'out of' -> 'outta' /aʊtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|23", "text": "'front of' -> 'fronta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|24", "text": "'I am going to' se reduce la 'I'mma' în vorbirea informală."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|25", "text": "'don't you' -> 'doncha'; 'want to' -> 'wanna'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|26", "text": "'didn't you' -> 'didn'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|27", "text": "'haven't you' -> 'haven'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|28", "text": "'and' se reduce la 'n' silabic /n/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|29", "text": "'day and night' -> 'day 'n night'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|30", "text": "'or' se reduce la /ər/; 'it or' se leagă fluent printr-un flap."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|31", "text": "'or' se reduce la /ər/ neaccentuat."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|32", "text": "'and' se reduce la /n/ între ocluzive."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|33", "text": "Pronumele relativ 'that' se reduce la /ðət/ cu schwa."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|34", "text": "Conjuncția 'that' este slabă și scurtă."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|35", "text": "'that' se pronunță /ðət/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|36", "text": "'them' se reduce la ''em' /əm/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|37", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|38", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|39", "text": "'some' -> /səm/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|40", "text": "'for' -> /fər/; 'you' -> /jə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|41", "text": "'are' -> /ər/; 'you' -> /jə/; 'to' -> /tə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|42", "text": "'were' se reduce la /wər/."}]
[{"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|point|3", "text": "got to → gotta"}, {"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|caution", "text": "Ini adalah bentuk lisan informal. Jangan menulisnya dalam esai, email, atau ujian formal, dan hindari dalam presentasi formal."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|explain", "text": "Reduksi yang lebih santai yang akan sering kamu dengar di film dan percakapan nyata."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|0", "text": "kind of → kinda"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|1", "text": "sort of → sorta"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|2", "text": "let me → lemme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|3", "text": "give me → gimme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|4", "text": "what do you → whaddaya"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|caution", "text": "Hanya informal. Dalam IELTS atau wawancara kerja, gunakan bentuk lengkapnya."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|explain", "text": "Reduksi kewajiban dan kebiasaan yang umum dalam bahasa Inggris lisan yang santai."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|0", "text": "have to → hafta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|1", "text": "need to → needa"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|2", "text": "used to → useta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|caution", "text": "Hanya bentuk lisan informal — jangan pernah menulisnya."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|explain", "text": "Reduksi modal lampau — sangat umum saat membicarakan penyesalan atau situasi hipotetis."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|0", "text": "could have → coulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|1", "text": "would have → woulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|2", "text": "should have → shoulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|caution", "text": "Hanya lisan informal — tulis 'could have' secara lengkap dalam tulisan formal."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|explain", "text": "Reduksi sangat santai yang umum di lagu, film, dan percakapan santai antar teman."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|0", "text": "don't know → dunno"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|1", "text": "don't you → dontcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|2", "text": "what are you → whatcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|caution", "text": "Sangat informal — hanya dengan teman dekat, jangan pernah dalam konteks profesional atau ujian."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|explain", "text": "Reduksi umum yang terkait preposisi dalam percakapan santai."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|0", "text": "out of → outta"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|1", "text": "off of → offa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|2", "text": "cup of → cuppa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|caution", "text": "Hanya informal."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|explain", "text": "Seruan sehari-hari dan frasa santai dengan reduksi yang kuat."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|0", "text": "come on → c'mon"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|1", "text": "going to be → gonna be"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|2", "text": "some more → s'more"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|caution", "text": "Hanya informal."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|explain", "text": "Pembuka pertanyaan banyak disingkat dalam percakapan cepat dan santai."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|0", "text": "did you → dja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|1", "text": "do you → dya"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|2", "text": "would you → wouldja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|caution", "text": "Hanya untuk konteks santai dan lisan."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|explain", "text": "Ucapan santai sering kali juga menyingkat frasa waktu."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|0", "text": "a couple of → a couple"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|1", "text": "in a minute → in a min"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|caution", "text": "Tidak masalah dalam percakapan santai, tetapi tidak dalam tulisan."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|explain", "text": "Penyingkatan santai yang lebih umum dan terus terdengar dalam percakapan yang rileks."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|0", "text": "probably → prolly"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|1", "text": "trying to → tryna"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|2", "text": "supposed to → s'posed to"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|caution", "text": "Hanya untuk lisan informal."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|explain", "text": "Penyingkatan santai yang umum di antara teman dan dalam percakapan informal Amerika."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|0", "text": "let's go → less go"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|1", "text": "give it to me → gimme that"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|2", "text": "you all → y'all"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|caution", "text": "Sangat informal — 'y'all' bersifat regional (Amerika Selatan) tetapi dipahami secara luas. (US)"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|explain", "text": "Angka bulat menyingkat bunyi konsonan tengahnya dalam ucapan Amerika yang cepat dan santai."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|0", "text": "twenty → twenny"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|1", "text": "hundred → hunnerd"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|caution", "text": "Hanya untuk lisan informal — selalu ucapkan bentuk lengkapnya dalam konteks formal."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|explain", "text": "Kumpulan kata sehari-hari lain yang secara rutin kehilangan satu suku kata dalam ucapan yang cepat dan santai."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|0", "text": "different → diff'rent"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|1", "text": "general → gen'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|2", "text": "several → sev'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|3", "text": "camera → cam'ra"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|caution", "text": "Tidak masalah dalam percakapan santai; ucapkan bentuk lengkapnya dengan jelas dalam presentasi formal."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|explain", "text": "Reduksi yang sangat informal yang akan kamu dengar di lagu dan percakapan santai orang Amerika, tetapi jangan pernah digunakan dalam situasi profesional."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|0", "text": "I'm going to → I'ma"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|1", "text": "kind of like → kinda like"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|caution", "text": "Sangat informal — hanya untuk teman/lirik lagu, jangan pernah dalam konteks profesional."}, {"key": "551b9527-f712-421d-966c-24644f360746|explain", "text": "Reduksi sapaan sehari-hari tambahan di luar what's up / how's it going."}, {"key": "551b9527-f712-421d-966c-24644f360746|point|0", "text": "how are you → how ya doin'"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|1", "text": "good to see you → good to see ya"}, {"key": "551b9527-f712-421d-966c-24644f360746|caution", "text": "Hanya bentuk lisan santai."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|explain", "text": "Reduksi kewajiban dan keinginan lainnya yang umum dalam percakapan santai orang Amerika."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|0", "text": "ought to → oughta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|1", "text": "don't have to → don't hafta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|2", "text": "want you → wantcha"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|caution", "text": "Hanya lisan informal."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|explain", "text": "Ini contoh klasik seberapa jauh reduksi santai orang Amerika bisa terjadi — beberapa kata melebur menjadi terdengar seperti satu kata."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|0", "text": "Did you eat yet? → Jeetyet?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|1", "text": "Did you already? → Jeetalready?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|caution", "text": "Sangat informal — untuk mengenali ucapan native yang cepat, bukan untuk bicara formalmu sendiri."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|explain", "text": "Dua reduksi tingkat frasa lainnya yang umum dalam percakapan santai."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|0", "text": "because of → 'cause of"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|1", "text": "sort of a → sorta a"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|caution", "text": "Hanya lisan informal."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|explain", "text": "Alternatif santai yang sangat umum untuk 'yes' dan 'no' dalam bahasa Inggris lisan yang santai."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|0", "text": "yes → yep / uh-huh"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|1", "text": "no → nope / nah"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|caution", "text": "Hanya percakapan santai — gunakan 'yes'/'no' dalam konteks formal atau ujian."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|explain", "text": "Keduanya direduksi menjadi 'wanna' yang terdengar mirip, tetapi satu diikuti kata benda dan yang lain diikuti kata kerja — perbedaan ini penting untuk diperhatikan."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|0", "text": "want a (coffee) → wanna coffee"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|1", "text": "want to (go) → wanna go"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|caution", "text": "Hanya dalam percakapan informal."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|0", "text": "'want a' + kata benda → wanna"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|1", "text": "'want to' + kata kerja → wanna"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|explain", "text": "Bentuk negatif dari 'would have' mengalami penyederhanaan yang sama seperti bentuk positifnya."}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|point|0", "text": "wouldn't have → wouldn'ta"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|caution", "text": "Hanya dalam percakapan informal — jika tidak, tulis 'wouldn't have' secara lengkap."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|explain", "text": "Dua penyederhanaan sehari-hari lainnya yang umum dalam penjelasan dan permintaan kasual."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|0", "text": "just because → just 'cause"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|1", "text": "going to need → gonna need"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|caution", "text": "Hanya dalam percakapan informal."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|explain", "text": "'Ain't' menggantikan am not/is not/are not/has not/have not dalam tuturan yang sangat kasual dan terdengar di mana-mana dalam lagu dan percakapan informal."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|0", "text": "I am not → I ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|1", "text": "that is not → that ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|2", "text": "you have not → you ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|caution", "text": "Jangan pernah gunakan dalam tulisan atau tuturan formal — dianggap tata bahasa non-standar, meskipun sangat umum secara informal."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|explain", "text": "Cara kasual yang sangat umum untuk mengatakan 'I understand' atau secara harfiah 'caught you'."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|0", "text": "got you (understand) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|1", "text": "got you (caught) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|caution", "text": "Hanya dalam percakapan informal — ucapkan 'I understand' atau 'got it' dalam konteks profesional."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|explain", "text": "Penyederhanaan modal-perfect yang digunakan untuk dugaan tentang masa lalu, bersama dengan coulda/woulda/shoulda."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|0", "text": "must have → musta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|1", "text": "might have → mighta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|caution", "text": "Hanya dalam percakapan informal — jika tidak, tulis 'must have'/'might have' secara lengkap."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|explain", "text": "Bentuk negatif dari coulda/woulda/shoulda, umum saat membicarakan penyesalan."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|0", "text": "shouldn't have → shouldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|1", "text": "couldn't have → couldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|caution", "text": "Hanya dalam percakapan informal — tulis 'shouldn't have'/'couldn't have' secara lengkap dalam konteks formal."}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|explain", "text": "Dalam tuturan santai, bunyi -ing di akhir sering kali menghilangkan 'g', sehingga terdengar seperti -in'. Ini terjadi pada hampir semua kata kerja berakhiran -ing. (, so it sounds like -in)"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|0", "text": "doing → doin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|1", "text": "going → goin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|2", "text": "talking → talkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|3", "text": "thinking → thinkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|caution", "text": "Hanya untuk percakapan santai — ucapkan '-ing' secara lengkap dan jelas dalam presentasi, wawancara, dan ujian."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|explain", "text": "Pola penghilangan bunyi g yang sama juga berlaku pada kata ganti tak tentu yang berakhiran -thing."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|0", "text": "something → somethin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|1", "text": "nothing → nothin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|2", "text": "anything → anythin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|caution", "text": "Hanya untuk percakapan santai."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|explain", "text": "'Them' disingkat menjadi 'em (bunyi 'th' dihilangkan) setelah kata kerja, dalam percakapan santai yang sangat umum."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|0", "text": "tell them → tell 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|1", "text": "get them → get 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|2", "text": "ask them → ask 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|caution", "text": "Hanya untuk percakapan lisan informal — ucapkan 'them' secara lengkap dalam tulisan atau pembicaraan formal."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|explain", "text": "'And' disingkat menjadi bunyi 'n' yang cepat di antara dua kata yang berhubungan erat, terutama dalam frasa tetap."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|0", "text": "rock and roll → rock 'n' roll"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|1", "text": "fish and chips → fish 'n' chips"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|2", "text": "back and forth → back 'n' forth"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|caution", "text": "Umum dalam frasa tetap dan percakapan cepat — ucapkan 'and' dengan jelas dalam tulisan formal."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|explain", "text": "'Because' yang berdiri sendiri (bukan hanya 'because of') sering disingkat menjadi 'cause dalam jawaban santai."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|point|0", "text": "because → 'cause"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|caution", "text": "Hanya untuk percakapan lisan informal — tulis 'because' secara lengkap dalam situasi lainnya."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|explain", "text": "'Of course' sering menghilangkan kata pertamanya dalam jawaban cepat dan santai."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|point|0", "text": "of course → 'course"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|caution", "text": "Hanya untuk percakapan santai."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|explain", "text": "Pengucapan santai yang sangat umum dari 'all right', digunakan untuk menyetujui atau mengakui sesuatu."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|point|0", "text": "all right → aight"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|caution", "text": "Sangat informal — ucapkan 'all right' atau 'okay' dalam konteks profesional."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|explain", "text": "'Let you' disingkat dengan cara yang sama seperti 'want you'/'wantcha'."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|point|0", "text": "let you → letcha"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|caution", "text": "Hanya untuk percakapan informal."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|explain", "text": "Gabungan ucapan cepat yang ekstrem lainnya, mirip dengan 'jeetyet' — beberapa kata menyatu menjadi satu bunyi."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|point|0", "text": "did you ever → jever"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|caution", "text": "Untuk mengenali ucapan native yang cepat, bukan untuk percakapan formal Anda sendiri."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|explain", "text": "Dua reduksi bergabung ketika 'going to' dan 'have to' muncul berdampingan."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|point|0", "text": "going to have to → gonna hafta"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|caution", "text": "Hanya untuk percakapan informal — jika tidak, tulis 'going to have to' secara lengkap."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|explain", "text": "Reduksi 'gonna' tetap berlaku pada bentuk negatif dan past tense."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|0", "text": "not going to → not gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|1", "text": "wasn't going to → wasn't gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|caution", "text": "Hanya untuk percakapan informal."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|explain", "text": "Reduksi tag question British English yang sangat umum, digunakan untuk mengonfirmasi atau menambahkan penekanan."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|point|0", "text": "isn't it → innit"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|caution", "text": "Slang British yang sangat informal — jangan gunakan dalam percakapan formal, bahkan di UK."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|explain", "text": "Cara santai untuk mengusulkan sesuatu atau meminta persetujuan."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|point|0", "text": "what do you say → whaddya say"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|caution", "text": "Hanya untuk percakapan informal."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|explain", "text": "Frasa pengisi yang sangat umum dalam percakapan santai bahasa Inggris, digunakan saat berpikir atau untuk penekanan."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|point|0", "text": "you know → y'know"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|caution", "text": "Hanya pengisi santai — terlalu sering menggunakannya terdengar tidak rapi bahkan dalam percakapan informal."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|explain", "text": "Sapaan yang sangat santai, disingkat dari 'what's up'."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|point|0", "text": "what's up → s'up"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|caution", "text": "Sapaan yang sangat informal, hanya antar teman."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|explain", "text": "'Him' dan 'her' juga melemah dalam percakapan santai, mirip dengan 'them' → 'em."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|0", "text": "tell him → tell 'im"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|1", "text": "ask her → ask 'er"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|caution", "text": "Hanya untuk percakapan informal."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|explain", "text": "'Kinda' dan 'sorta' sering digabungkan untuk lebih banyak keraguan dalam percakapan yang sangat santai."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|point|0", "text": "kind of sort of → kinda sorta"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|caution", "text": "Sangat informal — hindari dalam konteks profesional atau ujian apa pun."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|explain", "text": "Gabungan pembuka pertanyaan dalam ucapan cepat lainnya, bersama dja dan wouldja."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|point|0", "text": "didn't you → dincha"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|caution", "text": "Untuk mengenali ucapan asli yang cepat, bukan untuk berbicara formal Anda sendiri."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|explain", "text": "Bentuk lampau dari 'have to' mengalami reduksi dengan cara yang sama seperti bentuk sekarang."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|point|0", "text": "had to → hadta"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|caution", "text": "Hanya untuk ucapan informal."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|explain", "text": "Reduksi santai yang digunakan dalam permintaan informal, bersama bentuk-bentuk seperti wouldja dan couldja."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|point|0", "text": "will you → willcha"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|caution", "text": "Hanya untuk ucapan informal."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|explain", "text": "Frasa kuantitas dengan 'of' mengalami reduksi dengan cara yang sama seperti 'cup of' dalam 'cuppa'."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|0", "text": "lots of → lotsa"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|1", "text": "bunch of → buncha"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|caution", "text": "Hanya untuk ucapan informal."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|explain", "text": "Penguat informal yang kuat yang berarti 'a very impressive/big'."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|point|0", "text": "hell of a → helluva"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|caution", "text": "Agak kasar — tidak masalah dengan teman, hindari dalam situasi profesional atau sopan."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|explain", "text": "Reduksi historis dari sapaan lama 'how do you do', kini menjadi sapaan santai dan ramah tersendiri (terutama di Amerika Serikat bagian Selatan). (US)"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|point|0", "text": "how do you do → howdy"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|caution", "text": "Hanya sapaan santai dan ramah."}, {"key": "47538641-f573-4840-af35-02857a1d24de|explain", "text": "'I suppose' umumnya menghilangkan suku kata tengahnya dalam ucapan santai, digunakan untuk menyatakan ketidakpastian ringan atau persetujuan enggan — berbeda dari 'supposed to' → s'posed to."}, {"key": "47538641-f573-4840-af35-02857a1d24de|point|0", "text": "I suppose → I s'pose"}, {"key": "47538641-f573-4840-af35-02857a1d24de|caution", "text": "Hanya untuk ucapan informal — jika tidak, tulis 'I suppose' secara lengkap."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|explain", "text": "Kuasai reduksi melalui 50 latihan yang terarah. Dengarkan model AI dengan saksama, ulangi, dan rekam suara Anda untuk mendapatkan penilaian serta umpan balik pengucapan secara real-time yang terperinci."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|0", "text": "Fokus pada ritme, tekanan, dan alur yang disorot dalam setiap latihan."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|1", "text": "Dengarkan audio model referensi sebelum setiap percobaan rekaman."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|2", "text": "Tinjau skor AI dan umpan balik tingkat fonem Anda untuk menentukan area yang perlu ditingkatkan."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|caution", "text": "Jangan terburu-buru melalui latihan; utamakan kejelasan, irama yang alami, dan artikulasi yang akurat."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|0", "text": "Reduksi ekstrem kata bantu menjadi alur yang alami."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|1", "text": "'going to' -> 'gonna'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|2", "text": "'have got to' mengalami reduksi menjadi 'gotta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|3", "text": "'want a' -> 'wanna'; 'of' -> 'a' /ə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|4", "text": "'has to' -> 'hasta' /hæstə/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|5", "text": "'let me' -> 'lemme'; 'you' -> 'ya'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|6", "text": "'give me' -> 'gimme'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|7", "text": "'could you' -> 'couldja' /kʊdʒə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|8", "text": "'would you' -> 'wouldja'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|9", "text": "'what did you' -> 'whaddya'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|10", "text": "'should have' -> 'shoulda' /ʃʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|11", "text": "'could have' -> 'coulda' /kʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|12", "text": "'would have' -> 'woulda' /wʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|13", "text": "'must have' -> 'musta' /mʌstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|14", "text": "'might have' -> 'mighta' /maɪtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|15", "text": "'used to' -> 'usta' /juːstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|16", "text": "'supposed to' -> 'sposta' /spoʊstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|17", "text": "'need to' -> 'needa'; 'to' -> /də/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|18", "text": "'to' -> /də/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|19", "text": "'kind of' -> 'kinda' /kaɪndə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|20", "text": "'sort of' -> 'sorta' /sɔːrtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|21", "text": "'lots of' -> 'lotsa' /lɒtsə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|22", "text": "'out of' -> 'outta' /aʊtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|23", "text": "'front of' -> 'fronta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|24", "text": "'I am going to' disingkat menjadi 'I'mma' dalam percakapan informal."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|25", "text": "'don't you' -> 'doncha'; 'want to' -> 'wanna'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|26", "text": "'didn't you' -> 'didn'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|27", "text": "'haven't you' -> 'haven'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|28", "text": "'and' disingkat menjadi 'n' silabis /n/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|29", "text": "'day and night' -> 'day 'n night'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|30", "text": "'or' disingkat menjadi /ər/; 'it or' menyatu dengan lancar."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|31", "text": "'or' disingkat menjadi /ər/ tanpa tekanan."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|32", "text": "'and' disingkat menjadi /n/ di antara bunyi hambat."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|33", "text": "'that' relatif melemah menjadi /ðət/ dengan schwa."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|34", "text": "Konjungsi 'that' diucapkan lemah dan pendek."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|35", "text": "'that' diucapkan /ðət/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|36", "text": "'them' melemah menjadi ''em' /əm/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|37", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|38", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|39", "text": "'some' -> /səm/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|40", "text": "'for' -> /fər/; 'you' -> /jə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|41", "text": "'are' -> /ər/; 'you' -> /jə/; 'to' -> /tə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|42", "text": "'were' melemah menjadi /wər/."}]
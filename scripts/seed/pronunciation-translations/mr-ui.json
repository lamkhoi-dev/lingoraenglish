[{"key": "pron.hero.title", "text": "अधिक स्पष्ट, अधिक नैसर्गिक, अधिक प्रवाही बोला"}, {"key": "pron.hero.description", "text": "सर्व {{count}} इंग्रजी ध्वनी तसेच शब्द-ताण, वाक्य-ताण, स्वरसंगती, जोडलेले भाषण, संक्षेपण, लय, खंडीकरण आणि प्रवाह — प्रत्येक धडा तुमच्या स्वतःच्या रेकॉर्डिंगने संपतो."}, {"key": "pron.imageAlt", "text": "उच्चार व लेखन-उच्चारण (IPA)"}, {"key": "pron.progress.title", "text": "तुमची उच्चार प्रगती"}, {"key": "pron.progress.descUser", "text": "प्रशिक्षकाने तुमच्या स्वतःच्या रेकॉर्डिंगमध्ये ओळखलेल्या शब्दांवरून मोजली जाते."}, {"key": "pron.progress.descGuest", "text": "स्वतःचे रेकॉर्डिंग करण्यासाठी आणि प्रगती ट्रॅक करण्यासाठी मोफत खाते तयार करा."}, {"key": "pron.recommended", "text": "तुमच्यासाठी शिफारस केलेले"}, {"key": "pron.soundLabel", "text": "{{symbol}} ध्वनी"}, {"key": "pron.skill.sounds", "text": "ध्वनी"}, {"key": "pron.skill.sounds.blurb", "text": "सर्व ४४ इंग्रजी ध्वनी आणि किमान जोड्या."}, {"key": "pron.skill.wordStress", "text": "शब्द-ताण"}, {"key": "pron.skill.wordStress.blurb", "text": "अक्षरे, प्राथमिक आणि दुय्यम ताण."}, {"key": "pron.skill.sentenceStress", "text": "वाक्य-ताण"}, {"key": "pron.skill.sentenceStress.blurb", "text": "अर्थवाहक शब्द बलवान, सहायक शब्द सौम्य."}, {"key": "pron.skill.intonation", "text": "स्वरसंगती"}, {"key": "pron.skill.intonation.blurb", "text": "चढता, उतरता, चढ-उतर आणि उतर-चढ."}, {"key": "pron.skill.connectedSpeech", "text": "जोडलेले भाषण"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "जोडणी, लोप, समीकरण, सौम्य रूपे."}, {"key": "pron.skill.reductions", "text": "संक्षेपण"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — अनौपचारिक बोली इंग्रजी."}, {"key": "pron.skill.rhythm", "text": "लय"}, {"key": "pron.skill.rhythm.blurb", "text": "ताण-आधारित ठोके, वेळ आणि विराम."}, {"key": "pron.skill.chunking", "text": "विराम व खंडीकरण"}, {"key": "pron.skill.chunking.blurb", "text": "विचार-गट आणि नैसर्गिक श्वास-विराम."}, {"key": "pron.skill.fluency", "text": "प्रवाह"}, {"key": "pron.skill.fluency.blurb", "text": "वेग, संकोच, भरणारे शब्द आणि कल्पना जोडणे."}, {"key": "pron.filter.searchPlaceholder", "text": "ध्वनी, शब्द किंवा धडा शोधा"}, {"key": "pron.filter.allLevels", "text": "सर्व स्तर"}, {"key": "pron.filter.beginner", "text": "प्रारंभिक"}, {"key": "pron.filter.intermediate", "text": "मध्यम"}, {"key": "pron.filter.advanced", "text": "प्रगत"}, {"key": "pron.filter.allDifficulties", "text": "सर्व काठिण्य स्तर"}, {"key": "pron.filter.gentle", "text": "सौम्य"}, {"key": "pron.filter.steady", "text": "स्थिर"}, {"key": "pron.filter.challenging", "text": "आव्हानात्मक"}, {"key": "pron.filter.us", "text": "अमेरिकन इंग्रजी"}, {"key": "pron.filter.uk", "text": "ब्रिटिश इंग्रजी"}, {"key": "pron.sounds.title", "text": "{{count}} इंग्रजी ध्वनी"}, {"key": "pron.sounds.shown", "text": "{{count}} दर्शविले"}, {"key": "pron.lessons.title", "text": "{{skill}} धडे"}, {"key": "pron.lessons.none", "text": "या फिल्टरशी जुळणारा कोणताही धडा नाही. \"सर्व स्तर\" आणि \"कोणतेही काठिण्य\" वापरून पहा."}, {"key": "pron.how", "text": "कसे"}, {"key": "pron.commonMistakes", "text": "सामान्य चुका"}, {"key": "pron.wordPractice", "text": "शब्द सराव"}, {"key": "pron.sentencePractice", "text": "वाक्य सराव"}, {"key": "pron.minimalPairs", "text": "किमान जोड्या"}, {"key": "pron.practise", "text": "सराव करा"}, {"key": "pron.toast.signInModel", "text": "AI मॉडेलचा आवाज ऐकण्यासाठी साइन इन करा."}, {"key": "pron.toast.playError", "text": "ऑडिओ वाजवता आला नाही."}, {"key": "pron.voicedDesc", "text": "स्वरित — तुमच्या स्वरतंतू कंपन करतात"}, {"key": "pron.voicelessDesc", "text": "अस्वरित — फक्त श्वास, कंपन नाही"}, {"key": "pron.soundPracticeHint", "text": "उजवीकडील सराव कार्डमधील \"१. ऐका\" वर टॅप करा आणि AI मॉडेलचा हा ध्वनी व उदाहरण ऐका."}, {"key": "pron.paywall.soundLocked", "text": "या ध्वनीचा संपूर्ण धडा — तो कसा तयार करावा, तोंडाची स्थिती, उदाहरण शब्द, वाक्ये आणि किमान जोड्या — Lingora English Premium चा भाग आहे."}, {"key": "pron.paywall.freeLimit", "text": "पहिले {{count}} ध्वनी मोफत आहेत. सर्व ४४ ध्वनी आणि वैयक्तिक प्रशिक्षक अभिप्राय अनलॉक करण्यासाठी अपग्रेड करा."}, {"key": "pron.paywall.unlockAllSounds", "text": "सर्व ४४ ध्वनी अनलॉक करा"}, {"key": "pron.wordPracticeHint", "text": "AI ऐकण्यासाठी आणि सराव करण्यासाठी शब्दावर क्लिक करा"}, {"key": "pron.eg", "text": "उदा."}, {"key": "pron.playing", "text": "वाजत आहे"}, {"key": "pron.listen", "text": "ऐका"}, {"key": "pron.paywall.lessonLocked", "text": "या धड्याचे स्पष्टीकरण, सराव मुद्दे आणि उदाहरणे Lingora English Premium चा भाग आहेत."}, {"key": "pron.paywall.lessonFreeLimit", "text": "प्रत्येक कौशल्यातील पहिले {{count}} धडे मोफत आहेत. बाकीचे अनलॉक करण्यासाठी अपग्रेड करा."}, {"key": "pron.paywall.unlockAllLessons", "text": "सर्व धडे अनलॉक करा"}, {"key": "pron.itemPracticeHint", "text": "AI सोबत सराव करण्यासाठी आयटमवर क्लिक करा"}, {"key": "pron.practiceHint", "text": "ऐका, पुन्हा म्हणा, रेकॉर्ड करा आणि तुलना करा — कोच कोणते शब्द स्पष्ट आले ते नक्की दाखवतो."}, {"key": "pron.drillsCount", "text": "{{count}} सराव"}, {"key": "pron.useInShadowing", "text": "हे कौशल्य शॅडोइंगमध्ये वापरा"}, {"key": "pron.backToCoach", "text": "स्पीकिंग कोचकडे परत"}, {"key": "pron.p.title", "text": "सराव"}, {"key": "pron.p.step1.label", "text": "ऐका"}, {"key": "pron.p.step1.hint", "text": "नमुना ऑडिओ दोनदा वाजवा."}, {"key": "pron.p.step2.label", "text": "समजून घ्या"}, {"key": "pron.p.step2.hint", "text": "तुमच्या तोंडाने काय करायचे ते वाचा."}, {"key": "pron.p.step3.label", "text": "पहा / शिका"}, {"key": "pron.p.step3.hint", "text": "तोंड, जीभ आणि पॅटर्न मार्गदर्शक तपासा."}, {"key": "pron.p.step4.label", "text": "पुन्हा म्हणा"}, {"key": "pron.p.step4.hint", "text": "ऑडिओसोबत मोठ्याने म्हणा, आधी हळू."}, {"key": "pron.p.step5.label", "text": "रेकॉर्ड करा"}, {"key": "pron.p.step5.hint", "text": "तीच ओळ म्हणत स्वतःला रेकॉर्ड करा."}, {"key": "pron.p.step6.label", "text": "AI अभिप्राय"}, {"key": "pron.p.step6.hint", "text": "कोचने काय ऐकले आणि काय सुधारायचे ते पहा."}, {"key": "pron.p.step7.label", "text": "पुन्हा प्रयत्न करा"}, {"key": "pron.p.step7.hint", "text": "एक गोष्ट सुधारा आणि पुन्हा एकदा रेकॉर्ड करा."}, {"key": "pron.p.step8.label", "text": "प्रभुत्व"}, {"key": "pron.p.step8.hint", "text": "सलग दोनदा स्पष्ट वाचन — पुढे जा."}, {"key": "pron.p.stepTap", "text": "{{hint}} हे केल्यावर एकदा टॅप करा."}, {"key": "pron.p.focusSound", "text": "फोकस ध्वनी {{sound}}"}, {"key": "pron.p.eg", "text": "उदा. {{sentence}}"}, {"key": "pron.p.loading", "text": "लोड होत आहे…"}, {"key": "pron.p.speedNormal", "text": "सामान्य"}, {"key": "pron.p.speedSlower", "text": "थोडे हळू"}, {"key": "pron.p.speedSlow", "text": "हळू"}, {"key": "pron.p.loop", "text": "लूप"}, {"key": "pron.p.stop", "text": "थांबा"}, {"key": "pron.p.voiceNote", "text": "नमुना ऑडिओ Lingora चा अमेरिकन इंग्रजी AI आवाज आहे, मानवी रेकॉर्डिंग नाही."}, {"key": "pron.p.listenSentence", "text": "ऐका हे ध्वनी दोनदा, नंतर उदाहरण शब्द, नंतर तो असलेले वाक्य वाजवते."}, {"key": "pron.p.listenExample", "text": "ऐका हे ध्वनी दोनदा, नंतर उदाहरण वाजवते."}, {"key": "pron.p.recordHint", "text": "वरील ओळ एकदा स्पष्टपणे म्हणा."}, {"key": "pron.p.signupToRecord", "text": "रेकॉर्ड करण्यासाठी आणि अभिप्राय मिळवण्यासाठी मोफत खाते तयार करा."}, {"key": "pron.p.yourRecording", "text": "तुमचे रेकॉर्डिंग"}, {"key": "pron.p.listeningRec", "text": "तुमचे रेकॉर्डिंग ऐकत आहे…"}, {"key": "pron.p.wordsClear", "text": "स्पष्ट म्हटलेले शब्द"}, {"key": "pron.p.wpm", "text": "बोलण्याचा वेग (wpm)"}, {"key": "pron.p.heard", "text": "Lingora ने ऐकले"}, {"key": "pron.p.tagClear", "text": "स्पष्ट"}, {"key": "pron.p.tagNeeds", "text": "सुधारणा आवश्यक"}, {"key": "pron.p.measured", "text": "मोजलेले सादरीकरण"}, {"key": "pron.p.paceLabel", "text": "गती:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} शब्द प्रति मिनिट ({{pace}})"}, {"key": "pron.p.paceNote", "text": "नैसर्गिक संभाषण सुमारे 120–160 असते."}, {"key": "pron.p.pace.slow", "text": "हळू"}, {"key": "pron.p.pace.natural", "text": "नैसर्गिक"}, {"key": "pron.p.pace.fast", "text": "वेगवान"}, {"key": "pron.p.fillersLabel", "text": "भर घालणारे शब्द:"}, {"key": "pron.p.repeatedLabel", "text": "पुनरावृत्त शब्द:"}, {"key": "pron.p.noneDetected", "text": "काहीही आढळले नाही"}, {"key": "pron.p.measuredNote", "text": "गती, भर घालणारे शब्द आणि पुनरावृत्ती तुमच्या खऱ्या ट्रान्स्क्रिप्ट आणि रेकॉर्डिंग लांबीवरून मोजली जाते. पिच, आवाजाची तीव्रता आणि शांत विरामाची लांबी मोजली जात नाही, म्हणून आम्ही स्वरभेद किंवा विराम स्वयंचलितपणे गुण देत नाही."}, {"key": "pron.p.mastered", "text": "प्रभुत्व — दोन स्पष्ट प्रयत्न"}, {"key": "pron.p.attempt", "text": "प्रयत्न {{n}} — सलग दोन स्पष्ट वाचन या ओळीला प्रभुत्व म्हणून चिन्हांकित करते."}, {"key": "pron.p.toShadowing", "text": "हे खऱ्या बोलण्यात सराव करा → शॅडोइंग"}, {"key": "pron.p.toCoach", "text": "स्पीकिंग कोचसोबत वापरा"}]
[{"key": "pron.hero.title", "text": "よりクリアに、より自然に、より流暢に"}, {"key": "pron.hero.description", "text": "英語の全{{count}}音に加え、語強勢、文強勢、イントネーション、連結発話、短縮形、リズム、チャンキング、流暢さを網羅 — すべてのレッスンはあなた自身の録音で締めくくられます。"}, {"key": "pron.imageAlt", "text": "発音の調音とIPA"}, {"key": "pron.progress.title", "text": "あなたの発音の進捗"}, {"key": "pron.progress.descUser", "text": "コーチがあなたの録音から認識した単語に基づいて測定されます。"}, {"key": "pron.progress.descGuest", "text": "無料アカウントを作成して録音し、進捗の記録を始めましょう。"}, {"key": "pron.recommended", "text": "あなたへのおすすめ"}, {"key": "pron.soundLabel", "text": "{{symbol}}の音"}, {"key": "pron.skill.sounds", "text": "音"}, {"key": "pron.skill.sounds.blurb", "text": "英語の全44音素を最小対比語とともに。"}, {"key": "pron.skill.wordStress", "text": "語強勢"}, {"key": "pron.skill.wordStress.blurb", "text": "音節、主強勢と副強勢。"}, {"key": "pron.skill.sentenceStress", "text": "文強勢"}, {"key": "pron.skill.sentenceStress.blurb", "text": "内容語は強く、機能語は弱く。"}, {"key": "pron.skill.intonation", "text": "イントネーション"}, {"key": "pron.skill.intonation.blurb", "text": "上昇、下降、上昇下降、下降上昇。"}, {"key": "pron.skill.connectedSpeech", "text": "連結発話"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "連結、省略、同化、弱形。"}, {"key": "pron.skill.reductions", "text": "短縮形"}, {"key": "pron.skill.reductions.blurb", "text": "gonna、wanna、hafta — 口語英語のインフォーマルな形。"}, {"key": "pron.skill.rhythm", "text": "リズム"}, {"key": "pron.skill.rhythm.blurb", "text": "強勢拍のビート、タイミング、ポーズ。"}, {"key": "pron.skill.chunking", "text": "ポーズとチャンキング"}, {"key": "pron.skill.chunking.blurb", "text": "思考グループと自然な息継ぎのポーズ。"}, {"key": "pron.skill.fluency", "text": "流暢さ"}, {"key": "pron.skill.fluency.blurb", "text": "速度、ためらい、フィラー、アイデアのつなぎ。"}, {"key": "pron.filter.searchPlaceholder", "text": "音、単語、レッスンを検索"}, {"key": "pron.filter.allLevels", "text": "すべてのレベル"}, {"key": "pron.filter.beginner", "text": "初級"}, {"key": "pron.filter.intermediate", "text": "中級"}, {"key": "pron.filter.advanced", "text": "上級"}, {"key": "pron.filter.allDifficulties", "text": "すべての難易度"}, {"key": "pron.filter.gentle", "text": "やさしい"}, {"key": "pron.filter.steady", "text": "標準"}, {"key": "pron.filter.challenging", "text": "チャレンジ"}, {"key": "pron.filter.us", "text": "アメリカ英語"}, {"key": "pron.filter.uk", "text": "イギリス英語"}, {"key": "pron.sounds.title", "text": "英語の{{count}}音"}, {"key": "pron.sounds.shown", "text": "{{count}}件表示"}, {"key": "pron.lessons.title", "text": "{{skill}}のレッスン"}, {"key": "pron.lessons.none", "text": "このフィルターに一致するレッスンがありません。「すべてのレベル」と「すべての難易度」をお試しください。"}, {"key": "pron.how", "text": "発音の仕方"}, {"key": "pron.commonMistakes", "text": "よくある間違い"}, {"key": "pron.wordPractice", "text": "単語練習"}, {"key": "pron.sentencePractice", "text": "文練習"}, {"key": "pron.minimalPairs", "text": "最小対比語"}, {"key": "pron.practise", "text": "練習する"}, {"key": "pron.toast.signInModel", "text": "AIモデルの音声を聞くにはサインインしてください。"}, {"key": "pron.toast.playError", "text": "音声を再生できませんでした。"}, {"key": "pron.voicedDesc", "text": "有声音 — 声帯が振動します"}, {"key": "pron.voicelessDesc", "text": "無声音 — 息のみで振動なし"}, {"key": "pron.soundPracticeHint", "text": "右側の練習カードで「1. 聞く」をタップして、AIモデルによるこの音と例を聞きましょう。"}, {"key": "pron.paywall.soundLocked", "text": "この音の完全なレッスン — 発音の仕方、口の位置、例単語、文、最小対比語 — はLingora English Premiumの一部です。"}, {"key": "pron.paywall.freeLimit", "text": "最初の{{count}}音は無料です。アップグレードして全44音とパーソナライズされたコーチのフィードバックをアンロックしましょう。"}, {"key": "pron.paywall.unlockAllSounds", "text": "全44音をアンロック"}, {"key": "pron.wordPracticeHint", "text": "単語をクリックしてAIを聞き、練習する"}, {"key": "pron.eg", "text": "例:"}, {"key": "pron.playing", "text": "再生中"}, {"key": "pron.listen", "text": "聞く"}, {"key": "pron.paywall.lessonLocked", "text": "このレッスンの解説、練習ポイント、例はLingora English Premiumの一部です。"}, {"key": "pron.paywall.lessonFreeLimit", "text": "各スキルの最初の{{count}}レッスンは無料です。アップグレードして残りを解除しましょう。"}, {"key": "pron.paywall.unlockAllLessons", "text": "すべてのレッスンを解除"}, {"key": "pron.itemPracticeHint", "text": "項目をクリックしてAIと練習"}, {"key": "pron.practiceHint", "text": "聞いて、繰り返して、録音して、比較しましょう — コーチがどの単語がはっきり伝わったかを正確に示します。"}, {"key": "pron.drillsCount", "text": "{{count}}個のドリル"}, {"key": "pron.useInShadowing", "text": "このスキルをシャドーイングで使う"}, {"key": "pron.backToCoach", "text": "スピーキングコーチに戻る"}, {"key": "pron.p.title", "text": "練習"}, {"key": "pron.p.step1.label", "text": "聞く"}, {"key": "pron.p.step1.hint", "text": "モデル音声を2回再生しましょう。"}, {"key": "pron.p.step2.label", "text": "理解する"}, {"key": "pron.p.step2.hint", "text": "口の動かし方を読みましょう。"}, {"key": "pron.p.step3.label", "text": "見る／学ぶ"}, {"key": "pron.p.step3.hint", "text": "口、舌、パターンのガイドを確認しましょう。"}, {"key": "pron.p.step4.label", "text": "繰り返す"}, {"key": "pron.p.step4.hint", "text": "まずはゆっくり、音声に合わせて声に出しましょう。"}, {"key": "pron.p.step5.label", "text": "録音"}, {"key": "pron.p.step5.hint", "text": "同じフレーズを言って録音しましょう。"}, {"key": "pron.p.step6.label", "text": "AIフィードバック"}, {"key": "pron.p.step6.hint", "text": "コーチが聞き取った内容と修正点を確認しましょう。"}, {"key": "pron.p.step7.label", "text": "もう一度"}, {"key": "pron.p.step7.hint", "text": "1つ修正してもう一度録音しましょう。"}, {"key": "pron.p.step8.label", "text": "マスター"}, {"key": "pron.p.step8.hint", "text": "2回連続ではっきり読み上げられたら次へ進みましょう。"}, {"key": "pron.p.stepTap", "text": "{{hint}} 完了したらタップしてください。"}, {"key": "pron.p.focusSound", "text": "フォーカス音 {{sound}}"}, {"key": "pron.p.eg", "text": "例：{{sentence}}"}, {"key": "pron.p.loading", "text": "読み込み中…"}, {"key": "pron.p.speedNormal", "text": "普通"}, {"key": "pron.p.speedSlower", "text": "ややゆっくり"}, {"key": "pron.p.speedSlow", "text": "ゆっくり"}, {"key": "pron.p.loop", "text": "ループ"}, {"key": "pron.p.stop", "text": "停止"}, {"key": "pron.p.voiceNote", "text": "モデル音声はLingoraのアメリカ英語AI音声であり、人間の録音ではありません。"}, {"key": "pron.p.listenSentence", "text": "「聞く」を押すと、音を2回、例単語、その単語を含む文の順に再生されます。"}, {"key": "pron.p.listenExample", "text": "「聞く」を押すと、音を2回、次に例を再生します。"}, {"key": "pron.p.recordHint", "text": "上のフレーズを一度、はっきり言いましょう。"}, {"key": "pron.p.signupToRecord", "text": "無料アカウントを作成して録音し、フィードバックを受け取りましょう。"}, {"key": "pron.p.yourRecording", "text": "あなたの録音"}, {"key": "pron.p.listeningRec", "text": "録音を聞いています…"}, {"key": "pron.p.wordsClear", "text": "はっきり言えた単語"}, {"key": "pron.p.wpm", "text": "話す速度（wpm）"}, {"key": "pron.p.heard", "text": "Lingoraが聞き取った内容"}, {"key": "pron.p.tagClear", "text": "はっきり"}, {"key": "pron.p.tagNeeds", "text": "要改善"}, {"key": "pron.p.measured", "text": "測定結果"}, {"key": "pron.p.paceLabel", "text": "ペース："}, {"key": "pron.p.paceValue", "text": "{{wpm}}語/分（{{pace}}）"}, {"key": "pron.p.paceNote", "text": "自然な会話は約120〜160です。"}, {"key": "pron.p.pace.slow", "text": "遅い"}, {"key": "pron.p.pace.natural", "text": "自然"}, {"key": "pron.p.pace.fast", "text": "速い"}, {"key": "pron.p.fillersLabel", "text": "フィラー："}, {"key": "pron.p.repeatedLabel", "text": "繰り返した単語："}, {"key": "pron.p.noneDetected", "text": "検出されませんでした"}, {"key": "pron.p.measuredNote", "text": "ペース、フィラー、繰り返しは実際の文字起こしと録音の長さから算出されます。ピッチ、音量、無音の長さは測定されないため、イントネーションやポーズは自動採点されません。"}, {"key": "pron.p.mastered", "text": "マスター — 2回のはっきりした試行"}, {"key": "pron.p.attempt", "text": "試行{{n}} — 2回連続ではっきり読み上げると、このフレーズはマスターとなります。"}, {"key": "pron.p.toShadowing", "text": "実際の会話で練習 → シャドーイング"}, {"key": "pron.p.toCoach", "text": "スピーキングコーチで使う"}]
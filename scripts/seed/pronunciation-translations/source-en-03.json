[
 {
  "key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|point|3",
  "en": "got to → gotta"
 },
 {
  "key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|caution",
  "en": "These are informal spoken forms. Do not write them in essays, emails or formal exams, and avoid them in a formal presentation."
 },
 {
  "key": "b8706c44-5a49-402e-9382-f18427f2084c|explain",
  "en": "More casual reductions you will hear constantly in films and real conversation."
 },
 {
  "key": "b8706c44-5a49-402e-9382-f18427f2084c|point|0",
  "en": "kind of → kinda"
 },
 {
  "key": "b8706c44-5a49-402e-9382-f18427f2084c|point|1",
  "en": "sort of → sorta"
 },
 {
  "key": "b8706c44-5a49-402e-9382-f18427f2084c|point|2",
  "en": "let me → lemme"
 },
 {
  "key": "b8706c44-5a49-402e-9382-f18427f2084c|point|3",
  "en": "give me → gimme"
 },
 {
  "key": "b8706c44-5a49-402e-9382-f18427f2084c|point|4",
  "en": "what do you → whaddaya"
 },
 {
  "key": "b8706c44-5a49-402e-9382-f18427f2084c|caution",
  "en": "Informal only. In an IELTS or job interview, keep the full forms."
 },
 {
  "key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|explain",
  "en": "More obligation and habit reductions common in relaxed spoken English."
 },
 {
  "key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|0",
  "en": "have to → hafta"
 },
 {
  "key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|1",
  "en": "need to → needa"
 },
 {
  "key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|2",
  "en": "used to → useta"
 },
 {
  "key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|caution",
  "en": "Informal spoken forms only — never write them."
 },
 {
  "key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|explain",
  "en": "Past modal reductions — very common when talking about regrets or hypothetical situations."
 },
 {
  "key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|0",
  "en": "could have → coulda"
 },
 {
  "key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|1",
  "en": "would have → woulda"
 },
 {
  "key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|2",
  "en": "should have → shoulda"
 },
 {
  "key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|caution",
  "en": "Informal spoken only — write 'could have' in full in formal writing."
 },
 {
  "key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|explain",
  "en": "Very casual reductions common in songs, films and relaxed conversation among friends."
 },
 {
  "key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|0",
  "en": "don't know → dunno"
 },
 {
  "key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|1",
  "en": "don't you → dontcha"
 },
 {
  "key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|2",
  "en": "what are you → whatcha"
 },
 {
  "key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|caution",
  "en": "Very informal — only with close friends, never in professional or exam contexts."
 },
 {
  "key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|explain",
  "en": "Common preposition-linked reductions in casual speech."
 },
 {
  "key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|0",
  "en": "out of → outta"
 },
 {
  "key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|1",
  "en": "off of → offa"
 },
 {
  "key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|2",
  "en": "cup of → cuppa"
 },
 {
  "key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|caution",
  "en": "Informal only."
 },
 {
  "key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|explain",
  "en": "Everyday exclamations and casual phrases with heavy reduction."
 },
 {
  "key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|0",
  "en": "come on → c'mon"
 },
 {
  "key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|1",
  "en": "going to be → gonna be"
 },
 {
  "key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|2",
  "en": "some more → s'more"
 },
 {
  "key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|caution",
  "en": "Informal only."
 },
 {
  "key": "96d3b17b-36da-4b59-a18b-5199dc78c582|explain",
  "en": "Question-starters reduce heavily in fast, casual conversation."
 },
 {
  "key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|0",
  "en": "did you → dja"
 },
 {
  "key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|1",
  "en": "do you → dya"
 },
 {
  "key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|2",
  "en": "would you → wouldja"
 },
 {
  "key": "96d3b17b-36da-4b59-a18b-5199dc78c582|caution",
  "en": "Only for casual, spoken contexts."
 },
 {
  "key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|explain",
  "en": "Casual speech often reduces time phrases too."
 },
 {
  "key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|0",
  "en": "a couple of → a couple"
 },
 {
  "key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|1",
  "en": "in a minute → in a min"
 },
 {
  "key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|caution",
  "en": "Fine in casual talk, not in writing."
 },
 {
  "key": "294bc66f-885f-487c-a434-e3f668c306c5|explain",
  "en": "More common casual reductions heard constantly in relaxed conversation."
 },
 {
  "key": "294bc66f-885f-487c-a434-e3f668c306c5|point|0",
  "en": "probably → prolly"
 },
 {
  "key": "294bc66f-885f-487c-a434-e3f668c306c5|point|1",
  "en": "trying to → tryna"
 },
 {
  "key": "294bc66f-885f-487c-a434-e3f668c306c5|point|2",
  "en": "supposed to → s'posed to"
 },
 {
  "key": "294bc66f-885f-487c-a434-e3f668c306c5|caution",
  "en": "Informal spoken only."
 },
 {
  "key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|explain",
  "en": "Casual reductions common among friends and in American informal speech."
 },
 {
  "key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|0",
  "en": "let's go → less go"
 },
 {
  "key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|1",
  "en": "give it to me → gimme that"
 },
 {
  "key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|2",
  "en": "you all → y'all"
 },
 {
  "key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|caution",
  "en": "Very informal — 'y'all' is regional (Southern US) but widely understood."
 },
 {
  "key": "1015f614-a8a6-4634-97e1-86252ed3b149|explain",
  "en": "Round numbers reduce their middle consonant sounds in fast, casual American speech."
 },
 {
  "key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|0",
  "en": "twenty → twenny"
 },
 {
  "key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|1",
  "en": "hundred → hunnerd"
 },
 {
  "key": "1015f614-a8a6-4634-97e1-86252ed3b149|caution",
  "en": "Informal spoken only — always say the full form in formal contexts."
 },
 {
  "key": "69aea060-6196-4732-a658-25a6b0d08e52|explain",
  "en": "A different set of everyday words that regularly lose a syllable in fast, relaxed speech."
 },
 {
  "key": "69aea060-6196-4732-a658-25a6b0d08e52|point|0",
  "en": "different → diff'rent"
 },
 {
  "key": "69aea060-6196-4732-a658-25a6b0d08e52|point|1",
  "en": "general → gen'ral"
 },
 {
  "key": "69aea060-6196-4732-a658-25a6b0d08e52|point|2",
  "en": "several → sev'ral"
 },
 {
  "key": "69aea060-6196-4732-a658-25a6b0d08e52|point|3",
  "en": "camera → cam'ra"
 },
 {
  "key": "69aea060-6196-4732-a658-25a6b0d08e52|caution",
  "en": "Fine in casual speech; say the full form clearly in formal presentations."
 },
 {
  "key": "d19575cd-6d8a-4493-b1e0-f3d272543988|explain",
  "en": "Very informal reductions you'll hear in songs and casual American speech, but should never use in professional settings."
 },
 {
  "key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|0",
  "en": "I'm going to → I'ma"
 },
 {
  "key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|1",
  "en": "kind of like → kinda like"
 },
 {
  "key": "d19575cd-6d8a-4493-b1e0-f3d272543988|caution",
  "en": "Extremely informal — friends/song lyrics only, never professional contexts."
 },
 {
  "key": "551b9527-f712-421d-966c-24644f360746|explain",
  "en": "Extra everyday greeting reductions beyond what's up / how's it going."
 },
 {
  "key": "551b9527-f712-421d-966c-24644f360746|point|0",
  "en": "how are you → how ya doin'"
 },
 {
  "key": "551b9527-f712-421d-966c-24644f360746|point|1",
  "en": "good to see you → good to see ya"
 },
 {
  "key": "551b9527-f712-421d-966c-24644f360746|caution",
  "en": "Casual spoken forms only."
 },
 {
  "key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|explain",
  "en": "More obligation and desire reductions common in relaxed American speech."
 },
 {
  "key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|0",
  "en": "ought to → oughta"
 },
 {
  "key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|1",
  "en": "don't have to → don't hafta"
 },
 {
  "key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|2",
  "en": "want you → wantcha"
 },
 {
  "key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|caution",
  "en": "Informal spoken only."
 },
 {
  "key": "a988c705-5d07-4e9a-a930-5967242b673b|explain",
  "en": "This is a classic example of how far casual American reduction can go — several words blur into what sounds like one."
 },
 {
  "key": "a988c705-5d07-4e9a-a930-5967242b673b|point|0",
  "en": "Did you eat yet? → Jeetyet?"
 },
 {
  "key": "a988c705-5d07-4e9a-a930-5967242b673b|point|1",
  "en": "Did you already? → Jeetalready?"
 },
 {
  "key": "a988c705-5d07-4e9a-a930-5967242b673b|caution",
  "en": "Extremely informal — for recognizing fast native speech, not for your own formal speaking."
 },
 {
  "key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|explain",
  "en": "Two more common phrase-level reductions in casual conversation."
 },
 {
  "key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|0",
  "en": "because of → 'cause of"
 },
 {
  "key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|1",
  "en": "sort of a → sorta a"
 },
 {
  "key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|caution",
  "en": "Informal spoken only."
 },
 {
  "key": "d885413e-df2d-4088-b5a9-f07b62449289|explain",
  "en": "Very common casual alternatives to 'yes' and 'no' in relaxed spoken English."
 },
 {
  "key": "d885413e-df2d-4088-b5a9-f07b62449289|point|0",
  "en": "yes → yep / uh-huh"
 },
 {
  "key": "d885413e-df2d-4088-b5a9-f07b62449289|point|1",
  "en": "no → nope / nah"
 },
 {
  "key": "d885413e-df2d-4088-b5a9-f07b62449289|caution",
  "en": "Casual conversation only — use 'yes'/'no' in formal or exam contexts."
 },
 {
  "key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|explain",
  "en": "Both reduce to a similar-sounding 'wanna', but one is followed by a noun and the other by a verb — worth noticing the difference."
 },
 {
  "key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|0",
  "en": "want a (coffee) → wanna coffee"
 },
 {
  "key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|1",
  "en": "want to (go) → wanna go"
 },
 {
  "key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|caution",
  "en": "Informal spoken only."
 },
 {
  "key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|0",
  "en": "'want a' + noun → wanna"
 },
 {
  "key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|1",
  "en": "'want to' + verb → wanna"
 },
 {
  "key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|explain",
  "en": "The negative version of 'would have' reduces the same way as the positive form."
 },
 {
  "key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|point|0",
  "en": "wouldn't have → wouldn'ta"
 },
 {
  "key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|caution",
  "en": "Informal spoken only — write 'wouldn't have' in full otherwise."
 },
 {
  "key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|explain",
  "en": "Two more everyday reductions common in casual explanations and requests."
 },
 {
  "key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|0",
  "en": "just because → just 'cause"
 },
 {
  "key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|1",
  "en": "going to need → gonna need"
 },
 {
  "key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|caution",
  "en": "Informal spoken only."
 },
 {
  "key": "233cf355-0eca-4443-9a49-65fb7f9946ac|explain",
  "en": "'Ain't' replaces am not/is not/are not/has not/have not in very casual speech and is heard everywhere in songs and informal talk."
 },
 {
  "key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|0",
  "en": "I am not → I ain't"
 },
 {
  "key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|1",
  "en": "that is not → that ain't"
 },
 {
  "key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|2",
  "en": "you have not → you ain't"
 },
 {
  "key": "233cf355-0eca-4443-9a49-65fb7f9946ac|caution",
  "en": "Never use in writing or formal speech — considered non-standard grammar, even though extremely common informally."
 },
 {
  "key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|explain",
  "en": "A very common casual way to say 'I understand' or literally 'caught you'."
 },
 {
  "key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|0",
  "en": "got you (understand) → gotcha"
 },
 {
  "key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|1",
  "en": "got you (caught) → gotcha"
 },
 {
  "key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|caution",
  "en": "Informal spoken only — say 'I understand' or 'got it' in professional contexts."
 },
 {
  "key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|explain",
  "en": "Modal-perfect reductions used for guesses about the past, alongside coulda/woulda/shoulda."
 },
 {
  "key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|0",
  "en": "must have → musta"
 },
 {
  "key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|1",
  "en": "might have → mighta"
 },
 {
  "key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|caution",
  "en": "Informal spoken only — write 'must have'/'might have' in full otherwise."
 },
 {
  "key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|explain",
  "en": "The negative counterparts of coulda/woulda/shoulda, common when talking about regrets."
 },
 {
  "key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|0",
  "en": "shouldn't have → shouldn'ta"
 },
 {
  "key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|1",
  "en": "couldn't have → couldn'ta"
 },
 {
  "key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|caution",
  "en": "Informal spoken only — write 'shouldn't have'/'couldn't have' in full in formal contexts."
 },
 {
  "key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|explain",
  "en": "In relaxed speech, the final -ing sound often drops its 'g', so it sounds like -in'. This happens across almost any -ing verb."
 },
 {
  "key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|0",
  "en": "doing → doin'"
 },
 {
  "key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|1",
  "en": "going → goin'"
 },
 {
  "key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|2",
  "en": "talking → talkin'"
 },
 {
  "key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|3",
  "en": "thinking → thinkin'"
 },
 {
  "key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|caution",
  "en": "Casual speech only — pronounce the full '-ing' clearly in presentations, interviews and exams."
 },
 {
  "key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|explain",
  "en": "The same g-dropping pattern applies to indefinite pronouns ending in -thing."
 },
 {
  "key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|0",
  "en": "something → somethin'"
 },
 {
  "key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|1",
  "en": "nothing → nothin'"
 },
 {
  "key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|2",
  "en": "anything → anythin'"
 },
 {
  "key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|caution",
  "en": "Casual speech only."
 },
 {
  "key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|explain",
  "en": "'Them' reduces to 'em (the 'th' drops) after a verb, in very common casual speech."
 },
 {
  "key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|0",
  "en": "tell them → tell 'em"
 },
 {
  "key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|1",
  "en": "get them → get 'em"
 },
 {
  "key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|2",
  "en": "ask them → ask 'em"
 },
 {
  "key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|caution",
  "en": "Informal spoken only — say 'them' in full in writing or formal speech."
 },
 {
  "key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|explain",
  "en": "'And' reduces to a quick 'n' sound between two closely linked words, especially in set phrases."
 },
 {
  "key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|0",
  "en": "rock and roll → rock 'n' roll"
 },
 {
  "key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|1",
  "en": "fish and chips → fish 'n' chips"
 },
 {
  "key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|2",

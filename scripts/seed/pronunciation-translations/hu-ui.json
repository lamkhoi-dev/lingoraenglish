[{"key": "pron.hero.title", "text": "Beszélj érthetőbben, természetesebben, folyékonyabban"}, {"key": "pron.hero.description", "text": "Mind a {{count}} angol hang, valamint szóhangsúly, mondathangsúly, intonáció, összekapcsolt beszéd, redukciók, ritmus, tagolás és folyékonyság — minden lecke a saját felvételeddel zárul."}, {"key": "pron.imageAlt", "text": "Kiejtés, artikuláció és IPA"}, {"key": "pron.progress.title", "text": "A kiejtési fejlődésed"}, {"key": "pron.progress.descUser", "text": "A coach által a saját felvételeidben felismert szavak alapján mérve."}, {"key": "pron.progress.descGuest", "text": "Hozz létre ingyenes fiókot, hogy felvehesd magadat és nyomon követhesd a fejlődésedet."}, {"key": "pron.recommended", "text": "Neked ajánlott"}, {"key": "pron.soundLabel", "text": "{{symbol}} hang"}, {"key": "pron.skill.sounds", "text": "Hangok"}, {"key": "pron.skill.sounds.blurb", "text": "Mind a 44 angol fonéma minimálpárokkal."}, {"key": "pron.skill.wordStress", "text": "Szóhangsúly"}, {"key": "pron.skill.wordStress.blurb", "text": "Szótagok, elsődleges és másodlagos hangsúly."}, {"key": "pron.skill.sentenceStress", "text": "Mondathangsúly"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Tartalmas szavak erősen, funkciószavak gyengén."}, {"key": "pron.skill.intonation", "text": "Intonáció"}, {"key": "pron.skill.intonation.blurb", "text": "Emelkedő, ereszkedő, emelkedő-ereszkedő és ereszkedő-emelkedő."}, {"key": "pron.skill.connectedSpeech", "text": "Összekapcsolt beszéd"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Összekapcsolás, elízió, asszimiláció, gyenge formák."}, {"key": "pron.skill.reductions", "text": "Redukciók"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — informális beszélt angol."}, {"key": "pron.skill.rhythm", "text": "Ritmus"}, {"key": "pron.skill.rhythm.blurb", "text": "Hangsúlyvezérelt ütemek, időzítés és szünetek."}, {"key": "pron.skill.chunking", "text": "Szüneteltetés és tagolás"}, {"key": "pron.skill.chunking.blurb", "text": "Gondolategységek és természetes lélegzetszünetek."}, {"key": "pron.skill.fluency", "text": "Folyékonyság"}, {"key": "pron.skill.fluency.blurb", "text": "Sebesség, hezitálás, töltelékszavak és gondolatok összekapcsolása."}, {"key": "pron.filter.searchPlaceholder", "text": "Hang, szó vagy lecke keresése"}, {"key": "pron.filter.allLevels", "text": "Minden szint"}, {"key": "pron.filter.beginner", "text": "Kezdő"}, {"key": "pron.filter.intermediate", "text": "Középhaladó"}, {"key": "pron.filter.advanced", "text": "Haladó"}, {"key": "pron.filter.allDifficulties", "text": "Minden nehézség"}, {"key": "pron.filter.gentle", "text": "Könnyed"}, {"key": "pron.filter.steady", "text": "Egyenletes"}, {"key": "pron.filter.challenging", "text": "Kihívó"}, {"key": "pron.filter.us", "text": "Amerikai angol"}, {"key": "pron.filter.uk", "text": "Brit angol"}, {"key": "pron.sounds.title", "text": "A {{count}} angol hang"}, {"key": "pron.sounds.shown", "text": "{{count}} megjelenítve"}, {"key": "pron.lessons.title", "text": "{{skill}} leckék"}, {"key": "pron.lessons.none", "text": "Egyetlen lecke sem felel meg ezeknek a szűrőknek. Próbáld a „Minden szint” és „Minden nehézség” beállítást."}, {"key": "pron.how", "text": "Hogyan"}, {"key": "pron.commonMistakes", "text": "Gyakori hibák"}, {"key": "pron.wordPractice", "text": "Szógyakorlás"}, {"key": "pron.sentencePractice", "text": "Mondatgyakorlás"}, {"key": "pron.minimalPairs", "text": "Minimálpárok"}, {"key": "pron.practise", "text": "Gyakorlás"}, {"key": "pron.toast.signInModel", "text": "Jelentkezz be, hogy meghallhasd az AI modell hangját."}, {"key": "pron.toast.playError", "text": "Nem sikerült lejátszani a hangot."}, {"key": "pron.voicedDesc", "text": "Zöngés — a hangszálak rezegnek"}, {"key": "pron.voicelessDesc", "text": "Zöngétlen — csak levegő, nincs rezgés"}, {"key": "pron.soundPracticeHint", "text": "Koppints az „1. Hallgasd meg” gombra a jobb oldali gyakorlókártyán, hogy meghallhasd az AI modell ezt a hangot és egy példát."}, {"key": "pron.paywall.soundLocked", "text": "Ennek a hangnak a teljes leckéje — hogyan képezd, szájtartás, példaszavak, mondatok és minimálpárok — a Lingora English Premium része."}, {"key": "pron.paywall.freeLimit", "text": "Az első {{count}} hang ingyenes. Válts előfizetésre, hogy feloldd mind a 44 hangot és a személyre szabott coach-visszajelzést."}, {"key": "pron.paywall.unlockAllSounds", "text": "Mind a 44 hang feloldása"}, {"key": "pron.wordPracticeHint", "text": "Kattints a szóra az AI meghallgatásához és a gyakorláshoz"}, {"key": "pron.eg", "text": "pl."}, {"key": "pron.playing", "text": "Lejátszás"}, {"key": "pron.listen", "text": "Hallgasd meg"}, {"key": "pron.paywall.lessonLocked", "text": "Ennek a leckének a magyarázata, gyakorlati pontjai és példái a Lingora English Premium része."}, {"key": "pron.paywall.lessonFreeLimit", "text": "Minden készség első {{count}} leckéje ingyenes. Vásárolj előfizetést a többi feloldásához."}, {"key": "pron.paywall.unlockAllLessons", "text": "Összes lecke feloldása"}, {"key": "pron.itemPracticeHint", "text": "Kattints az elemre az AI-val való gyakorláshoz"}, {"key": "pron.practiceHint", "text": "Hallgasd, ismételd, vedd fel és hasonlítsd össze — a coach pontosan megmutatja, mely szavak hangzottak tisztán."}, {"key": "pron.drillsCount", "text": "{{count}} gyakorlat"}, {"key": "pron.useInShadowing", "text": "Használd ezt a készséget árnyékolásban"}, {"key": "pron.backToCoach", "text": "Vissza a beszédcoachhoz"}, {"key": "pron.p.title", "text": "Gyakorlás"}, {"key": "pron.p.step1.label", "text": "Hallgasd"}, {"key": "pron.p.step1.hint", "text": "Játszd le a minta hanganyagot kétszer."}, {"key": "pron.p.step2.label", "text": "Értsd meg"}, {"key": "pron.p.step2.hint", "text": "Olvasd el, mit kell tennie a szádnak."}, {"key": "pron.p.step3.label", "text": "Nézd / tanuld"}, {"key": "pron.p.step3.hint", "text": "Nézd meg a száj-, nyelv- és mintaútmutatót."}, {"key": "pron.p.step4.label", "text": "Ismételd"}, {"key": "pron.p.step4.hint", "text": "Mondd ki hangosan a hanganyaggal, először lassan."}, {"key": "pron.p.step5.label", "text": "Vedd fel"}, {"key": "pron.p.step5.hint", "text": "Vedd fel magadat, ahogy ugyanazt a mondatot mondod."}, {"key": "pron.p.step6.label", "text": "AI visszajelzés"}, {"key": "pron.p.step6.hint", "text": "Nézd meg, mit hallott a coach, és mit kell javítani."}, {"key": "pron.p.step7.label", "text": "Próbáld újra"}, {"key": "pron.p.step7.hint", "text": "Javíts egy dolgot, és vedd fel még egyszer."}, {"key": "pron.p.step8.label", "text": "Elsajátítva"}, {"key": "pron.p.step8.hint", "text": "Kétszer egymás után tiszta visszaolvasás — lépj tovább."}, {"key": "pron.p.stepTap", "text": "{{hint}} Koppints, ha ezt megtetted."}, {"key": "pron.p.focusSound", "text": "Fókusz hang {{sound}}"}, {"key": "pron.p.eg", "text": "pl. {{sentence}}"}, {"key": "pron.p.loading", "text": "Betöltés…"}, {"key": "pron.p.speedNormal", "text": "Normál"}, {"key": "pron.p.speedSlower", "text": "Lassabb"}, {"key": "pron.p.speedSlow", "text": "Lassú"}, {"key": "pron.p.loop", "text": "Ismétlés"}, {"key": "pron.p.stop", "text": "Leállítás"}, {"key": "pron.p.voiceNote", "text": "A minta hanganyag a Lingora amerikai angol AI-hangja, nem emberi felvétel."}, {"key": "pron.p.listenSentence", "text": "A Hallgasd kétszer lejátssza a hangot, majd a példaszót, végül egy mondatot, amely tartalmazza."}, {"key": "pron.p.listenExample", "text": "A Hallgasd kétszer lejátssza a hangot, majd a példát."}, {"key": "pron.p.recordHint", "text": "Mondd ki a fenti mondatot egyszer, tisztán."}, {"key": "pron.p.signupToRecord", "text": "Hozz létre ingyenes fiókot a felvételhez és a visszajelzéshez."}, {"key": "pron.p.yourRecording", "text": "A felvételed"}, {"key": "pron.p.listeningRec", "text": "A felvételed hallgatása…"}, {"key": "pron.p.wordsClear", "text": "Tisztán kimondott szavak"}, {"key": "pron.p.wpm", "text": "Beszédtempó (szó/perc)"}, {"key": "pron.p.heard", "text": "A Lingora ezt hallotta"}, {"key": "pron.p.tagClear", "text": "Tiszta"}, {"key": "pron.p.tagNeeds", "text": "Javításra szorul"}, {"key": "pron.p.measured", "text": "Mért előadásmód"}, {"key": "pron.p.paceLabel", "text": "Tempó:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} szó percenként ({{pace}})"}, {"key": "pron.p.paceNote", "text": "A természetes beszélgetés körülbelül 120–160."}, {"key": "pron.p.pace.slow", "text": "lassú"}, {"key": "pron.p.pace.natural", "text": "természetes"}, {"key": "pron.p.pace.fast", "text": "gyors"}, {"key": "pron.p.fillersLabel", "text": "Töltelékszavak:"}, {"key": "pron.p.repeatedLabel", "text": "Ismételt szavak:"}, {"key": "pron.p.noneDetected", "text": "nem található"}, {"key": "pron.p.measuredNote", "text": "A tempót, a töltelékszavakat és az ismétlést a valódi átiratodból és a felvétel hosszából számoljuk. A hangmagasságot, a hangerőt és a csend szünetek hosszát nem mérjük, ezért az intonációt és a szüneteket nem pontozzuk automatikusan."}, {"key": "pron.p.mastered", "text": "Elsajátítva — két tiszta kísérlet"}, {"key": "pron.p.attempt", "text": "{{n}}. kísérlet — két tiszta visszaolvasás egymás után elsajátítottként jelöli meg ezt a mondatot."}, {"key": "pron.p.toShadowing", "text": "Gyakorold valódi beszédben → Árnyékolás"}, {"key": "pron.p.toCoach", "text": "Használd a beszédcoachhal"}]
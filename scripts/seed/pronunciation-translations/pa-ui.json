[{"key": "pron.hero.title", "text": "ਹੋਰ ਸਾਫ਼, ਹੋਰ ਕੁਦਰਤੀ, ਹੋਰ ਰਵਾਨੀ ਨਾਲ ਬੋਲੋ"}, {"key": "pron.hero.description", "text": "ਸਾਰੇ {{count}} ਅੰਗਰੇਜ਼ੀ ਧੁਨੀਆਂ ਦੇ ਨਾਲ-ਨਾਲ ਸ਼ਬਦ ਦਬਾਅ, ਵਾਕ ਦਬਾਅ, ਸੁਰ, ਜੁੜੀ ਬੋਲੀ, ਘਟਾਓ, ਲੈਅ, ਟੁਕੜੇਬੰਦੀ ਅਤੇ ਰਵਾਨੀ — ਹਰ ਪਾਠ ਤੁਹਾਡੀ ਆਪਣੀ ਰਿਕਾਰਡਿੰਗ ਨਾਲ ਖ਼ਤਮ ਹੁੰਦਾ ਹੈ।"}, {"key": "pron.imageAlt", "text": "ਉਚਾਰਨ, ਉਚਾਰ-ਅੰਗ ਅਤੇ IPA"}, {"key": "pron.progress.title", "text": "ਤੁਹਾਡੀ ਉਚਾਰਨ ਤਰੱਕੀ"}, {"key": "pron.progress.descUser", "text": "ਕੋਚ ਵੱਲੋਂ ਤੁਹਾਡੀਆਂ ਰਿਕਾਰਡਿੰਗਾਂ ਵਿੱਚ ਪਛਾਣੇ ਗਏ ਸ਼ਬਦਾਂ ਤੋਂ ਮਾਪੀ ਗਈ।"}, {"key": "pron.progress.descGuest", "text": "ਆਪਣੇ ਆਪ ਨੂੰ ਰਿਕਾਰਡ ਕਰਨ ਅਤੇ ਤਰੱਕੀ ਟਰੈਕ ਕਰਨ ਲਈ ਮੁਫ਼ਤ ਖਾਤਾ ਬਣਾਓ।"}, {"key": "pron.recommended", "text": "ਤੁਹਾਡੇ ਲਈ ਸਿਫ਼ਾਰਸ਼ੀ"}, {"key": "pron.soundLabel", "text": "{{symbol}} ਧੁਨੀ"}, {"key": "pron.skill.sounds", "text": "ਧੁਨੀਆਂ"}, {"key": "pron.skill.sounds.blurb", "text": "ਸਾਰੇ 44 ਅੰਗਰੇਜ਼ੀ ਫ਼ੋਨੀਮ ਨਿਊਨਤਮ ਜੋੜਿਆਂ ਸਮੇਤ।"}, {"key": "pron.skill.wordStress", "text": "ਸ਼ਬਦ ਦਬਾਅ"}, {"key": "pron.skill.wordStress.blurb", "text": "ਅੱਖਰਾਂ ਦੇ ਟੁਕੜੇ, ਮੁੱਖ ਅਤੇ ਗੌਣ ਦਬਾਅ।"}, {"key": "pron.skill.sentenceStress", "text": "ਵਾਕ ਦਬਾਅ"}, {"key": "pron.skill.sentenceStress.blurb", "text": "ਸਾਰਥਕ ਸ਼ਬਦ ਜ਼ੋਰ ਨਾਲ, ਸਹਾਇਕ ਸ਼ਬਦ ਹਲਕੇ।"}, {"key": "pron.skill.intonation", "text": "ਸੁਰ"}, {"key": "pron.skill.intonation.blurb", "text": "ਚੜ੍ਹਦੀ, ਡਿਗਦੀ, ਚੜ੍ਹ-ਡਿਗ ਅਤੇ ਡਿਗ-ਚੜ੍ਹ।"}, {"key": "pron.skill.connectedSpeech", "text": "ਜੁੜੀ ਬੋਲੀ"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "ਜੋੜਨਾ, ਲੋਪ, ਸਮਾਈਕਰਨ, ਕਮਜ਼ੋਰ ਰੂਪ।"}, {"key": "pron.skill.reductions", "text": "ਘਟਾਓ"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — ਗੈਰ-ਰਸਮੀ ਬੋਲਚਾਲ ਦੀ ਅੰਗਰੇਜ਼ੀ।"}, {"key": "pron.skill.rhythm", "text": "ਲੈਅ"}, {"key": "pron.skill.rhythm.blurb", "text": "ਦਬਾਅ-ਅਧਾਰਿਤ ਤਾਲ, ਸਮਾਂ ਅਤੇ ਰੁਕਾਵਟਾਂ।"}, {"key": "pron.skill.chunking", "text": "ਰੁਕਣਾ ਅਤੇ ਟੁਕੜੇਬੰਦੀ"}, {"key": "pron.skill.chunking.blurb", "text": "ਵਿਚਾਰ ਸਮੂਹ ਅਤੇ ਕੁਦਰਤੀ ਸਾਹ ਰੁਕਾਵਟਾਂ।"}, {"key": "pron.skill.fluency", "text": "ਰਵਾਨੀ"}, {"key": "pron.skill.fluency.blurb", "text": "ਰਫ਼ਤਾਰ, ਝਿਜਕ, ਭਰਤੀ ਸ਼ਬਦ ਅਤੇ ਵਿਚਾਰ ਜੋੜਨਾ।"}, {"key": "pron.filter.searchPlaceholder", "text": "ਧੁਨੀ, ਸ਼ਬਦ ਜਾਂ ਪਾਠ ਖੋਜੋ"}, {"key": "pron.filter.allLevels", "text": "ਸਾਰੇ ਪੱਧਰ"}, {"key": "pron.filter.beginner", "text": "ਸ਼ੁਰੂਆਤੀ"}, {"key": "pron.filter.intermediate", "text": "ਦਰਮਿਆਨਾ"}, {"key": "pron.filter.advanced", "text": "ਉੱਨਤ"}, {"key": "pron.filter.allDifficulties", "text": "ਸਾਰੀਆਂ ਮੁਸ਼ਕਲਾਂ"}, {"key": "pron.filter.gentle", "text": "ਹਲਕਾ"}, {"key": "pron.filter.steady", "text": "ਸਥਿਰ"}, {"key": "pron.filter.challenging", "text": "ਚੁਣੌਤੀਪੂਰਨ"}, {"key": "pron.filter.us", "text": "ਅਮਰੀਕੀ ਅੰਗਰੇਜ਼ੀ"}, {"key": "pron.filter.uk", "text": "ਬ੍ਰਿਟਿਸ਼ ਅੰਗਰੇਜ਼ੀ"}, {"key": "pron.sounds.title", "text": "{{count}} ਅੰਗਰੇਜ਼ੀ ਧੁਨੀਆਂ"}, {"key": "pron.sounds.shown", "text": "{{count}} ਦਿਖਾਈਆਂ ਗਈਆਂ"}, {"key": "pron.lessons.title", "text": "{{skill}} ਪਾਠ"}, {"key": "pron.lessons.none", "text": "ਕੋਈ ਪਾਠ ਇਹਨਾਂ ਫ਼ਿਲਟਰਾਂ ਨਾਲ ਮੇਲ ਨਹੀਂ ਖਾਂਦਾ। “ਸਾਰੇ ਪੱਧਰ” ਅਤੇ “ਕੋਈ ਵੀ ਮੁਸ਼ਕਲ” ਅਜ਼ਮਾਓ।"}, {"key": "pron.how", "text": "ਕਿਵੇਂ"}, {"key": "pron.commonMistakes", "text": "ਆਮ ਗਲਤੀਆਂ"}, {"key": "pron.wordPractice", "text": "ਸ਼ਬਦ ਅਭਿਆਸ"}, {"key": "pron.sentencePractice", "text": "ਵਾਕ ਅਭਿਆਸ"}, {"key": "pron.minimalPairs", "text": "ਨਿਊਨਤਮ ਜੋੜੇ"}, {"key": "pron.practise", "text": "ਅਭਿਆਸ ਕਰੋ"}, {"key": "pron.toast.signInModel", "text": "AI ਮਾਡਲ ਦੀ ਆਵਾਜ਼ ਸੁਣਨ ਲਈ ਸਾਈਨ ਇਨ ਕਰੋ।"}, {"key": "pron.toast.playError", "text": "ਆਡੀਓ ਨਹੀਂ ਚੱਲ ਸਕੀ।"}, {"key": "pron.voicedDesc", "text": "ਗੂੰਜਦੀ — ਤੁਹਾਡੀਆਂ ਸੁਰ-ਤੰਦਾਂ ਕੰਬਦੀਆਂ ਹਨ"}, {"key": "pron.voicelessDesc", "text": "ਬਿਨਾਂ ਗੂੰਜ — ਸਿਰਫ਼ ਸਾਹ, ਕੋਈ ਕੰਬਣ ਨਹੀਂ"}, {"key": "pron.soundPracticeHint", "text": "ਸੱਜੇ ਪਾਸੇ ਅਭਿਆਸ ਕਾਰਡ ਵਿੱਚ \"1. ਸੁਣੋ\" 'ਤੇ ਟੈਪ ਕਰੋ ਤਾਂ ਜੋ AI ਮਾਡਲ ਇਹ ਧੁਨੀ ਅਤੇ ਇੱਕ ਉਦਾਹਰਨ ਸੁਣਾ ਸਕੇ।"}, {"key": "pron.paywall.soundLocked", "text": "ਇਸ ਧੁਨੀ ਦਾ ਪੂਰਾ ਪਾਠ — ਇਸਨੂੰ ਕਿਵੇਂ ਬਣਾਉਣਾ ਹੈ, ਮੂੰਹ ਦੀ ਸਥਿਤੀ, ਉਦਾਹਰਨ ਸ਼ਬਦ, ਵਾਕ ਅਤੇ ਨਿਊਨਤਮ ਜੋੜੇ — Lingora English Premium ਦਾ ਹਿੱਸਾ ਹੈ।"}, {"key": "pron.paywall.freeLimit", "text": "ਪਹਿਲੀਆਂ {{count}} ਧੁਨੀਆਂ ਮੁਫ਼ਤ ਹਨ। ਸਾਰੀਆਂ 44 ਧੁਨੀਆਂ ਅਤੇ ਨਿੱਜੀ ਕੋਚ ਫੀਡਬੈਕ ਨੂੰ ਅਨਲੌਕ ਕਰਨ ਲਈ ਅੱਪਗ੍ਰੇਡ ਕਰੋ।"}, {"key": "pron.paywall.unlockAllSounds", "text": "ਸਾਰੀਆਂ 44 ਧੁਨੀਆਂ ਅਨਲੌਕ ਕਰੋ"}, {"key": "pron.wordPracticeHint", "text": "AI ਸੁਣਨ ਅਤੇ ਅਭਿਆਸ ਲਈ ਸ਼ਬਦ 'ਤੇ ਕਲਿੱਕ ਕਰੋ"}, {"key": "pron.eg", "text": "ਜਿਵੇਂ"}, {"key": "pron.playing", "text": "ਚੱਲ ਰਿਹਾ ਹੈ"}, {"key": "pron.listen", "text": "ਸੁਣੋ"}, {"key": "pron.paywall.lessonLocked", "text": "ਇਸ ਪਾਠ ਦੀ ਵਿਆਖਿਆ, ਅਭਿਆਸ ਨੁਕਤੇ ਅਤੇ ਉਦਾਹਰਨਾਂ Lingora English Premium ਦਾ ਹਿੱਸਾ ਹਨ।"}, {"key": "pron.paywall.lessonFreeLimit", "text": "ਹਰ ਹੁਨਰ ਦੇ ਪਹਿਲੇ {{count}} ਪਾਠ ਮੁਫ਼ਤ ਹਨ। ਬਾਕੀ ਖੋਲ੍ਹਣ ਲਈ ਅੱਪਗ੍ਰੇਡ ਕਰੋ।"}, {"key": "pron.paywall.unlockAllLessons", "text": "ਸਾਰੇ ਪਾਠ ਖੋਲ੍ਹੋ"}, {"key": "pron.itemPracticeHint", "text": "AI ਨਾਲ ਅਭਿਆਸ ਲਈ ਆਈਟਮ 'ਤੇ ਕਲਿੱਕ ਕਰੋ"}, {"key": "pron.practiceHint", "text": "ਸੁਣੋ, ਦੁਹਰਾਓ, ਰਿਕਾਰਡ ਕਰੋ ਅਤੇ ਤੁਲਨਾ ਕਰੋ — ਕੋਚ ਦੱਸਦਾ ਹੈ ਕਿ ਕਿਹੜੇ ਸ਼ਬਦ ਸਾਫ਼ ਸੁਣਾਈ ਦਿੱਤੇ।"}, {"key": "pron.drillsCount", "text": "{{count}} ਅਭਿਆਸ"}, {"key": "pron.useInShadowing", "text": "ਇਸ ਹੁਨਰ ਨੂੰ ਸ਼ੈਡੋਇੰਗ ਵਿੱਚ ਵਰਤੋ"}, {"key": "pron.backToCoach", "text": "ਸਪੀਕਿੰਗ ਕੋਚ 'ਤੇ ਵਾਪਸ ਜਾਓ"}, {"key": "pron.p.title", "text": "ਅਭਿਆਸ"}, {"key": "pron.p.step1.label", "text": "ਸੁਣੋ"}, {"key": "pron.p.step1.hint", "text": "ਮਾਡਲ ਆਡੀਓ ਦੋ ਵਾਰ ਚਲਾਓ।"}, {"key": "pron.p.step2.label", "text": "ਸਮਝੋ"}, {"key": "pron.p.step2.hint", "text": "ਪੜ੍ਹੋ ਕਿ ਤੁਹਾਡੇ ਮੂੰਹ ਨੂੰ ਕੀ ਕਰਨਾ ਚਾਹੀਦਾ ਹੈ।"}, {"key": "pron.p.step3.label", "text": "ਵੇਖੋ / ਸਿੱਖੋ"}, {"key": "pron.p.step3.hint", "text": "ਮੂੰਹ, ਜੀਭ ਅਤੇ ਪੈਟਰਨ ਗਾਈਡ ਵੇਖੋ।"}, {"key": "pron.p.step4.label", "text": "ਦੁਹਰਾਓ"}, {"key": "pron.p.step4.hint", "text": "ਆਡੀਓ ਨਾਲ ਉੱਚੀ ਬੋਲੋ, ਪਹਿਲਾਂ ਹੌਲੀ।"}, {"key": "pron.p.step5.label", "text": "ਰਿਕਾਰਡ ਕਰੋ"}, {"key": "pron.p.step5.hint", "text": "ਉਹੀ ਲਾਈਨ ਬੋਲਦੇ ਹੋਏ ਆਪਣੇ ਆਪ ਨੂੰ ਰਿਕਾਰਡ ਕਰੋ।"}, {"key": "pron.p.step6.label", "text": "AI ਫੀਡਬੈਕ"}, {"key": "pron.p.step6.hint", "text": "ਵੇਖੋ ਕੋਚ ਨੇ ਕੀ ਸੁਣਿਆ ਅਤੇ ਕੀ ਸੁਧਾਰਨਾ ਹੈ।"}, {"key": "pron.p.step7.label", "text": "ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ"}, {"key": "pron.p.step7.hint", "text": "ਇੱਕ ਚੀਜ਼ ਸੁਧਾਰੋ ਅਤੇ ਇੱਕ ਵਾਰ ਹੋਰ ਰਿਕਾਰਡ ਕਰੋ।"}, {"key": "pron.p.step8.label", "text": "ਮਾਹਰ"}, {"key": "pron.p.step8.hint", "text": "ਲਗਾਤਾਰ ਦੋ ਵਾਰ ਸਾਫ਼ ਪੜ੍ਹੋ — ਅੱਗੇ ਵਧੋ।"}, {"key": "pron.p.stepTap", "text": "{{hint}} ਇਹ ਕਰਨ ਤੋਂ ਬਾਅਦ ਟੈਪ ਕਰੋ।"}, {"key": "pron.p.focusSound", "text": "ਫੋਕਸ ਧੁਨੀ {{sound}}"}, {"key": "pron.p.eg", "text": "ਜਿਵੇਂ {{sentence}}"}, {"key": "pron.p.loading", "text": "ਲੋਡ ਹੋ ਰਿਹਾ ਹੈ…"}, {"key": "pron.p.speedNormal", "text": "ਆਮ"}, {"key": "pron.p.speedSlower", "text": "ਹੌਲੀ"}, {"key": "pron.p.speedSlow", "text": "ਬਹੁਤ ਹੌਲੀ"}, {"key": "pron.p.loop", "text": "ਲੂਪ"}, {"key": "pron.p.stop", "text": "ਰੋਕੋ"}, {"key": "pron.p.voiceNote", "text": "ਮਾਡਲ ਆਡੀਓ Lingora ਦੀ ਅਮਰੀਕੀ ਅੰਗਰੇਜ਼ੀ AI ਆਵਾਜ਼ ਹੈ, ਮਨੁੱਖੀ ਰਿਕਾਰਡਿੰਗ ਨਹੀਂ।"}, {"key": "pron.p.listenSentence", "text": "ਸੁਣੋ ਧੁਨੀ ਦੋ ਵਾਰ ਚਲਾਉਂਦਾ ਹੈ, ਫਿਰ ਉਦਾਹਰਨ ਸ਼ਬਦ, ਫਿਰ ਇਸ ਵਾਲਾ ਵਾਕ।"}, {"key": "pron.p.listenExample", "text": "ਸੁਣੋ ਧੁਨੀ ਦੋ ਵਾਰ ਚਲਾਉਂਦਾ ਹੈ, ਫਿਰ ਉਦਾਹਰਨ।"}, {"key": "pron.p.recordHint", "text": "ਉੱਪਰ ਵਾਲੀ ਲਾਈਨ ਇੱਕ ਵਾਰ ਸਾਫ਼ ਬੋਲੋ।"}, {"key": "pron.p.signupToRecord", "text": "ਰਿਕਾਰਡ ਕਰਨ ਅਤੇ ਫੀਡਬੈਕ ਲੈਣ ਲਈ ਮੁਫ਼ਤ ਖਾਤਾ ਬਣਾਓ।"}, {"key": "pron.p.yourRecording", "text": "ਤੁਹਾਡੀ ਰਿਕਾਰਡਿੰਗ"}, {"key": "pron.p.listeningRec", "text": "ਤੁਹਾਡੀ ਰਿਕਾਰਡਿੰਗ ਸੁਣੀ ਜਾ ਰਹੀ ਹੈ…"}, {"key": "pron.p.wordsClear", "text": "ਸਾਫ਼ ਬੋਲੇ ਗਏ ਸ਼ਬਦ"}, {"key": "pron.p.wpm", "text": "ਬੋਲਣ ਦੀ ਗਤੀ (wpm)"}, {"key": "pron.p.heard", "text": "Lingora ਨੇ ਸੁਣਿਆ"}, {"key": "pron.p.tagClear", "text": "ਸਾਫ਼"}, {"key": "pron.p.tagNeeds", "text": "ਸੁਧਾਰ ਦੀ ਲੋੜ"}, {"key": "pron.p.measured", "text": "ਮਾਪੀ ਗਈ ਪੇਸ਼ਕਾਰੀ"}, {"key": "pron.p.paceLabel", "text": "ਰਫ਼ਤਾਰ:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} ਸ਼ਬਦ ਪ੍ਰਤੀ ਮਿੰਟ ({{pace}})"}, {"key": "pron.p.paceNote", "text": "ਕੁਦਰਤੀ ਗੱਲਬਾਤ ਲਗਭਗ 120–160 ਹੁੰਦੀ ਹੈ।"}, {"key": "pron.p.pace.slow", "text": "ਹੌਲੀ"}, {"key": "pron.p.pace.natural", "text": "ਕੁਦਰਤੀ"}, {"key": "pron.p.pace.fast", "text": "ਤੇਜ਼"}, {"key": "pron.p.fillersLabel", "text": "ਭਰਤੀ ਸ਼ਬਦ:"}, {"key": "pron.p.repeatedLabel", "text": "ਦੁਹਰਾਏ ਸ਼ਬਦ:"}, {"key": "pron.p.noneDetected", "text": "ਕੋਈ ਨਹੀਂ ਮਿਲਿਆ"}, {"key": "pron.p.measuredNote", "text": "ਰਫ਼ਤਾਰ, ਭਰਤੀ ਸ਼ਬਦ ਅਤੇ ਦੁਹਰਾਅ ਤੁਹਾਡੇ ਅਸਲ ਟ੍ਰਾਂਸਕ੍ਰਿਪਟ ਅਤੇ ਰਿਕਾਰਡਿੰਗ ਲੰਬਾਈ ਤੋਂ ਗਿਣੇ ਜਾਂਦੇ ਹਨ। ਸੁਰ, ਆਵਾਜ਼ ਦੀ ਉੱਚਾਈ ਅਤੇ ਖ਼ਾਮੋਸ਼ ਵਿਰਾਮ ਦੀ ਲੰਬਾਈ ਨਹੀਂ ਮਾਪੀ ਜਾਂਦੀ, ਇਸ ਲਈ ਅਸੀਂ ਸੁਰ ਅਤੇ ਵਿਰਾਮਾਂ ਨੂੰ ਆਪਣੇ ਆਪ ਸਕੋਰ ਨਹੀਂ ਕਰਦੇ।"}, {"key": "pron.p.mastered", "text": "ਮਾਹਰ — ਦੋ ਸਾਫ਼ ਕੋਸ਼ਿਸ਼ਾਂ"}, {"key": "pron.p.attempt", "text": "ਕੋਸ਼ਿਸ਼ {{n}} — ਲਗਾਤਾਰ ਦੋ ਸਾਫ਼ ਪੜ੍ਹਾਈਆਂ ਇਸ ਲਾਈਨ ਨੂੰ ਮਾਹਰ ਬਣਾਉਂਦੀਆਂ ਹਨ।"}, {"key": "pron.p.toShadowing", "text": "ਇਸਨੂੰ ਅਸਲ ਬੋਲਚਾਲ ਵਿੱਚ ਅਭਿਆਸ ਕਰੋ → ਸ਼ੈਡੋਇੰਗ"}, {"key": "pron.p.toCoach", "text": "ਇਸਨੂੰ ਸਪੀਕਿੰਗ ਕੋਚ ਨਾਲ ਵਰਤੋ"}]
[{"key": "pron.hero.title", "text": "ಸ್ಪಷ್ಟವಾಗಿ, ಸಹಜವಾಗಿ, ನಿರರ್ಗಳವಾಗಿ ಮಾತನಾಡಿ"}, {"key": "pron.hero.description", "text": "ಎಲ್ಲಾ {{count}} ಇಂಗ್ಲಿಷ್ ಶಬ್ದಗಳು ಮತ್ತು ಪದ ಒತ್ತು, ವಾಕ್ಯ ಒತ್ತು, ಸ್ವರ ಏರಿಳಿತ, ಸಂಯೋಜಿತ ಮಾತು, ಸಂಕ್ಷೇಪಣೆಗಳು, ಲಯ, ಭಾಗಗಳಾಗಿ ವಿಭಜನೆ ಮತ್ತು ನಿರರ್ಗಳತೆ — ಪ್ರತಿ ಪಾಠವೂ ನಿಮ್ಮದೇ ಧ್ವನಿಮುದ್ರಣದೊಂದಿಗೆ ಕೊನೆಗೊಳ್ಳುತ್ತದೆ."}, {"key": "pron.imageAlt", "text": "ಉಚ್ಚಾರಣೆ ಮತ್ತು IPA"}, {"key": "pron.progress.title", "text": "ನಿಮ್ಮ ಉಚ್ಚಾರಣೆ ಪ್ರಗತಿ"}, {"key": "pron.progress.descUser", "text": "ನಿಮ್ಮದೇ ಧ್ವನಿಮುದ್ರಣಗಳಲ್ಲಿ ತರಬೇತುದಾರರು ಗುರುತಿಸಿದ ಪದಗಳಿಂದ ಅಳೆಯಲಾಗಿದೆ."}, {"key": "pron.progress.descGuest", "text": "ನಿಮ್ಮನ್ನು ಧ್ವನಿಮುದ್ರಿಸಲು ಮತ್ತು ಪ್ರಗತಿ ಟ್ರ್ಯಾಕ್ ಮಾಡಲು ಉಚಿತ ಖಾತೆ ರಚಿಸಿ."}, {"key": "pron.recommended", "text": "ನಿಮಗಾಗಿ ಶಿಫಾರಸು ಮಾಡಲಾಗಿದೆ"}, {"key": "pron.soundLabel", "text": "{{symbol}} ಶಬ್ದ"}, {"key": "pron.skill.sounds", "text": "ಶಬ್ದಗಳು"}, {"key": "pron.skill.sounds.blurb", "text": "ಎಲ್ಲಾ 44 ಇಂಗ್ಲಿಷ್ ಧ್ವನಿಮಗಳು ಮತ್ತು ಕನಿಷ್ಠ ಜೋಡಿಗಳು."}, {"key": "pron.skill.wordStress", "text": "ಪದ ಒತ್ತು"}, {"key": "pron.skill.wordStress.blurb", "text": "ಅಕ್ಷರಗಳು, ಪ್ರಾಥಮಿಕ ಮತ್ತು ದ್ವಿತೀಯ ಒತ್ತು."}, {"key": "pron.skill.sentenceStress", "text": "ವಾಕ್ಯ ಒತ್ತು"}, {"key": "pron.skill.sentenceStress.blurb", "text": "ಅರ್ಥಪೂರ್ಣ ಪದಗಳು ಬಲವಾಗಿ, ಸಹಾಯಕ ಪದಗಳು ದುರ್ಬಲವಾಗಿ."}, {"key": "pron.skill.intonation", "text": "ಸ್ವರ ಏರಿಳಿತ"}, {"key": "pron.skill.intonation.blurb", "text": "ಏರಿಕೆ, ಇಳಿಕೆ, ಏರಿ-ಇಳಿಕೆ ಮತ್ತು ಇಳಿದು-ಏರಿಕೆ."}, {"key": "pron.skill.connectedSpeech", "text": "ಸಂಯೋಜಿತ ಮಾತು"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "ಜೋಡಣೆ, ಲೋಪ, ಸಮೀಕರಣ, ದುರ್ಬಲ ರೂಪಗಳು."}, {"key": "pron.skill.reductions", "text": "ಸಂಕ್ಷೇಪಣೆಗಳು"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — ಅನೌಪಚಾರಿಕ ಮಾತಿನ ಇಂಗ್ಲಿಷ್."}, {"key": "pron.skill.rhythm", "text": "ಲಯ"}, {"key": "pron.skill.rhythm.blurb", "text": "ಒತ್ತು-ಸಮಯದ ಹೊಡೆತಗಳು, ಸಮಯ ಮತ್ತು ವಿರಾಮಗಳು."}, {"key": "pron.skill.chunking", "text": "ವಿರಾಮ ಮತ್ತು ಭಾಗಗಳಾಗಿ ವಿಭಜನೆ"}, {"key": "pron.skill.chunking.blurb", "text": "ಆಲೋಚನಾ ಗುಂಪುಗಳು ಮತ್ತು ಸಹಜ ಉಸಿರಾಟದ ವಿರಾಮಗಳು."}, {"key": "pron.skill.fluency", "text": "ನಿರರ್ಗಳತೆ"}, {"key": "pron.skill.fluency.blurb", "text": "ವೇಗ, ಹಿಂಜರಿಕೆ, ತುಂಬು ಪದಗಳು ಮತ್ತು ಆಲೋಚನೆಗಳ ಜೋಡಣೆ."}, {"key": "pron.filter.searchPlaceholder", "text": "ಶಬ್ದ, ಪದ ಅಥವಾ ಪಾಠ ಹುಡುಕಿ"}, {"key": "pron.filter.allLevels", "text": "ಎಲ್ಲಾ ಹಂತಗಳು"}, {"key": "pron.filter.beginner", "text": "ಆರಂಭಿಕ"}, {"key": "pron.filter.intermediate", "text": "ಮಧ್ಯಮ"}, {"key": "pron.filter.advanced", "text": "ಸುಧಾರಿತ"}, {"key": "pron.filter.allDifficulties", "text": "ಎಲ್ಲಾ ಕಷ್ಟದ ಮಟ್ಟಗಳು"}, {"key": "pron.filter.gentle", "text": "ಸುಲಭ"}, {"key": "pron.filter.steady", "text": "ಸ್ಥಿರ"}, {"key": "pron.filter.challenging", "text": "ಸವಾಲಿನ"}, {"key": "pron.filter.us", "text": "ಅಮೇರಿಕನ್ ಇಂಗ್ಲಿಷ್"}, {"key": "pron.filter.uk", "text": "ಬ್ರಿಟಿಷ್ ಇಂಗ್ಲಿಷ್"}, {"key": "pron.sounds.title", "text": "{{count}} ಇಂಗ್ಲಿಷ್ ಶಬ್ದಗಳು"}, {"key": "pron.sounds.shown", "text": "{{count}} ತೋರಿಸಲಾಗಿದೆ"}, {"key": "pron.lessons.title", "text": "{{skill}} ಪಾಠಗಳು"}, {"key": "pron.lessons.none", "text": "ಈ ಫಿಲ್ಟರ್ಗಳಿಗೆ ಯಾವುದೇ ಪಾಠ ಹೊಂದಿಕೆಯಾಗುತ್ತಿಲ್ಲ. \"ಎಲ್ಲಾ ಹಂತಗಳು\" ಮತ್ತು \"ಎಲ್ಲಾ ಕಷ್ಟದ ಮಟ್ಟಗಳು\" ಪ್ರಯತ್ನಿಸಿ."}, {"key": "pron.how", "text": "ಹೇಗೆ"}, {"key": "pron.commonMistakes", "text": "ಸಾಮಾನ್ಯ ತಪ್ಪುಗಳು"}, {"key": "pron.wordPractice", "text": "ಪದ ಅಭ್ಯಾಸ"}, {"key": "pron.sentencePractice", "text": "ವಾಕ್ಯ ಅಭ್ಯಾಸ"}, {"key": "pron.minimalPairs", "text": "ಕನಿಷ್ಠ ಜೋಡಿಗಳು"}, {"key": "pron.practise", "text": "ಅಭ್ಯಾಸ ಮಾಡಿ"}, {"key": "pron.toast.signInModel", "text": "AI ಮಾದರಿ ಶಬ್ದ ಕೇಳಲು ಸೈನ್ ಇನ್ ಮಾಡಿ."}, {"key": "pron.toast.playError", "text": "ಆಡಿಯೋ ಪ್ಲೇ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."}, {"key": "pron.voicedDesc", "text": "ಘೋಷ — ನಿಮ್ಮ ಧ್ವನಿಪೆಟ್ಟಿಗೆ ಕಂಪಿಸುತ್ತದೆ"}, {"key": "pron.voicelessDesc", "text": "ಅಘೋಷ — ಕೇವಲ ಉಸಿರು, ಕಂಪನವಿಲ್ಲ"}, {"key": "pron.soundPracticeHint", "text": "ಈ ಶಬ್ದದ AI ಮಾದರಿ ಮತ್ತು ಉದಾಹರಣೆ ಕೇಳಲು ಬಲಭಾಗದ ಅಭ್ಯಾಸ ಕಾರ್ಡ್ನಲ್ಲಿ \"1. ಕೇಳಿ\" ಟ್ಯಾಪ್ ಮಾಡಿ."}, {"key": "pron.paywall.soundLocked", "text": "ಈ ಶಬ್ದದ ಪೂರ್ಣ ಪಾಠ — ಅದನ್ನು ಹೇಗೆ ಮಾಡುವುದು, ಬಾಯಿಯ ಸ್ಥಾನ, ಉದಾಹರಣೆ ಪದಗಳು, ವಾಕ್ಯಗಳು ಮತ್ತು ಕನಿಷ್ಠ ಜೋಡಿಗಳು — Lingora English Premium ನ ಭಾಗವಾಗಿದೆ."}, {"key": "pron.paywall.freeLimit", "text": "ಮೊದಲ {{count}} ಶಬ್ದಗಳು ಉಚಿತ. ಎಲ್ಲಾ 44 ಶಬ್ದಗಳು ಮತ್ತು ವೈಯಕ್ತಿಕ ತರಬೇತುದಾರರ ಪ್ರತಿಕ್ರಿಯೆ ಅನ್ಲಾಕ್ ಮಾಡಲು ಅಪ್ಗ್ರೇಡ್ ಮಾಡಿ."}, {"key": "pron.paywall.unlockAllSounds", "text": "ಎಲ್ಲಾ 44 ಶಬ್ದಗಳನ್ನು ಅನ್ಲಾಕ್ ಮಾಡಿ"}, {"key": "pron.wordPracticeHint", "text": "AI ಕೇಳಲು ಮತ್ತು ಅಭ್ಯಾಸ ಮಾಡಲು ಪದ ಕ್ಲಿಕ್ ಮಾಡಿ"}, {"key": "pron.eg", "text": "ಉದಾ."}, {"key": "pron.playing", "text": "ಪ್ಲೇ ಆಗುತ್ತಿದೆ"}, {"key": "pron.listen", "text": "ಕೇಳಿ"}, {"key": "pron.paywall.lessonLocked", "text": "ಈ ಪಾಠದ ವಿವರಣೆ, ಅಭ್ಯಾಸ ಅಂಶಗಳು ಮತ್ತು ಉದಾಹರಣೆಗಳು Lingora English Premium ನ ಭಾಗವಾಗಿದೆ."}, {"key": "pron.paywall.lessonFreeLimit", "text": "ಪ್ರತಿ ಕೌಶಲ್ಯದ ಮೊದಲ {{count}} ಪಾಠಗಳು ಉಚಿತ. ಉಳಿದವನ್ನು ಅನ್ಲಾಕ್ ಮಾಡಲು ಅಪ್ಗ್ರೇಡ್ ಮಾಡಿ."}, {"key": "pron.paywall.unlockAllLessons", "text": "ಎಲ್ಲಾ ಪಾಠಗಳನ್ನು ಅನ್ಲಾಕ್ ಮಾಡಿ"}, {"key": "pron.itemPracticeHint", "text": "AI ಜೊತೆ ಅಭ್ಯಾಸ ಮಾಡಲು ಐಟಂ ಕ್ಲಿಕ್ ಮಾಡಿ"}, {"key": "pron.practiceHint", "text": "ಕೇಳಿ, ಪುನರಾವರ್ತಿಸಿ, ರೆಕಾರ್ಡ್ ಮಾಡಿ ಮತ್ತು ಹೋಲಿಸಿ — ಯಾವ ಪದಗಳು ಸ್ಪಷ್ಟವಾಗಿ ಬಂದವು ಎಂದು ಕೋಚ್ ನಿಖರವಾಗಿ ತೋರಿಸುತ್ತಾರೆ."}, {"key": "pron.drillsCount", "text": "{{count}} ಅಭ್ಯಾಸಗಳು"}, {"key": "pron.useInShadowing", "text": "ಈ ಕೌಶಲ್ಯವನ್ನು ಶ್ಯಾಡೋಯಿಂಗ್ನಲ್ಲಿ ಬಳಸಿ"}, {"key": "pron.backToCoach", "text": "ಸ್ಪೀಕಿಂಗ್ ಕೋಚ್ಗೆ ಹಿಂತಿರುಗಿ"}, {"key": "pron.p.title", "text": "ಅಭ್ಯಾಸ"}, {"key": "pron.p.step1.label", "text": "ಕೇಳಿ"}, {"key": "pron.p.step1.hint", "text": "ಮಾದರಿ ಆಡಿಯೊವನ್ನು ಎರಡು ಬಾರಿ ಪ್ಲೇ ಮಾಡಿ."}, {"key": "pron.p.step2.label", "text": "ಅರ್ಥ ಮಾಡಿಕೊಳ್ಳಿ"}, {"key": "pron.p.step2.hint", "text": "ನಿಮ್ಮ ಬಾಯಿ ಏನು ಮಾಡಬೇಕು ಎಂದು ಓದಿ."}, {"key": "pron.p.step3.label", "text": "ನೋಡಿ / ಕಲಿಯಿರಿ"}, {"key": "pron.p.step3.hint", "text": "ಬಾಯಿ, ನಾಲಿಗೆ ಮತ್ತು ಮಾದರಿ ಮಾರ್ಗದರ್ಶಿಯನ್ನು ಪರಿಶೀಲಿಸಿ."}, {"key": "pron.p.step4.label", "text": "ಪುನರಾವರ್ತಿಸಿ"}, {"key": "pron.p.step4.hint", "text": "ಮೊದಲು ನಿಧಾನವಾಗಿ, ಆಡಿಯೊದೊಂದಿಗೆ ಗಟ್ಟಿಯಾಗಿ ಹೇಳಿ."}, {"key": "pron.p.step5.label", "text": "ರೆಕಾರ್ಡ್ ಮಾಡಿ"}, {"key": "pron.p.step5.hint", "text": "ಅದೇ ಸಾಲನ್ನು ಹೇಳುತ್ತಾ ನಿಮ್ಮನ್ನು ರೆಕಾರ್ಡ್ ಮಾಡಿ."}, {"key": "pron.p.step6.label", "text": "AI ಪ್ರತಿಕ್ರಿಯೆ"}, {"key": "pron.p.step6.hint", "text": "ಕೋಚ್ ಏನು ಕೇಳಿದರು ಮತ್ತು ಏನನ್ನು ಸರಿಪಡಿಸಬೇಕು ಎಂದು ನೋಡಿ."}, {"key": "pron.p.step7.label", "text": "ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ"}, {"key": "pron.p.step7.hint", "text": "ಒಂದನ್ನು ಸರಿಪಡಿಸಿ ಮತ್ತೊಮ್ಮೆ ರೆಕಾರ್ಡ್ ಮಾಡಿ."}, {"key": "pron.p.step8.label", "text": "ಪ್ರಾವೀಣ್ಯ"}, {"key": "pron.p.step8.hint", "text": "ಸತತವಾಗಿ ಎರಡು ಬಾರಿ ಸ್ಪಷ್ಟವಾಗಿ ಓದಿ — ಮುಂದೆ ಸಾಗಿ."}, {"key": "pron.p.stepTap", "text": "{{hint}} ಇದನ್ನು ಮಾಡಿದ ನಂತರ ಒಮ್ಮೆ ಟ್ಯಾಪ್ ಮಾಡಿ."}, {"key": "pron.p.focusSound", "text": "ಕೇಂದ್ರ ಧ್ವನಿ {{sound}}"}, {"key": "pron.p.eg", "text": "ಉದಾ. {{sentence}}"}, {"key": "pron.p.loading", "text": "ಲೋಡ್ ಆಗುತ್ತಿದೆ…"}, {"key": "pron.p.speedNormal", "text": "ಸಾಮಾನ್ಯ"}, {"key": "pron.p.speedSlower", "text": "ನಿಧಾನವಾಗಿ"}, {"key": "pron.p.speedSlow", "text": "ನಿಧಾನ"}, {"key": "pron.p.loop", "text": "ಲೂಪ್"}, {"key": "pron.p.stop", "text": "ನಿಲ್ಲಿಸಿ"}, {"key": "pron.p.voiceNote", "text": "ಮಾದರಿ ಆಡಿಯೊ ಲಿಂಗೋರಾದ ಅಮೆರಿಕನ್ ಇಂಗ್ಲಿಷ್ AI ಧ್ವನಿ, ಮಾನವ ರೆಕಾರ್ಡಿಂಗ್ ಅಲ್ಲ."}, {"key": "pron.p.listenSentence", "text": "ಕೇಳಿ ಎಂಬುದು ಧ್ವನಿಯನ್ನು ಎರಡು ಬಾರಿ, ನಂತರ ಉದಾಹರಣೆ ಪದವನ್ನು, ನಂತರ ಅದನ್ನು ಒಳಗೊಂಡ ವಾಕ್ಯವನ್ನು ಪ್ಲೇ ಮಾಡುತ್ತದೆ."}, {"key": "pron.p.listenExample", "text": "ಕೇಳಿ ಎಂಬುದು ಧ್ವನಿಯನ್ನು ಎರಡು ಬಾರಿ, ನಂತರ ಉದಾಹರಣೆಯನ್ನು ಪ್ಲೇ ಮಾಡುತ್ತದೆ."}, {"key": "pron.p.recordHint", "text": "ಮೇಲಿನ ಸಾಲನ್ನು ಒಮ್ಮೆ ಸ್ಪಷ್ಟವಾಗಿ ಹೇಳಿ."}, {"key": "pron.p.signupToRecord", "text": "ರೆಕಾರ್ಡ್ ಮಾಡಲು ಮತ್ತು ಪ್ರತಿಕ್ರಿಯೆ ಪಡೆಯಲು ಉಚಿತ ಖಾತೆ ರಚಿಸಿ."}, {"key": "pron.p.yourRecording", "text": "ನಿಮ್ಮ ರೆಕಾರ್ಡಿಂಗ್"}, {"key": "pron.p.listeningRec", "text": "ನಿಮ್ಮ ರೆಕಾರ್ಡಿಂಗ್ ಕೇಳುತ್ತಿದ್ದೇವೆ…"}, {"key": "pron.p.wordsClear", "text": "ಸ್ಪಷ್ಟವಾಗಿ ಹೇಳಿದ ಪದಗಳು"}, {"key": "pron.p.wpm", "text": "ಮಾತಿನ ವೇಗ (wpm)"}, {"key": "pron.p.heard", "text": "ಲಿಂಗೋರಾ ಕೇಳಿದ್ದು"}, {"key": "pron.p.tagClear", "text": "ಸ್ಪಷ್ಟ"}, {"key": "pron.p.tagNeeds", "text": "ಸುಧಾರಣೆ ಬೇಕು"}, {"key": "pron.p.measured", "text": "ಅಳೆಯಲಾದ ಪ್ರಸ್ತುತಿ"}, {"key": "pron.p.paceLabel", "text": "ವೇಗ:"}, {"key": "pron.p.paceValue", "text": "ನಿಮಿಷಕ್ಕೆ {{wpm}} ಪದಗಳು ({{pace}})"}, {"key": "pron.p.paceNote", "text": "ಸಹಜ ಸಂಭಾಷಣೆ ಸುಮಾರು 120–160."}, {"key": "pron.p.pace.slow", "text": "ನಿಧಾನ"}, {"key": "pron.p.pace.natural", "text": "ಸಹಜ"}, {"key": "pron.p.pace.fast", "text": "ವೇಗ"}, {"key": "pron.p.fillersLabel", "text": "ಭರ್ತಿ ಪದಗಳು:"}, {"key": "pron.p.repeatedLabel", "text": "ಪುನರಾವರ್ತಿತ ಪದಗಳು:"}, {"key": "pron.p.noneDetected", "text": "ಯಾವುದೂ ಪತ್ತೆಯಾಗಿಲ್ಲ"}, {"key": "pron.p.measuredNote", "text": "ವೇಗ, ಭರ್ತಿ ಪದಗಳು ಮತ್ತು ಪುನರಾವರ್ತನೆಗಳನ್ನು ನಿಮ್ಮ ನಿಜವಾದ ಪ್ರತಿಲೇಖನ ಮತ್ತು ರೆಕಾರ್ಡಿಂಗ್ ಉದ್ದದಿಂದ ಎಣಿಸಲಾಗುತ್ತದೆ. ಶ್ರುತಿ, ಧ್ವನಿ ತೀವ್ರತೆ ಮತ್ತು ಮೌನ ವಿರಾಮದ ಉದ್ದವನ್ನು ಅಳೆಯುವುದಿಲ್ಲ, ಆದ್ದರಿಂದ ನಾವು ಸ್ವರಮಾಧುರ್ಯ ಅಥವಾ ವಿರಾಮಗಳನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸ್ಕೋರ್ ಮಾಡುವುದಿಲ್ಲ."}, {"key": "pron.p.mastered", "text": "ಪ್ರಾವೀಣ್ಯ — ಎರಡು ಸ್ಪಷ್ಟ ಪ್ರಯತ್ನಗಳು"}, {"key": "pron.p.attempt", "text": "ಪ್ರಯತ್ನ {{n}} — ಸತತವಾಗಿ ಎರಡು ಸ್ಪಷ್ಟ ಓದುವಿಕೆಗಳು ಈ ಸಾಲನ್ನು ಪ್ರಾವೀಣ್ಯ ಎಂದು ಗುರುತಿಸುತ್ತದೆ."}, {"key": "pron.p.toShadowing", "text": "ಇದನ್ನು ನಿಜವಾದ ಮಾತಿನಲ್ಲಿ ಅಭ್ಯಾಸ ಮಾಡಿ → ಶ್ಯಾಡೋಯಿಂಗ್"}, {"key": "pron.p.toCoach", "text": "ಸ್ಪೀಕಿಂಗ್ ಕೋಚ್ನೊಂದಿಗೆ ಇದನ್ನು ಬಳಸಿ"}]
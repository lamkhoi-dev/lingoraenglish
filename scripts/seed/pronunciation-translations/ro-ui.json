[{"key": "pron.hero.title", "text": "Sună mai clar, mai natural, mai fluent"}, {"key": "pron.hero.description", "text": "Toate cele {{count}} sunete englezești plus accentul de cuvânt, accentul de propoziție, intonația, vorbirea conectată, reducerile, ritmul, segmentarea și fluența — fiecare lecție se încheie cu propria ta înregistrare."}, {"key": "pron.imageAlt", "text": "Pronunție: articulare și AFI"}, {"key": "pron.progress.title", "text": "Progresul tău la pronunție"}, {"key": "pron.progress.descUser", "text": "Măsurat pe baza cuvintelor recunoscute de coach în propriile tale înregistrări."}, {"key": "pron.progress.descGuest", "text": "Creează un cont gratuit pentru a te înregistra și a începe să-ți urmărești progresul."}, {"key": "pron.recommended", "text": "Recomandat pentru tine"}, {"key": "pron.soundLabel", "text": "Sunetul {{symbol}}"}, {"key": "pron.skill.sounds", "text": "Sunete"}, {"key": "pron.skill.sounds.blurb", "text": "Toate cele 44 de foneme englezești cu perechi minimale."}, {"key": "pron.skill.wordStress", "text": "Accentul de cuvânt"}, {"key": "pron.skill.wordStress.blurb", "text": "Silabe, accent principal și secundar."}, {"key": "pron.skill.sentenceStress", "text": "Accentul de propoziție"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Cuvintele de conținut accentuate, cuvintele funcționale slăbite."}, {"key": "pron.skill.intonation", "text": "Intonație"}, {"key": "pron.skill.intonation.blurb", "text": "Ascendentă, descendentă, ascendent-descendentă și descendent-ascendentă."}, {"key": "pron.skill.connectedSpeech", "text": "Vorbire conectată"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Legare, eliziune, asimilare, forme slabe."}, {"key": "pron.skill.reductions", "text": "Reduceri"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — engleza vorbită informală."}, {"key": "pron.skill.rhythm", "text": "Ritm"}, {"key": "pron.skill.rhythm.blurb", "text": "Bătăi bazate pe accent, timing și pauze."}, {"key": "pron.skill.chunking", "text": "Pauze și segmentare"}, {"key": "pron.skill.chunking.blurb", "text": "Grupuri de idei și pauze naturale de respirație."}, {"key": "pron.skill.fluency", "text": "Fluență"}, {"key": "pron.skill.fluency.blurb", "text": "Viteză, ezitare, cuvinte de umplutură și legarea ideilor."}, {"key": "pron.filter.searchPlaceholder", "text": "Caută un sunet, un cuvânt sau o lecție"}, {"key": "pron.filter.allLevels", "text": "Toate nivelurile"}, {"key": "pron.filter.beginner", "text": "Începător"}, {"key": "pron.filter.intermediate", "text": "Intermediar"}, {"key": "pron.filter.advanced", "text": "Avansat"}, {"key": "pron.filter.allDifficulties", "text": "Toate dificultățile"}, {"key": "pron.filter.gentle", "text": "Ușor"}, {"key": "pron.filter.steady", "text": "Moderat"}, {"key": "pron.filter.challenging", "text": "Provocator"}, {"key": "pron.filter.us", "text": "Engleza americană"}, {"key": "pron.filter.uk", "text": "Engleza britanică"}, {"key": "pron.sounds.title", "text": "Cele {{count}} sunete englezești"}, {"key": "pron.sounds.shown", "text": "{{count}} afișate"}, {"key": "pron.lessons.title", "text": "Lecții de {{skill}}"}, {"key": "pron.lessons.none", "text": "Nicio lecție nu corespunde acestor filtre. Încearcă „Toate nivelurile” și „Toate dificultățile”."}, {"key": "pron.how", "text": "Cum"}, {"key": "pron.commonMistakes", "text": "Greșeli frecvente"}, {"key": "pron.wordPractice", "text": "Exersare cuvinte"}, {"key": "pron.sentencePractice", "text": "Exersare propoziții"}, {"key": "pron.minimalPairs", "text": "Perechi minimale"}, {"key": "pron.practise", "text": "Exersează"}, {"key": "pron.toast.signInModel", "text": "Autentifică-te pentru a auzi modelul AI."}, {"key": "pron.toast.playError", "text": "Nu s-a putut reda audio."}, {"key": "pron.voicedDesc", "text": "Sonor — corzile vocale vibrează"}, {"key": "pron.voicelessDesc", "text": "Surd — doar aer, fără vibrație"}, {"key": "pron.soundPracticeHint", "text": "Apasă „1. Ascultă” în cardul de exersare din dreapta pentru a auzi modelul AI al acestui sunet și un exemplu."}, {"key": "pron.paywall.soundLocked", "text": "Lecția completă pentru acest sunet — cum se pronunță, poziția gurii, cuvinte exemplu, propoziții și perechi minimale — face parte din Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "Primele {{count}} sunete sunt gratuite. Fă upgrade pentru a debloca toate cele 44 de sunete și feedback personalizat de la coach."}, {"key": "pron.paywall.unlockAllSounds", "text": "Deblochează toate cele 44 de sunete"}, {"key": "pron.wordPracticeHint", "text": "Click pe cuvânt pentru a auzi AI și a exersa"}, {"key": "pron.eg", "text": "ex."}, {"key": "pron.playing", "text": "Se redă"}, {"key": "pron.listen", "text": "Ascultă"}, {"key": "pron.paywall.lessonLocked", "text": "Explicația, punctele de exersare și exemplele acestei lecții fac parte din Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "Primele {{count}} lecții ale fiecărei abilități sunt gratuite. Fă upgrade pentru a le debloca pe restul."}, {"key": "pron.paywall.unlockAllLessons", "text": "Deblochează toate lecțiile"}, {"key": "pron.itemPracticeHint", "text": "Click pe element pentru a exersa cu AI"}, {"key": "pron.practiceHint", "text": "Ascultă, repetă, înregistrează și compară — coach-ul îți arată exact ce cuvinte au fost clare."}, {"key": "pron.drillsCount", "text": "{{count}} exerciții"}, {"key": "pron.useInShadowing", "text": "Folosește această abilitate în Shadowing"}, {"key": "pron.backToCoach", "text": "Înapoi la Coach-ul de Vorbire"}, {"key": "pron.p.title", "text": "Exersare"}, {"key": "pron.p.step1.label", "text": "Ascultă"}, {"key": "pron.p.step1.hint", "text": "Redă audio-ul model de două ori."}, {"key": "pron.p.step2.label", "text": "Înțelege"}, {"key": "pron.p.step2.hint", "text": "Citește ce ar trebui să facă gura ta."}, {"key": "pron.p.step3.label", "text": "Urmărește / învață"}, {"key": "pron.p.step3.hint", "text": "Verifică ghidul pentru 
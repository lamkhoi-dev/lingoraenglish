[{"key": "pron.hero.title", "text": "آواز زیادہ واضح، زیادہ فطری، زیادہ روانی کے ساتھ"}, {"key": "pron.hero.description", "text": "تمام {{count}} انگریزی آوازیں اور ساتھ ہی لفظی دباؤ، جملے کا دباؤ، لہجہ، جڑی ہوئی تقریر، تخفیف، تال، ٹکڑے اور روانی — ہر سبق آپ کی اپنی ریکارڈنگ کے ساتھ ختم ہوتا ہے۔"}, {"key": "pron.imageAlt", "text": "تلفظ، ادائیگی اور IPA"}, {"key": "pron.progress.title", "text": "آپ کی تلفظ کی پیش رفت"}, {"key": "pron.progress.descUser", "text": "کوچ نے آپ کی اپنی ریکارڈنگز میں جو الفاظ پہچانے، اُن سے ماپا گیا۔"}, {"key": "pron.progress.descGuest", "text": "اپنی ریکارڈنگ کرنے اور پیش رفت ٹریک کرنے کے لیے مفت اکاؤنٹ بنائیں۔"}, {"key": "pron.recommended", "text": "آپ کے لیے تجویز کردہ"}, {"key": "pron.soundLabel", "text": "{{symbol}} آواز"}, {"key": "pron.skill.sounds", "text": "آوازیں"}, {"key": "pron.skill.sounds.blurb", "text": "تمام 44 انگریزی صوتیے کم سے کم جوڑوں کے ساتھ۔"}, {"key": "pron.skill.wordStress", "text": "لفظی دباؤ"}, {"key": "pron.skill.wordStress.blurb", "text": "رکن، بنیادی اور ثانوی دباؤ۔"}, {"key": "pron.skill.sentenceStress", "text": "جملے کا دباؤ"}, {"key": "pron.skill.sentenceStress.blurb", "text": "مواد والے الفاظ مضبوط، فعل والے الفاظ کمزور۔"}, {"key": "pron.skill.intonation", "text": "لہجہ"}, {"key": "pron.skill.intonation.blurb", "text": "اُٹھتا، گرتا، اُٹھتا-گرتا اور گرتا-اُٹھتا۔"}, {"key": "pron.skill.connectedSpeech", "text": "جڑی ہوئی تقریر"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "جوڑنا، حذف، انضمام، کمزور شکلیں۔"}, {"key": "pron.skill.reductions", "text": "تخفیف"}, {"key": "pron.skill.reductions.blurb", "text": "gonna، wanna، hafta — غیر رسمی بولی جانے والی انگریزی۔"}, {"key": "pron.skill.rhythm", "text": "تال"}, {"key": "pron.skill.rhythm.blurb", "text": "دباؤ کے وقت کی تھاپ، وقت اور وقفے۔"}, {"key": "pron.skill.chunking", "text": "وقفہ اور ٹکڑے کرنا"}, {"key": "pron.skill.chunking.blurb", "text": "خیالات کے گروہ اور فطری سانس کے وقفے۔"}, {"key": "pron.skill.fluency", "text": "روانی"}, {"key": "pron.skill.fluency.blurb", "text": "رفتار، ہچکچاہٹ، بھرنے والے الفاظ اور خیالات جوڑنا۔"}, {"key": "pron.filter.searchPlaceholder", "text": "آواز، لفظ یا سبق تلاش کریں"}, {"key": "pron.filter.allLevels", "text": "تمام سطحیں"}, {"key": "pron.filter.beginner", "text": "ابتدائی"}, {"key": "pron.filter.intermediate", "text": "درمیانی"}, {"key": "pron.filter.advanced", "text": "اعلیٰ"}, {"key": "pron.filter.allDifficulties", "text": "تمام مشکلات"}, {"key": "pron.filter.gentle", "text": "آسان"}, {"key": "pron.filter.steady", "text": "معتدل"}, {"key": "pron.filter.challenging", "text": "چیلنجنگ"}, {"key": "pron.filter.us", "text": "امریکی انگریزی"}, {"key": "pron.filter.uk", "text": "برطانوی انگریزی"}, {"key": "pron.sounds.title", "text": "{{count}} انگریزی آوازیں"}, {"key": "pron.sounds.shown", "text": "{{count}} دکھائی گئیں"}, {"key": "pron.lessons.title", "text": "{{skill}} اسباق"}, {"key": "pron.lessons.none", "text": "کوئی سبق اِن فلٹرز سے مطابقت نہیں رکھتا۔ \"تمام سطحیں\" اور \"کوئی بھی مشکل\" آزمائیں۔"}, {"key": "pron.how", "text": "کیسے"}, {"key": "pron.commonMistakes", "text": "عام غلطیاں"}, {"key": "pron.wordPractice", "text": "لفظ کی مشق"}, {"key": "pron.sentencePractice", "text": "جملے کی مشق"}, {"key": "pron.minimalPairs", "text": "کم سے کم جوڑے"}, {"key": "pron.practise", "text": "مشق کریں"}, {"key": "pron.toast.signInModel", "text": "AI ماڈل کی آواز سننے کے لیے سائن ان کریں۔"}, {"key": "pron.toast.playError", "text": "آڈیو چلائی نہیں جا سکی۔"}, {"key": "pron.voicedDesc", "text": "بھاری — آپ کے صوتی تاروں میں کمپن ہوتی ہے"}, {"key": "pron.voicelessDesc", "text": "ہلکی — صرف سانس، کوئی کمپن نہیں"}, {"key": "pron.soundPracticeHint", "text": "دائیں طرف پریکٹس کارڈ میں \"1. سنیں\" پر ٹیپ کریں تاکہ AI ماڈل کی اِس آواز اور ایک مثال کی آواز سن سکیں۔"}, {"key": "pron.paywall.soundLocked", "text": "اِس آواز کا مکمل سبق — اِسے کیسے بنائیں، منہ کی پوزیشن، مثالی الفاظ، جملے اور کم سے کم جوڑے — Lingora English Premium کا حصہ ہے۔"}, {"key": "pron.paywall.freeLimit", "text": "پہلی {{count}} آوازیں مفت ہیں۔ تمام 44 آوازیں اور ذاتی کوچ فیڈبیک کھولنے کے لیے اپ گریڈ کریں۔"}, {"key": "pron.paywall.unlockAllSounds", "text": "تمام 44 آوازیں کھولیں"}, {"key": "pron.wordPracticeHint", "text": "AI سننے اور مشق کرنے کے لیے لفظ پر کلک کریں"}, {"key": "pron.eg", "text": "مثلاً"}, {"key": "pron.playing", "text": "چل رہا ہے"}, {"key": "pron.listen", "text": "سنیں"}, {"key": "pron.paywall.lessonLocked", "text": "اِس سبق کی وضاحت، مشق کے نکات اور مثالیں Lingora English Premium کا حصہ ہیں۔"}, {"key": "pron.paywall.lessonFreeLimit", "text": "ہر ہنر کے پہلے {{count}} اسباق مفت ہیں۔ باقی کھولنے کے لیے اپ گریڈ کریں۔"}, {"key": "pron.paywall.unlockAllLessons", "text": "تمام اسباق کھولیں"}, {"key": "pron.itemPracticeHint", "text": "AI کے ساتھ مشق کرنے کے لیے آئٹم پر کلک کریں"}, {"key": "pron.practiceHint", "text": "سنیں، دہرائیں، ریکارڈ کریں اور موازنہ کریں — کوچ بتاتا ہے کہ کون سے الفاظ واضح طور پر ادا ہوئے۔"}, {"key": "pron.drillsCount", "text": "{{count}} مشقیں"}, {"key": "pron.useInShadowing", "text": "یہ ہنر شیڈوئنگ میں استعمال کریں"}, {"key": "pron.backToCoach", "text": "اسپیکنگ کوچ پر واپس جائیں"}, {"key": "pron.p.title", "text": "مشق"}, {"key": "pron.p.step1.label", "text": "سنیں"}, {"key": "pron.p.step1.hint", "text": "ماڈل آڈیو دو بار چلائیں۔"}, {"key": "pron.p.step2.label", "text": "سمجھیں"}, {"key": "pron.p.step2.hint", "text": "پڑھیں کہ آپ کے منہ کو کیا کرنا چاہیے۔"}, {"key": "pron.p.step3.label", "text": "دیکھیں / سیکھیں"}, {"key": "pron.p.step3.hint", "text": "منہ، زبان اور پیٹرن گائیڈ دیکھیں۔"}, {"key": "pron.p.step4.label", "text": "دہرائیں"}, {"key": "pron.p.step4.hint", "text": "آڈیو کے ساتھ بلند آواز میں کہیں، پہلے آہستہ۔"}, {"key": "pron.p.step5.label", "text": "ریکارڈ کریں"}, {"key": "pron.p.step5.hint", "text": "وہی جملہ کہتے ہوئے خود کو ریکارڈ کریں۔"}, {"key": "pron.p.step6.label", "text": "AI فیڈبیک"}, {"key": "pron.p.step6.hint", "text": "دیکھیں کوچ نے کیا سنا اور کیا ٹھیک کرنا ہے۔"}, {"key": "pron.p.step7.label", "text": "دوبارہ کوشش کریں"}, {"key": "pron.p.step7.hint", "text": "ایک چیز ٹھیک کریں اور ایک بار پھر ریکارڈ کریں۔"}, {"key": "pron.p.step8.label", "text": "ماہر"}, {"key": "pron.p.step8.hint", "text": "مسلسل دو بار واضح پڑھائی — آگے بڑھیں۔"}, {"key": "pron.p.stepTap", "text": "{{hint}} یہ کرنے کے بعد ایک بار ٹیپ کریں۔"}, {"key": "pron.p.focusSound", "text": "فوکس آواز {{sound}}"}, {"key": "pron.p.eg", "text": "مثلاً {{sentence}}"}, {"key": "pron.p.loading", "text": "لوڈ ہو رہا ہے…"}, {"key": "pron.p.speedNormal", "text": "نارمل"}, {"key": "pron.p.speedSlower", "text": "سست تر"}, {"key": "pron.p.speedSlow", "text": "آہستہ"}, {"key": "pron.p.loop", "text": "لوپ"}, {"key": "pron.p.stop", "text": "رکیں"}, {"key": "pron.p.voiceNote", "text": "ماڈل آڈیو Lingora کی امریکی انگریزی AI آواز ہے، انسانی ریکارڈنگ نہیں۔"}, {"key": "pron.p.listenSentence", "text": "سنیں آواز دو بار چلاتا ہے، پھر مثال کا لفظ، پھر اس پر مشتمل جملہ۔"}, {"key": "pron.p.listenExample", "text": "سنیں آواز دو بار چلاتا ہے، پھر مثال۔"}, {"key": "pron.p.recordHint", "text": "اوپر دیا جملہ ایک بار واضح طور پر کہیں۔"}, {"key": "pron.p.signupToRecord", "text": "ریکارڈ کرنے اور فیڈبیک حاصل کرنے کے لیے مفت اکاؤنٹ بنائیں۔"}, {"key": "pron.p.yourRecording", "text": "آپ کی ریکارڈنگ"}, {"key": "pron.p.listeningRec", "text": "آپ کی ریکارڈنگ سنی جا رہی ہے…"}, {"key": "pron.p.wordsClear", "text": "واضح کہے گئے الفاظ"}, {"key": "pron.p.wpm", "text": "بولنے کی رفتار (wpm)"}, {"key": "pron.p.heard", "text": "Lingora نے سنا"}, {"key": "pron.p.tagClear", "text": "واضح"}, {"key": "pron.p.tagNeeds", "text": "بہتری درکار"}, {"key": "pron.p.measured", "text": "پیمائش شدہ ادائیگی"}, {"key": "pron.p.paceLabel", "text": "رفتار:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} الفاظ فی منٹ ({{pace}})"}, {"key": "pron.p.paceNote", "text": "قدرتی گفتگو تقریباً 120–160 ہوتی ہے۔"}, {"key": "pron.p.pace.slow", "text": "آہستہ"}, {"key": "pron.p.pace.natural", "text": "قدرتی"}, {"key": "pron.p.pace.fast", "text": "تیز"}, {"key": "pron.p.fillersLabel", "text": "بھرنے والے الفاظ:"}, {"key": "pron.p.repeatedLabel", "text": "دہرائے گئے الفاظ:"}, {"key": "pron.p.noneDetected", "text": "کوئی نہیں ملا"}, {"key": "pron.p.measuredNote", "text": "رفتار، بھرنے والے الفاظ اور تکرار آپ کی اصل تحریر اور ریکارڈنگ کی لمبائی سے شمار کیے جاتے ہیں۔ آواز کی اونچائی، بلندی اور خاموش وقفوں کی لمبائی نہیں ناپی جاتی، اس لیے ہم لہجے یا وقفوں کو خودکار طور پر اسکور نہیں کرتے۔"}, {"key": "pron.p.mastered", "text": "ماہر — دو واضح کوششیں"}, {"key": "pron.p.attempt", "text": "کوشش {{n}} — مسلسل دو واضح پڑھائیاں اس جملے کو ماہر قرار دیتی ہیں۔"}, {"key": "pron.p.toShadowing", "text": "اسے حقیقی گفتگو میں مشق کریں → شیڈوئنگ"}, {"key": "pron.p.toCoach", "text": "اسے اسپیکنگ کوچ کے ساتھ استعمال کریں"}]
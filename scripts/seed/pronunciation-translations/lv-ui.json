[{"key": "pron.hero.title", "text": "Skaidrāka, dabiskāka, plūstošāka runa"}, {"key": "pron.hero.description", "text": "Visi {{count}} angļu valodas skaņas plus vārdu uzsvars, teikuma uzsvars, intonācija, saistītā runa, redukcijas, ritms, sadalīšana un plūdums — katra nodarbība beidzas ar tavu paša ierakstu."}, {"key": "pron.imageAlt", "text": "Izruna: artikulācija un IPA"}, {"key": "pron.progress.title", "text": "Tavs izrunas progress"}, {"key": "pron.progress.descUser", "text": "Mērīts pēc vārdiem, ko treneris atpazina tavos ierakstos."}, {"key": "pron.progress.descGuest", "text": "Izveido bezmaksas kontu, lai ierakstītu sevi un sāktu sekot progresam."}, {"key": "pron.recommended", "text": "Ieteikts tev"}, {"key": "pron.soundLabel", "text": "{{symbol}} skaņa"}, {"key": "pron.skill.sounds", "text": "Skaņas"}, {"key": "pron.skill.sounds.blurb", "text": "Visas 44 angļu valodas fonēmas ar minimālajiem pāriem."}, {"key": "pron.skill.wordStress", "text": "Vārdu uzsvars"}, {"key": "pron.skill.wordStress.blurb", "text": "Zilbes, galvenais un blakusuzsvars."}, {"key": "pron.skill.sentenceStress", "text": "Teikuma uzsvars"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Satura vārdi spēcīgi, palīgvārdi vāji."}, {"key": "pron.skill.intonation", "text": "Intonācija"}, {"key": "pron.skill.intonation.blurb", "text": "Kāpjoša, krītoša, kāpjoši-krītoša un krītoši-kāpjoša."}, {"key": "pron.skill.connectedSpeech", "text": "Saistītā runa"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Saistīšana, elīzija, asimilācija, vājās formas."}, {"key": "pron.skill.reductions", "text": "Redukcijas"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — neformālā sarunvalodas angļu valoda."}, {"key": "pron.skill.rhythm", "text": "Ritms"}, {"key": "pron.skill.rhythm.blurb", "text": "Uzsvara taktis, laiks un pauzes."}, {"key": "pron.skill.chunking", "text": "Pauzes un sadalīšana"}, {"key": "pron.skill.chunking.blurb", "text": "Domu grupas un dabiskas elpas pauzes."}, {"key": "pron.skill.fluency", "text": "Plūdums"}, {"key": "pron.skill.fluency.blurb", "text": "Ātrums, vilcināšanās, aizpildītāji un ideju saistīšana."}, {"key": "pron.filter.searchPlaceholder", "text": "Meklē skaņu, vārdu vai nodarbību"}, {"key": "pron.filter.allLevels", "text": "Visi līmeņi"}, {"key": "pron.filter.beginner", "text": "Iesācējs"}, {"key": "pron.filter.intermediate", "text": "Vidējs"}, {"key": "pron.filter.advanced", "text": "Augsts"}, {"key": "pron.filter.allDifficulties", "text": "Visas grūtības"}, {"key": "pron.filter.gentle", "text": "Viegla"}, {"key": "pron.filter.steady", "text": "Vidēja"}, {"key": "pron.filter.challenging", "text": "Izaicinoša"}, {"key": "pron.filter.us", "text": "ASV angļu valoda"}, {"key": "pron.filter.uk", "text": "Lielbritānijas angļu valoda"}, {"key": "pron.sounds.title", "text": "{{count}} angļu valodas skaņas"}, {"key": "pron.sounds.shown", "text": "Parādītas {{count}}"}, {"key": "pron.lessons.title", "text": "{{skill}} nodarbības"}, {"key": "pron.lessons.none", "text": "Neviena nodarbība neatbilst šiem filtriem. Pamēģini “Visi līmeņi” un “Jebkura grūtība”."}, {"key": "pron.how", "text": "Kā"}, {"key": "pron.commonMistakes", "text": "Biežākās kļūdas"}, {"key": "pron.wordPractice", "text": "Vārdu vingrināšana"}, {"key": "pron.sentencePractice", "text": "Teikumu vingrināšana"}, {"key": "pron.minimalPairs", "text": "Minimālie pāri"}, {"key": "pron.practise", "text": "Vingrināties"}, {"key": "pron.toast.signInModel", "text": "Piesakies, lai dzirdētu AI modeļa skaņu."}, {"key": "pron.toast.playError", "text": "Nevarēja atskaņot audio."}, {"key": "pron.voicedDesc", "text": "Balsīga — balss saites vibrē"}, {"key": "pron.voicelessDesc", "text": "Nebalsīga — tikai elpa, bez vibrācijas"}, {"key": "pron.soundPracticeHint", "text": "Pieskaries \"1. Klausies\" vingrināšanās kartītē labajā pusē, lai dzirdētu AI modeļa šo skaņu un piemēru."}, {"key": "pron.paywall.soundLocked", "text": "Šīs skaņas pilnā nodarbība — kā to veidot, mutes pozīcija, piemēru vārdi, teikumi un minimālie pāri — ir daļa no Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "Pirmās {{count}} skaņas ir bezmaksas. Jaunini, lai atslēgtu visas 44 skaņas un personalizētu trenera atgriezenisko saiti."}, {"key": "pron.paywall.unlockAllSounds", "text": "Atslēgt visas 44 skaņas"}, {"key": "pron.wordPracticeHint", "text": "Noklikšķini uz vārda, lai dzirdētu AI un vingrinātos"}, {"key": "pron.eg", "text": "piem."}, {"key": "pron.playing", "text": "Atskaņo"}, {"key": "pron.listen", "text": "Klausies"}, {"key": "pron.paywall.lessonLocked", "text": "Šīs nodarbības skaidrojums, vingrināšanās punkti un piemēri ir daļa no Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "Pirmās {{count}} nodarbības katrā prasmē ir bez maksas. Jaunini, lai atslēgtu pārējās."}, {"key": "pron.paywall.unlockAllLessons", "text": "Atslēgt visas nodarbības"}, {"key": "pron.itemPracticeHint", "text": "Noklikšķini uz vienuma, lai trenētos ar AI"}, {"key": "pron.practiceHint", "text": "Klausies, atkārto, ieraksti un salīdzini — treneris parāda tieši tos vārdus, kas izskanēja skaidri."}, {"key": "pron.drillsCount", "text": "{{count}} vingrinājumi"}, {"key": "pron.useInShadowing", "text": "Izmanto šo prasmi Ēnuošanā"}, {"key": "pron.backToCoach", "text": "Atpakaļ pie Runas trenera"}, {"key": "pron.p.title", "text": "Treniņš"}, {"key": "pron.p.step1.label", "text": "Klausies"}, {"key": "pron.p.step1.hint", "text": "Atskaņo parauga audio divas reizes."}, {"key": "pron.p.step2.label", "text": "Saproti"}, {"key": "pron.p.step2.hint", "text": "Izlasi, kas jādara tavai mutei."}, {"key": "pron.p.step3.label", "text": "Vēro / mācies"}, {"key": "pron.p.step3.hint", "text": "Pārbaudi mutes, mēles un modeļa ceļvedi."}, {"key": "pron.p.step4.label", "text": "Atkārto"}, {"key": "pron.p.step4.hint", "text": "Saki to skaļi līdzi audio, sākumā lēni."}, {"key": "pron.p.step5.label", "text": "Ieraksti"}, {"key": "pron.p.step5.hint", "text": "Ieraksti sevi sakām to pašu frāzi."}, {"key": "pron.p.step6.label", "text": "AI atgriezeniskā saite"}, {"key": "pron.p.step6.hint", "text": "Uzzini, ko treneris sadzirdēja un ko labot."}, {"key": "pron.p.step7.label", "text": "Mēģini vēlreiz"}, {"key": "pron.p.step7.hint", "text": "Izlabo vienu lietu un ieraksti vēlreiz."}, {"key": "pron.p.step8.label", "text": "Apgūts"}, {"key": "pron.p.step8.hint", "text": "Skaidri nolasīts divas reizes pēc kārtas — ej tālāk."}, {"key": "pron.p.stepTap", "text": "{{hint}} Pieskaries, kad tas izdarīts."}, {"key": "pron.p.focusSound", "text": "Fokusa skaņa {{sound}}"}, {"key": "pron.p.eg", "text": "piem. {{sentence}}"}, {"key": "pron.p.loading", "text": "Ielādē…"}, {"key": "pron.p.speedNormal", "text": "Normāls"}, {"key": "pron.p.speedSlower", "text": "Lēnāk"}, {"key": "pron.p.speedSlow", "text": "Lēni"}, {"key": "pron.p.loop", "text": "Atkārtot"}, {"key": "pron.p.stop", "text": "Apturēt"}, {"key": "pron.p.voiceNote", "text": "Parauga audio ir Lingora amerikāņu angļu AI balss, nevis cilvēka ieraksts."}, {"key": "pron.p.listenSentence", "text": "Klausies atskaņo skaņu divas reizes, tad parauga vārdu, tad teikumu ar to."}, {"key": "pron.p.listenExample", "text": "Klausies atskaņo skaņu divas reizes, tad piemēru."}, {"key": "pron.p.recordHint", "text": "Saki iepriekšējo frāzi vienu reizi, skaidri."}, {"key": "pron.p.signupToRecord", "text": "Izveido bezmaksas kontu, lai ierakstītu un saņemtu atgriezenisko saiti."}, {"key": "pron.p.yourRecording", "text": "Tavs ieraksts"}, {"key": "pron.p.listeningRec", "text": "Klausāmies tavu ierakstu…"}, {"key": "pron.p.wordsClear", "text": "Skaidri pateikti vārdi"}, {"key": "pron.p.wpm", "text": "Runas ātrums (vārdi/min)"}, {"key": "pron.p.heard", "text": "Lingora sadzirdēja"}, {"key": "pron.p.tagClear", "text": "Skaidri"}, {"key": "pron.p.tagNeeds", "text": "Jāuzlabo"}, {"key": "pron.p.measured", "text": "Mērītā runa"}, {"key": "pron.p.paceLabel", "text": "Temps:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} vārdi minūtē ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Dabiskā sarunā ir aptuveni 120–160."}, {"key": "pron.p.pace.slow", "text": "lēns"}, {"key": "pron.p.pace.natural", "text": "dabisks"}, {"key": "pron.p.pace.fast", "text": "ātrs"}, {"key": "pron.p.fillersLabel", "text": "Pildvārdi:"}, {"key": "pron.p.repeatedLabel", "text": "Atkārtoti vārdi:"}, {"key": "pron.p.noneDetected", "text": "nav konstatēts"}, {"key": "pron.p.measuredNote", "text": "Temps, pildvārdi un atkārtošanās tiek skaitīti no tavas īstās transkripcijas un ieraksta garuma. Augstums, skaļums un kluso paužu garums netiek mērīti, tāpēc intonāciju un pauzes automātiski nevērtējam."}, {"key": "pron.p.mastered", "text": "Apgūts — divi skaidri mēģinājumi"}, {"key": "pron.p.attempt", "text": "Mēģinājums {{n}} — divi skaidri nolasījumi pēc kārtas atzīmē šo frāzi kā apgūtu."}, {"key": "pron.p.toShadowing", "text": "Trenē to īstā runā → Ēnuošana"}, {"key": "pron.p.toCoach", "text": "Izmanto to ar Runas treneri"}]
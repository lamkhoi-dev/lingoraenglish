[{"key": "pron.hero.title", "text": "Звучи по-ясно, по-естествено, по-свободно"}, {"key": "pron.hero.description", "text": "Всички {{count}} английски звука плюс ударение в думи, ударение в изречения, интонация, свързана реч, редукции, ритъм, групиране и беглост — всеки урок завършва с твой собствен запис."}, {"key": "pron.imageAlt", "text": "Произношение, артикулация и IPA"}, {"key": "pron.progress.title", "text": "Твоят напредък в произношението"}, {"key": "pron.progress.descUser", "text": "Измерен от думите, които коучът разпозна в твоите собствени записи."}, {"key": "pron.progress.descGuest", "text": "Създай безплатен акаунт, за да се записваш и да започнеш да следиш напредъка си."}, {"key": "pron.recommended", "text": "Препоръчано за теб"}, {"key": "pron.soundLabel", "text": "Звук {{symbol}}"}, {"key": "pron.skill.sounds", "text": "Звукове"}, {"key": "pron.skill.sounds.blurb", "text": "Всички 44 английски фонеми с минимални двойки."}, {"key": "pron.skill.wordStress", "text": "Ударение в думи"}, {"key": "pron.skill.wordStress.blurb", "text": "Срички, главно и второстепенно ударение."}, {"key": "pron.skill.sentenceStress", "text": "Ударение в изречения"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Значещите думи — силни, служебните — слаби."}, {"key": "pron.skill.intonation", "text": "Интонация"}, {"key": "pron.skill.intonation.blurb", "text": "Възходяща, низходяща, възходящо-низходяща и низходящо-възходяща."}, {"key": "pron.skill.connectedSpeech", "text": "Свързана реч"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Свързване, елизия, асимилация, слаби форми."}, {"key": "pron.skill.reductions", "text": "Редукции"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — неформален говорим английски."}, {"key": "pron.skill.rhythm", "text": "Ритъм"}, {"key": "pron.skill.rhythm.blurb", "text": "Ударно-времеви такт, темпо и паузи."}, {"key": "pron.skill.chunking", "text": "Паузи и групиране"}, {"key": "pron.skill.chunking.blurb", "text": "Смислови групи и естествени паузи за дишане."}, {"key": "pron.skill.fluency", "text": "Беглост"}, {"key": "pron.skill.fluency.blurb", "text": "Скорост, колебание, запълващи думи и свързване на идеи."}, {"key": "pron.filter.searchPlaceholder", "text": "Търси звук, дума или урок"}, {"key": "pron.filter.allLevels", "text": "Всички нива"}, {"key": "pron.filter.beginner", "text": "Начинаещ"}, {"key": "pron.filter.intermediate", "text": "Средно ниво"}, {"key": "pron.filter.advanced", "text": "Напреднал"}, {"key": "pron.filter.allDifficulties", "text": "Всички трудности"}, {"key": "pron.filter.gentle", "text": "Лека"}, {"key": "pron.filter.steady", "text": "Умерена"}, {"key": "pron.filter.challenging", "text": "Предизвикателна"}, {"key": "pron.filter.us", "text": "Американски английски"}, {"key": "pron.filter.uk", "text": "Британски английски"}, {"key": "pron.sounds.title", "text": "{{count}}те английски звука"}, {"key": "pron.sounds.shown", "text": "Показани: {{count}}"}, {"key": "pron.lessons.title", "text": "Уроци по {{skill}}"}, {"key": "pron.lessons.none", "text": "Няма урок, който да отговаря на тези филтри. Опитай „Всички нива“ и „Всички трудности“."}, {"key": "pron.how", "text": "Как"}, {"key": "pron.commonMistakes", "text": "Чести грешки"}, {"key": "pron.wordPractice", "text": "Упражнение с думи"}, {"key": "pron.sentencePractice", "text": "Упражнение с изречения"}, {"key": "pron.minimalPairs", "text": "Минимални двойки"}, {"key": "pron.practise", "text": "Упражнявай се"}, {"key": "pron.toast.signInModel", "text": "Влез в профила си, за да чуеш AI модела."}, {"key": "pron.toast.playError", "text": "Аудиото не можа да се възпроизведе."}, {"key": "pron.voicedDesc", "text": "Звучен — гласните струни вибрират"}, {"key": "pron.voicelessDesc", "text": "Беззвучен — само дихание, без вибрация"}, {"key": "pron.soundPracticeHint", "text": "Натисни „1. Слушай“ в картата за упражнения вдясно, за да чуеш AI модела на този звук и пример."}, {"key": "pron.paywall.soundLocked", "text": "Пълният урок за този звук — как се образува, положение на устата, примерни думи, изречения и минимални двойки — е част от Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "Първите {{count}} звука са безплатни. Надгради, за да отключиш всички 44 звука и персонализирана обратна връзка от коуча."}, {"key": "pron.paywall.unlockAllSounds", "text": "Отключи всички 44 звука"}, {"key": "pron.wordPracticeHint", "text": "Кликни върху дума, за да чуеш AI и да се упражняваш"}, {"key": "pron.eg", "text": "напр."}, {"key": "pron.playing", "text": "Възпроизвежда се"}, {"key": "pron.listen", "text": "Слушай"}, {"key": "pron.paywall.lessonLocked", "text": "Обяснението, точките за упражнение и примерите в този урок са част от Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "Първите {{count}} урока от всяко умение са безплатни. Надградете, за да отключите останалите."}, {"key": "pron.paywall.unlockAllLessons", "text": "Отключи всички уроци"}, {"key": "pron.itemPracticeHint", "text": "Кликнете върху елемента, за да упражнявате с AI"}, {"key": "pron.practiceHint", "text": "Слушайте, повтаряйте, записвайте и сравнявайте — коучът показва точно кои думи са се чули ясно."}, {"key": "pron.drillsCount", "text": "{{count}} упражнения"}, {"key": "pron.useInShadowing", "text": "Използвай това умение в Shadowing"}, {"key": "pron.backToCoach", "text": "Обратно към Speaking Coach"}, {"key": "pron.p.title", "text": "Практика"}, {"key": "pron.p.step1.label", "text": "Слушай"}, {"key": "pron.p.step1.hint", "text": "Пуснете примерния аудио запис два пъти."}, {"key": "pron.p.step2.label", "text": "Разбери"}, {"key": "pron.p.step2.hint", "text": "Прочетете какво трябва да прави устата ви."}, {"key": "pron.p.step3.label", "text": "Гледай / научи"}, {"key": "pron.p.step3.hint", "text": "Проверете ръководството за уста, език и артикулация."}, {"key": "pron.p.step4.label", "text": "Повтори"}, {"key": "pron.p.step4.hint", "text": "Кажете го на глас с аудиото, първо бавно."}, {"key": "pron.p.step5.label", "text": "Запиши"}, {"key": "pron.p.step5.hint", "text": "Запишете се как казвате същия ред."}, {"key": "pron.p.step6.label", "text": "AI обратна връзка"}, {"key": "pron.p.step6.hint", "text": "Вижте какво е чул коучът и какво да поправите."}, {"key": "pron.p.step7.label", "text": "Опитай отново"}, {"key": "pron.p.step7.hint", "text": "Поправете едно нещо и запишете още веднъж."}, {"key": "pron.p.step8.label", "text": "Овладяно"}, {"key": "pron.p.step8.hint", "text": "Ясно прочитане два пъти подред — продължете напред."}, {"key": "pron.p.stepTap", "text": "{{hint}} Докоснете, след като сте го направили."}, {"key": "pron.p.focusSound", "text": "Фокусен звук {{sound}}"}, {"key": "pron.p.eg", "text": "напр. {{sentence}}"}, {"key": "pron.p.loading", "text": "Зареждане…"}, {"key": "pron.p.speedNormal", "text": "Нормално"}, {"key": "pron.p.speedSlower", "text": "По-бавно"}, {"key": "pron.p.speedSlow", "text": "Бавно"}, {"key": "pron.p.loop", "text": "Повторение"}, {"key": "pron.p.stop", "text": "Спри"}, {"key": "pron.p.voiceNote", "text": "Примерният аудио запис е американският английски AI глас на Lingora, а не човешки запис."}, {"key": "pron.p.listenSentence", "text": "Слушай пуска звука два пъти, после примерната дума, после изречение с нея."}, {"key": "pron.p.listenExample", "text": "Слушай пуска звука два пъти, после примера."}, {"key": "pron.p.recordHint", "text": "Кажете реда по-горе веднъж, ясно."}, {"key": "pron.p.signupToRecord", "text": "Създайте безплатен акаунт, за да записвате и получавате обратна връзка."}, {"key": "pron.p.yourRecording", "text": "Вашият запис"}, {"key": "pron.p.listeningRec", "text": "Слушане на вашия запис…"}, {"key": "pron.p.wordsClear", "text": "Ясно изговорени думи"}, {"key": "pron.p.wpm", "text": "Скорост на говорене (думи/мин)"}, {"key": "pron.p.heard", "text": "Lingora чу"}, {"key": "pron.p.tagClear", "text": "Ясно"}, {"key": "pron.p.tagNeeds", "text": "Нуждае се от подобрение"}, {"key": "pron.p.measured", "text": "Измерено представяне"}, {"key": "pron.p.paceLabel", "text": "Темпо:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} думи в минута ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Естественият разговор е около 120–160."}, {"key": "pron.p.pace.slow", "text": "бавно"}, {"key": "pron.p.pace.natural", "text": "естествено"}, {"key": "pron.p.pace.fast", "text": "бързо"}, {"key": "pron.p.fillersLabel", "text": "Пълнежи:"}, {"key": "pron.p.repeatedLabel", "text": "Повторени думи:"}, {"key": "pron.p.noneDetected", "text": "не са открити"}, {"key": "pron.p.measuredNote", "text": "Темпото, пълнежите и повторенията се отчитат от реалния ви транскрипт и дължината на записа. Височината на тона, силата на звука и дължината на тихите паузи не се измерват, затова не оценяваме автоматично интонацията или паузите."}, {"key": "pron.p.mastered", "text": "Овладяно — два ясни опита"}, {"key": "pron.p.attempt", "text": "Опит {{n}} — две ясни прочитания подред отбелязват този ред като овладян."}, {"key": "pron.p.toShadowing", "text": "Упражнявайте това в реална реч → Shadowing"}, {"key": "pron.p.toCoach", "text": "Използвайте го със Speaking Coach"}]
[{"key": "pron.hero.title", "text": "Tal tydeligere, mere naturligt, mere flydende"}, {"key": "pron.hero.description", "text": "Alle {{count}} engelske lyde plus ordtryk, sætningstryk, intonation, sammenhængende tale, reduktioner, rytme, opdeling og flydende tale — hver lektion slutter med din egen optagelse."}, {"key": "pron.imageAlt", "text": "Udtale, artikulation og IPA"}, {"key": "pron.progress.title", "text": "Din udtalefremgang"}, {"key": "pron.progress.descUser", "text": "Målt ud fra de ord, coachen genkendte i dine egne optagelser."}, {"key": "pron.progress.descGuest", "text": "Opret en gratis konto for at optage dig selv og begynde at følge din fremgang."}, {"key": "pron.recommended", "text": "Anbefalet til dig"}, {"key": "pron.soundLabel", "text": "{{symbol}}-lyd"}, {"key": "pron.skill.sounds", "text": "Lyde"}, {"key": "pron.skill.sounds.blurb", "text": "Alle 44 engelske fonemer med minimalpar."}, {"key": "pron.skill.wordStress", "text": "Ordtryk"}, {"key": "pron.skill.wordStress.blurb", "text": "Stavelser, primært og sekundært tryk."}, {"key": "pron.skill.sentenceStress", "text": "Sætningstryk"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Indholdsord stærke, funktionsord svage."}, {"key": "pron.skill.intonation", "text": "Intonation"}, {"key": "pron.skill.intonation.blurb", "text": "Stigende, faldende, stig-fald og fald-stig."}, {"key": "pron.skill.connectedSpeech", "text": "Sammenhængende tale"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Sammenkædning, elision, assimilation, svage former."}, {"key": "pron.skill.reductions", "text": "Reduktioner"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — uformel talt engelsk."}, {"key": "pron.skill.rhythm", "text": "Rytme"}, {"key": "pron.skill.rhythm.blurb", "text": "Trykbaserede takter, timing og pauser."}, {"key": "pron.skill.chunking", "text": "Pausering og opdeling"}, {"key": "pron.skill.chunking.blurb", "text": "Tankegrupper og naturlige åndedrætspauser."}, {"key": "pron.skill.fluency", "text": "Flydende tale"}, {"key": "pron.skill.fluency.blurb", "text": "Tempo, tøven, fyldord og sammenkædning af idéer."}, {"key": "pron.filter.searchPlaceholder", "text": "Søg en lyd, et ord eller en lektion"}, {"key": "pron.filter.allLevels", "text": "Alle niveauer"}, {"key": "pron.filter.beginner", "text": "Begynder"}, {"key": "pron.filter.intermediate", "text": "Mellemniveau"}, {"key": "pron.filter.advanced", "text": "Øvet"}, {"key": "pron.filter.allDifficulties", "text": "Alle sværhedsgrader"}, {"key": "pron.filter.gentle", "text": "Skånsom"}, {"key": "pron.filter.steady", "text": "Jævn"}, {"key": "pron.filter.challenging", "text": "Udfordrende"}, {"key": "pron.filter.us", "text": "Amerikansk engelsk"}, {"key": "pron.filter.uk", "text": "Britisk engelsk"}, {"key": "pron.sounds.title", "text": "De {{count}} engelske lyde"}, {"key": "pron.sounds.shown", "text": "{{count}} vist"}, {"key": "pron.lessons.title", "text": "{{skill}}-lektioner"}, {"key": "pron.lessons.none", "text": "Ingen lektion matcher disse filtre. Prøv \"Alle niveauer\" og \"Alle sværhedsgrader\"."}, {"key": "pron.how", "text": "Sådan"}, {"key": "pron.commonMistakes", "text": "Almindelige fejl"}, {"key": "pron.wordPractice", "text": "Ordøvelse"}, {"key": "pron.sentencePractice", "text": "Sætningsøvelse"}, {"key": "pron.minimalPairs", "text": "Minimalpar"}, {"key": "pron.practise", "text": "Øv"}, {"key": "pron.toast.signInModel", "text": "Log ind for at høre AI-modellens lyd."}, {"key": "pron.toast.playError", "text": "Kunne ikke afspille lyd."}, {"key": "pron.voicedDesc", "text": "Stemt — dine stemmebånd vibrerer"}, {"key": "pron.voicelessDesc", "text": "Ustemt — kun luft, ingen vibration"}, {"key": "pron.soundPracticeHint", "text": "Tryk på \"1. Lyt\" i øvelseskortet til højre for at høre AI-modellen sige denne lyd og et eksempel."}, {"key": "pron.paywall.soundLocked", "text": "Denne lyds fulde lektion — hvordan man laver den, mundstilling, eksempelord, sætninger og minimalpar — er en del af Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "De første {{count}} lyde er gratis. Opgrader for at låse alle 44 lyde op og få personlig feedback fra coachen."}, {"key": "pron.paywall.unlockAllSounds", "text": "Lås alle 44 lyde op"}, {"key": "pron.wordPracticeHint", "text": "Klik på ordet for at høre AI og øve"}, {"key": "pron.eg", "text": "f.eks."}, {"key": "pron.playing", "text": "Afspiller"}, {"key": "pron.listen", "text": "Lyt"}, {"key": "pron.paywall.lessonLocked", "text": "Denne lektions forklaring, øvelsespunkter og eksempler er en del af Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "De første {{count}} lektioner i hver færdighed er gratis. Opgrader for at låse op for resten."}, {"key": "pron.paywall.unlockAllLessons", "text": "Lås alle lektioner op"}, {"key": "pron.itemPracticeHint", "text": "Klik på elementet for at øve med AI"}, {"key": "pron.practiceHint", "text": "Lyt, gentag, optag og sammenlign — coachen viser præcis, hvilke ord der kom klart igennem."}, {"key": "pron.drillsCount", "text": "{{count}} øvelser"}, {"key": "pron.useInShadowing", "text": "Brug denne færdighed i Shadowing"}, {"key": "pron.backToCoach", "text": "Tilbage til Speaking Coach"}, {"key": "pron.p.title", "text": "Øv"}, {"key": "pron.p.step1.label", "text": "Lyt"}, {"key": "pron.p.step1.hint", "text": "Afspil modellyden to gange."}, {"key": "pron.p.step2.label", "text": "Forstå"}, {"key": "pron.p.step2.hint", "text": "Læs, hvad din mund skal gøre."}, {"key": "pron.p.step3.label", "text": "Se / lær"}, {"key": "pron.p.step3.hint", "text": "Tjek guiden for mund, tunge og mønster."}, {"key": "pron.p.step4.label", "text": "Gentag"}, {"key": "pron.p.step4.hint", "text": "Sig det højt med lyden, først langsomt."}, {"key": "pron.p.step5.label", "text": "Optag"}, {"key": "pron.p.step5.hint", "text": "Optag dig selv, når du siger samme linje."}, {"key": "pron.p.step6.label", "text": "AI-feedback"}, {"key": "pron.p.step6.hint", "text": "Se, hvad coachen hørte, og hvad du skal rette."}, {"key": "pron.p.step7.label", "text": "Prøv igen"}, {"key": "pron.p.step7.hint", "text": "Ret én ting og optag en gang mere."}, {"key": "pron.p.step8.label", "text": "Mestret"}, {"key": "pron.p.step8.hint", "text": "Tydelig oplæsning to gange i træk — gå videre."}, {"key": "pron.p.stepTap", "text": "{{hint}} Tryk, når du har gjort dette."}, {"key": "pron.p.focusSound", "text": "Fokuslyd {{sound}}"}, {"key": "pron.p.eg", "text": "f.eks. {{sentence}}"}, {"key": "pron.p.loading", "text": "Indlæser…"}, {"key": "pron.p.speedNormal", "text": "Normal"}, {"key": "pron.p.speedSlower", "text": "Langsommere"}, {"key": "pron.p.speedSlow", "text": "Langsom"}, {"key": "pron.p.loop", "text": "Gentag"}, {"key": "pron.p.stop", "text": "Stop"}, {"key": "pron.p.voiceNote", "text": "Modellyden er Lingoras amerikansk-engelske AI-stemme, ikke en menneskelig optagelse."}, {"key": "pron.p.listenSentence", "text": "Lyt afspiller lyden to gange, derefter eksempelordet og til sidst en sætning med det."}, {"key": "pron.p.listenExample", "text": "Lyt afspiller lyden to gange, derefter eksemplet."}, {"key": "pron.p.recordHint", "text": "Sig linjen ovenfor én gang, tydeligt."}, {"key": "pron.p.signupToRecord", "text": "Opret en gratis konto for at optage og få feedback."}, {"key": "pron.p.yourRecording", "text": "Din optagelse"}, {"key": "pron.p.listeningRec", "text": "Lytter til din optagelse…"}, {"key": "pron.p.wordsClear", "text": "Ord sagt tydeligt"}, {"key": "pron.p.wpm", "text": "Taletempo (ord/min)"}, {"key": "pron.p.heard", "text": "Lingora hørte"}, {"key": "pron.p.tagClear", "text": "Tydeligt"}, {"key": "pron.p.tagNeeds", "text": "Kan forbedres"}, {"key": "pron.p.measured", "text": "Målt fremføring"}, {"key": "pron.p.paceLabel", "text": "Tempo:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} ord i minuttet ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Naturlig samtale er omkring 120–160."}, {"key": "pron.p.pace.slow", "text": "langsomt"}, {"key": "pron.p.pace.natural", "text": "naturligt"}, {"key": "pron.p.pace.fast", "text": "hurtigt"}, {"key": "pron.p.fillersLabel", "text": "Udfyldningsord:"}, {"key": "pron.p.repeatedLabel", "text": "Gentagne ord:"}, {"key": "pron.p.noneDetected", "text": "ingen fundet"}, {"key": "pron.p.measuredNote", "text": "Tempo, udfyldningsord og gentagelser tælles ud fra din faktiske transskription og optagelsens længde. Tonehøjde, lydstyrke og længden af stille pauser måles ikke, så vi vurderer ikke intonation eller pauser automatisk."}, {"key": "pron.p.mastered", "text": "Mestret — to tydelige forsøg"}, {"key": "pron.p.attempt", "text": "Forsøg {{n}} — to tydelige oplæsninger i træk markerer denne linje som mestret."}, {"key": "pron.p.toShadowing", "text": "Øv dette i virkelig tale → Shadowing"}, {"key": "pron.p.toCoach", "text": "Brug det med Speaking Coach"}]
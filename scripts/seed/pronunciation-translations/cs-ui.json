[{"key": "pron.hero.title", "text": "Mluvte jasněji, přirozeněji a plynuleji"}, {"key": "pron.hero.description", "text": "Všech {{count}} anglických zvuků plus slovní přízvuk, větný přízvuk, intonace, spojená řeč, redukce, rytmus, členění a plynulost — každá lekce končí vaším vlastním nahráváním."}, {"key": "pron.imageAlt", "text": "Výslovnost, artikulace a IPA"}, {"key": "pron.progress.title", "text": "Váš pokrok ve výslovnosti"}, {"key": "pron.progress.descUser", "text": "Měřeno podle slov, která kouč rozpoznal ve vašich vlastních nahrávkách."}, {"key": "pron.progress.descGuest", "text": "Vytvořte si zdarma účet, nahrávejte se a začněte sledovat pokrok."}, {"key": "pron.recommended", "text": "Doporučeno pro vás"}, {"key": "pron.soundLabel", "text": "Zvuk {{symbol}}"}, {"key": "pron.skill.sounds", "text": "Zvuky"}, {"key": "pron.skill.sounds.blurb", "text": "Všech 44 anglických fonémů s minimálními páry."}, {"key": "pron.skill.wordStress", "text": "Slovní přízvuk"}, {"key": "pron.skill.wordStress.blurb", "text": "Slabiky, hlavní a vedlejší přízvuk."}, {"key": "pron.skill.sentenceStress", "text": "Větný přízvuk"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Obsahová slova silně, funkční slova slabě."}, {"key": "pron.skill.intonation", "text": "Intonace"}, {"key": "pron.skill.intonation.blurb", "text": "Stoupavá, klesavá, stoupavě-klesavá a klesavě-stoupavá."}, {"key": "pron.skill.connectedSpeech", "text": "Spojená řeč"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Propojování, elize, asimilace, slabé formy."}, {"key": "pron.skill.reductions", "text": "Redukce"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — neformální mluvená angličtina."}, {"key": "pron.skill.rhythm", "text": "Rytmus"}, {"key": "pron.skill.rhythm.blurb", "text": "Přízvukové takty, načasování a pauzy."}, {"key": "pron.skill.chunking", "text": "Pauzy a členění"}, {"key": "pron.skill.chunking.blurb", "text": "Myšlenkové celky a přirozené dechové pauzy."}, {"key": "pron.skill.fluency", "text": "Plynulost"}, {"key": "pron.skill.fluency.blurb", "text": "Rychlost, zaváhání, výplňová slova a propojování myšlenek."}, {"key": "pron.filter.searchPlaceholder", "text": "Hledat zvuk, slovo nebo lekci"}, {"key": "pron.filter.allLevels", "text": "Všechny úrovně"}, {"key": "pron.filter.beginner", "text": "Začátečník"}, {"key": "pron.filter.intermediate", "text": "Středně pokročilý"}, {"key": "pron.filter.advanced", "text": "Pokročilý"}, {"key": "pron.filter.allDifficulties", "text": "Všechny obtížnosti"}, {"key": "pron.filter.gentle", "text": "Lehká"}, {"key": "pron.filter.steady", "text": "Střední"}, {"key": "pron.filter.challenging", "text": "Náročná"}, {"key": "pron.filter.us", "text": "Americká angličtina"}, {"key": "pron.filter.uk", "text": "Britská angličtina"}, {"key": "pron.sounds.title", "text": "{{count}} anglických zvuků"}, {"key": "pron.sounds.shown", "text": "Zobrazeno {{count}}"}, {"key": "pron.lessons.title", "text": "Lekce: {{skill}}"}, {"key": "pron.lessons.none", "text": "Žádná lekce neodpovídá těmto filtrům. Zkuste „Všechny úrovně“ a „Všechny obtížnosti“."}, {"key": "pron.how", "text": "Jak"}, {"key": "pron.commonMistakes", "text": "Časté chyby"}, {"key": "pron.wordPractice", "text": "Procvičování slov"}, {"key": "pron.sentencePractice", "text": "Procvičování vět"}, {"key": "pron.minimalPairs", "text": "Minimální páry"}, {"key": "pron.practise", "text": "Procvičit"}, {"key": "pron.toast.signInModel", "text": "Přihlaste se a poslechněte si zvuk AI modelu."}, {"key": "pron.toast.playError", "text": "Zvuk se nepodařilo přehrát."}, {"key": "pron.voicedDesc", "text": "Znělý — hlasivky vibrují"}, {"key": "pron.voicelessDesc", "text": "Neznělý — pouze dech, bez vibrací"}, {"key": "pron.soundPracticeHint", "text": "Klepněte na „1. Poslouchat“ v kartě Procvičování vpravo a uslyšíte AI model tohoto zvuku a příklad."}, {"key": "pron.paywall.soundLocked", "text": "Kompletní lekce tohoto zvuku — jak ho vyslovit, postavení úst, příkladová slova, věty a minimální páry — je součástí Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "Prvních {{count}} zvuků je zdarma. Přejděte na Premium a odemkněte všech 44 zvuků a personalizovanou zpětnou vazbu kouče."}, {"key": "pron.paywall.unlockAllSounds", "text": "Odemknout všech 44 zvuků"}, {"key": "pron.wordPracticeHint", "text": "Klepněte na slovo pro poslech AI a procvičení"}, {"key": "pron.eg", "text": "např."}, {"key": "pron.playing", "text": "Přehrává se"}, {"key": "pron.listen", "text": "Poslouchat"}, {"key": "pron.paywall.lessonLocked", "text": "Vysvětlení této lekce, body k procvičení a příklady jsou součástí Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "Prvních {{count}} lekcí u každé dovednosti je zdarma. Odemkni zbytek upgradem."}, {"key": "pron.paywall.unlockAllLessons", "text": "Odemknout všechny lekce"}, {"key": "pron.itemPracticeHint", "text": "Klikni na položku a procvičuj s AI"}, {"key": "pron.practiceHint", "text": "Poslouchej, opakuj, nahrávej a porovnávej — kouč ti ukáže, která slova zazněla jasně."}, {"key": "pron.drillsCount", "text": "{{count}} cvičení"}, {"key": "pron.useInShadowing", "text": "Použít tuto dovednost ve Shadowingu"}, {"key": "pron.backToCoach", "text": "Zpět na Speaking Coach"}, {"key": "pron.p.title", "text": "Procvičování"}, {"key": "pron.p.step1.label", "text": "Poslouchej"}, {"key": "pron.p.step1.hint", "text": "Přehraj vzorovou nahrávku dvakrát."}, {"key": "pron.p.step2.label", "text": "Pochop"}, {"key": "pron.p.step2.hint", "text": "Přečti si, co má tvá ústa dělat."}, {"key": "pron.p.step3.label", "text": "Sleduj / uč se"}, {"key": "pron.p.step3.hint", "text": "Zkontroluj průvodce ústy, jazykem a vzorem."}, {"key": "pron.p.step4.label", "text": "Opakuj"}, {"key": "pron.p.step4.hint", "text": "Říkej to nahlas spolu s nahrávkou, nejdřív pomalu."}, {"key": "pron.p.step5.label", "text": "Nahraj"}, {"key": "pron.p.step5.hint", "text": "Nahraj si, jak říkáš stejnou větu."}, {"key": "pron.p.step6.label", "text": "Zpětná vazba AI"}, {"key": "pron.p.step6.hint", "text": "Podívej se, co kouč slyšel a co zlepšit."}, {"key": "pron.p.step7.label", "text": "Zkus znovu"}, {"key": "pron.p.step7.hint", "text": "Oprav jednu věc a nahraj ještě jednou."}, {"key": "pron.p.step8.label", "text": "Zvládnuto"}, {"key": "pron.p.step8.hint", "text": "Dvakrát po sobě jasné přečtení — jdi dál."}, {"key": "pron.p.stepTap", "text": "{{hint}} Klepni, až to budeš mít."}, {"key": "pron.p.focusSound", "text": "Zaměř se na zvuk {{sound}}"}, {"key": "pron.p.eg", "text": "např. {{sentence}}"}, {"key": "pron.p.loading", "text": "Načítání…"}, {"key": "pron.p.speedNormal", "text": "Normální"}, {"key": "pron.p.speedSlower", "text": "Pomalejší"}, {"key": "pron.p.speedSlow", "text": "Pomalá"}, {"key": "pron.p.loop", "text": "Smyčka"}, {"key": "pron.p.stop", "text": "Zastavit"}, {"key": "pron.p.voiceNote", "text": "Vzorová nahrávka je americký AI hlas Lingory, nejde o nahrávku člověka."}, {"key": "pron.p.listenSentence", "text": "Poslech přehraje zvuk dvakrát, pak vzorové slovo a nakonec větu, která ho obsahuje."}, {"key": "pron.p.listenExample", "text": "Poslech přehraje zvuk dvakrát, pak příklad."}, {"key": "pron.p.recordHint", "text": "Řekni větu výše jednou, jasně."}, {"key": "pron.p.signupToRecord", "text": "Vytvoř si zdarma účet, abys mohl nahrávat a dostávat zpětnou vazbu."}, {"key": "pron.p.yourRecording", "text": "Tvá nahrávka"}, {"key": "pron.p.listeningRec", "text": "Poslouchám tvou nahrávku…"}, {"key": "pron.p.wordsClear", "text": "Slova řečená jasně"}, {"key": "pron.p.wpm", "text": "Tempo řeči (slova/min)"}, {"key": "pron.p.heard", "text": "Lingora slyšela"}, {"key": "pron.p.tagClear", "text": "Jasné"}, {"key": "pron.p.tagNeeds", "text": "Ke zlepšení"}, {"key": "pron.p.measured", "text": "Naměřený projev"}, {"key": "pron.p.paceLabel", "text": "Tempo:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} slov za minutu ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Přirozená konverzace je kolem 120–160."}, {"key": "pron.p.pace.slow", "text": "pomalé"}, {"key": "pron.p.pace.natural", "text": "přirozené"}, {"key": "pron.p.pace.fast", "text": "rychlé"}, {"key": "pron.p.fillersLabel", "text": "Výplňová slova:"}, {"key": "pron.p.repeatedLabel", "text": "Opakovaná slova:"}, {"key": "pron.p.noneDetected", "text": "nic nezjištěno"}, {"key": "pron.p.measuredNote", "text": "Tempo, výplňová slova a opakování se počítají z tvého skutečného přepisu a délky nahrávky. Výška hlasu, hlasitost a délka tichých pauz se neměří, proto intonaci ani pauzy automaticky nehodnotíme."}, {"key": "pron.p.mastered", "text": "Zvládnuto — dva jasné pokusy"}, {"key": "pron.p.attempt", "text": "Pokus {{n}} — dvě jasná přečtení po sobě označí tuto větu jako zvládnutou."}, {"key": "pron.p.toShadowing", "text": "Procvič to v reálné řeči → Shadowing"}, {"key": "pron.p.toCoach", "text": "Použij to se Speaking Coach"}]
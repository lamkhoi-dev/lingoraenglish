[{"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|point|3", "text": "got to → gotta"}, {"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|caution", "text": "Ezek kötetlen, beszélt nyelvi formák. Ne írd le őket esszékben, e-mailekben vagy hivatalos vizsgákon, és kerüld őket hivatalos prezentációk során."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|explain", "text": "További hétköznapi összevonások, amelyeket folyamatosan hallhatsz filmekben és valódi beszélgetésekben."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|0", "text": "kind of → kinda"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|1", "text": "sort of → sorta"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|2", "text": "let me → lemme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|3", "text": "give me → gimme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|4", "text": "what do you → whaddaya"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|caution", "text": "Kizárólag kötetlen helyzetben használd. IELTS-vizsgán vagy állásinterjún maradj a teljes alakoknál."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|explain", "text": "További, kötelezettséget és szokást kifejező összevonások, amelyek gyakoriak a laza beszélt angolban."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|0", "text": "have to → hafta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|1", "text": "need to → needa"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|2", "text": "used to → useta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|caution", "text": "Csak kötetlen, beszélt nyelvi formák — írásban soha ne használd őket."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|explain", "text": "Múlt idejű modális segédigék összevonásai — nagyon gyakoriak megbánások vagy feltételes helyzetek megvitatásakor."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|0", "text": "could have → coulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|1", "text": "would have → woulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|2", "text": "should have → shoulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|caution", "text": "Csak kötetlen beszédben használatos — hivatalos írásban írd ki teljesen: 'could have'."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|explain", "text": "Nagyon kötetlen összevonások, amelyek gyakoriak dalokban, filmekben és baráti beszélgetésekben."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|0", "text": "don't know → dunno"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|1", "text": "don't you → dontcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|2", "text": "what are you → whatcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|caution", "text": "Nagyon kötetlen — csak közeli barátokkal használd, szakmai vagy vizsgakörnyezetben soha."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|explain", "text": "Gyakori elöljárószós összevonások a hétköznapi beszédben."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|0", "text": "out of → outta"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|1", "text": "off of → offa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|2", "text": "cup of → cuppa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|caution", "text": "Kizárólag kötetlen helyzetekben."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|explain", "text": "Mindennapi felkiáltások és laza kifejezések erőteljes összevonással."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|0", "text": "come on → c'mon"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|1", "text": "going to be → gonna be"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|2", "text": "some more → s'more"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|caution", "text": "Kizárólag kötetlen helyzetekben."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|explain", "text": "A kérdésindító kifejezések erősen összevonódnak a gyors, hétköznapi beszédben."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|0", "text": "did you → dja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|1", "text": "do you → dya"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|2", "text": "would you → wouldja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|caution", "text": "Csak laza, beszélt nyelvi helyzetekre."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|explain", "text": "A kötetlen beszéd gyakran az időhatározói kifejezéseket is összevonja."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|0", "text": "a couple of → a couple"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|1", "text": "in a minute → in a min"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|caution", "text": "Hétköznapi beszédben rendben van, írásban viszont kerülendő."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|explain", "text": "Gyakori kötetlen szóösszevonások, amelyek folyamatosan előfordulnak a laza társalgásokban."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|0", "text": "probably → prolly"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|1", "text": "trying to → tryna"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|2", "text": "supposed to → s'posed to"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|caution", "text": "Kizárólag informális beszédben használatos."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|explain", "text": "Baráti körben és a laza amerikai beszédben gyakori kötetlen szóösszevonások."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|0", "text": "let's go → less go"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|1", "text": "give it to me → gimme that"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|2", "text": "you all → y'all"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|caution", "text": "Nagyon kötetlen — a 'y'all' területi sajátosság (déli US), de széles körben megértik."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|explain", "text": "A kerek számok középső mássalhangzói a gyors, laza amerikai beszédben leegyszerűsödnek."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|0", "text": "twenty → twenny"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|1", "text": "hundred → hunnerd"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|caution", "text": "Csak kötetlen beszédben használatos — hivatalos helyzetekben mindig a teljes alakot ejtsd."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|explain", "text": "További hétköznapi szavak, amelyek gyors, kötetlen beszédben rendszerint veszítenek egy szótagot."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|0", "text": "different → diff'rent"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|1", "text": "general → gen'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|2", "text": "several → sev'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|3", "text": "camera → cam'ra"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|caution", "text": "Kötetlen beszédben természetes; hivatalos előadások során viszont ejtsd tisztán a teljes alakot."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|explain", "text": "Rendkívül kötetlen szóösszevonások, amelyekkel dalokban és laza amerikai beszédben találkozhatsz, de szakmai környezetben soha ne használd őket."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|0", "text": "I'm going to → I'ma"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|1", "text": "kind of like → kinda like"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|caution", "text": "Rendkívül informális — csak barátok között és dalszövegekben fordul elő, szakmai környezetben soha."}, {"key": "551b9527-f712-421d-966c-24644f360746|explain", "text": "További mindennapi üdvözlés-összevonások a what's up / how's it going kifejezéseken túl."}, {"key": "551b9527-f712-421d-966c-24644f360746|point|0", "text": "how are you → how ya doin'"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|1", "text": "good to see you → good to see ya"}, {"key": "551b9527-f712-421d-966c-24644f360746|caution", "text": "Kizárólag kötetlen beszélt nyelvi formák."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|explain", "text": "További kötelességet és szándékot kifejező rövidülések a laza amerikai beszédből."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|0", "text": "ought to → oughta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|1", "text": "don't have to → don't hafta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|2", "text": "want you → wantcha"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|caution", "text": "Kizárólag informális beszédben használatos."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|explain", "text": "Klasszikus példa arra, milyen mértékű lehet a laza amerikai szóösszevonás — több szó egyetlen kifejezéssé mosódik össze."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|0", "text": "Did you eat yet? → Jeetyet?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|1", "text": "Did you already? → Jeetalready?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|caution", "text": "Rendkívül informális — a gyors anyanyelvi beszéd felismerésére való, nem saját formális beszédre."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|explain", "text": "Két újabb gyakori kifejezésszintű redukció a kötetlen beszélgetésekben."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|0", "text": "because of → 'cause of"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|1", "text": "sort of a → sorta a"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|caution", "text": "Kizárólag informális beszédben használatos."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|explain", "text": "Nagyon gyakori kötetlen alternatívák a 'yes' és 'no' szavakra a laza beszélt angolban."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|0", "text": "yes → yep / uh-huh"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|1", "text": "no → nope / nah"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|caution", "text": "Csak kötetlen beszélgetésekben – hivatalos vagy vizsgahelyzetekben használd a 'yes'/'no' formákat."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|explain", "text": "Mindkettő a hasonló hangzású 'wanna' alakra redukálódik, de az egyiket főnév, a másikat ige követi – érdemes megfigyelni a különbséget."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|0", "text": "want a (coffee) → wanna coffee"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|1", "text": "want to (go) → wanna go"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|caution", "text": "Kizárólag informális beszédben használatos."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|0", "text": "'want a' + főnév → wanna"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|1", "text": "'want to' + ige → wanna"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|explain", "text": "A 'would have' tagadó alakja ugyanúgy redukálódik, mint a kijelentő forma."}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|point|0", "text": "wouldn't have → wouldn'ta"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|caution", "text": "Kizárólag informális beszédben használatos – egyébként írd ki teljesen a 'wouldn't have' alakot."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|explain", "text": "Két újabb mindennapi redukció, amely gyakori a kötetlen magyarázatokban és kérésekben."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|0", "text": "just because → just 'cause"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|1", "text": "going to need → gonna need"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|caution", "text": "Kizárólag informális beszédben használatos."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|explain", "text": "Az 'Ain't' a nagyon kötetlen beszédben az am not/is not/are not/has not/have not kifejezéseket helyettesíti, és lépten-nyomon hallható dalokban és informális társalgásokban."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|0", "text": "I am not → I ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|1", "text": "that is not → that ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|2", "text": "you have not → you ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|caution", "text": "Soha ne használd írásban vagy formális beszédben – nem számít helyes nyelvtannak, még ha kötetlen formában rendkívül elterjedt is."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|explain", "text": "Nagyon gyakori kötetlen módja annak kifejezésére, hogy 'I understand', vagy szó szerint: 'caught you'."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|0", "text": "got you (megértettem) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|1", "text": "got you (elkaptalak) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|caution", "text": "Kizárólag informális beszédben használatos – szakmai környezetben használd az 'I understand' vagy 'got it' kifejezést."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|explain", "text": "Múltbeli feltételezések kifejezésére használt befejezett segédigés redukciók a coulda/woulda/shoulda mellett."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|0", "text": "must have → musta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|1", "text": "might have → mighta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|caution", "text": "Kizárólag informális beszédben használatos – egyébként írd ki teljesen a 'must have'/'might have' alakot."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|explain", "text": "A coulda/woulda/shoulda tagadó megfelelői, amelyek gyakoriak a megbánás kifejezésekor."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|0", "text": "shouldn't have → shouldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|1", "text": "couldn't have → couldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|caution", "text": "Kizárólag informális beszédben használatos – formális környezetben írd ki teljesen a 'shouldn't have'/'couldn't have' formát."}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|explain", "text": "Laza beszédben a szóvégi -ing képzőből gyakran kiesik a 'g', így -in' hangzásúvá válik. Ez szinte bármelyik -ing végű igénél előfordul. (, so it sounds like -in)"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|0", "text": "doing → doin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|1", "text": "going → goin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|2", "text": "talking → talkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|3", "text": "thinking → thinkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|caution", "text": "Kizárólag kötetlen beszédben használd — prezentációkban, interjúkon és vizsgákon ejtsd tisztán a teljes '-ing' végződést."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|explain", "text": "Ugyanez a g-elhagyási minta érvényes a -thing végű határozatlan névmásokra is."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|0", "text": "something → somethin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|1", "text": "nothing → nothin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|2", "text": "anything → anythin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|caution", "text": "Kizárólag kötetlen beszédben."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|explain", "text": "A 'Them' nagyon gyakran 'em alakra redukálódik (a 'th' kiesik) ige után a kötetlen beszédben."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|0", "text": "tell them → tell 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|1", "text": "get them → get 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|2", "text": "ask them → ask 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|caution", "text": "Kizárólag informális beszédben — írásban vagy formális beszédben ejtsd végig a(z) 'them' szót."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|explain", "text": "Az 'And' egy gyors 'n' hanggá redukálódik két szorosan kapcsolódó szó között, különösen állandósult szókapcsolatokban."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|0", "text": "rock and roll → rock 'n' roll"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|1", "text": "fish and chips → fish 'n' chips"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|2", "text": "back and forth → back 'n' forth"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|caution", "text": "Gyakori állandósult kifejezésekben és gyors beszédben — hivatalos írásban használd a teljes 'and' alakot."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|explain", "text": "A(z) 'Because' önmagában is (nem csak a(z) 'because of' szerkezetben) gyakran 'cause alakra rövidül kötetlen válaszokban."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|point|0", "text": "because → 'cause"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|caution", "text": "Kizárólag informális beszédben — máskülönben írd ki teljesen a(z) 'because' szót."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|explain", "text": "Gyors, laza válaszokban a(z) 'Of course' kifejezésből gyakran kiesik az első szó."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|point|0", "text": "of course → 'course"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|caution", "text": "Kizárólag kötetlen beszédben."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|explain", "text": "A(z) 'all right' nagyon gyakori, kötetlen kiejtése, amelyet egyetértés vagy tudomásulvétel kifejezésére használnak."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|point|0", "text": "all right → aight"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|caution", "text": "Nagyon kötetlen — szakmai környezetben használd az 'all right' vagy 'okay' kifejezést."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|explain", "text": "A(z) 'Let you' ugyanúgy redukálódik, mint a(z) 'want you'/'wantcha'."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|point|0", "text": "let you → letcha"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|caution", "text": "Kizárólag informális beszédben."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|explain", "text": "Egy másik példa a rendkívül gyors beszédre jellemző összeolvadásra, hasonlóan a(z) 'jeetyet' szóhoz — több szó sűrűsödik össze egyetlen hanggá."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|point|0", "text": "did you ever → jever"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|caution", "text": "A gyors anyanyelvi beszéd felismerésére szolgál, ne használd hivatalos beszédhelyzetekben."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|explain", "text": "Két redukció kapcsolódik össze, amikor a(z) 'going to' és a(z) 'have to' egymás mellé kerül."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|point|0", "text": "going to have to → gonna hafta"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|caution", "text": "Kizárólag informális beszédben — egyébként írd ki teljesen a(z) 'going to have to' kifejezést."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|explain", "text": "A(z) 'gonna' redukció tagadásnál és múlt időben is érvényesül."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|0", "text": "not going to → not gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|1", "text": "wasn't going to → wasn't gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|caution", "text": "Kizárólag kötetlen beszélt nyelvben használatos."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|explain", "text": "Egy nagyon gyakori brit angol visszakérdező (tag question) összevonás, amelyet megerősítésre vagy nyomatékosításra használnak."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|point|0", "text": "isn't it → innit"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|caution", "text": "Nagyon informális brit szleng — hivatalos beszédben ne használd, még az UK területén sem."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|explain", "text": "Kötetlen módja egy javaslat felvetésének vagy az egyetértés kérésének."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|point|0", "text": "what do you say → whaddya say"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|caution", "text": "Kizárólag kötetlen beszélt nyelvben használatos."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|explain", "text": "Rendkívül gyakori töltelékkifejezés a kötetlen beszélt angolban; gondolkodási idő nyerésére vagy nyomatékosításra használják."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|point|0", "text": "you know → y'know"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|caution", "text": "Csak laza töltelékszó — túlzott használata még kötetlen beszélgetésben is igénytelennek hat."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|explain", "text": "Nagyon laza üdvözlés, amely a 'what's up' kifejezésből rövidült le."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|point|0", "text": "what's up → s'up"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|caution", "text": "Nagyon kötetlen üdvözlés, kizárólag barátok között ajánlott."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|explain", "text": "A 'Him' és a 'her' alakok szintén elgyengülnek a kötetlen beszédben, hasonlóan a 'them' → 'em esethez."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|0", "text": "tell him → tell 'im"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|1", "text": "ask her → ask 'er"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|caution", "text": "Kizárólag kötetlen beszélt nyelvben használatos."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|explain", "text": "A 'Kinda' és a 'sorta' szavakat gyakran összekapcsolják a még óvatosabb fogalmazás (hedging) érdekében a nagyon laza beszédben."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|point|0", "text": "kind of sort of → kinda sorta"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|caution", "text": "Nagyon kötetlen — kerüld bármilyen szakmai környezetben vagy vizsgahelyzetben."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|explain", "text": "Egy újabb, gyors beszédben használt kérdéskezdő összevonás a dja és wouldja mellett."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|point|0", "text": "didn't you → dincha"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|caution", "text": "A gyors anyanyelvi beszéd megértéséhez való, nem a saját hivatalos beszédedben való használatra."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|explain", "text": "A 'have to' múlt idejű alakja ugyanúgy redukálódik, mint a jelen idejű forma."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|point|0", "text": "had to → hadta"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|caution", "text": "Kizárólag kötetlen beszélt nyelvben használatos."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|explain", "text": "Kötetlen összevonás, amelyet informális kérésekben használnak a wouldja és couldja típusú formák mellett."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|point|0", "text": "will you → willcha"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|caution", "text": "Kizárólag kötetlen beszélt nyelvben használatos."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|explain", "text": "Az 'of' szót tartalmazó mennyiségi kifejezések ugyanúgy redukálódnak, mint a 'cup of' a 'cuppa' formában."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|0", "text": "lots of → lotsa"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|1", "text": "bunch of → buncha"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|caution", "text": "Kizárólag kötetlen beszélt nyelvben használatos."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|explain", "text": "Erőteljes, kötetlen nyomatékosító szerkezet, melynek jelentése: 'a very impressive/big'."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|point|0", "text": "hell of a → helluva"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|caution", "text": "Enyhén vulgáris — barátok között elfogadható, de szakmai vagy udvarias környezetben kerülendő."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|explain", "text": "A régi 'how do you do' üdvözlés történelmi összevonása, amely mára önálló, laza és barátságos köszöntéssé vált (különösen a déli US területén)."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|point|0", "text": "how do you do → howdy"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|caution", "text": "Kizárólag laza, barátságos üdvözlésként használható."}, {"key": "47538641-f573-4840-af35-02857a1d24de|explain", "text": "Az 'I suppose' kötetlen beszédben gyakran elhagyja a középső szótagját; enyhe bizonytalanság vagy vonakodó beleegyezés kifejezésére szolgál — elkülönítendő ettől: 'supposed to' → s'posed to."}, {"key": "47538641-f573-4840-af35-02857a1d24de|point|0", "text": "I suppose → I s'pose"}, {"key": "47538641-f573-4840-af35-02857a1d24de|caution", "text": "Kizárólag informális beszédben használatos — egyébként írd ki teljesen: 'I suppose'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|explain", "text": "Sajátítsd el a redukciókat 50 célzott gyakorlaton keresztül. Hallgasd meg figyelmesen az AI modellt, ismételd el, és vedd fel a hangodat, hogy részletes, valós idejű kiejtési értékelést és visszajelzést kapj."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|0", "text": "Fókuszálj az egyes gyakorlatokban kiemelt ritmusra, hangsúlyra és folyékonyságra."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|1", "text": "Minden felvételi kísérlet előtt hallgasd meg a mintahangot."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|2", "text": "Nézd át az AI-pontszámodat és a fonémaszintű visszajelzést a fejlesztendő területek pontos azonosításához."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|caution", "text": "Ne siess a gyakorlatokkal; helyezd előtérbe a tisztaságot, a természetes ritmust és a pontos artikulációt."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|0", "text": "A segédszavak erőteljes redukciója a természetes beszédritmus érdekében."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|1", "text": "'going to' -> 'gonna'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|2", "text": "A(z) 'have got to' 'gotta' alakra redukálódik."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|3", "text": "'want a' -> 'wanna'; 'of' -> 'a' /ə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|4", "text": "'has to' -> 'hasta' /hæstə/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|5", "text": "'let me' -> 'lemme'; 'you' -> 'ya'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|6", "text": "'give me' -> 'gimme'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|7", "text": "'could you' -> 'couldja' /kʊdʒə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|8", "text": "'would you' -> 'wouldja'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|9", "text": "'what did you' -> 'whaddya'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|10", "text": "'should have' -> 'shoulda' /ʃʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|11", "text": "'could have' -> 'coulda' /kʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|12", "text": "'would have' -> 'woulda' /wʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|13", "text": "'must have' -> 'musta' /mʌstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|14", "text": "'might have' -> 'mighta' /maɪtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|15", "text": "'used to' -> 'usta' /juːstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|16", "text": "'supposed to' -> 'sposta' /spoʊstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|17", "text": "'need to' -> 'needa'; 'to' -> /də/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|18", "text": "'to' -> /də/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|19", "text": "'kind of' -> 'kinda' /kaɪndə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|20", "text": "'sort of' -> 'sorta' /sɔːrtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|21", "text": "'lots of' -> 'lotsa' /lɒtsə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|22", "text": "'out of' -> 'outta' /aʊtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|23", "text": "'front of' -> 'fronta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|24", "text": "A(z) 'I am going to' az informális beszédben 'I'mma' alakra redukálódik."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|25", "text": "'don't you' -> 'doncha'; 'want to' -> 'wanna'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|26", "text": "'didn't you' -> 'didn'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|27", "text": "'haven't you' -> 'haven'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|28", "text": "Az 'and' szótagképző 'n' /n/ hanggá redukálódik."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|29", "text": "'day and night' -> 'day 'n night'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|30", "text": "Az 'or' /ər/ hanggá redukálódik; az 'it or' zökkenőmentes flap hanggal kapcsolódik össze."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|31", "text": "Az 'or' hangsúlytalan /ər/ hanggá redukálódik."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|32", "text": "Az 'and' zárhangok között /n/ hanggá redukálódik."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|33", "text": "A vonatkozó névmási 'that' svával /ðət/ alakra redukálódik."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|34", "text": "A kötőszói 'that' gyenge és rövid."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|35", "text": "A 'that' kiejtése /ðət/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|36", "text": "A 'them' az ''em' /əm/ alakra gyengül."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|37", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|38", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|39", "text": "'some' -> /səm/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|40", "text": "'for' -> /fər/; 'you' -> /jə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|41", "text": "'are' -> /ər/; 'you' -> /jə/; 'to' -> /tə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|42", "text": "A 'were' /wər/ alakra redukálódik."}]
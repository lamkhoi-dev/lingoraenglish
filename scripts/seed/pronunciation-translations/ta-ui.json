[{"key": "pron.hero.title", "text": "தெளிவாக, இயற்கையாக, சரளமாக பேசுங்கள்"}, {"key": "pron.hero.description", "text": "அனைத்து {{count}} ஆங்கில ஒலிகளும், சொல் அழுத்தம், வாக்கிய அழுத்தம், சுருதி, இணைந்த பேச்சு, சுருக்கங்கள், தாளம், தொகுத்தல் மற்றும் சரளம் — ஒவ்வொரு பாடமும் உங்கள் சொந்த பதிவுடன் முடிகிறது."}, {"key": "pron.imageAlt", "text": "உச்சரிப்பு & IPA"}, {"key": "pron.progress.title", "text": "உங்கள் உச்சரிப்பு முன்னேற்றம்"}, {"key": "pron.progress.descUser", "text": "உங்கள் சொந்த பதிவுகளில் பயிற்சியாளர் அடையாளம் கண்ட சொற்களிலிருந்து அளவிடப்படுகிறது."}, {"key": "pron.progress.descGuest", "text": "இலவச கணக்கை உருவாக்கி, உங்களை பதிவு செய்து முன்னேற்றத்தை கண்காணிக்கத் தொடங்குங்கள்."}, {"key": "pron.recommended", "text": "உங்களுக்கு பரிந்துரைக்கப்படுகிறது"}, {"key": "pron.soundLabel", "text": "{{symbol}} ஒலி"}, {"key": "pron.skill.sounds", "text": "ஒலிகள்"}, {"key": "pron.skill.sounds.blurb", "text": "அனைத்து 44 ஆங்கில ஒலியன்களும் குறைந்தபட்ச ஜோடிகளுடன்."}, {"key": "pron.skill.wordStress", "text": "சொல் அழுத்தம்"}, {"key": "pron.skill.wordStress.blurb", "text": "அசைகள், முதன்மை மற்றும் இரண்டாம் நிலை அழுத்தம்."}, {"key": "pron.skill.sentenceStress", "text": "வாக்கிய அழுத்தம்"}, {"key": "pron.skill.sentenceStress.blurb", "text": "பொருள் சொற்கள் வலிமையாக, செயல் சொற்கள் மெலிதாக."}, {"key": "pron.skill.intonation", "text": "சுருதி"}, {"key": "pron.skill.intonation.blurb", "text": "ஏற்றம், தாழ்வு, ஏற்ற-தாழ்வு மற்றும் தாழ்வ-ஏற்றம்."}, {"key": "pron.skill.connectedSpeech", "text": "இணைந்த பேச்சு"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "இணைப்பு, நீக்கம், ஒருமைப்படுத்தல், மெலிந்த வடிவங்கள்."}, {"key": "pron.skill.reductions", "text": "சுருக்கங்கள்"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — முறைசாரா பேச்சு ஆங்கிலம்."}, {"key": "pron.skill.rhythm", "text": "தாளம்"}, {"key": "pron.skill.rhythm.blurb", "text": "அழுத்த நேர துடிப்புகள், நேரம் மற்றும் இடைவேளைகள்."}, {"key": "pron.skill.chunking", "text": "இடைவேளை & தொகுத்தல்"}, {"key": "pron.skill.chunking.blurb", "text": "கருத்து குழுக்கள் மற்றும் இயற்கையான மூச்சு இடைவேளைகள்."}, {"key": "pron.skill.fluency", "text": "சரளம்"}, {"key": "pron.skill.fluency.blurb", "text": "வேகம், தயக்கம், நிரப்பிகள் மற்றும் கருத்துகளை இணைத்தல்."}, {"key": "pron.filter.searchPlaceholder", "text": "ஒலி, சொல் அல்லது பாடத்தை தேடுங்கள்"}, {"key": "pron.filter.allLevels", "text": "அனைத்து நிலைகள்"}, {"key": "pron.filter.beginner", "text": "தொடக்கநிலை"}, {"key": "pron.filter.intermediate", "text": "இடைநிலை"}, {"key": "pron.filter.advanced", "text": "மேல்நிலை"}, {"key": "pron.filter.allDifficulties", "text": "அனைத்து கடினத்தன்மைகள்"}, {"key": "pron.filter.gentle", "text": "எளிதான"}, {"key": "pron.filter.steady", "text": "நடுத்தர"}, {"key": "pron.filter.challenging", "text": "சவாலான"}, {"key": "pron.filter.us", "text": "அமெரிக்க ஆங்கிலம்"}, {"key": "pron.filter.uk", "text": "பிரிட்டிஷ் ஆங்கிலம்"}, {"key": "pron.sounds.title", "text": "{{count}} ஆங்கில ஒலிகள்"}, {"key": "pron.sounds.shown", "text": "{{count}} காட்டப்படுகிறது"}, {"key": "pron.lessons.title", "text": "{{skill}} பாடங்கள்"}, {"key": "pron.lessons.none", "text": "இந்த வடிகட்டிகளுக்கு எந்த பாடமும் பொருந்தவில்லை. \"அனைத்து நிலைகள்\" மற்றும் \"எந்த கடினத்தன்மையும்\" முயற்சிக்கவும்."}, {"key": "pron.how", "text": "எப்படி"}, {"key": "pron.commonMistakes", "text": "பொதுவான தவறுகள்"}, {"key": "pron.wordPractice", "text": "சொல் பயிற்சி"}, {"key": "pron.sentencePractice", "text": "வாக்கிய பயிற்சி"}, {"key": "pron.minimalPairs", "text": "குறைந்தபட்ச ஜோடிகள்"}, {"key": "pron.practise", "text": "பயிற்சி செய்"}, {"key": "pron.toast.signInModel", "text": "AI மாதிரி ஒலியைக் கேட்க உள்நுழையவும்."}, {"key": "pron.toast.playError", "text": "ஆடியோவை இயக்க முடியவில்லை."}, {"key": "pron.voicedDesc", "text": "குரல் உள்ள — உங்கள் குரல் நாண்கள் அதிர்கின்றன"}, {"key": "pron.voicelessDesc", "text": "குரல் இல்லாத — மூச்சு மட்டும், அதிர்வு இல்லை"}, {"key": "pron.soundPracticeHint", "text": "வலதுபுறம் உள்ள பயிற்சி அட்டையில் \"1. கேள்\" என்பதைத் தட்டி AI மாதிரி இந்த ஒலியையும் ஒரு உதாரணத்தையும் கேளுங்கள்."}, {"key": "pron.paywall.soundLocked", "text": "இந்த ஒலியின் முழு பாடம் — அதை எப்படி உருவாக்குவது, வாய் நிலை, உதாரண சொற்கள், வாக்கியங்கள் மற்றும் குறைந்தபட்ச ஜோடிகள் — Lingora English Premium-இன் ஒரு பகுதி."}, {"key": "pron.paywall.freeLimit", "text": "முதல் {{count}} ஒலிகள் இலவசம். அனைத்து 44 ஒலிகளையும் தனிப்பயனாக்கப்பட்ட பயிற்சியாளர் கருத்தையும் திறக்க மேம்படுத்துங்கள்."}, {"key": "pron.paywall.unlockAllSounds", "text": "அனைத்து 44 ஒலிகளையும் திறக்கவும்"}, {"key": "pron.wordPracticeHint", "text": "AI கேட்க & பயிற்சி செய்ய சொல்லை கிளிக் செய்யவும்"}, {"key": "pron.eg", "text": "எ.கா."}, {"key": "pron.playing", "text": "இயக்குகிறது"}, {"key": "pron.listen", "text": "கேள்"}, {"key": "pron.paywall.lessonLocked", "text": "இந்த பாடத்தின் விளக்கம், பயிற்சி புள்ளிகள் மற்றும் உதாரணங்கள் Lingora English Premium-இன் ஒரு பகுதி."}, {"key": "pron.paywall.lessonFreeLimit", "text": "ஒவ்வொரு திறமையின் முதல் {{count}} பாடங்கள் இலவசம். மீதமுள்ளவற்றைத் திறக்க மேம்படுத்துங்கள்."}, {"key": "pron.paywall.unlockAllLessons", "text": "அனைத்து பாடங்களையும் திறக்கவும்"}, {"key": "pron.itemPracticeHint", "text": "AI உடன் பயிற்சி செய்ய உருப்படியைக் கிளிக் செய்யவும்"}, {"key": "pron.practiceHint", "text": "கேளுங்கள், திரும்பச் சொல்லுங்கள், பதிவு செய்யுங்கள், ஒப்பிடுங்கள் — எந்த வார்த்தைகள் தெளிவாக வந்தன என்பதை பயிற்சியாளர் சரியாகக் காட்டுவார்."}, {"key": "pron.drillsCount", "text": "{{count}} பயிற்சிகள்"}, {"key": "pron.useInShadowing", "text": "இந்தத் திறமையை Shadowing இல் பயன்படுத்தவும்"}, {"key": "pron.backToCoach", "text": "பேச்சு பயிற்சியாளருக்குத் திரும்பு"}, {"key": "pron.p.title", "text": "பயிற்சி"}, {"key": "pron.p.step1.label", "text": "கேள்"}, {"key": "pron.p.step1.hint", "text": "மாதிரி ஒலியை இரண்டு முறை இயக்கவும்."}, {"key": "pron.p.step2.label", "text": "புரிந்துகொள்"}, {"key": "pron.p.step2.hint", "text": "உங்கள் வாய் என்ன செய்ய வேண்டும் என்பதைப் படியுங்கள்."}, {"key": "pron.p.step3.label", "text": "பார் / கற்றுக்கொள்"}, {"key": "pron.p.step3.hint", "text": "வாய், நாக்கு மற்றும் வடிவ வழிகாட்டியைப் பார்க்கவும்."}, {"key": "pron.p.step4.label", "text": "திரும்பச் சொல்"}, {"key": "pron.p.step4.hint", "text": "ஒலியுடன் சேர்ந்து சத்தமாகச் சொல்லுங்கள், முதலில் மெதுவாக."}, {"key": "pron.p.step5.label", "text": "பதிவு செய்"}, {"key": "pron.p.step5.hint", "text": "அதே வரியைச் சொல்லி உங்களைப் பதிவு செய்யுங்கள்."}, {"key": "pron.p.step6.label", "text": "AI கருத்து"}, {"key": "pron.p.step6.hint", "text": "பயிற்சியாளர் என்ன கேட்டார், என்ன சரிசெய்ய வேண்டும் என்பதைப் பாருங்கள்."}, {"key": "pron.p.step7.label", "text": "மீண்டும் முயற்சி"}, {"key": "pron.p.step7.hint", "text": "ஒன்றைச் சரிசெய்து மீண்டும் ஒருமுறை பதிவு செய்யுங்கள்."}, {"key": "pron.p.step8.label", "text": "தேர்ச்சி"}, {"key": "pron.p.step8.hint", "text": "தொடர்ச்சியாக இரண்டு முறை தெளிவாகப் படியுங்கள் — அடுத்ததற்குச் செல்லுங்கள்."}, {"key": "pron.p.stepTap", "text": "{{hint}} இதைச் செய்த பிறகு ஒருமுறை தட்டவும்."}, {"key": "pron.p.focusSound", "text": "கவன ஒலி {{sound}}"}, {"key": "pron.p.eg", "text": "எ.கா. {{sentence}}"}, {"key": "pron.p.loading", "text": "ஏற்றுகிறது…"}, {"key": "pron.p.speedNormal", "text": "இயல்பு"}, {"key": "pron.p.speedSlower", "text": "மெதுவாக"}, {"key": "pron.p.speedSlow", "text": "மிக மெதுவாக"}, {"key": "pron.p.loop", "text": "மீள்சுழற்சி"}, {"key": "pron.p.stop", "text": "நிறுத்து"}, {"key": "pron.p.voiceNote", "text": "மாதிரி ஒலி Lingora இன் அமெரிக்க ஆங்கில AI குரல், மனிதப் பதிவு அல்ல."}, {"key": "pron.p.listenSentence", "text": "கேள் என்பது ஒலியை இரண்டு முறை, பின்னர் எடுத்துக்காட்டு வார்த்தையை, பின்னர் அதைக் கொண்ட ஒரு வாக்கியத்தை இயக்கும்."}, {"key": "pron.p.listenExample", "text": "கேள் என்பது ஒலியை இரண்டு முறை, பின்னர் எடுத்துக்காட்டை இயக்கும்."}, {"key": "pron.p.recordHint", "text": "மேலே உள்ள வரியை ஒருமுறை தெளிவாகச் சொல்லுங்கள்."}, {"key": "pron.p.signupToRecord", "text": "பதிவு செய்து கருத்துப் பெற இலவச கணக்கை உருவாக்கவும்."}, {"key": "pron.p.yourRecording", "text": "உங்கள் பதிவு"}, {"key": "pron.p.listeningRec", "text": "உங்கள் பதிவைக் கேட்கிறது…"}, {"key": "pron.p.wordsClear", "text": "தெளிவாகச் சொன்ன வார்த்தைகள்"}, {"key": "pron.p.wpm", "text": "பேச்சு வேகம் (wpm)"}, {"key": "pron.p.heard", "text": "Lingora கேட்டது"}, {"key": "pron.p.tagClear", "text": "தெளிவு"}, {"key": "pron.p.tagNeeds", "text": "மேம்பாடு தேவை"}, {"key": "pron.p.measured", "text": "அளவிடப்பட்ட வழங்கல்"}, {"key": "pron.p.paceLabel", "text": "வேகம்:"}, {"key": "pron.p.paceValue", "text": "நிமிடத்திற்கு {{wpm}} வார்த்தைகள் ({{pace}})"}, {"key": "pron.p.paceNote", "text": "இயற்கையான உரையாடல் சுமார் 120–160."}, {"key": "pron.p.pace.slow", "text": "மெதுவான"}, {"key": "pron.p.pace.natural", "text": "இயற்கையான"}, {"key": "pron.p.pace.fast", "text": "வேகமான"}, {"key": "pron.p.fillersLabel", "text": "நிரப்பு வார்த்தைகள்:"}, {"key": "pron.p.repeatedLabel", "text": "மீண்டும் சொன்ன வார்த்தைகள்:"}, {"key": "pron.p.noneDetected", "text": "எதுவும் கண்டறியப்படவில்லை"}, {"key": "pron.p.measuredNote", "text": "வேகம், நிரப்பு வார்த்தைகள் மற்றும் மீள்சொல் ஆகியவை உங்கள் உண்மையான எழுத்துப்படி மற்றும் பதிவு நீளத்திலிருந்து கணக்கிடப்படுகின்றன. சுருதி, சத்தம் மற்றும் அமைதி இடைவெளி நீளம் அளவிடப்படுவதில்லை, எனவே சுருதி அல்லது இடைவெளிகளை தானாக மதிப்பிடுவதில்லை."}, {"key": "pron.p.mastered", "text": "தேர்ச்சி — இரண்டு தெளிவான முயற்சிகள்"}, {"key": "pron.p.attempt", "text": "முயற்சி {{n}} — தொடர்ச்சியாக இரண்டு தெளிவான வாசிப்புகள் இந்த வரியை தேர்ச்சி எனக் குறிக்கும்."}, {"key": "pron.p.toShadowing", "text": "இதை உண்மையான பேச்சில் பயிற்சி செய் → Shadowing"}, {"key": "pron.p.toCoach", "text": "பேச்சு பயிற்சியாளருடன் பயன்படுத்தவும்"}]
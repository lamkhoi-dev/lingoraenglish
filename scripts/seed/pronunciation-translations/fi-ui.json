[{"key": "pron.hero.title", "text": "Kuulosta selkeämmältä, luonnollisemmalta, sujuvammalta"}, {"key": "pron.hero.description", "text": "Kaikki {{count}} englannin äännettä sekä sanapaino, lausepaino, intonaatio, yhtenäinen puhe, redusoinnit, rytmi, jaksotus ja sujuvuus — jokainen oppitunti päättyy omaan äänitykseesi."}, {"key": "pron.imageAlt", "text": "Ääntäminen, artikulaatio ja IPA"}, {"key": "pron.progress.title", "text": "Ääntämisen edistymisesi"}, {"key": "pron.progress.descUser", "text": "Mitattu sanoista, jotka valmentaja tunnisti omista äänityksistäsi."}, {"key": "pron.progress.descGuest", "text": "Luo ilmainen tili, äänitä itsesi ja ala seurata edistymistä."}, {"key": "pron.recommended", "text": "Suositeltu sinulle"}, {"key": "pron.soundLabel", "text": "{{symbol}}-äänne"}, {"key": "pron.skill.sounds", "text": "Äänteet"}, {"key": "pron.skill.sounds.blurb", "text": "Kaikki 44 englannin foneemia minimipareineen."}, {"key": "pron.skill.wordStress", "text": "Sanapaino"}, {"key": "pron.skill.wordStress.blurb", "text": "Tavut, pää- ja sivupaino."}, {"key": "pron.skill.sentenceStress", "text": "Lausepaino"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Sisältösanat vahvoina, funktiosanat heikkoina."}, {"key": "pron.skill.intonation", "text": "Intonaatio"}, {"key": "pron.skill.intonation.blurb", "text": "Nouseva, laskeva, nouseva-laskeva ja laskeva-nouseva."}, {"key": "pron.skill.connectedSpeech", "text": "Yhtenäinen puhe"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Yhdistäminen, elisio, assimilaatio, heikot muodot."}, {"key": "pron.skill.reductions", "text": "Redusoinnit"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — epämuodollinen puhuttu englanti."}, {"key": "pron.skill.rhythm", "text": "Rytmi"}, {"key": "pron.skill.rhythm.blurb", "text": "Painotetut iskut, ajoitus ja tauot."}, {"key": "pron.skill.chunking", "text": "Tauotus ja jaksotus"}, {"key": "pron.skill.chunking.blurb", "text": "Ajatusryhmät ja luonnolliset hengitystauot."}, {"key": "pron.skill.fluency", "text": "Sujuvuus"}, {"key": "pron.skill.fluency.blurb", "text": "Nopeus, epäröinti, täytesanat ja ideoiden yhdistäminen."}, {"key": "pron.filter.searchPlaceholder", "text": "Etsi äänne, sana tai oppitunti"}, {"key": "pron.filter.allLevels", "text": "Kaikki tasot"}, {"key": "pron.filter.beginner", "text": "Aloittelija"}, {"key": "pron.filter.intermediate", "text": "Keskitaso"}, {"key": "pron.filter.advanced", "text": "Edistynyt"}, {"key": "pron.filter.allDifficulties", "text": "Kaikki vaikeustasot"}, {"key": "pron.filter.gentle", "text": "Helppo"}, {"key": "pron.filter.steady", "text": "Keskitaso"}, {"key": "pron.filter.challenging", "text": "Haastava"}, {"key": "pron.filter.us", "text": "Amerikanenglanti"}, {"key": "pron.filter.uk", "text": "Brittienglanti"}, {"key": "pron.sounds.title", "text": "Englannin {{count}} äännettä"}, {"key": "pron.sounds.shown", "text": "{{count}} näytetty"}, {"key": "pron.lessons.title", "text": "{{skill}}-oppitunnit"}, {"key": "pron.lessons.none", "text": "Yksikään oppitunti ei vastaa näitä suodattimia. Kokeile \"Kaikki tasot\" ja \"Kaikki vaikeustasot\"."}, {"key": "pron.how", "text": "Miten"}, {"key": "pron.commonMistakes", "text": "Yleiset virheet"}, {"key": "pron.wordPractice", "text": "Sanaharjoittelu"}, {"key": "pron.sentencePractice", "text": "Lauseharjoittelu"}, {"key": "pron.minimalPairs", "text": "Minimiparit"}, {"key": "pron.practise", "text": "Harjoittele"}, {"key": "pron.toast.signInModel", "text": "Kirjaudu sisään kuullaksesi tekoälymallin ääntämisen."}, {"key": "pron.toast.playError", "text": "Äänen toisto ei onnistunut."}, {"key": "pron.voicedDesc", "text": "Soinnillinen — äänihuulet värähtelevät"}, {"key": "pron.voicelessDesc", "text": "Soinniton — vain hengitys, ei värähtelyä"}, {"key": "pron.soundPracticeHint", "text": "Napauta \"1. Kuuntele\" oikealla olevassa harjoittelukortissa kuullaksesi tekoälymallin tämän äänteen ja esimerkin."}, {"key": "pron.paywall.soundLocked", "text": "Tämän äänteen täysi oppitunti — miten se muodostetaan, suun asento, esimerkkisanat, lauseet ja minimiparit — sisältyy Lingora English Premiumiin."}, {"key": "pron.paywall.freeLimit", "text": "Ensimmäiset {{count}} äännettä ovat ilmaisia. Päivitä avataksesi kaikki 44 äännettä ja henkilökohtaisen valmentajan palautteen."}, {"key": "pron.paywall.unlockAllSounds", "text": "Avaa kaikki 44 äännettä"}, {"key": "pron.wordPracticeHint", "text": "Napsauta sanaa kuullaksesi tekoälyn ja harjoitellaksesi"}, {"key": "pron.eg", "text": "esim."}, {"key": "pron.playing", "text": "Toistetaan"}, {"key": "pron.listen", "text": "Kuuntele"}, {"key": "pron.paywall.lessonLocked", "text": "Tämän oppitunnin selitys, harjoittelukohdat ja esimerkit sisältyvät Lingora English Premiumiin."}, {"key": "pron.paywall.lessonFreeLimit", "text": "Jokaisen taidon ensimmäiset {{count}} oppituntia ovat ilmaisia. Päivitä avataksesi loput."}, {"key": "pron.paywall.unlockAllLessons", "text": "Avaa kaikki oppitunnit"}, {"key": "pron.itemPracticeHint", "text": "Harjoittele tekoälyn kanssa napsauttamalla"}, {"key": "pron.practiceHint", "text": "Kuuntele, toista, tallenna ja vertaa — valmentaja näyttää tarkalleen, mitkä sanat tulivat selkeästi esiin."}, {"key": "pron.drillsCount", "text": "{{count}} harjoitusta"}, {"key": "pron.useInShadowing", "text": "Käytä tätä taitoa varjostuksessa"}, {"key": "pron.backToCoach", "text": "Takaisin puhevalmentajaan"}, {"key": "pron.p.title", "text": "Harjoittele"}, {"key": "pron.p.step1.label", "text": "Kuuntele"}, {"key": "pron.p.step1.hint", "text": "Toista mallinauha kahdesti."}, {"key": "pron.p.step2.label", "text": "Ymmärrä"}, {"key": "pron.p.step2.hint", "text": "Lue, mitä suusi pitäisi tehdä."}, {"key": "pron.p.step3.label", "text": "Katso / opi"}, {"key": "pron.p.step3.hint", "text": "Tarkista suun, kielen ja mallin opas."}, {"key": "pron.p.step4.label", "text": "Toista"}, {"key": "pron.p.step4.hint", "text": "Sano se ääneen nauhan mukana, aluksi hitaasti."}, {"key": "pron.p.step5.label", "text": "Tallenna"}, {"key": "pron.p.step5.hint", "text": "Tallenna itsesi sanomassa sama lause."}, {"key": "pron.p.step6.label", "text": "Tekoälyn palaute"}, {"key": "pron.p.step6.hint", "text": "Katso, mitä valmentaja kuuli ja mitä korjata."}, {"key": "pron.p.step7.label", "text": "Yritä uudelleen"}, {"key": "pron.p.step7.hint", "text": "Korjaa yksi asia ja tallenna vielä kerran."}, {"key": "pron.p.step8.label", "text": "Hallittu"}, {"key": "pron.p.step8.hint", "text": "Selkeä toisto kahdesti peräkkäin — jatka eteenpäin."}, {"key": "pron.p.stepTap", "text": "{{hint}} Napauta, kun olet tehnyt tämän."}, {"key": "pron.p.focusSound", "text": "Kohdeääni {{sound}}"}, {"key": "pron.p.eg", "text": "esim. {{sentence}}"}, {"key": "pron.p.loading", "text": "Ladataan…"}, {"key": "pron.p.speedNormal", "text": "Normaali"}, {"key": "pron.p.speedSlower", "text": "Hitaampi"}, {"key": "pron.p.speedSlow", "text": "Hidas"}, {"key": "pron.p.loop", "text": "Toista"}, {"key": "pron.p.stop", "text": "Pysäytä"}, {"key": "pron.p.voiceNote", "text": "Mallinauha on Lingoran amerikanenglannin tekoälyääni, ei ihmisen nauhoitus."}, {"key": "pron.p.listenSentence", "text": "Kuuntele toistaa äänen kahdesti, sitten esimerkkisanan ja lopuksi lauseen, jossa se esiintyy."}, {"key": "pron.p.listenExample", "text": "Kuuntele toistaa äänen kahdesti, sitten esimerkin."}, {"key": "pron.p.recordHint", "text": "Sano yllä oleva lause kerran selkeästi."}, {"key": "pron.p.signupToRecord", "text": "Luo ilmainen tili tallentaaksesi ja saadaksesi palautetta."}, {"key": "pron.p.yourRecording", "text": "Tallenteesi"}, {"key": "pron.p.listeningRec", "text": "Kuunnellaan tallennettasi…"}, {"key": "pron.p.wordsClear", "text": "Selkeästi sanotut sanat"}, {"key": "pron.p.wpm", "text": "Puhenopeus (sanaa/min)"}, {"key": "pron.p.heard", "text": "Lingora kuuli"}, {"key": "pron.p.tagClear", "text": "Selkeä"}, {"key": "pron.p.tagNeeds", "text": "Vaatii parannusta"}, {"key": "pron.p.measured", "text": "Mitattu esitys"}, {"key": "pron.p.paceLabel", "text": "Tahti:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} sanaa minuutissa ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Luonnollinen keskustelu on noin 120–160."}, {"key": "pron.p.pace.slow", "text": "hidas"}, {"key": "pron.p.pace.natural", "text": "luonnollinen"}, {"key": "pron.p.pace.fast", "text": "nopea"}, {"key": "pron.p.fillersLabel", "text": "Täytesanat:"}, {"key": "pron.p.repeatedLabel", "text": "Toistetut sanat:"}, {"key": "pron.p.noneDetected", "text": "ei havaittu"}, {"key": "pron.p.measuredNote", "text": "Tahti, täytesanat ja toisto lasketaan todellisesta litteroinnistasi ja tallenteen pituudesta. Sävelkorkeutta, äänenvoimakkuutta ja hiljaisten taukojen pituutta ei mitata, joten emme arvioi intonaatiota tai taukoja automaattisesti."}, {"key": "pron.p.mastered", "text": "Hallittu — kaksi selkeää yritystä"}, {"key": "pron.p.attempt", "text": "Yritys {{n}} — kaksi selkeää toistoa peräkkäin merkitsee tämän lauseen hallituksi."}, {"key": "pron.p.toShadowing", "text": "Harjoittele tätä oikeassa puheessa → Varjostus"}, {"key": "pron.p.toCoach", "text": "Käytä sitä puhevalmentajan kanssa"}]
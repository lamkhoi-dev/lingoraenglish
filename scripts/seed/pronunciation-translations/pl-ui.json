[{"key": "pron.hero.title", "text": "Mów wyraźniej, naturalniej, płynniej"}, {"key": "pron.hero.description", "text": "Wszystkie {{count}} dźwięki angielskie oraz akcent wyrazowy, akcent zdaniowy, intonacja, mowa łączona, redukcje, rytm, dzielenie na frazy i płynność — każda lekcja kończy się Twoim własnym nagraniem."}, {"key": "pron.imageAlt", "text": "Artykulacja i IPA wymowy"}, {"key": "pron.progress.title", "text": "Twój postęp w wymowie"}, {"key": "pron.progress.descUser", "text": "Mierzony na podstawie słów rozpoznanych przez coacha w Twoich nagraniach."}, {"key": "pron.progress.descGuest", "text": "Załóż darmowe konto, aby nagrywać się i śledzić postępy."}, {"key": "pron.recommended", "text": "Polecane dla Ciebie"}, {"key": "pron.soundLabel", "text": "Dźwięk {{symbol}}"}, {"key": "pron.skill.sounds", "text": "Dźwięki"}, {"key": "pron.skill.sounds.blurb", "text": "Wszystkie 44 fonemy angielskie z parami minimalnymi."}, {"key": "pron.skill.wordStress", "text": "Akcent wyrazowy"}, {"key": "pron.skill.wordStress.blurb", "text": "Sylaby, akcent główny i poboczny."}, {"key": "pron.skill.sentenceStress", "text": "Akcent zdaniowy"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Słowa treściowe mocno, funkcyjne słabo."}, {"key": "pron.skill.intonation", "text": "Intonacja"}, {"key": "pron.skill.intonation.blurb", "text": "Rosnąca, opadająca, rosnąco-opadająca i opadająco-rosnąca."}, {"key": "pron.skill.connectedSpeech", "text": "Mowa łączona"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Łączenie, elizja, asymilacja, formy słabe."}, {"key": "pron.skill.reductions", "text": "Redukcje"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — nieformalny mówiony angielski."}, {"key": "pron.skill.rhythm", "text": "Rytm"}, {"key": "pron.skill.rhythm.blurb", "text": "Takty akcentowe, wyczucie czasu i pauzy."}, {"key": "pron.skill.chunking", "text": "Pauzy i frazowanie"}, {"key": "pron.skill.chunking.blurb", "text": "Grupy myślowe i naturalne pauzy oddechowe."}, {"key": "pron.skill.fluency", "text": "Płynność"}, {"key": "pron.skill.fluency.blurb", "text": "Tempo, wahanie, wypełniacze i łączenie myśli."}, {"key": "pron.filter.searchPlaceholder", "text": "Szukaj dźwięku, słowa lub lekcji"}, {"key": "pron.filter.allLevels", "text": "Wszystkie poziomy"}, {"key": "pron.filter.beginner", "text": "Początkujący"}, {"key": "pron.filter.intermediate", "text": "Średniozaawansowany"}, {"key": "pron.filter.advanced", "text": "Zaawansowany"}, {"key": "pron.filter.allDifficulties", "text": "Wszystkie poziomy trudności"}, {"key": "pron.filter.gentle", "text": "Łatwy"}, {"key": "pron.filter.steady", "text": "Umiarkowany"}, {"key": "pron.filter.challenging", "text": "Wymagający"}, {"key": "pron.filter.us", "text": "Angielski amerykański"}, {"key": "pron.filter.uk", "text": "Angielski brytyjski"}, {"key": "pron.sounds.title", "text": "{{count}} dźwięków angielskich"}, {"key": "pron.sounds.shown", "text": "Wyświetlono {{count}}"}, {"key": "pron.lessons.title", "text": "Lekcje: {{skill}}"}, {"key": "pron.lessons.none", "text": "Żadna lekcja nie pasuje do tych filtrów. Spróbuj „Wszystkie poziomy” i „Wszystkie poziomy trudności”."}, {"key": "pron.how", "text": "Jak"}, {"key": "pron.commonMistakes", "text": "Częste błędy"}, {"key": "pron.wordPractice", "text": "Ćwiczenie słów"}, {"key": "pron.sentencePractice", "text": "Ćwiczenie zdań"}, {"key": "pron.minimalPairs", "text": "Pary minimalne"}, {"key": "pron.practise", "text": "Ćwicz"}, {"key": "pron.toast.signInModel", "text": "Zaloguj się, aby usłyszeć wzorzec AI."}, {"key": "pron.toast.playError", "text": "Nie udało się odtworzyć dźwięku."}, {"key": "pron.voicedDesc", "text": "Dźwięczny — więzadła głosowe drgają"}, {"key": "pron.voicelessDesc", "text": "Bezdźwięczny — tylko oddech, bez drgań"}, {"key": "pron.soundPracticeHint", "text": "Dotknij „1. Słuchaj” w karcie Ćwiczenie po prawej, aby usłyszeć wzorzec AI tego dźwięku i przykład."}, {"key": "pron.paywall.soundLocked", "text": "Pełna lekcja tego dźwięku — jak go wymówić, ułożenie ust, przykładowe słowa, zdania i pary minimalne — jest częścią Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "Pierwsze {{count}} dźwięków jest darmowych. Ulepsz plan, aby odblokować wszystkie 44 dźwięki i spersonalizowaną informację zwrotną od coacha."}, {"key": "pron.paywall.unlockAllSounds", "text": "Odblokuj wszystkie 44 dźwięki"}, {"key": "pron.wordPracticeHint", "text": "Kliknij słowo, aby usłyszeć AI i ćwiczyć"}, {"key": "pron.eg", "text": "np."}, {"key": "pron.playing", "text": "Odtwarzanie"}, {"key": "pron.listen", "text": "Słuchaj"}, {"key": "pron.paywall.lessonLocked", "text": "Wyjaśnienie, punkty ćwiczeniowe i przykłady tej lekcji są częścią Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "Pierwsze {{count}} lekcje każdej umiejętności są darmowe. Ulepsz, aby odblokować resztę."}, {"key": "pron.paywall.unlockAllLessons", "text": "Odblokuj wszystkie lekcje"}, {"key": "pron.itemPracticeHint", "text": "Kliknij element, aby ćwiczyć z AI"}, {"key": "pron.practiceHint", "text": "Słuchaj, powtarzaj, nagrywaj i porównuj — trener pokaże dokładnie, które słowa były wyraźne."}, {"key": "pron.drillsCount", "text": "{{count}} ćwiczeń"}, {"key": "pron.useInShadowing", "text": "Użyj tej umiejętności w Shadowingu"}, {"key": "pron.backToCoach", "text": "Powrót do Trenera Mówienia"}, {"key": "pron.p.title", "text": "Ćwiczenie"}, {"key": "pron.p.step1.label", "text": "Słuchaj"}, {"key": "pron.p.step1.hint", "text": "Odtwórz wzorcowe nagranie dwa razy."}, {"key": "pron.p.step2.label", "text": "Zrozum"}, {"key": "pron.p.step2.hint", "text": "Przeczytaj, co powinny robić Twoje usta."}, {"key": "pron.p.step3.label", "text": "Obejrzyj / naucz się"}, {"key": "pron.p.step3.hint", "text": "Sprawdź przewodnik po ustach, języku i wzorcu."}, {"key": "pron.p.step4.label", "text": "Powtórz"}, {"key": "pron.p.step4.hint", "text": "Powiedz to na głos razem z nagraniem, najpierw powoli."}, {"key": "pron.p.step5.label", "text": "Nagraj"}, {"key": "pron.p.step5.hint", "text": "Nagraj siebie mówiącego tę samą kwestię."}, {"key": "pron.p.step6.label", "text": "Informacja zwrotna AI"}, {"key": "pron.p.step6.hint", "text": "Zobacz, co usłyszał trener i co poprawić."}, {"key": "pron.p.step7.label", "text": "Spróbuj ponownie"}, {"key": "pron.p.step7.hint", "text": "Popraw jedną rzecz i nagraj jeszcze raz."}, {"key": "pron.p.step8.label", "text": "Opanowane"}, {"key": "pron.p.step8.hint", "text": "Dwa wyraźne odczyty z rzędu — przejdź dalej."}, {"key": "pron.p.stepTap", "text": "{{hint}} Dotknij, gdy to zrobisz."}, {"key": "pron.p.focusSound", "text": "Dźwięk docelowy {{sound}}"}, {"key": "pron.p.eg", "text": "np. {{sentence}}"}, {"key": "pron.p.loading", "text": "Ładowanie…"}, {"key": "pron.p.speedNormal", "text": "Normalna"}, {"key": "pron.p.speedSlower", "text": "Wolniejsza"}, {"key": "pron.p.speedSlow", "text": "Wolna"}, {"key": "pron.p.loop", "text": "Pętla"}, {"key": "pron.p.stop", "text": "Stop"}, {"key": "pron.p.voiceNote", "text": "Wzorcowe nagranie to amerykański głos AI Lingory, nie nagranie człowieka."}, {"key": "pron.p.listenSentence", "text": "Słuchaj odtwarza dźwięk dwa razy, potem przykładowe słowo, a następnie zdanie z nim."}, {"key": "pron.p.listenExample", "text": "Słuchaj odtwarza dźwięk dwa razy, potem przykład."}, {"key": "pron.p.recordHint", "text": "Powiedz powyższą kwestię raz, wyraźnie."}, {"key": "pron.p.signupToRecord", "text": "Załóż darmowe konto, aby nagrywać i otrzymywać informacje zwrotne."}, {"key": "pron.p.yourRecording", "text": "Twoje nagranie"}, {"key": "pron.p.listeningRec", "text": "Słuchanie Twojego nagrania…"}, {"key": "pron.p.wordsClear", "text": "Słowa wypowiedziane wyraźnie"}, {"key": "pron.p.wpm", "text": "Tempo mówienia (słowa/min)"}, {"key": "pron.p.heard", "text": "Lingora usłyszała"}, {"key": "pron.p.tagClear", "text": "Wyraźne"}, {"key": "pron.p.tagNeeds", "text": "Do poprawy"}, {"key": "pron.p.measured", "text": "Zmierzona wymowa"}, {"key": "pron.p.paceLabel", "text": "Tempo:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} słów na minutę ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Naturalna rozmowa to około 120–160."}, {"key": "pron.p.pace.slow", "text": "wolne"}, {"key": "pron.p.pace.natural", "text": "naturalne"}, {"key": "pron.p.pace.fast", "text": "szybkie"}, {"key": "pron.p.fillersLabel", "text": "Wypełniacze:"}, {"key": "pron.p.repeatedLabel", "text": "Powtórzone słowa:"}, {"key": "pron.p.noneDetected", "text": "nie wykryto"}, {"key": "pron.p.measuredNote", "text": "Tempo, wypełniacze i powtórzenia są liczone na podstawie Twojego rzeczywistego transkryptu i długości nagrania. Wysokość, głośność i długość cichych pauz nie są mierzone, więc nie oceniamy automatycznie intonacji ani pauz."}, {"key": "pron.p.mastered", "text": "Opanowane — dwie wyraźne próby"}, {"key": "pron.p.attempt", "text": "Próba {{n}} — dwa wyraźne odczyty z rzędu oznaczają tę kwestię jako opanowaną."}, {"key": "pron.p.toShadowing", "text": "Ćwicz to w prawdziwej mowie → Shadowing"}, {"key": "pron.p.toCoach", "text": "Użyj tego z Trenerem Mówienia"}]
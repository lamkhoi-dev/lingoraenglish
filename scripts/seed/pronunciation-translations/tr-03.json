[{"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|point|3", "text": "got to → gotta"}, {"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|caution", "text": "Bunlar gayri resmi konuşma biçimleridir. Makalelerde, e-postalarda veya resmi sınavlarda bunları yazmayın ve resmi bir sunumda bunlardan kaçının."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|explain", "text": "Filmlerde ve gerçek konuşmalarda sürekli duyacağınız daha günlük kısaltmalar."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|0", "text": "kind of → kinda"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|1", "text": "sort of → sorta"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|2", "text": "let me → lemme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|3", "text": "give me → gimme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|4", "text": "what do you → whaddaya"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|caution", "text": "Yalnızca gayri resmi. Bir IELTS veya iş görüşmesinde tam biçimleri kullanın."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|explain", "text": "Rahat konuşma İngilizcesinde yaygın olan daha fazla zorunluluk ve alışkanlık kısaltması."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|0", "text": "have to → hafta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|1", "text": "need to → needa"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|2", "text": "used to → useta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|caution", "text": "Yalnızca gayri resmi konuşma biçimleri — bunları asla yazmayın."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|explain", "text": "Geçmiş modal kısaltmaları — pişmanlıklar veya varsayımsal durumlar hakkında konuşurken çok yaygındır."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|0", "text": "could have → coulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|1", "text": "would have → woulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|2", "text": "should have → shoulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|caution", "text": "Yalnızca gayri resmi konuşma — resmi yazıda 'could have' ifadesini tam olarak yazın."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|explain", "text": "Şarkılarda, filmlerde ve arkadaşlar arasında rahat konuşmalarda yaygın olan çok günlük kısaltmalar."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|0", "text": "don't know → dunno"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|1", "text": "don't you → dontcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|2", "text": "what are you → whatcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|caution", "text": "Çok gayri resmi — yalnızca yakın arkadaşlarla, profesyonel veya sınav bağlamlarında asla."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|explain", "text": "Günlük konuşmada yaygın edat bağlantılı kısaltmalar."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|0", "text": "out of → outta"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|1", "text": "off of → offa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|2", "text": "cup of → cuppa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|caution", "text": "Yalnızca gayri resmi."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|explain", "text": "Yoğun kısaltma içeren günlük ünlemler ve günlük ifadeler."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|0", "text": "come on → c'mon"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|1", "text": "going to be → gonna be"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|2", "text": "some more → s'more"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|caution", "text": "Yalnızca gayri resmi."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|explain", "text": "Hızlı ve günlük konuşmada soru başlatıcıları büyük ölçüde kısalır."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|0", "text": "did you → dja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|1", "text": "do you → dya"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|2", "text": "would you → wouldja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|caution", "text": "Yalnızca günlük, konuşma bağlamları için."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|explain", "text": "Günlük konuşmada zaman ifadeleri de sıklıkla kısalır."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|0", "text": "a couple of → a couple"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|1", "text": "in a minute → in a min"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|caution", "text": "Günlük konuşmada uygun, yazıda değil."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|explain", "text": "Rahat konuşmada sürekli duyulan daha yaygın günlük kısaltmalar."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|0", "text": "probably → prolly"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|1", "text": "trying to → tryna"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|2", "text": "supposed to → s'posed to"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|caution", "text": "Yalnızca gayri resmi konuşma."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|explain", "text": "Arkadaşlar arasında ve Amerikan gayri resmi konuşmasında yaygın olan günlük kısaltmalar."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|0", "text": "let's go → less go"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|1", "text": "give it to me → gimme that"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|2", "text": "you all → y'all"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|caution", "text": "Çok gayri resmi — 'y'all' bölgeseldir (Güney ABD) ama geniş çapta anlaşılır. (US)"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|explain", "text": "Yuvarlak sayılar hızlı, günlük Amerikan konuşmasında ortadaki ünsüz seslerini kısaltır."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|0", "text": "twenty → twenny"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|1", "text": "hundred → hunnerd"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|caution", "text": "Yalnızca gayri resmi konuşma — resmi bağlamlarda her zaman tam biçimini söyleyin."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|explain", "text": "Hızlı ve rahat konuşmada düzenli olarak bir hece kaybeden farklı bir günlük kelime grubu."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|0", "text": "different → diff'rent"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|1", "text": "general → gen'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|2", "text": "several → sev'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|3", "text": "camera → cam'ra"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|caution", "text": "Günlük konuşmada uygundur; resmi sunumlarda tam biçimini net bir şekilde söyleyin."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|explain", "text": "Şarkılarda ve günlük Amerikan konuşmasında duyacağınız çok gayri resmi kısaltmalardır, ancak profesyonel ortamlarda asla kullanılmamalıdır."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|0", "text": "I'm going to → I'ma"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|1", "text": "kind of like → kinda like"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|caution", "text": "Son derece gayri resmi — yalnızca arkadaşlar/şarkı sözleri için, asla profesyonel bağlamlarda değil."}, {"key": "551b9527-f712-421d-966c-24644f360746|explain", "text": "what's up / how's it going dışındaki ek günlük selamlama kısaltmaları."}, {"key": "551b9527-f712-421d-966c-24644f360746|point|0", "text": "how are you → how ya doin'"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|1", "text": "good to see you → good to see ya"}, {"key": "551b9527-f712-421d-966c-24644f360746|caution", "text": "Yalnızca günlük konuşma biçimleri."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|explain", "text": "Rahat Amerikan konuşmasında yaygın olan daha fazla zorunluluk ve istek kısaltması."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|0", "text": "ought to → oughta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|1", "text": "don't have to → don't hafta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|2", "text": "want you → wantcha"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|caution", "text": "Yalnızca gayri resmi konuşma."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|explain", "text": "Bu, günlük Amerikan kısaltmasının ne kadar ileri gidebileceğinin klasik bir örneğidir — birkaç kelime tek bir kelime gibi duyulacak şekilde birbirine karışır."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|0", "text": "Did you eat yet? → Jeetyet?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|1", "text": "Did you already? → Jeetalready?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|caution", "text": "Son derece gayri resmi — hızlı ana dili konuşmasını tanımak için, kendi resmi konuşmanız için değil."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|explain", "text": "Günlük konuşmada iki yaygın ifade düzeyinde kısaltma daha."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|0", "text": "because of → 'cause of"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|1", "text": "sort of a → sorta a"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|caution", "text": "Yalnızca gayri resmi konuşma."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|explain", "text": "Rahat konuşma İngilizcesinde 'yes' ve 'no' için çok yaygın günlük alternatifler."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|0", "text": "yes → yep / uh-huh"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|1", "text": "no → nope / nah"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|caution", "text": "Yalnızca günlük konuşma — resmi veya sınav bağlamlarında 'yes'/'no' kullanın."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|explain", "text": "Her ikisi de kulağa benzer gelen 'wanna'ya indirgenir, ancak biri bir isimden sonra, diğeri bir fiilden sonra gelir — farkı fark etmeye değer."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|0", "text": "want a (coffee) → wanna coffee"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|1", "text": "want to (go) → wanna go"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|caution", "text": "Yalnızca gayri resmi konuşma dilinde."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|0", "text": "'want a' + isim → wanna"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|1", "text": "'want to' + fiil → wanna"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|explain", "text": "'would have' ifadesinin olumsuz hali de olumlu haliyle aynı şekilde kısalır."}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|point|0", "text": "wouldn't have → wouldn'ta"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|caution", "text": "Yalnızca gayri resmi konuşma dilinde — diğer durumlarda 'wouldn't have' şeklinde tam yazın."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|explain", "text": "Günlük açıklamalarda ve ricalarda sık kullanılan iki kısaltma daha."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|0", "text": "just because → just 'cause"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|1", "text": "going to need → gonna need"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|caution", "text": "Yalnızca gayri resmi konuşma dilinde."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|explain", "text": "'Ain't', çok gayri resmi konuşma dilinde am not/is not/are not/has not/have not yerine kullanılır ve şarkılarda ve günlük konuşmalarda her yerde duyulur."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|0", "text": "I am not → I ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|1", "text": "that is not → that ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|2", "text": "you have not → you ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|caution", "text": "Yazıda veya resmi konuşmada asla kullanmayın — gayri resmi olarak son derece yaygın olsa da standart dışı gramer kabul edilir."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|explain", "text": "'I understand' ya da kelimesi kelimesine 'caught you' demenin çok yaygın bir günlük yolu."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|0", "text": "got you (anladım) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|1", "text": "got you (yakaladım) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|caution", "text": "Yalnızca gayri resmi konuşma dilinde — profesyonel ortamlarda 'I understand' veya 'got it' deyin."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|explain", "text": "Geçmişe dair tahminler için kullanılan modal-perfect kısaltmaları; coulda/woulda/shoulda ile birlikte."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|0", "text": "must have → musta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|1", "text": "might have → mighta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|caution", "text": "Yalnızca gayri resmi konuşma dilinde — diğer durumlarda 'must have'/'might have' şeklinde tam yazın."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|explain", "text": "coulda/woulda/shoulda'nın olumsuz karşılıkları; pişmanlıklardan bahsederken yaygındır."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|0", "text": "shouldn't have → shouldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|1", "text": "couldn't have → couldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|caution", "text": "Yalnızca gayri resmi konuşma dilinde — resmi bağlamlarda 'shouldn't have'/'couldn't have' şeklinde tam yazın."}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|explain", "text": "Rahat konuşmada, sondaki -ing sesi genellikle 'g'sini düşürür ve -in' gibi duyulur. Bu, neredeyse tüm -ing fiillerinde görülür. (, so it sounds like -in)"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|0", "text": "doing → doin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|1", "text": "going → goin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|2", "text": "talking → talkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|3", "text": "thinking → thinkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|caution", "text": "Yalnızca günlük konuşmada — sunumlarda, mülakatlarda ve sınavlarda '-ing' ekini tam ve net telaffuz edin."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|explain", "text": "Aynı g-düşmesi kuralı -thing ile biten belgisiz zamirler için de geçerlidir."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|0", "text": "something → somethin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|1", "text": "nothing → nothin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|2", "text": "anything → anythin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|caution", "text": "Yalnızca günlük konuşmada."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|explain", "text": "'Them', bir fiilden sonra çok yaygın günlük konuşmada 'em biçimine indirgenir ('th' düşer)."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|0", "text": "tell them → tell 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|1", "text": "get them → get 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|2", "text": "ask them → ask 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|caution", "text": "Yalnızca resmî olmayan konuşmada — yazıda veya resmî konuşmada 'them' sözcüğünü tam olarak söyleyin."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|explain", "text": "'And', özellikle kalıplaşmış ifadelerde, birbirine sıkı bağlı iki sözcük arasında hızlı bir 'n' sesine indirgenir."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|0", "text": "rock and roll → rock 'n' roll"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|1", "text": "fish and chips → fish 'n' chips"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|2", "text": "back and forth → back 'n' forth"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|caution", "text": "Kalıplaşmış ifadelerde ve hızlı konuşmada yaygın — resmî yazıda 'and' sözcüğünü net biçimde yazın."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|explain", "text": "'Because' (yalnızca 'because of' değil), günlük yanıtlarda sıklıkla 'cause biçimine kısalır."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|point|0", "text": "because → 'cause"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|caution", "text": "Yalnızca resmî olmayan konuşmada — diğer durumlarda 'because' sözcüğünü tam olarak yazın."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|explain", "text": "'Of course', hızlı ve günlük yanıtlarda genellikle ilk sözcüğünü düşürür."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|point|0", "text": "of course → 'course"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|caution", "text": "Yalnızca günlük konuşmada."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|explain", "text": "'All right' sözcüğünün, onaylamak veya kabul etmek için kullanılan çok yaygın günlük telaffuzu. (all right)"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|point|0", "text": "all right → aight"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|caution", "text": "Çok resmî olmayan — profesyonel bağlamlarda 'all right' veya 'okay' deyin."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|explain", "text": "'Let you', 'want you'/'wantcha' ile aynı şekilde indirgenir."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|point|0", "text": "let you → letcha"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|caution", "text": "Yalnızca gayri resmi konuşma dilinde."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|explain", "text": "'jeetyet' ile benzer bir başka aşırı hızlı konuşma birleşmesi — birkaç kelime tek bir sese sıkışır."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|point|0", "text": "did you ever → jever"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|caution", "text": "Hızlı ana dili konuşmasını tanımak için, kendi resmi konuşmanız için değil."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|explain", "text": "'going to' ve 'have to' yan yana geldiğinde iki kısaltma üst üste binin."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|point|0", "text": "going to have to → gonna hafta"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|caution", "text": "Yalnızca gayri resmi konuşma dilinde — aksi halde 'going to have to' şeklinde tam yazın."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|explain", "text": "'gonna' kısaltması olumsuz ve geçmiş zamanda da geçerlidir."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|0", "text": "not going to → not gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|1", "text": "wasn't going to → wasn't gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|caution", "text": "Yalnızca gayri resmi konuşma dilinde."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|explain", "text": "Onaylamak veya vurgu katmak için kullanılan çok yaygın bir İngiliz İngilizcesi eklenti soru kısaltması."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|point|0", "text": "isn't it → innit"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|caution", "text": "Çok gayri resmi İngiliz argosu — Birleşik Krallık'ta bile resmi konuşmada kullanmayın. (UK)"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|explain", "text": "Bir şey önermenin veya onay istemenin rahat bir yolu."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|point|0", "text": "what do you say → whaddya say"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|caution", "text": "Yalnızca gayri resmi konuşma dilinde."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|explain", "text": "Günlük konuşma İngilizcesinde son derece yaygın bir dolgu ifadesi; düşünürken veya vurgu için kullanılır."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|point|0", "text": "you know → y'know"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|caution", "text": "Yalnızca günlük dolgu ifadesi — aşırı kullanımı gayri resmi ortamda bile özensiz kulağa gelir."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|explain", "text": "'what's up' ifadesinden kısaltılmış çok rahat bir selamlama."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|point|0", "text": "what's up → s'up"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|caution", "text": "Yalnızca arkadaşlar arasında kullanılan çok gayri resmi bir selamlama."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|explain", "text": "'Him' ve 'her' de günlük konuşmada zayıflar; tıpkı 'them' → 'em gibi."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|0", "text": "tell him → tell 'im"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|1", "text": "ask her → ask 'er"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|caution", "text": "Yalnızca gayri resmi konuşma dilinde."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|explain", "text": "'Kinda' ve 'sorta' çok rahat konuşmada ekstra belirsizlik için sıklıkla birleştirilir."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|point|0", "text": "kind of sort of → kinda sorta"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|caution", "text": "Çok gayri resmi — profesyonel veya sınav bağlamında kaçının."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|explain", "text": "dja ve wouldja ile birlikte bir başka hızlı konuşma soru başlatıcı birleşmesi."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|point|0", "text": "didn't you → dincha"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|caution", "text": "Hızlı ana dili konuşmasını tanımak için, kendi resmi konuşmanız için değil."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|explain", "text": "'have to' yapısının geçmiş zaman biçimi, şimdiki zaman biçimiyle aynı şekilde kısalır."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|point|0", "text": "had to → hadta"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|caution", "text": "Yalnızca gayri resmi konuşma dili."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|explain", "text": "wouldja ve couldja tarzı biçimlerle birlikte, gayri resmi ricalarda kullanılan günlük bir kısaltma."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|point|0", "text": "will you → willcha"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|caution", "text": "Yalnızca gayri resmi konuşma dili."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|explain", "text": "'of' içeren miktar ifadeleri, 'cuppa' içindeki 'cup of' ile aynı şekilde kısalır."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|0", "text": "lots of → lotsa"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|1", "text": "bunch of → buncha"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|caution", "text": "Yalnızca gayri resmi konuşma dili."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|explain", "text": "'Çok etkileyici/büyük' anlamına gelen güçlü, gayri resmi bir pekiştirici. (a very impressive/big)"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|point|0", "text": "hell of a → helluva"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|caution", "text": "Hafif kaba — arkadaşlar arasında uygun, profesyonel veya kibar ortamlarda kaçının."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|explain", "text": "Eski 'how do you do' selamlamasının tarihsel bir kısaltması; artık kendi başına günlük, samimi bir selamlama (özellikle Güney ABD'de). (US)"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|point|0", "text": "how do you do → howdy"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|caution", "text": "Yalnızca günlük, samimi selamlama."}, {"key": "47538641-f573-4840-af35-02857a1d24de|explain", "text": "'I suppose' günlük konuşmada genellikle ortadaki hecesini düşürür; hafif belirsizliği veya isteksiz kabulü ifade etmek için kullanılır — 'supposed to' → s'posed to yapısından farklıdır."}, {"key": "47538641-f573-4840-af35-02857a1d24de|point|0", "text": "I suppose → I s'pose"}, {"key": "47538641-f573-4840-af35-02857a1d24de|caution", "text": "Yalnızca gayri resmi konuşma dili — diğer durumlarda tam olarak 'I suppose' yazın."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|explain", "text": "50 hedefli alıştırmada kısaltmalarda ustalaşın. AI modelini dikkatle dinleyin, tekrarlayın ve sesinizi kaydederek ayrıntılı gerçek zamanlı telaffuz puanı ve geri bildirim alın."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|0", "text": "Her alıştırmada vurgulanan ritim, vurgu ve akışa odaklanın."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|1", "text": "Her kayıt denemesinden önce referans model sesini dinleyin."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|2", "text": "Geliştirilecek alanları belirlemek için AI puanınızı ve fonem düzeyindeki geri bildirimi inceleyin."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|caution", "text": "Alıştırmaları aceleyle geçmeyin; netliğe, doğal akışa ve doğru artikülasyona öncelik verin."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|0", "text": "Yardımcı kelimelerin doğal akışa aşırı kısaltılması."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|1", "text": "'going to' -> 'gonna'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|2", "text": "'have got to' 'gotta' olarak kısalır."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|3", "text": "'want a' -> 'wanna'; 'of' -> 'a' /ə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|4", "text": "'has to' -> 'hasta' /hæstə/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|5", "text": "'let me' -> 'lemme'; 'you' -> 'ya'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|6", "text": "'give me' -> 'gimme'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|7", "text": "'could you' -> 'couldja' /kʊdʒə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|8", "text": "'would you' -> 'wouldja'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|9", "text": "'what did you' -> 'whaddya'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|10", "text": "'should have' -> 'shoulda' /ʃʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|11", "text": "'could have' -> 'coulda' /kʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|12", "text": "'would have' -> 'woulda' /wʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|13", "text": "'must have' -> 'musta' /mʌstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|14", "text": "'might have' -> 'mighta' /maɪtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|15", "text": "'used to' -> 'usta' /juːstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|16", "text": "'supposed to' -> 'sposta' /spoʊstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|17", "text": "'need to' -> 'needa'; 'to' -> /də/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|18", "text": "'to' -> /də/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|19", "text": "'kind of' -> 'kinda' /kaɪndə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|20", "text": "'sort of' -> 'sorta' /sɔːrtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|21", "text": "'lots of' -> 'lotsa' /lɒtsə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|22", "text": "'out of' -> 'outta' /aʊtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|23", "text": "'front of' -> 'fronta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|24", "text": "'I am going to' günlük konuşmada 'I'mma' şeklinde kısalır."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|25", "text": "'don't you' -> 'doncha'; 'want to' -> 'wanna'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|26", "text": "'didn't you' -> 'didn'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|27", "text": "'haven't you' -> 'haven'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|28", "text": "'and' hece oluşturan 'n' /n/ sesine indirgenir."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|29", "text": "'day and night' -> 'day 'n night'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|30", "text": "'or' /ər/ sesine indirgenir; 'it or' akıcı biçimde flap sesiyle bağlanır."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|31", "text": "'or' vurgusuz /ər/ sesine indirgenir."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|32", "text": "'and' patlamalı sesler arasında /n/ sesine indirgenir."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|33", "text": "İlgi zamiri 'that', schwa ile /ðət/ şeklinde zayıflar."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|34", "text": "Bağlaç 'that' zayıf ve kısadır."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|35", "text": "'that' /ðət/ şeklini alır."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|36", "text": "'them', ''em' /əm/ şeklinde zayıflar."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|37", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|38", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|39", "text": "'some' -> /səm/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|40", "text": "'for' -> /fər/; 'you' -> /jə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|41", "text": "'are' -> /ər/; 'you' -> /jə/; 'to' -> /tə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|42", "text": "'were' /wər/ şeklinde zayıflar."}]
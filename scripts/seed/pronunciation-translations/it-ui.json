[{"key": "pron.hero.title", "text": "Parla in modo più chiaro, naturale e scorrevole"}, {"key": "pron.hero.description", "text": "Tutti i {{count}} suoni inglesi più accento di parola, accento di frase, intonazione, connected speech, riduzioni, ritmo, chunking e fluidità — ogni lezione termina con la tua registrazione."}, {"key": "pron.imageAlt", "text": "Articolazione e IPA della pronuncia"}, {"key": "pron.progress.title", "text": "I tuoi progressi di pronuncia"}, {"key": "pron.progress.descUser", "text": "Misurati dalle parole che il coach ha riconosciuto nelle tue registrazioni."}, {"key": "pron.progress.descGuest", "text": "Crea un account gratuito per registrarti e iniziare a monitorare i progressi."}, {"key": "pron.recommended", "text": "Consigliato per te"}, {"key": "pron.soundLabel", "text": "Suono {{symbol}}"}, {"key": "pron.skill.sounds", "text": "Suoni"}, {"key": "pron.skill.sounds.blurb", "text": "Tutti i 44 fonemi inglesi con coppie minime."}, {"key": "pron.skill.wordStress", "text": "Accento di parola"}, {"key": "pron.skill.wordStress.blurb", "text": "Sillabe, accento primario e secondario."}, {"key": "pron.skill.sentenceStress", "text": "Accento di frase"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Parole di contenuto forti, parole funzionali deboli."}, {"key": "pron.skill.intonation", "text": "Intonazione"}, {"key": "pron.skill.intonation.blurb", "text": "Ascendente, discendente, ascendente-discendente e discendente-ascendente."}, {"key": "pron.skill.connectedSpeech", "text": "Connected speech"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Collegamento, elisione, assimilazione, forme deboli."}, {"key": "pron.skill.reductions", "text": "Riduzioni"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — inglese parlato informale."}, {"key": "pron.skill.rhythm", "text": "Ritmo"}, {"key": "pron.skill.rhythm.blurb", "text": "Battute a isocronia accentuale, timing e pause."}, {"key": "pron.skill.chunking", "text": "Pause e chunking"}, {"key": "pron.skill.chunking.blurb", "text": "Gruppi di pensiero e pause naturali per respirare."}, {"key": "pron.skill.fluency", "text": "Fluidità"}, {"key": "pron.skill.fluency.blurb", "text": "Velocità, esitazione, riempitivi e collegamento di idee."}, {"key": "pron.filter.searchPlaceholder", "text": "Cerca un suono, una parola o una lezione"}, {"key": "pron.filter.allLevels", "text": "Tutti i livelli"}, {"key": "pron.filter.beginner", "text": "Principiante"}, {"key": "pron.filter.intermediate", "text": "Intermedio"}, {"key": "pron.filter.advanced", "text": "Avanzato"}, {"key": "pron.filter.allDifficulties", "text": "Tutte le difficoltà"}, {"key": "pron.filter.gentle", "text": "Facile"}, {"key": "pron.filter.steady", "text": "Moderata"}, {"key": "pron.filter.challenging", "text": "Impegnativa"}, {"key": "pron.filter.us", "text": "Inglese US"}, {"key": "pron.filter.uk", "text": "Inglese UK"}, {"key": "pron.sounds.title", "text": "I {{count}} suoni inglesi"}, {"key": "pron.sounds.shown", "text": "{{count}} mostrati"}, {"key": "pron.lessons.title", "text": "Lezioni di {{skill}}"}, {"key": "pron.lessons.none", "text": "Nessuna lezione corrisponde a questi filtri. Prova \"Tutti i livelli\" e \"Tutte le difficoltà\"."}, {"key": "pron.how", "text": "Come"}, {"key": "pron.commonMistakes", "text": "Errori comuni"}, {"key": "pron.wordPractice", "text": "Pratica con le parole"}, {"key": "pron.sentencePractice", "text": "Pratica con le frasi"}, {"key": "pron.minimalPairs", "text": "Coppie minime"}, {"key": "pron.practise", "text": "Esercitati"}, {"key": "pron.toast.signInModel", "text": "Accedi per ascoltare il suono del modello AI."}, {"key": "pron.toast.playError", "text": "Impossibile riprodurre l'audio."}, {"key": "pron.voicedDesc", "text": "Sonoro — le corde vocali vibrano"}, {"key": "pron.voicelessDesc", "text": "Sordo — solo respiro, nessuna vibrazione"}, {"key": "pron.soundPracticeHint", "text": "Tocca \"1. Ascolta\" nella scheda Pratica a destra per sentire il modello AI di questo suono e un esempio."}, {"key": "pron.paywall.soundLocked", "text": "La lezione completa di questo suono — come produrlo, posizione della bocca, parole di esempio, frasi e coppie minime — fa parte di Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "I primi {{count}} suoni sono gratuiti. Passa a Premium per sbloccare tutti i 44 suoni e il feedback personalizzato del coach."}, {"key": "pron.paywall.unlockAllSounds", "text": "Sblocca tutti i 44 suoni"}, {"key": "pron.wordPracticeHint", "text": "Clicca sulla parola per ascoltare l'AI ed esercitarti"}, {"key": "pron.eg", "text": "es."}, {"key": "pron.playing", "text": "In riproduzione"}, {"key": "pron.listen", "text": "Ascolta"}, {"key": "pron.paywall.lessonLocked", "text": "La spiegazione, i punti di pratica e gli esempi di questa lezione fanno parte di Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "Le prime {{count}} lezioni di ogni abilità sono gratuite. Passa a Premium per sbloccare le altre."}, {"key": "pron.paywall.unlockAllLessons", "text": "Sblocca tutte le lezioni"}, {"key": "pron.itemPracticeHint", "text": "Tocca l'elemento per esercitarti con l'AI"}, {"key": "pron.practiceHint", "text": "Ascolta, ripeti, registra e confronta — il coach mostra esattamente quali parole sono state pronunciate chiaramente."}, {"key": "pron.drillsCount", "text": "{{count}} esercizi"}, {"key": "pron.useInShadowing", "text": "Usa questa abilità in Shadowing"}, {"key": "pron.backToCoach", "text": "Torna al Speaking Coach"}, {"key": "pron.p.title", "text": "Pratica"}, {"key": "pron.p.step1.label", "text": "Ascolta"}, {"key": "pron.p.step1.hint", "text": "Riproduci l'audio modello due volte."}, {"key": "pron.p.step2.label", "text": "Comprendi"}, {"key": "pron.p.step2.hint", "text": "Leggi cosa deve fare la tua bocca."}, {"key": "pron.p.step3.label", "text": "Guarda / impara"}, {"key": "pron.p.step3.hint", "text": "Controlla la guida su bocca, lingua e schema."}, {"key": "pron.p.step4.label", "text": "Ripeti"}, {"key": "pron.p.step4.hint", "text": "Dillo ad alta voce con l'audio, prima lentamente."}, {"key": "pron.p.step5.label", "text": "Registra"}, {"key": "pron.p.step5.hint", "text": "Registrati mentre dici la stessa frase."}, {"key": "pron.p.step6.label", "text": "Feedback AI"}, {"key": "pron.p.step6.hint", "text": "Scopri cosa ha sentito il coach e cosa correggere."}, {"key": "pron.p.step7.label", "text": "Riprova"}, {"key": "pron.p.step7.hint", "text": "Correggi una cosa e registra ancora una volta."}, {"key": "pron.p.step8.label", "text": "Padroneggiato"}, {"key": "pron.p.step8.hint", "text": "Lettura chiara due volte di fila — vai avanti."}, {"key": "pron.p.stepTap", "text": "{{hint}} Tocca quando l'hai fatto."}, {"key": "pron.p.focusSound", "text": "Suono focus {{sound}}"}, {"key": "pron.p.eg", "text": "es. {{sentence}}"}, {"key": "pron.p.loading", "text": "Caricamento…"}, {"key": "pron.p.speedNormal", "text": "Normale"}, {"key": "pron.p.speedSlower", "text": "Più lento"}, {"key": "pron.p.speedSlow", "text": "Lento"}, {"key": "pron.p.loop", "text": "Ripeti"}, {"key": "pron.p.stop", "text": "Ferma"}, {"key": "pron.p.voiceNote", "text": "L'audio modello è la voce AI di Lingora in inglese americano, non una registrazione umana."}, {"key": "pron.p.listenSentence", "text": "Ascolta riproduce il suono due volte, poi la parola di esempio, poi una frase che lo contiene."}, {"key": "pron.p.listenExample", "text": "Ascolta riproduce il suono due volte, poi l'esempio."}, {"key": "pron.p.recordHint", "text": "Di' la frase qui sopra una volta, chiaramente."}, {"key": "pron.p.signupToRecord", "text": "Crea un account gratuito per registrare e ricevere feedback."}, {"key": "pron.p.yourRecording", "text": "La tua registrazione"}, {"key": "pron.p.listeningRec", "text": "Ascolto della tua registrazione…"}, {"key": "pron.p.wordsClear", "text": "Parole dette chiaramente"}, {"key": "pron.p.wpm", "text": "Velocità di parlato (wpm)"}, {"key": "pron.p.heard", "text": "Lingora ha sentito"}, {"key": "pron.p.tagClear", "text": "Chiaro"}, {"key": "pron.p.tagNeeds", "text": "Da migliorare"}, {"key": "pron.p.measured", "text": "Esposizione misurata"}, {"key": "pron.p.paceLabel", "text": "Ritmo:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} parole al minuto ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Una conversazione naturale è circa 120–160."}, {"key": "pron.p.pace.slow", "text": "lento"}, {"key": "pron.p.pace.natural", "text": "naturale"}, {"key": "pron.p.pace.fast", "text": "veloce"}, {"key": "pron.p.fillersLabel", "text": "Riempitivi:"}, {"key": "pron.p.repeatedLabel", "text": "Parole ripetute:"}, {"key": "pron.p.noneDetected", "text": "nessuno rilevato"}, {"key": "pron.p.measuredNote", "text": "Ritmo, riempitivi e ripetizioni sono calcolati dalla tua trascrizione reale e dalla durata della registrazione. Tono, volume e durata delle pause silenziose non sono misurati, quindi non valutiamo automaticamente intonazione o pause."}, {"key": "pron.p.mastered", "text": "Padroneggiato — due tentativi chiari"}, {"key": "pron.p.attempt", "text": "Tentativo {{n}} — due letture chiare di fila marcano questa frase come padroneggiata."}, {"key": "pron.p.toShadowing", "text": "Esercitati nel parlato reale → Shadowing"}, {"key": "pron.p.toCoach", "text": "Usalo con il Speaking Coach"}]
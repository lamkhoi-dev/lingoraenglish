[{"key": "pron.hero.title", "text": "स्पष्ट, स्वाभाविक र प्रवाहमय उच्चारण"}, {"key": "pron.hero.description", "text": "सबै {{count}} अंग्रेजी ध्वनिहरू साथै शब्द बल, वाक्य बल, स्वर-उतार-चढ़ाव, जोडिएको बोली, संक्षेपण, लय, खण्डीकरण र प्रवाह — हरेक पाठ तपाईंको आफ्नै रेकर्डिङमा टुंगिन्छ।"}, {"key": "pron.imageAlt", "text": "उच्चारण अंग-विन्यास र IPA"}, {"key": "pron.progress.title", "text": "तपाईंको उच्चारण प्रगति"}, {"key": "pron.progress.descUser", "text": "कोचले तपाईंको आफ्नै रेकर्डिङमा चिनेका शब्दहरूबाट मापन गरिएको।"}, {"key": "pron.progress.descGuest", "text": "आफ्नो आवाज रेकर्ड गर्न र प्रगति ट्र्याक गर्न निःशुल्क खाता बनाउनुहोस्।"}, {"key": "pron.recommended", "text": "तपाईंको लागि सिफारिस गरिएको"}, {"key": "pron.soundLabel", "text": "{{symbol}} ध्वनि"}, {"key": "pron.skill.sounds", "text": "ध्वनिहरू"}, {"key": "pron.skill.sounds.blurb", "text": "सबै ४४ अंग्रेजी स्वनिमहरू न्यूनतम जोडीहरूसहित।"}, {"key": "pron.skill.wordStress", "text": "शब्द बल"}, {"key": "pron.skill.wordStress.blurb", "text": "अक्षरहरू, प्राथमिक र द्वितीयक बल।"}, {"key": "pron.skill.sentenceStress", "text": "वाक्य बल"}, {"key": "pron.skill.sentenceStress.blurb", "text": "सार्थक शब्दहरू बलियो, सहायक शब्दहरू कमजोर।"}, {"key": "pron.skill.intonation", "text": "स्वर-उतार-चढ़ाव"}, {"key": "pron.skill.intonation.blurb", "text": "उठ्ने, झर्ने, उठ-झर्ने र झर-उठ्ने।"}, {"key": "pron.skill.connectedSpeech", "text": "जोडिएको बोली"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "जोड्ने, लोप, समीकरण, कमजोर रूपहरू।"}, {"key": "pron.skill.reductions", "text": "संक्षेपण"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — अनौपचारिक बोलचालको अंग्रेजी।"}, {"key": "pron.skill.rhythm", "text": "लय"}, {"key": "pron.skill.rhythm.blurb", "text": "बल-समयबद्ध ताल, समय र विराम।"}, {"key": "pron.skill.chunking", "text": "विराम र खण्डीकरण"}, {"key": "pron.skill.chunking.blurb", "text": "विचार समूहहरू र स्वाभाविक श्वास विरामहरू।"}, {"key": "pron.skill.fluency", "text": "प्रवाह"}, {"key": "pron.skill.fluency.blurb", "text": "गति, हिचकिचाहट, भरण शब्दहरू र विचार जोड्ने।"}, {"key": "pron.filter.searchPlaceholder", "text": "ध्वनि, शब्द वा पाठ खोज्नुहोस्"}, {"key": "pron.filter.allLevels", "text": "सबै स्तरहरू"}, {"key": "pron.filter.beginner", "text": "शुरुवाती"}, {"key": "pron.filter.intermediate", "text": "मध्यम"}, {"key": "pron.filter.advanced", "text": "उच्च"}, {"key": "pron.filter.allDifficulties", "text": "सबै कठिनाइहरू"}, {"key": "pron.filter.gentle", "text": "सजिलो"}, {"key": "pron.filter.steady", "text": "मध्यम"}, {"key": "pron.filter.challenging", "text": "चुनौतीपूर्ण"}, {"key": "pron.filter.us", "text": "अमेरिकी अंग्रेजी"}, {"key": "pron.filter.uk", "text": "ब्रिटिश अंग्रेजी"}, {"key": "pron.sounds.title", "text": "{{count}} अंग्रेजी ध्वनिहरू"}, {"key": "pron.sounds.shown", "text": "{{count}} देखाइएको"}, {"key": "pron.lessons.title", "text": "{{skill}} पाठहरू"}, {"key": "pron.lessons.none", "text": "यी फिल्टरहरूसँग कुनै पाठ मेल खाँदैन। \"सबै स्तरहरू\" र \"कुनै पनि कठिनाइ\" प्रयास गर्नुहोस्।"}, {"key": "pron.how", "text": "कसरी"}, {"key": "pron.commonMistakes", "text": "सामान्य गल्तीहरू"}, {"key": "pron.wordPractice", "text": "शब्द अभ्यास"}, {"key": "pron.sentencePractice", "text": "वाक्य अभ्यास"}, {"key": "pron.minimalPairs", "text": "न्यूनतम जोडीहरू"}, {"key": "pron.practise", "text": "अभ्यास गर्नुहोस्"}, {"key": "pron.toast.signInModel", "text": "AI मोडेलको आवाज सुन्न साइन इन गर्नुहोस्।"}, {"key": "pron.toast.playError", "text": "अडियो बजाउन सकिएन।"}, {"key": "pron.voicedDesc", "text": "घोष — तपाईंको स्वर तारहरू कम्पन हुन्छन्"}, {"key": "pron.voicelessDesc", "text": "अघोष — केवल श्वास, कुनै कम्पन छैन"}, {"key": "pron.soundPracticeHint", "text": "दायाँको अभ्यास कार्डमा \"१. सुन्नुहोस्\" ट्याप गर्नुहोस् यो ध्वनि र एउटा उदाहरणको AI मोडेल सुन्न।"}, {"key": "pron.paywall.soundLocked", "text": "यो ध्वनिको पूर्ण पाठ — यसलाई कसरी बनाउने, मुखको स्थिति, उदाहरण शब्दहरू, वाक्यहरू र न्यूनतम जोडीहरू — Lingora English Premium को हिस्सा हो।"}, {"key": "pron.paywall.freeLimit", "text": "पहिलो {{count}} ध्वनिहरू निःशुल्क छन्। सबै ४४ ध्वनिहरू र व्यक्तिगत कोच प्रतिक्रिया अनलक गर्न अपग्रेड गर्नुहोस्।"}, {"key": "pron.paywall.unlockAllSounds", "text": "सबै ४४ ध्वनिहरू अनलक गर्नुहोस्"}, {"key": "pron.wordPracticeHint", "text": "AI सुन्न र अभ्यास गर्न शब्दमा क्लिक गर्नुहोस्"}, {"key": "pron.eg", "text": "जस्तै"}, {"key": "pron.playing", "text": "बजिरहेको"}, {"key": "pron.listen", "text": "सुन्नुहोस्"}, {"key": "pron.paywall.lessonLocked", "text": "यो पाठको व्याख्या, अभ्यास बिन्दुहरू र उदाहरणहरू Lingora English Premium को हिस्सा हो।"}, {"key": "pron.paywall.lessonFreeLimit", "text": "प्रत्येक सीपका पहिलो {{count}} पाठ निःशुल्क छन्। बाँकी अनलक गर्न अपग्रेड गर्नुहोस्।"}, {"key": "pron.paywall.unlockAllLessons", "text": "सबै पाठ अनलक गर्नुहोस्"}, {"key": "pron.itemPracticeHint", "text": "AI सँग अभ्यास गर्न वस्तुमा क्लिक गर्नुहोस्"}, {"key": "pron.practiceHint", "text": "सुन्नुहोस्, दोहोर्याउनुहोस्, रेकर्ड गर्नुहोस् र तुलना गर्नुहोस् — कोचले कुन शब्दहरू स्पष्ट आए भनी देखाउँछ।"}, {"key": "pron.drillsCount", "text": "{{count}} अभ्यास"}, {"key": "pron.useInShadowing", "text": "यो सीप Shadowing मा प्रयोग गर्नुहोस्"}, {"key": "pron.backToCoach", "text": "Speaking Coach मा फर्कनुहोस्"}, {"key": "pron.p.title", "text": "अभ्यास"}, {"key": "pron.p.step1.label", "text": "सुन्नुहोस्"}, {"key": "pron.p.step1.hint", "text": "नमुना अडियो दुई पटक बजाउनुहोस्।"}, {"key": "pron.p.step2.label", "text": "बुझ्नुहोस्"}, {"key": "pron.p.step2.hint", "text": "तपाईंको मुखले के गर्नुपर्छ पढ्नुहोस्।"}, {"key": "pron.p.step3.label", "text": "हेर्नुहोस् / सिक्नुहोस्"}, {"key": "pron.p.step3.hint", "text": "मुख, जिब्रो र ढाँचा गाइड हेर्नुहोस्।"}, {"key": "pron.p.step4.label", "text": "दोहोर्याउनुहोस्"}, {"key": "pron.p.step4.hint", "text": "पहिले बिस्तारै, अडियोसँगै ठूलो स्वरमा भन्नुहोस्।"}, {"key": "pron.p.step5.label", "text": "रेकर्ड गर्नुहोस्"}, {"key": "pron.p.step5.hint", "text": "उही वाक्य भन्दै आफैलाई रेकर्ड गर्नुहोस्।"}, {"key": "pron.p.step6.label", "text": "AI प्रतिक्रिया"}, {"key": "pron.p.step6.hint", "text": "कोचले के सुन्यो र के सुधार्नुपर्छ हेर्नुहोस्।"}, {"key": "pron.p.step7.label", "text": "फेरि प्रयास गर्नुहोस्"}, {"key": "pron.p.step7.hint", "text": "एउटा कुरा सुधार्नुहोस् र फेरि एक पटक रेकर्ड गर्नुहोस्।"}, {"key": "pron.p.step8.label", "text": "मास्टर भयो"}, {"key": "pron.p.step8.hint", "text": "लगातार दुई पटक स्पष्ट पढ्नुहोस् — अगाडि बढ्नुहोस्।"}, {"key": "pron.p.stepTap", "text": "{{hint}} यो गरेपछि एक पटक थिच्नुहोस्।"}, {"key": "pron.p.focusSound", "text": "केन्द्रित ध्वनि {{sound}}"}, {"key": "pron.p.eg", "text": "जस्तै: {{sentence}}"}, {"key": "pron.p.loading", "text": "लोड हुँदैछ…"}, {"key": "pron.p.speedNormal", "text": "सामान्य"}, {"key": "pron.p.speedSlower", "text": "अलि ढिलो"}, {"key": "pron.p.speedSlow", "text": "ढिलो"}, {"key": "pron.p.loop", "text": "लूप"}, {"key": "pron.p.stop", "text": "रोक्नुहोस्"}, {"key": "pron.p.voiceNote", "text": "नमुना अडियो Lingora को अमेरिकी अंग्रेजी AI आवाज हो, मानव रेकर्डिङ होइन।"}, {"key": "pron.p.listenSentence", "text": "Listen ले ध्वनि दुई पटक, त्यसपछि नमुना शब्द, त्यसपछि त्यो समावेश भएको वाक्य बजाउँछ।"}, {"key": "pron.p.listenExample", "text": "Listen ले ध्वनि दुई पटक, त्यसपछि नमुना बजाउँछ।"}, {"key": "pron.p.recordHint", "text": "माथिको वाक्य एक पटक स्पष्ट भन्नुहोस्।"}, {"key": "pron.p.signupToRecord", "text": "रेकर्ड गर्न र प्रतिक्रिया पाउन निःशुल्क खाता बनाउनुहोस्।"}, {"key": "pron.p.yourRecording", "text": "तपाईंको रेकर्डिङ"}, {"key": "pron.p.listeningRec", "text": "तपाईंको रेकर्डिङ सुन्दै…"}, {"key": "pron.p.wordsClear", "text": "स्पष्ट भनिएका शब्दहरू"}, {"key": "pron.p.wpm", "text": "बोल्ने गति (wpm)"}, {"key": "pron.p.heard", "text": "Lingora ले सुन्यो"}, {"key": "pron.p.tagClear", "text": "स्पष्ट"}, {"key": "pron.p.tagNeeds", "text": "सुधार आवश्यक"}, {"key": "pron.p.measured", "text": "मापन गरिएको प्रस्तुति"}, {"key": "pron.p.paceLabel", "text": "गति:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} शब्द प्रति मिनेट ({{pace}})"}, {"key": "pron.p.paceNote", "text": "स्वाभाविक कुराकानी लगभग १२०–१६० हुन्छ।"}, {"key": "pron.p.pace.slow", "text": "ढिलो"}, {"key": "pron.p.pace.natural", "text": "स्वाभाविक"}, {"key": "pron.p.pace.fast", "text": "छिटो"}, {"key": "pron.p.fillersLabel", "text": "भर्ने शब्दहरू:"}, {"key": "pron.p.repeatedLabel", "text": "दोहोरिएका शब्दहरू:"}, {"key": "pron.p.noneDetected", "text": "कुनै भेटिएन"}, {"key": "pron.p.measuredNote", "text": "गति, भर्ने शब्द र दोहोरो तपाईंको वास्तविक ट्रान्स्क्रिप्ट र रेकर्डिङ लम्बाइबाट गणना गरिन्छ। स्वर, आवाज र मौन विरामको लम्बाइ मापन गरिँदैन, त्यसैले हामी स्वरोच्चारण वा विराम स्वचालित रूपमा स्कोर गर्दैनौं।"}, {"key": "pron.p.mastered", "text": "मास्टर भयो — दुई स्पष्ट प्रयास"}, {"key": "pron.p.attempt", "text": "प्रयास {{n}} — लगातार दुई स्पष्ट पठनले यो वाक्य मास्टर भएको मानिन्छ।"}, {"key": "pron.p.toShadowing", "text": "यसलाई वास्तविक बोलीमा अभ्यास गर्नुहोस् → Shadowing"}, {"key": "pron.p.toCoach", "text": "यसलाई Speaking Coach सँग प्रयोग गर्नुहोस्"}]
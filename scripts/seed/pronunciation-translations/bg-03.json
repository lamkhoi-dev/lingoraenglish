[{"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|point|3", "text": "got to → gotta"}, {"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|caution", "text": "Това са неформални разговорни форми. Не ги използвайте в есета, имейли или официални изпити, и ги избягвайте по време на официални презентации."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|explain", "text": "Още неформални редукции, които ще чувате постоянно във филми и реални разговори."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|0", "text": "kind of → kinda"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|1", "text": "sort of → sorta"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|2", "text": "let me → lemme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|3", "text": "give me → gimme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|4", "text": "what do you → whaddaya"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|caution", "text": "Само за неформална реч. На IELTS или интервю за работа използвайте пълните форми."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|explain", "text": "Още редукции за задължение и навик, срещани често в непринудения говорим английски."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|0", "text": "have to → hafta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|1", "text": "need to → needa"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|2", "text": "used to → useta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|caution", "text": "Само неформални разговорни форми — никога не ги изписвайте."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|explain", "text": "Редукции на модални глаголи в минало време — изключително чести при съжаления или хипотетични ситуации."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|0", "text": "could have → coulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|1", "text": "would have → woulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|2", "text": "should have → shoulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|caution", "text": "Само за неформална реч — при официално писане изписвайте 'could have' изцяло."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|explain", "text": "Много неформални редукции, често срещани в песни, филми и непринудени разговори с приятели."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|0", "text": "don't know → dunno"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|1", "text": "don't you → dontcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|2", "text": "what are you → whatcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|caution", "text": "Изключително неформално — само с близки приятели, никога в професионален или изпитен контекст."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|explain", "text": "Често срещани редукции с предлози в разговорната реч."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|0", "text": "out of → outta"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|1", "text": "off of → offa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|2", "text": "cup of → cuppa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|caution", "text": "Само за неформална употреба."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|explain", "text": "Ежедневни възклицания и разговорни изрази със силна редукция."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|0", "text": "come on → c'mon"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|1", "text": "going to be → gonna be"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|2", "text": "some more → s'more"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|caution", "text": "Само за неформална употреба."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|explain", "text": "Въпросителните фрази в началото се редуцират силно при бърз, неформален разговор."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|0", "text": "did you → dja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|1", "text": "do you → dya"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|2", "text": "would you → wouldja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|caution", "text": "Само за неформален, говорим контекст."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|explain", "text": "В разговорната реч често се редуцират и изразите за време."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|0", "text": "a couple of → a couple"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|1", "text": "in a minute → in a min"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|caution", "text": "Подходящо за непринуден разговор, но не и за писане."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|explain", "text": "Още често срещани разговорни редукции, които се чуват постоянно в непринуден разговор."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|0", "text": "probably → prolly"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|1", "text": "trying to → tryna"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|2", "text": "supposed to → s'posed to"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|caution", "text": "Само за неформална разговорна реч."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|explain", "text": "Разговорни редукции, често срещани между приятели и в американската неформална реч."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|0", "text": "let's go → less go"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|1", "text": "give it to me → gimme that"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|2", "text": "you all → y'all"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|caution", "text": "Изключително неформално — 'y'all' е регионален израз (Southern US), но е широко разбираем."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|explain", "text": "Кръглите числа редуцират средните си съгласни звукове в бързата, непринудена американска реч."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|0", "text": "twenty → twenny"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|1", "text": "hundred → hunnerd"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|caution", "text": "Само за неформална разговорна реч — винаги изговаряйте пълната форма във формален контекст."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|explain", "text": "Друга група ежедневни думи, които редовно губят сричка в бърза, непринудена реч."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|0", "text": "different → diff'rent"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|1", "text": "general → gen'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|2", "text": "several → sev'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|3", "text": "camera → cam'ra"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|caution", "text": "Подходящо за разговорна реч; произнасяйте пълната форма ясно при официални презентации."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|explain", "text": "Много неформални редукции, които ще чуете в песни и в непринудена американска реч, но никога не бива да използвате в професионална среда."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|0", "text": "I'm going to → I'ma"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|1", "text": "kind of like → kinda like"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|caution", "text": "Изключително неформално — само сред приятели или в текстове на песни, никога в професионален контекст."}, {"key": "551b9527-f712-421d-966c-24644f360746|explain", "text": "Още ежедневни редукции при поздрав освен what's up / how's it going."}, {"key": "551b9527-f712-421d-966c-24644f360746|point|0", "text": "how are you → how ya doin'"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|1", "text": "good to see you → good to see ya"}, {"key": "551b9527-f712-421d-966c-24644f360746|caution", "text": "Само за неформална разговорна реч."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|explain", "text": "Още редукции за задължение и желание, често срещани в непринудената американска реч."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|0", "text": "ought to → oughta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|1", "text": "don't have to → don't hafta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|2", "text": "want you → wantcha"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|caution", "text": "Само за неформална разговорна реч."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|explain", "text": "Това е класически пример до каква степен може да стигне разговорната американска редукция — няколко думи се сливат в нещо, което звучи като една."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|0", "text": "Did you eat yet? → Jeetyet?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|1", "text": "Did you already? → Jeetalready?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|caution", "text": "Изключително неформално — служи за разпознаване на бърза реч от носители на езика, а не за собствена официална реч."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|explain", "text": "Още две чести редукции на ниво фраза в ежедневния разговор."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|0", "text": "because of → 'cause of"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|1", "text": "sort of a → sorta a"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|caution", "text": "Само за разговорна, неформална реч."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|explain", "text": "Много чести неформални алтернативи на 'yes' и 'no' в непринудения говорим английски."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|0", "text": "yes → yep / uh-huh"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|1", "text": "no → nope / nah"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|caution", "text": "Само за разговорна реч — използвайте 'yes'/'no' в официален контекст или на изпити."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|explain", "text": "И двете се редуцират до подобно звучащо 'wanna', но след едното следва съществително име, а след другото — глагол. Струва си да се забележи разликата."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|0", "text": "want a (coffee) → wanna coffee"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|1", "text": "want to (go) → wanna go"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|caution", "text": "Само за разговорна, неформална реч."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|0", "text": "'want a' + съществително име → wanna"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|1", "text": "'want to' + глагол → wanna"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|explain", "text": "Отрицателната форма на 'would have' се редуцира по същия начин, както положителната."}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|point|0", "text": "wouldn't have → wouldn'ta"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|caution", "text": "Само за разговорна, неформална реч — в останалите случаи изписвайте 'wouldn't have' изцяло."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|explain", "text": "Още две ежедневни редукции, често срещани при неформални обяснения и молби."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|0", "text": "just because → just 'cause"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|1", "text": "going to need → gonna need"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|caution", "text": "Само за разговорна, неформална реч."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|explain", "text": "'Ain't' замества am not/is not/are not/has not/have not в подчертано неформален стил и се чува навсякъде в песни и разговорна реч."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|0", "text": "I am not → I ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|1", "text": "that is not → that ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|2", "text": "you have not → you ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|caution", "text": "Никога не използвайте в писмена или официална реч — счита се за нестандартна граматика, макар и изключително популярна в неформална среда."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|explain", "text": "Много популярен разговор начин да кажете 'I understand' или буквално 'caught you'."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|0", "text": "got you (understand) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|1", "text": "got you (caught) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|caution", "text": "Само за разговорна реч — в професионален контекст използвайте 'I understand' или 'got it'."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|explain", "text": "Редукции на модални перфектни форми, използвани за предположения за миналото, наред с coulda/woulda/shoulda."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|0", "text": "must have → musta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|1", "text": "might have → mighta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|caution", "text": "Само за разговорна, неформална реч — в останалите случаи изписвайте 'must have'/'might have' изцяло."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|explain", "text": "Отрицателните съответствия на coulda/woulda/shoulda, често използвани при изразяване на съжаление."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|0", "text": "shouldn't have → shouldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|1", "text": "couldn't have → couldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|caution", "text": "Само за разговорна, неформална реч — в официален контекст изписвайте 'shouldn't have'/'couldn't have' изцяло."}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|explain", "text": "В непринудената реч крайният звук -ing често губи своето 'g', така че звучи като -in'. Това важи за почти всеки глагол с окончание -ing. (, so it sounds like -in)"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|0", "text": "doing → doin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|1", "text": "going → goin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|2", "text": "talking → talkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|3", "text": "thinking → thinkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|caution", "text": "Само за разговорна реч — произнасяйте пълното '-ing' ясно при презентации, интервюта и изпити."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|explain", "text": "Същият модел на изпускане на g важи и за неопределителните местоимения, завършващи на -thing."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|0", "text": "something → somethin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|1", "text": "nothing → nothin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|2", "text": "anything → anythin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|caution", "text": "Само за разговорна реч."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|explain", "text": "'Them' се редуцира до 'em (изпуска се 'th') след глагол в много обичайната разговорна реч."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|0", "text": "tell them → tell 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|1", "text": "get them → get 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|2", "text": "ask them → ask 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|caution", "text": "Само за неформална разговорна реч — произнасяйте 'them' изцяло при писане или официална реч."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|explain", "text": "'And' се редуцира до бърз звук 'n' между две тясно свързани думи, особено в устойчиви изрази."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|0", "text": "rock and roll → rock 'n' roll"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|1", "text": "fish and chips → fish 'n' chips"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|2", "text": "back and forth → back 'n' forth"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|caution", "text": "Често срещано в устойчиви изрази и бърза реч — изговаряйте 'and' ясно при официално писане."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|explain", "text": "Самостоятелно 'Because' (не само 'because of') често се съкращава до 'cause в ежедневни отговори."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|point|0", "text": "because → 'cause"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|caution", "text": "Само за неформална разговорна реч — в останалите случаи изписвайте 'because' изцяло."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|explain", "text": "При бързи, ежедневни отговори от 'Of course' често отпада първата дума."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|point|0", "text": "of course → 'course"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|caution", "text": "Само за разговорна реч."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|explain", "text": "Много често срещано разговорно произношение на 'all right', използвано за изразяване на съгласие или потвърждение."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|point|0", "text": "all right → aight"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|caution", "text": "Много неформално — използвайте 'all right' или 'okay' в професионален контекст."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|explain", "text": "'Let you' се редуцира по същия начин като 'want you'/'wantcha'."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|point|0", "text": "let you → letcha"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|caution", "text": "Само за неформална разговорна реч."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|explain", "text": "Още едно екстремно сливане в бързата реч, подобно на 'jeetyet' — няколко думи се компресират в един звук."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|point|0", "text": "did you ever → jever"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|caution", "text": "За разпознаване на бърза реч от носители на езика, а не за вашето официално говорене."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|explain", "text": "Две редукции се наслагват една върху друга, когато 'going to' и 'have to' се появяват едно до друго."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|point|0", "text": "going to have to → gonna hafta"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|caution", "text": "Само за неформална разговорна реч — в останалите случаи изписвайте 'going to have to' изцяло."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|explain", "text": "Редукцията 'gonna' продължава да важи и при отрицания и минало време."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|0", "text": "not going to → not gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|1", "text": "wasn't going to → wasn't gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|caution", "text": "Само за неформална разговорна реч."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|explain", "text": "Много честа редукция на въпросите с добавка (tag question) в британския английски, използвана за потвърждение или за подсилване."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|point|0", "text": "isn't it → innit"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|caution", "text": "Много неформален британски жаргон — не го използвайте в официална реч, дори в UK."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|explain", "text": "Неформален начин да предложите нещо или да потърсите съгласие."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|point|0", "text": "what do you say → whaddya say"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|caution", "text": "Само за неформална разговорна реч."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|explain", "text": "Изключително често срещана фраза-пълнеж в разговорния английски, използвана при размисъл или за наблягане."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|point|0", "text": "you know → y'know"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|caution", "text": "Само като неформален пълнеж — прекомерната му употреба звучи неизчистено дори в неофициална обстановка."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|explain", "text": "Много непринуден поздрав, съкратен от 'what's up'."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|point|0", "text": "what's up → s'up"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|caution", "text": "Много неформален поздрав, подходящ само между приятели."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|explain", "text": "'Him' и 'her' също отслабват в разговорната реч, подобно на 'them' → 'em."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|0", "text": "tell him → tell 'im"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|1", "text": "ask her → ask 'er"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|caution", "text": "Само за неформална разговорна реч."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|explain", "text": "'Kinda' и 'sorta' често се комбинират за допълнителна уклончивост в много неформална реч."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|point|0", "text": "kind of sort of → kinda sorta"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|caution", "text": "Много неформално — избягвайте в професионален контекст или на изпити."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|explain", "text": "Още едно сливане в бързата реч при започване на въпрос, наред с dja и wouldja."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|point|0", "text": "didn't you → dincha"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|caution", "text": "Служи за разпознаване на бърза реч от носители на езика, а не за самостоятелна употреба при официално говорене."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|explain", "text": "Формата за минало време на 'have to' се редуцира по същия начин, както и формата за сегашно време."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|point|0", "text": "had to → hadta"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|caution", "text": "Само за неформална разговорна реч."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|explain", "text": "Разговорна редукция, използвана при неформални молби, подобно на формите от типа на wouldja и couldja."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|point|0", "text": "will you → willcha"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|caution", "text": "Само за неформална разговорна реч."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|explain", "text": "Фразите за количество с 'of' се редуцират по същия начин, както 'cup of' в 'cuppa'."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|0", "text": "lots of → lotsa"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|1", "text": "bunch of → buncha"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|caution", "text": "Само за неформална разговорна реч."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|explain", "text": "Силна неформална подсилваща дума със значение 'a very impressive/big'."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|point|0", "text": "hell of a → helluva"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|caution", "text": "Леко грубо — подходящо сред приятели, но го избягвайте в професионална или учтива среда."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|explain", "text": "Историческа редукция на стария поздрав 'how do you do', превърнала се в самостоятелен непринуден, приятелски поздрав (особено в южната част на US)."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|point|0", "text": "how do you do → howdy"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|caution", "text": "Само за непринуден, приятелски поздрав."}, {"key": "47538641-f573-4840-af35-02857a1d24de|explain", "text": "При 'I suppose' в разговорната реч често отпада средната сричка; използва се за изразяване на лека несигурност или неохотно съгласие — различава се от 'supposed to' → s'posed to."}, {"key": "47538641-f573-4840-af35-02857a1d24de|point|0", "text": "I suppose → I s'pose"}, {"key": "47538641-f573-4840-af35-02857a1d24de|caution", "text": "Само в разговорната реч — в останалите случаи пишете 'I suppose' изцяло."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|explain", "text": "Усъвършенствайте редукциите чрез 50 целенасочени упражнения. Слушайте внимателно AI модела, повтаряйте и записвайте гласа си, за да получите подробна оценка и обратна връзка за произношението си в реално време."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|0", "text": "Фокусирайте се върху ритъма, ударението и плавния поток на речта, подчертани във всяко упражнение."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|1", "text": "Слушайте референтния примерен аудиозапис преди всеки опит за запис."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|2", "text": "Прегледайте вашата AI оценка и обратната връзка на ниво фонеми, за да определите областите за подобрение."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|caution", "text": "Не бързайте с упражненията; дайте приоритет на яснотата, естествената интонация и точната артикулация."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|0", "text": "Силна редукция на спомагателните думи за постигане на плавен и естествен ритъм."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|1", "text": "'going to' -> 'gonna'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|2", "text": "'have got to' се редуцира до 'gotta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|3", "text": "'want a' -> 'wanna'; 'of' -> 'a' /ə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|4", "text": "'has to' -> 'hasta' /hæstə/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|5", "text": "'let me' -> 'lemme'; 'you' -> 'ya'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|6", "text": "'give me' -> 'gimme'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|7", "text": "'could you' -> 'couldja' /kʊdʒə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|8", "text": "'would you' -> 'wouldja'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|9", "text": "'what did you' -> 'whaddya'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|10", "text": "'should have' -> 'shoulda' /ʃʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|11", "text": "'could have' -> 'coulda' /kʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|12", "text": "'would have' -> 'woulda' /wʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|13", "text": "'must have' -> 'musta' /mʌstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|14", "text": "'might have' -> 'mighta' /maɪtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|15", "text": "'used to' -> 'usta' /juːstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|16", "text": "'supposed to' -> 'sposta' /spoʊstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|17", "text": "'need to' -> 'needa'; 'to' -> /də/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|18", "text": "'to' -> /də/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|19", "text": "'kind of' -> 'kinda' /kaɪndə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|20", "text": "'sort of' -> 'sorta' /sɔːrtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|21", "text": "'lots of' -> 'lotsa' /lɒtsə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|22", "text": "'out of' -> 'outta' /aʊtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|23", "text": "'front of' -> 'fronta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|24", "text": "'I am going to' се редуцира до 'I'mma' в неформалната реч."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|25", "text": "'don't you' -> 'doncha'; 'want to' -> 'wanna'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|26", "text": "'didn't you' -> 'didn'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|27", "text": "'haven't you' -> 'haven'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|28", "text": "'and' се редуцира до сричкотворно 'n' /n/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|29", "text": "'day and night' -> 'day 'n night'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|30", "text": "'or' се редуцира до /ər/; 'it or' се свързва плавно с flap."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|31", "text": "'or' се редуцира до неударено /ər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|32", "text": "'and' се редуцира до /n/ между преградни съгласни."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|33", "text": "Относителното 'that' се редуцира до /ðət/ с шва."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|34", "text": "Съюзът 'that' е слаб и кратък."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|35", "text": "'that' приема /ðət/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|36", "text": "'them' се редуцира до ''em' /əm/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|37", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|38", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|39", "text": "'some' -> /səm/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|40", "text": "'for' -> /fər/; 'you' -> /jə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|41", "text": "'are' -> /ər/; 'you' -> /jə/; 'to' -> /tə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|42", "text": "'were' се редуцира до /wər/."}]
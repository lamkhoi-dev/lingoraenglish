[{"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|point|3", "text": "got to → gotta"}, {"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|caution", "text": "Nämä ovat epämuodollisia puhekielisiä muotoja. Älä kirjoita niitä esseisiin, sähköposteihin tai muodollisiin kokeisiin, ja vältä niitä muodollisessa esityksessä."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|explain", "text": "Lisää arkikielisiä lyhennyksiä, joita kuulet jatkuvasti elokuvissa ja oikeassa keskustelussa."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|0", "text": "kind of → kinda"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|1", "text": "sort of → sorta"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|2", "text": "let me → lemme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|3", "text": "give me → gimme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|4", "text": "what do you → whaddaya"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|caution", "text": "Vain epämuodolliseen käyttöön. Käytä 'IELTS'- tai työhaastattelussa täysiä muotoja."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|explain", "text": "Lisää velvollisuuden ja tottumuksen lyhennyksiä, jotka ovat yleisiä rennossa puhekielessä."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|0", "text": "have to → hafta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|1", "text": "need to → needa"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|2", "text": "used to → useta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|caution", "text": "Vain epämuodollisia puhekielisiä muotoja — älä koskaan kirjoita niitä."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|explain", "text": "Mennyt ajan modaalisten verbien lyhennykset — hyvin yleisiä puhuttaessa katumuksista tai hypoteettisista tilanteista."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|0", "text": "could have → coulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|1", "text": "would have → woulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|2", "text": "should have → shoulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|caution", "text": "Vain epämuodolliseen puheeseen — kirjoita muodollisessa tekstissä 'could have' kokonaan."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|explain", "text": "Hyvin arkikielisiä lyhennyksiä, jotka ovat yleisiä lauluissa, elokuvissa ja rennossa keskustelussa ystävien kesken."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|0", "text": "don't know → dunno"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|1", "text": "don't you → dontcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|2", "text": "what are you → whatcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|caution", "text": "Hyvin epämuodollista — vain läheisten ystävien kanssa, ei koskaan ammattimaisissa tai koetilanteissa."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|explain", "text": "Yleisiä prepositioihin liittyviä lyhennyksiä arkikielessä."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|0", "text": "out of → outta"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|1", "text": "off of → offa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|2", "text": "cup of → cuppa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|caution", "text": "Vain epämuodolliseen käyttöön."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|explain", "text": "Jokapäiväisiä huudahduksia ja arkikielisiä ilmauksia, joissa on voimakas lyhennys."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|0", "text": "come on → c'mon"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|1", "text": "going to be → gonna be"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|2", "text": "some more → s'more"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|caution", "text": "Vain epämuodollisessa kielessä."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|explain", "text": "Kysymysten aloitukset lyhenevät voimakkaasti nopeassa, rennossa keskustelussa."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|0", "text": "did you → dja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|1", "text": "do you → dya"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|2", "text": "would you → wouldja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|caution", "text": "Vain rennoissa puhekielen tilanteissa."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|explain", "text": "Rentopuheessa myös ajanilmaukset lyhenevät usein."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|0", "text": "a couple of → a couple"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|1", "text": "in a minute → in a min"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|caution", "text": "Sopii rentoon puheeseen, ei kirjoitettuun kieleen."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|explain", "text": "Yleisempiä rentoja lyhennyksiä, joita kuulee jatkuvasti rennossa keskustelussa."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|0", "text": "probably → prolly"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|1", "text": "trying to → tryna"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|2", "text": "supposed to → s'posed to"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|caution", "text": "Vain epämuodollisessa puhekielessä."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|explain", "text": "Rentoja lyhennyksiä, joita käytetään yleisesti ystävien kesken ja amerikkalaisessa epämuodollisessa puheessa."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|0", "text": "let's go → less go"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|1", "text": "give it to me → gimme that"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|2", "text": "you all → y'all"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|caution", "text": "Hyvin epämuodollinen — 'y'all' on alueellinen (Southern US), mutta laajalti ymmärretty."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|explain", "text": "Pyöreät luvut menettävät keskikonsonanttiäänteensä nopeassa, rennossa amerikkalaisessa puheessa."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|0", "text": "twenty → twenny"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|1", "text": "hundred → hunnerd"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|caution", "text": "Vain epämuodollisessa puheessa — käytä aina täyttä muotoa muodollisissa tilanteissa."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|explain", "text": "Toinen joukko jokapäiväisiä sanoja, jotka menettävät säännöllisesti tavun nopeassa, rennossa puheessa."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|0", "text": "different → diff'rent"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|1", "text": "general → gen'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|2", "text": "several → sev'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|3", "text": "camera → cam'ra"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|caution", "text": "Sopii hyvin arkikieleen; lausu täysi muoto selvästi virallisissa esityksissä."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|explain", "text": "Hyvin epämuodollisia supistumia, joita kuulet lauluissa ja rennossa amerikkalaisessa puheessa, mutta joita ei koskaan pitäisi käyttää ammattimaisissa yhteyksissä."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|0", "text": "I'm going to → I'ma"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|1", "text": "kind of like → kinda like"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|caution", "text": "Erittäin epämuodollinen — vain ystävien kesken tai laulunsanoissa, ei koskaan ammattimaisissa yhteyksissä."}, {"key": "551b9527-f712-421d-966c-24644f360746|explain", "text": "Lisää arkisia tervehdysten supistumia sen lisäksi, mitä ovat what's up / how's it going."}, {"key": "551b9527-f712-421d-966c-24644f360746|point|0", "text": "how are you → how ya doin'"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|1", "text": "good to see you → good to see ya"}, {"key": "551b9527-f712-421d-966c-24644f360746|caution", "text": "Vain epämuodollisia puhekielisiä muotoja."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|explain", "text": "Lisää velvollisuuden ja halun supistumia, jotka ovat yleisiä rennossa amerikkalaisessa puheessa."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|0", "text": "ought to → oughta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|1", "text": "don't have to → don't hafta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|2", "text": "want you → wantcha"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|caution", "text": "Vain epämuodolliseen puheeseen."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|explain", "text": "Tämä on klassinen esimerkki siitä, miten pitkälle rento amerikkalainen supistaminen voi mennä — useat sanat sulautuvat yhteen ja kuulostavat yhdeltä sanalta."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|0", "text": "Did you eat yet? → Jeetyet?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|1", "text": "Did you already? → Jeetalready?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|caution", "text": "Erittäin epämuodollinen — tarkoitettu nopean natiivipuheen tunnistamiseen, ei omaan viralliseen puheeseesi."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|explain", "text": "Kaksi muuta yleistä lausetason supistumaa arkikeskustelussa."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|0", "text": "because of → 'cause of"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|1", "text": "sort of a → sorta a"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|caution", "text": "Vain epämuodolliseen puheeseen."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|explain", "text": "Hyvin yleisiä arkisia vaihtoehtoja sanoille 'yes' ja 'no' rennossa puhutussa englannissa."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|0", "text": "yes → yep / uh-huh"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|1", "text": "no → nope / nah"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|caution", "text": "Vain arkikeskusteluun — käytä 'yes'/'no' virallisissa tai koetilanteissa."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|explain", "text": "Molemmat supistuvat samankuuloiseksi 'wanna'-muodoksi, mutta toista seuraa substantiivi ja toista verbi — ero kannattaa huomata."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|0", "text": "want a (coffee) → wanna coffee"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|1", "text": "want to (go) → wanna go"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|caution", "text": "Vain epämuodollisessa puhekielessä."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|0", "text": "'want a' + substantiivi → wanna"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|1", "text": "'want to' + verbi → wanna"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|explain", "text": "'would have' -muodon kielteinen versio lyhenee samalla tavalla kuin myönteinen muoto."}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|point|0", "text": "wouldn't have → wouldn'ta"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|caution", "text": "Vain epämuodollisessa puhekielessä — kirjoita muuten 'wouldn't have' kokonaan."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|explain", "text": "Kaksi muuta arkipäivän lyhennystä, jotka ovat yleisiä rennoissa selityksissä ja pyynnöissä."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|0", "text": "just because → just 'cause"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|1", "text": "going to need → gonna need"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|caution", "text": "Vain epämuodollisessa puhekielessä."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|explain", "text": "'Ain't' korvaa muodot am not/is not/are not/has not/have not hyvin rennossa puheessa, ja sitä kuulee kaikkialla lauluissa ja epämuodollisessa keskustelussa."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|0", "text": "I am not → I ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|1", "text": "that is not → that ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|2", "text": "you have not → you ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|caution", "text": "Älä koskaan käytä kirjoituksessa tai muodollisessa puheessa — sitä pidetään epästandardina kielioppina, vaikka se on erittäin yleinen epämuodollisessa kielessä."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|explain", "text": "Hyvin yleinen rento tapa sanoa 'I understand' tai kirjaimellisesti 'caught you'."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|0", "text": "got you (understand) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|1", "text": "got you (caught) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|caution", "text": "Vain epämuodollisessa puhekielessä — sano ammattimaisissa yhteyksissä 'I understand' tai 'got it'."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|explain", "text": "Modaali-perfektin lyhennykset, joita käytetään arvailuihin menneisyydestä, yhdessä muotojen coulda/woulda/shoulda kanssa."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|0", "text": "must have → musta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|1", "text": "might have → mighta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|caution", "text": "Vain epämuodollisessa puhekielessä — kirjoita muuten 'must have'/'might have' kokonaan."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|explain", "text": "Muotojen coulda/woulda/shoulda kielteiset vastineet, yleisiä puhuttaessa katkeruudesta."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|0", "text": "shouldn't have → shouldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|1", "text": "couldn't have → couldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|caution", "text": "Vain epämuodollisessa puhekielessä — kirjoita muodollisissa yhteyksissä 'shouldn't have'/'couldn't have' kokonaan."}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|explain", "text": "Rennossa puheessa lopun -ing-äänne pudottaa usein 'g':n, jolloin se kuulostaa -in' -päätteeltä. Tämä tapahtuu lähes kaikkien -ing-verbien kohdalla. (, so it sounds like -in)"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|0", "text": "doing → doin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|1", "text": "going → goin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|2", "text": "talking → talkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|3", "text": "thinking → thinkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|caution", "text": "Vain arkikielessä — lausu täysi '-ing' selvästi esitelmissä, haastatteluissa ja kokeissa."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|explain", "text": "Sama g:n poisjättö koskee myös epämääräisiä pronomineja, jotka päättyvät -thing."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|0", "text": "something → somethin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|1", "text": "nothing → nothin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|2", "text": "anything → anythin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|caution", "text": "Vain arkikielessä."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|explain", "text": "'Them' lyhenee muotoon 'em (the 'th' putoaa) verbin jälkeen hyvin yleisessä arkikielessä."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|0", "text": "tell them → tell 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|1", "text": "get them → get 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|2", "text": "ask them → ask 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|caution", "text": "Vain epämuodollisessa puhekielessä — kirjoita tai sano 'them' kokonaan muodollisessa kielessä."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|explain", "text": "'And' lyhenee nopeaksi 'n'-äänteeksi kahden tiiviisti liittyvän sanan välissä, erityisesti vakiintuneissa fraaseissa."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|0", "text": "rock and roll → rock 'n' roll"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|1", "text": "fish and chips → fish 'n' chips"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|2", "text": "back and forth → back 'n' forth"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|caution", "text": "Yleinen vakiintuneissa fraaseissa ja nopeassa puheessa — kirjoita 'and' selvästi muodollisessa tekstissä."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|explain", "text": "'Because' yksinään (ei vain 'because of') lyhenee usein muotoon 'cause arkisissa vastauksissa."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|point|0", "text": "because → 'cause"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|caution", "text": "Vain epämuodollisessa puhekielessä — kirjoita muuten 'because' kokonaan."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|explain", "text": "'Of course' pudottaa usein ensimmäisen sanansa nopeissa, arkisissa vastauksissa."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|point|0", "text": "of course → 'course"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|caution", "text": "Vain arkisessa puhekielessä."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|explain", "text": "Hyvin yleinen arkikielinen ääntämysmuoto sanasta 'all right', käytetään myöntymiseen tai kuittaukseen."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|point|0", "text": "all right → aight"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|caution", "text": "Hyvin epämuodollinen — sano 'all right' tai 'okay' ammattimaisissa yhteyksissä."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|explain", "text": "'Let you' lyhenee samalla tavalla kuin 'want you'/'wantcha'."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|point|0", "text": "let you → letcha"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|caution", "text": "Vain epämuodollisessa puhekielessä."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|explain", "text": "Toinen äärimmäinen nopean puheen sulautuma, samankaltainen kuin 'jeetyet' — useita sanoja tiivistyy yhdeksi äänteeksi."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|point|0", "text": "did you ever → jever"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|caution", "text": "Nopean natiivipuheen tunnistamiseen, ei omaan muodolliseen puheeseesi."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|explain", "text": "Kaksi reduktiota kasautuu yhteen, kun 'going to' ja 'have to' esiintyvät vierekkäin."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|point|0", "text": "going to have to → gonna hafta"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|caution", "text": "Vain epämuodollisessa puhekielessä — kirjoita muuten 'going to have to' kokonaan."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|explain", "text": "'gonna'-reduktio pätee edelleen kielteisissä muodoissa ja imperfektissä."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|0", "text": "not going to → not gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|1", "text": "wasn't going to → wasn't gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|caution", "text": "Vain epämuodollisessa puhekielessä."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|explain", "text": "Hyvin yleinen brittienglannin lisäkysymyksen reduktio, jota käytetään vahvistamaan tai korostamaan."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|point|0", "text": "isn't it → innit"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|caution", "text": "Hyvin epämuodollista brittiläistä slängiä — älä käytä muodollisessa puheessa, edes Isossa-Britanniassa. (UK)"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|explain", "text": "Rentoutunut tapa ehdottaa jotain tai kysyä hyväksyntää."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|point|0", "text": "what do you say → whaddya say"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|caution", "text": "Vain epämuodollisessa puhekielessä."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|explain", "text": "Äärimmäisen yleinen täytesana rentoutuneessa puhekielessä, käytetään miettimisen aikana tai korostuksena."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|point|0", "text": "you know → y'know"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|caution", "text": "Vain rentona täytesanana — liiallinen käyttö kuulostaa hiotumattomalta jopa epämuodollisesti."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|explain", "text": "Hyvin rentoutunut tervehdys, lyhennetty muodosta 'what's up'."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|point|0", "text": "what's up → s'up"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|caution", "text": "Hyvin epämuodollinen tervehdys vain ystävien kesken."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|explain", "text": "'Him' ja 'her' myös heikkenevät rentoutuneessa puheessa, samoin kuin 'them' → 'em."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|0", "text": "tell him → tell 'im"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|1", "text": "ask her → ask 'er"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|caution", "text": "Vain epämuodollisessa puhekielessä."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|explain", "text": "'Kinda' ja 'sorta' yhdistetään usein lisävarauksen ilmaisemiseksi hyvin rentoutuneessa puheessa."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|point|0", "text": "kind of sort of → kinda sorta"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|caution", "text": "Hyvin epämuodollista — vältä kaikissa ammatillisissa tai koetilanteissa."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|explain", "text": "Toinen nopean puheen kysymysalku, samanlainen kuin dja ja wouldja."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|point|0", "text": "didn't you → dincha"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|caution", "text": "Nopean natiivipuheen tunnistamiseen, ei omaan muodolliseen puheeseesi."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|explain", "text": "'have to' -rakenteen imperfektimuoto lyhenee samalla tavalla kuin preesensmuoto."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|point|0", "text": "had to → hadta"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|caution", "text": "Vain epämuodollisessa puhekielessä."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|explain", "text": "Epämuodollinen lyhennys, jota käytetään rennoissa pyynnöissä, samankaltainen kuin wouldja ja couldja -muodot."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|point|0", "text": "will you → willcha"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|caution", "text": "Vain epämuodollisessa puhekielessä."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|explain", "text": "Määrän ilmaukset, joissa on 'of', lyhenevät samalla tavalla kuin 'cup of' muodossa 'cuppa'."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|0", "text": "lots of → lotsa"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|1", "text": "bunch of → buncha"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|caution", "text": "Vain epämuodollisessa puhekielessä."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|explain", "text": "Vahva epämuodollinen tehostussana, joka tarkoittaa 'erittäin vaikuttavaa/suurta'. (a very impressive/big)"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|point|0", "text": "hell of a → helluva"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|caution", "text": "Lievästi karkea — sopii ystävien kanssa, vältä ammattimaisissa tai kohteliaissa tilanteissa."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|explain", "text": "Historiallinen lyhennys vanhasta tervehdyksestä 'how do you do', nykyään oma rento, ystävällinen tervehdyksensä (erityisesti Yhdysvaltain eteläosissa). (US)"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|point|0", "text": "how do you do → howdy"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|caution", "text": "Vain rento, ystävällinen tervehdys."}, {"key": "47538641-f573-4840-af35-02857a1d24de|explain", "text": "'I suppose' menettää usein keskimmäisen tavunsa rennossa puheessa; käytetään ilmaisemaan lievää epävarmuutta tai vastahakoista myöntymistä — eri asia kuin 'supposed to' → s'posed to."}, {"key": "47538641-f573-4840-af35-02857a1d24de|point|0", "text": "I suppose → I s'pose"}, {"key": "47538641-f573-4840-af35-02857a1d24de|caution", "text": "Vain epämuodollisessa puhekielessä — kirjoita muuten 'I suppose' kokonaan."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|explain", "text": "Hallitse lyhennykset 50 kohdennetun harjoituksen avulla. Kuuntele tarkasti AI-mallia, toista ja nauhoita äänesi saadaksesi yksityiskohtaista reaaliaikaista ääntämispisteytystä ja palautetta."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|0", "text": "Keskity rytmiin, painotukseen ja sujuvuuteen, jotka on korostettu kussakin harjoituksessa."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|1", "text": "Kuuntele mallin ääninäyte ennen jokaista nauhoitusyritystä."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|2", "text": "Käy läpi AI-pisteytyksesi ja foneemitasoinen palaute tunnistaaksesi parannuskohteet."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|caution", "text": "Älä kiirehdi harjoitusten läpi; priorisoi selkeys, luonnollinen rytmi ja tarkka ääntäminen."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|0", "text": "Apusanojen äärimmäinen lyhentyminen luonnolliseen virtaan."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|1", "text": "'going to' -> 'gonna'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|2", "text": "'have got to' lyhenee muotoon 'gotta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|3", "text": "'want a' -> 'wanna'; 'of' -> 'a' /ə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|4", "text": "'has to' -> 'hasta' /hæstə/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|5", "text": "'let me' -> 'lemme'; 'you' -> 'ya'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|6", "text": "'give me' -> 'gimme'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|7", "text": "'could you' -> 'couldja' /kʊdʒə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|8", "text": "'would you' -> 'wouldja'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|9", "text": "'what did you' -> 'whaddya'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|10", "text": "'should have' -> 'shoulda' /ʃʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|11", "text": "'could have' -> 'coulda' /kʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|12", "text": "'would have' -> 'woulda' /wʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|13", "text": "'must have' -> 'musta' /mʌstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|14", "text": "'might have' -> 'mighta' /maɪtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|15", "text": "'used to' -> 'usta' /juːstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|16", "text": "'supposed to' -> 'sposta' /spoʊstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|17", "text": "'need to' -> 'needa'; 'to' -> /də/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|18", "text": "'to' -> /də/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|19", "text": "'kind of' -> 'kinda' /kaɪndə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|20", "text": "'sort of' -> 'sorta' /sɔːrtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|21", "text": "'lots of' -> 'lotsa' /lɒtsə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|22", "text": "'out of' -> 'outta' /aʊtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|23", "text": "'front of' -> 'fronta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|24", "text": "'I am going to' lyhenee muotoon 'I'mma' epämuodollisessa puheessa."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|25", "text": "'don't you' -> 'doncha'; 'want to' -> 'wanna'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|26", "text": "'didn't you' -> 'didn'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|27", "text": "'haven't you' -> 'haven'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|28", "text": "'and' lyhenee tavuiseksi 'n:ksi' /n/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|29", "text": "'day and night' -> 'day 'n night'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|30", "text": "'or' lyhenee muotoon /ər/; 'it or' liukuu saumattomasti."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|31", "text": "'or' lyhenee painottomaksi /ər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|32", "text": "'and' lyhenee muotoon /n/ klusiilien välissä."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|33", "text": "Relatiivipronomini 'that' redusoituu muotoon /ðət/, jossa on schwa."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|34", "text": "Konjunktio 'that' on heikko ja lyhyt."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|35", "text": "'that' ääntyy /ðət/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|36", "text": "'them' redusoituu muotoon ''em' /əm/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|37", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|38", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|39", "text": "'some' -> /səm/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|40", "text": "'for' -> /fər/; 'you' -> /jə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|41", "text": "'are' -> /ər/; 'you' -> /jə/; 'to' -> /tə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|42", "text": "'were' redusoituu muotoon /wər/."}]
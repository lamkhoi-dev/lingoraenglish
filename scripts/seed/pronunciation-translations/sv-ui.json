[{"key": "pron.hero.title", "text": "Tala tydligare, mer naturligt, mer flytande"}, {"key": "pron.hero.description", "text": "Alla {{count}} engelska ljud plus ordbetoning, satsbetoning, intonation, sammanhängande tal, reduktioner, rytm, frasering och flyt — varje lektion avslutas med din egen inspelning."}, {"key": "pron.imageAlt", "text": "Uttal, artikulation och IPA"}, {"key": "pron.progress.title", "text": "Din uttalsutveckling"}, {"key": "pron.progress.descUser", "text": "Mätt utifrån de ord coachen kände igen i dina egna inspelningar."}, {"key": "pron.progress.descGuest", "text": "Skapa ett gratis konto för att spela in dig själv och börja följa din utveckling."}, {"key": "pron.recommended", "text": "Rekommenderat för dig"}, {"key": "pron.soundLabel", "text": "{{symbol}}-ljudet"}, {"key": "pron.skill.sounds", "text": "Ljud"}, {"key": "pron.skill.sounds.blurb", "text": "Alla 44 engelska fonem med minimala par."}, {"key": "pron.skill.wordStress", "text": "Ordbetoning"}, {"key": "pron.skill.wordStress.blurb", "text": "Stavelser, huvudbetoning och bibetoning."}, {"key": "pron.skill.sentenceStress", "text": "Satsbetoning"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Innehållsord starka, funktionsord svaga."}, {"key": "pron.skill.intonation", "text": "Intonation"}, {"key": "pron.skill.intonation.blurb", "text": "Stigande, fallande, stigande-fallande och fallande-stigande."}, {"key": "pron.skill.connectedSpeech", "text": "Sammanhängande tal"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Länkning, elision, assimilation, svaga former."}, {"key": "pron.skill.reductions", "text": "Reduktioner"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — informellt talad engelska."}, {"key": "pron.skill.rhythm", "text": "Rytm"}, {"key": "pron.skill.rhythm.blurb", "text": "Betoningstakt, timing och pauser."}, {"key": "pron.skill.chunking", "text": "Pausering och frasering"}, {"key": "pron.skill.chunking.blurb", "text": "Tankegrupper och naturliga andningspauser."}, {"key": "pron.skill.fluency", "text": "Flyt"}, {"key": "pron.skill.fluency.blurb", "text": "Tempo, tvekan, utfyllnadsord och att länka idéer."}, {"key": "pron.filter.searchPlaceholder", "text": "Sök ett ljud, ord eller lektion"}, {"key": "pron.filter.allLevels", "text": "Alla nivåer"}, {"key": "pron.filter.beginner", "text": "Nybörjare"}, {"key": "pron.filter.intermediate", "text": "Medel"}, {"key": "pron.filter.advanced", "text": "Avancerad"}, {"key": "pron.filter.allDifficulties", "text": "Alla svårighetsgrader"}, {"key": "pron.filter.gentle", "text": "Lätt"}, {"key": "pron.filter.steady", "text": "Medel"}, {"key": "pron.filter.challenging", "text": "Utmanande"}, {"key": "pron.filter.us", "text": "Amerikansk engelska"}, {"key": "pron.filter.uk", "text": "Brittisk engelska"}, {"key": "pron.sounds.title", "text": "De {{count}} engelska ljuden"}, {"key": "pron.sounds.shown", "text": "{{count}} visas"}, {"key": "pron.lessons.title", "text": "Lektioner i {{skill}}"}, {"key": "pron.lessons.none", "text": "Ingen lektion matchar dessa filter. Prova ”Alla nivåer” och ”Alla svårighetsgrader”."}, {"key": "pron.how", "text": "Hur"}, {"key": "pron.commonMistakes", "text": "Vanliga misstag"}, {"key": "pron.wordPractice", "text": "Ordövning"}, {"key": "pron.sentencePractice", "text": "Meningövning"}, {"key": "pron.minimalPairs", "text": "Minimala par"}, {"key": "pron.practise", "text": "Öva"}, {"key": "pron.toast.signInModel", "text": "Logga in för att höra AI-modellens ljud."}, {"key": "pron.toast.playError", "text": "Kunde inte spela upp ljudet."}, {"key": "pron.voicedDesc", "text": "Tonande — stämbanden vibrerar"}, {"key": "pron.voicelessDesc", "text": "Tonlös — bara luft, ingen vibration"}, {"key": "pron.soundPracticeHint", "text": "Tryck på ”1. Lyssna” i övningskortet till höger för att höra AI-modellen säga ljudet och ett exempel."}, {"key": "pron.paywall.soundLocked", "text": "Det här ljudets fullständiga lektion — hur det bildas, munposition, exempelord, meningar och minimala par — ingår i Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "De första {{count}} ljuden är gratis. Uppgradera för att låsa upp alla 44 ljud och personlig återkoppling från coachen."}, {"key": "pron.paywall.unlockAllSounds", "text": "Lås upp alla 44 ljud"}, {"key": "pron.wordPracticeHint", "text": "Klicka på ett ord för att höra AI och öva"}, {"key": "pron.eg", "text": "t.ex."}, {"key": "pron.playing", "text": "Spelar"}, {"key": "pron.listen", "text": "Lyssna"}, {"key": "pron.paywall.lessonLocked", "text": "Den här lektionens förklaring, övningspunkter och exempel ingår i Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "De första {{count}} lektionerna i varje färdighet är gratis. Uppgradera för att låsa upp resten."}, {"key": "pron.paywall.unlockAllLessons", "text": "Lås upp alla lektioner"}, {"key": "pron.itemPracticeHint", "text": "Klicka på objektet för att öva med AI"}, {"key": "pron.practiceHint", "text": "Lyssna, upprepa, spela in och jämför — coachen visar exakt vilka ord som kom fram tydligt."}, {"key": "pron.drillsCount", "text": "{{count}} övningar"}, {"key": "pron.useInShadowing", "text": "Använd denna färdighet i Shadowing"}, {"key": "pron.backToCoach", "text": "Tillbaka till Speaking Coach"}, {"key": "pron.p.title", "text": "Öva"}, {"key": "pron.p.step1.label", "text": "Lyssna"}, {"key": "pron.p.step1.hint", "text": "Spela upp modelljudet två gånger."}, {"key": "pron.p.step2.label", "text": "Förstå"}, {"key": "pron.p.step2.hint", "text": "Läs vad munnen ska göra."}, {"key": "pron.p.step3.label", "text": "Titta / lär"}, {"key": "pron.p.step3.hint", "text": "Kolla guiden för mun, tunga och mönster."}, {"key": "pron.p.step4.label", "text": "Upprepa"}, {"key": "pron.p.step4.hint", "text": "Säg det högt med ljudet, långsamt först."}, {"key": "pron.p.step5.label", "text": "Spela in"}, {"key": "pron.p.step5.hint", "text": "Spela in dig själv när du säger samma rad."}, {"key": "pron.p.step6.label", "text": "AI-feedback"}, {"key": "pron.p.step6.hint", "text": "Se vad coachen hörde och vad du bör fixa."}, {"key": "pron.p.step7.label", "text": "Försök igen"}, {"key": "pron.p.step7.hint", "text": "Fixa en sak och spela in en gång till."}, {"key": "pron.p.step8.label", "text": "Bemästrad"}, {"key": "pron.p.step8.hint", "text": "Tydlig uppläsning två gånger i rad — gå vidare."}, {"key": "pron.p.stepTap", "text": "{{hint}} Tryck när du har gjort detta."}, {"key": "pron.p.focusSound", "text": "Fokusljud {{sound}}"}, {"key": "pron.p.eg", "text": "t.ex. {{sentence}}"}, {"key": "pron.p.loading", "text": "Laddar…"}, {"key": "pron.p.speedNormal", "text": "Normal"}, {"key": "pron.p.speedSlower", "text": "Långsammare"}, {"key": "pron.p.speedSlow", "text": "Långsam"}, {"key": "pron.p.loop", "text": "Loopa"}, {"key": "pron.p.stop", "text": "Stopp"}, {"key": "pron.p.voiceNote", "text": "Modelljudet är Lingoras amerikanska AI-röst, inte en mänsklig inspelning."}, {"key": "pron.p.listenSentence", "text": "Lyssna spelar upp ljudet två gånger, sedan exempelordet och till sist en mening med det."}, {"key": "pron.p.listenExample", "text": "Lyssna spelar upp ljudet två gånger, sedan exemplet."}, {"key": "pron.p.recordHint", "text": "Säg raden ovan en gång, tydligt."}, {"key": "pron.p.signupToRecord", "text": "Skapa ett gratis konto för att spela in och få feedback."}, {"key": "pron.p.yourRecording", "text": "Din inspelning"}, {"key": "pron.p.listeningRec", "text": "Lyssnar på din inspelning…"}, {"key": "pron.p.wordsClear", "text": "Ord som sades tydligt"}, {"key": "pron.p.wpm", "text": "Talthastighet (ord/min)"}, {"key": "pron.p.heard", "text": "Lingora hörde"}, {"key": "pron.p.tagClear", "text": "Tydligt"}, {"key": "pron.p.tagNeeds", "text": "Behöver förbättras"}, {"key": "pron.p.measured", "text": "Uppmätt framförande"}, {"key": "pron.p.paceLabel", "text": "Tempo:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} ord per minut ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Naturligt samtal ligger på cirka 120–160."}, {"key": "pron.p.pace.slow", "text": "långsamt"}, {"key": "pron.p.pace.natural", "text": "naturligt"}, {"key": "pron.p.pace.fast", "text": "snabbt"}, {"key": "pron.p.fillersLabel", "text": "Utfyllnadsord:"}, {"key": "pron.p.repeatedLabel", "text": "Upprepade ord:"}, {"key": "pron.p.noneDetected", "text": "inga hittade"}, {"key": "pron.p.measuredNote", "text": "Tempo, utfyllnadsord och upprepningar räknas från din faktiska transkription och inspelningens längd. Tonhöjd, volym och tysta pausers längd mäts inte, så vi bedömer inte intonation eller pauser automatiskt."}, {"key": "pron.p.mastered", "text": "Bemästrad — två tydliga försök"}, {"key": "pron.p.attempt", "text": "Försök {{n}} — två tydliga uppläsningar i rad markerar raden som bemästrad."}, {"key": "pron.p.toShadowing", "text": "Öva på detta i verkligt tal → Shadowing"}, {"key": "pron.p.toCoach", "text": "Använd det med Speaking Coach"}]
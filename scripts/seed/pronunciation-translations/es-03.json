[{"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|point|3", "text": "got to → gotta"}, {"key": "4a1e712b-60c7-4a1a-ba46-bb7dd890b366|caution", "text": "Estas son formas informales del habla. No las escribas en ensayos, correos electrónicos ni exámenes formales, y evítalas en una presentación formal."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|explain", "text": "Más reducciones casuales que escucharás constantemente en películas y conversaciones reales."}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|0", "text": "kind of → kinda"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|1", "text": "sort of → sorta"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|2", "text": "let me → lemme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|3", "text": "give me → gimme"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|point|4", "text": "what do you → whaddaya"}, {"key": "b8706c44-5a49-402e-9382-f18427f2084c|caution", "text": "Solo informal. En un IELTS o una entrevista de trabajo, usa las formas completas."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|explain", "text": "Más reducciones de obligación y hábito comunes en el inglés hablado relajado."}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|0", "text": "have to → hafta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|1", "text": "need to → needa"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|point|2", "text": "used to → useta"}, {"key": "1fe69396-9206-4baf-a8e5-ffcf1b604754|caution", "text": "Solo formas informales del habla — nunca las escribas."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|explain", "text": "Reducciones de modales en pasado — muy comunes al hablar de arrepentimientos o situaciones hipotéticas."}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|0", "text": "could have → coulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|1", "text": "would have → woulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|point|2", "text": "should have → shoulda"}, {"key": "9b9c6914-86f0-4448-91ad-32332b1c44bd|caution", "text": "Solo oral informal — escribe 'could have' completo en la escritura formal."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|explain", "text": "Reducciones muy casuales comunes en canciones, películas y conversaciones relajadas entre amigos."}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|0", "text": "don't know → dunno"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|1", "text": "don't you → dontcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|point|2", "text": "what are you → whatcha"}, {"key": "93381b1d-c960-4403-9a28-d6c4d2a93b75|caution", "text": "Muy informal — solo con amigos cercanos, nunca en contextos profesionales o de examen."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|explain", "text": "Reducciones comunes vinculadas a preposiciones en el habla casual."}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|0", "text": "out of → outta"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|1", "text": "off of → offa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|point|2", "text": "cup of → cuppa"}, {"key": "7b1c6a89-bdad-45bd-9a41-802609c8f2ff|caution", "text": "Solo informal."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|explain", "text": "Exclamaciones cotidianas y frases casuales con fuerte reducción."}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|0", "text": "come on → c'mon"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|1", "text": "going to be → gonna be"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|point|2", "text": "some more → s'more"}, {"key": "beaa82ee-d675-44b8-adf8-596c8ca37c5a|caution", "text": "Solo informal."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|explain", "text": "Los inicios de preguntas se reducen mucho en la conversación rápida e informal."}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|0", "text": "did you → dja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|1", "text": "do you → dya"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|point|2", "text": "would you → wouldja"}, {"key": "96d3b17b-36da-4b59-a18b-5199dc78c582|caution", "text": "Solo para contextos informales y hablados."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|explain", "text": "El habla informal también suele reducir las expresiones de tiempo."}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|0", "text": "a couple of → a couple"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|point|1", "text": "in a minute → in a min"}, {"key": "aef0d49a-5252-4ae2-bca1-9a54870c0117|caution", "text": "Está bien en el habla informal, no en la escritura."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|explain", "text": "Otras reducciones informales muy comunes que se oyen constantemente en la conversación relajada."}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|0", "text": "probably → prolly"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|1", "text": "trying to → tryna"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|point|2", "text": "supposed to → s'posed to"}, {"key": "294bc66f-885f-487c-a434-e3f668c306c5|caution", "text": "Solo informal y hablado."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|explain", "text": "Reducciones informales comunes entre amigos y en el habla informal estadounidense."}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|0", "text": "let's go → less go"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|1", "text": "give it to me → gimme that"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|point|2", "text": "you all → y'all"}, {"key": "5b03a85a-0d23-44a4-b9b5-647d6e65d86f|caution", "text": "Muy informal — 'y'all' es regional (sur de EE. UU.) pero se entiende ampliamente. (US)"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|explain", "text": "Los números redondos reducen sus sonidos consonánticos intermedios en el habla estadounidense rápida e informal."}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|0", "text": "twenty → twenny"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|point|1", "text": "hundred → hunnerd"}, {"key": "1015f614-a8a6-4634-97e1-86252ed3b149|caution", "text": "Solo informal y hablado — di siempre la forma completa en contextos formales."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|explain", "text": "Otro conjunto de palabras cotidianas que pierden regularmente una sílaba en el habla rápida y relajada."}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|0", "text": "different → diff'rent"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|1", "text": "general → gen'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|2", "text": "several → sev'ral"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|point|3", "text": "camera → cam'ra"}, {"key": "69aea060-6196-4732-a658-25a6b0d08e52|caution", "text": "Está bien en el habla casual; di la forma completa claramente en presentaciones formales."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|explain", "text": "Reducciones muy informales que oirás en canciones y en el habla americana casual, pero que nunca deberías usar en entornos profesionales."}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|0", "text": "I'm going to → I'ma"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|point|1", "text": "kind of like → kinda like"}, {"key": "d19575cd-6d8a-4493-b1e0-f3d272543988|caution", "text": "Extremadamente informal — solo con amigos o en letras de canciones, nunca en contextos profesionales."}, {"key": "551b9527-f712-421d-966c-24644f360746|explain", "text": "Más reducciones de saludos cotidianos además de what's up / how's it going."}, {"key": "551b9527-f712-421d-966c-24644f360746|point|0", "text": "how are you → how ya doin'"}, {"key": "551b9527-f712-421d-966c-24644f360746|point|1", "text": "good to see you → good to see ya"}, {"key": "551b9527-f712-421d-966c-24644f360746|caution", "text": "Solo formas habladas casuales."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|explain", "text": "Más reducciones de obligación y deseo comunes en el habla americana relajada."}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|0", "text": "ought to → oughta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|1", "text": "don't have to → don't hafta"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|point|2", "text": "want you → wantcha"}, {"key": "b855faed-9428-4a1b-b95c-1e0c3b2d30c8|caution", "text": "Solo hablado informal."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|explain", "text": "Este es un ejemplo clásico de hasta dónde puede llegar la reducción americana casual — varias palabras se funden en lo que suena como una sola."}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|0", "text": "Did you eat yet? → Jeetyet?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|point|1", "text": "Did you already? → Jeetalready?"}, {"key": "a988c705-5d07-4e9a-a930-5967242b673b|caution", "text": "Extremadamente informal — para reconocer el habla nativa rápida, no para tu propio habla formal."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|explain", "text": "Dos reducciones más a nivel de frase comunes en la conversación casual."}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|0", "text": "because of → 'cause of"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|point|1", "text": "sort of a → sorta a"}, {"key": "e363cee4-e7a6-4107-9da8-a4a5ac3c4a47|caution", "text": "Solo hablado informal."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|explain", "text": "Alternativas casuales muy comunes a 'yes' y 'no' en el inglés hablado relajado."}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|0", "text": "yes → yep / uh-huh"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|point|1", "text": "no → nope / nah"}, {"key": "d885413e-df2d-4088-b5a9-f07b62449289|caution", "text": "Solo en conversación casual — usa 'yes'/'no' en contextos formales o de examen."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|explain", "text": "Ambas se reducen a un 'wanna' de sonido similar, pero una va seguida de un sustantivo y la otra de un verbo — vale la pena notar la diferencia."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|0", "text": "want a (coffee) → wanna coffee"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|point|1", "text": "want to (go) → wanna go"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|caution", "text": "Solo en habla informal."}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|0", "text": "'want a' + sustantivo → wanna"}, {"key": "d0dc977b-e24c-46c3-a2a1-6a98544f014f|note|1", "text": "'want to' + verbo → wanna"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|explain", "text": "La versión negativa de 'would have' se reduce de la misma forma que la forma positiva."}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|point|0", "text": "wouldn't have → wouldn'ta"}, {"key": "6c1b9c14-fcf8-463c-9ba2-34b43d55e77f|caution", "text": "Solo en habla informal — en otros casos escribe 'wouldn't have' completo."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|explain", "text": "Dos reducciones cotidianas más, comunes en explicaciones y peticiones casuales."}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|0", "text": "just because → just 'cause"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|point|1", "text": "going to need → gonna need"}, {"key": "2856e155-9edf-4a4e-9b05-c66ea6dac7d1|caution", "text": "Solo en habla informal."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|explain", "text": "'Ain't' reemplaza am not/is not/are not/has not/have not en el habla muy casual y se escucha en todas partes en canciones y conversaciones informales."}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|0", "text": "I am not → I ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|1", "text": "that is not → that ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|point|2", "text": "you have not → you ain't"}, {"key": "233cf355-0eca-4443-9a49-65fb7f9946ac|caution", "text": "Nunca lo uses al escribir ni en el habla formal — se considera gramática no estándar, aunque sea extremadamente común de forma informal."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|explain", "text": "Una forma casual muy común de decir 'I understand' o literalmente 'caught you'."}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|0", "text": "got you (entender) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|point|1", "text": "got you (atrapar) → gotcha"}, {"key": "dc20f314-54fe-4dbd-a7f9-1b8af815d3af|caution", "text": "Solo en habla informal — di 'I understand' o 'got it' en contextos profesionales."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|explain", "text": "Reducciones de modal + perfecto usadas para suposiciones sobre el pasado, junto con coulda/woulda/shoulda."}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|0", "text": "must have → musta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|point|1", "text": "might have → mighta"}, {"key": "83e44703-96d2-48c4-8303-0bc0b0bbb6ed|caution", "text": "Solo en habla informal — en otros casos escribe 'must have'/'might have' completo."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|explain", "text": "Las contrapartes negativas de coulda/woulda/shoulda, comunes al hablar de arrepentimientos."}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|0", "text": "shouldn't have → shouldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|point|1", "text": "couldn't have → couldn'ta"}, {"key": "ae8c9220-fd86-4c54-a3d7-97ceb131af9a|caution", "text": "Solo en habla informal — escribe 'shouldn't have'/'couldn't have' completo en contextos formales."}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|explain", "text": "En el habla relajada, el sonido final -ing a menudo pierde la 'g', así que suena como -in'. Esto ocurre con casi cualquier verbo terminado en -ing. (, so it sounds like -in)"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|0", "text": "doing → doin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|1", "text": "going → goin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|2", "text": "talking → talkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|point|3", "text": "thinking → thinkin'"}, {"key": "7c1b096d-60ed-4c34-b500-ab3afab592fa|caution", "text": "Solo en habla informal — pronuncia el '-ing' completo y claro en presentaciones, entrevistas y exámenes."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|explain", "text": "El mismo patrón de omisión de la g se aplica a los pronombres indefinidos terminados en -thing."}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|0", "text": "something → somethin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|1", "text": "nothing → nothin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|point|2", "text": "anything → anythin'"}, {"key": "0269fc6d-11c6-4667-9e5f-34ff1033bcf6|caution", "text": "Solo en habla informal."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|explain", "text": "'Them' se reduce a 'em (se pierde el 'th') después de un verbo, en habla informal muy común."}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|0", "text": "tell them → tell 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|1", "text": "get them → get 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|point|2", "text": "ask them → ask 'em"}, {"key": "cd64bb2e-37b3-4869-94d3-830cbdf2eb6a|caution", "text": "Solo en habla informal — di 'them' completo al escribir o en habla formal."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|explain", "text": "'And' se reduce a un sonido rápido 'n' entre dos palabras muy unidas, especialmente en frases hechas."}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|0", "text": "rock and roll → rock 'n' roll"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|1", "text": "fish and chips → fish 'n' chips"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|point|2", "text": "back and forth → back 'n' forth"}, {"key": "66b204c8-d0cb-4469-a82c-7416aa6f96b6|caution", "text": "Común en frases hechas y habla rápida — di 'and' claramente al escribir formalmente."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|explain", "text": "'Because' por sí solo (no solo 'because of') a menudo se acorta a 'cause en respuestas informales."}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|point|0", "text": "because → 'cause"}, {"key": "74f83968-80ee-48d6-8255-ecd4ed9c9028|caution", "text": "Solo en habla informal — escribe 'because' completo en otros casos."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|explain", "text": "'Of course' a menudo pierde su primera palabra en respuestas rápidas e informales."}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|point|0", "text": "of course → 'course"}, {"key": "f8740e37-88d7-4e64-a74d-762766ff4593|caution", "text": "Solo en habla informal."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|explain", "text": "Una pronunciación informal muy común de 'all right', usada para estar de acuerdo o reconocer algo."}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|point|0", "text": "all right → aight"}, {"key": "a1c62d96-731e-4d96-803e-33f2cd732fc7|caution", "text": "Muy informal — di 'all right' o 'okay' en contextos profesionales."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|explain", "text": "'Let you' se reduce de la misma manera que 'want you'/'wantcha'."}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|point|0", "text": "let you → letcha"}, {"key": "fd275dbf-ca1f-489e-93aa-a7928df2aa76|caution", "text": "Solo en habla informal."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|explain", "text": "Otra fusión extrema del habla rápida, similar a 'jeetyet' — varias palabras se comprimen en un solo sonido."}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|point|0", "text": "did you ever → jever"}, {"key": "9bf1b2d8-c97b-4451-8371-0efb3b24ecd0|caution", "text": "Para reconocer el habla nativa rápida, no para tu propio habla formal."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|explain", "text": "Dos reducciones se acumulan cuando 'going to' y 'have to' aparecen juntas."}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|point|0", "text": "going to have to → gonna hafta"}, {"key": "82a1afdf-f024-41d9-bb83-15d15e39a5cf|caution", "text": "Solo en habla informal — en otros contextos escribe 'going to have to' completo."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|explain", "text": "La reducción 'gonna' también se aplica con negaciones y pasado."}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|0", "text": "not going to → not gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|point|1", "text": "wasn't going to → wasn't gonna"}, {"key": "d7d2b06f-c8dd-444a-ba6e-638346e18810|caution", "text": "Solo en habla informal."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|explain", "text": "Una reducción muy común de la tag question en inglés británico, usada para confirmar o enfatizar."}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|point|0", "text": "isn't it → innit"}, {"key": "b0c3028d-02d0-4b69-b6b0-310ed3468566|caution", "text": "Jerga británica muy informal — no la uses en habla formal, ni siquiera en el Reino Unido. (UK)"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|explain", "text": "Una forma casual de proponer algo o pedir acuerdo."}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|point|0", "text": "what do you say → whaddya say"}, {"key": "ddb8cc83-dc22-4690-8bab-748461e813e9|caution", "text": "Solo en habla informal."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|explain", "text": "Una muletilla extremadamente común en el inglés hablado casual, usada mientras piensas o para enfatizar."}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|point|0", "text": "you know → y'know"}, {"key": "16f619b1-adfc-405e-a120-14925cf94795|caution", "text": "Solo como muletilla casual — usarla en exceso suena poco pulido incluso de forma informal."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|explain", "text": "Un saludo muy casual, acortado de 'what's up'."}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|point|0", "text": "what's up → s'up"}, {"key": "3b8f4cc8-03e2-4857-8f5b-1fdccc205c54|caution", "text": "Saludo muy informal solo entre amigos."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|explain", "text": "'Him' y 'her' también se debilitan en el habla casual, similar a 'them' → 'em."}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|0", "text": "tell him → tell 'im"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|point|1", "text": "ask her → ask 'er"}, {"key": "6f674595-f4b4-44fa-9edf-d597d0a2e73a|caution", "text": "Solo en habla informal."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|explain", "text": "'Kinda' y 'sorta' a menudo se combinan para más matización en el habla muy casual."}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|point|0", "text": "kind of sort of → kinda sorta"}, {"key": "066faaed-c7b6-44d1-8bd5-0c29a8119dcb|caution", "text": "Muy informal — evítalo en cualquier contexto profesional o de examen."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|explain", "text": "Otra fusión rápida de inicio de pregunta en el habla, junto a dja y wouldja."}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|point|0", "text": "didn't you → dincha"}, {"key": "5bee9ab9-fa4b-4174-b055-5e0daa1d4a08|caution", "text": "Para reconocer el habla nativa rápida, no para tu propio habla formal."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|explain", "text": "La forma en pasado de 'have to' se reduce de la misma manera que la forma en presente."}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|point|0", "text": "had to → hadta"}, {"key": "b787eef9-022a-4553-a472-0e4e7077c0e4|caution", "text": "Solo en habla informal."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|explain", "text": "Una reducción casual usada en peticiones informales, junto a formas del estilo wouldja y couldja."}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|point|0", "text": "will you → willcha"}, {"key": "0ea50af7-f1be-4ee5-90c9-acf52cfb6dbf|caution", "text": "Solo en habla informal."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|explain", "text": "Las frases de cantidad con 'of' se reducen de la misma manera que 'cup of' en 'cuppa'."}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|0", "text": "lots of → lotsa"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|point|1", "text": "bunch of → buncha"}, {"key": "8eb2f2ac-a4c2-41e6-bc12-9cf7f4a95bc1|caution", "text": "Solo en habla informal."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|explain", "text": "Un intensificador informal fuerte que significa 'a very impressive/big'."}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|point|0", "text": "hell of a → helluva"}, {"key": "643d42f4-55c6-49bb-ba59-6641d41b118a|caution", "text": "Ligeramente vulgar — está bien con amigos, evítalo en contextos profesionales o formales."}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|explain", "text": "Una reducción histórica del antiguo saludo 'how do you do', ahora un saludo casual y amistoso por sí mismo (especialmente en el sur de EE. UU.). (US)"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|point|0", "text": "how do you do → howdy"}, {"key": "d91f71d3-f31d-4215-8d05-8e8a07483832|caution", "text": "Solo como saludo casual y amistoso."}, {"key": "47538641-f573-4840-af35-02857a1d24de|explain", "text": "'I suppose' normalmente pierde su sílaba media en el habla casual, se usa para expresar incertidumbre leve o acuerdo a regañadientes — distinto de 'supposed to' → s'posed to."}, {"key": "47538641-f573-4840-af35-02857a1d24de|point|0", "text": "I suppose → I s'pose"}, {"key": "47538641-f573-4840-af35-02857a1d24de|caution", "text": "Solo en habla informal — escribe 'I suppose' completo en otros casos."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|explain", "text": "Domina las reducciones con 50 ejercicios específicos. Escucha con atención al modelo de IA, repite y graba tu voz para recibir puntuación y comentarios detallados de pronunciación en tiempo real. (AI)"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|0", "text": "Céntrate en el ritmo, el acento y la fluidez destacados en cada ejercicio."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|1", "text": "Escucha el audio del modelo de referencia antes de cada intento de grabación."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|point|2", "text": "Revisa tu puntuación de IA y los comentarios a nivel de fonema para identificar áreas de mejora. (AI)"}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|caution", "text": "No hagas los ejercicios con prisa; prioriza la claridad, la cadencia natural y una articulación precisa."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|0", "text": "Reducción extrema de palabras auxiliares en un flujo natural."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|1", "text": "'going to' -> 'gonna'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|2", "text": "'have got to' se reduce a 'gotta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|3", "text": "'want a' -> 'wanna'; 'of' -> 'a' /ə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|4", "text": "'has to' -> 'hasta' /hæstə/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|5", "text": "'let me' -> 'lemme'; 'you' -> 'ya'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|6", "text": "'give me' -> 'gimme'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|7", "text": "'could you' -> 'couldja' /kʊdʒə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|8", "text": "'would you' -> 'wouldja'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|9", "text": "'what did you' -> 'whaddya'; 'him' -> ''im'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|10", "text": "'should have' -> 'shoulda' /ʃʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|11", "text": "'could have' -> 'coulda' /kʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|12", "text": "'would have' -> 'woulda' /wʊdə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|13", "text": "'must have' -> 'musta' /mʌstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|14", "text": "'might have' -> 'mighta' /maɪtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|15", "text": "'used to' -> 'usta' /juːstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|16", "text": "'supposed to' -> 'sposta' /spoʊstə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|17", "text": "'need to' -> 'needa'; 'to' -> /də/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|18", "text": "'to' -> /də/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|19", "text": "'kind of' -> 'kinda' /kaɪndə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|20", "text": "'sort of' -> 'sorta' /sɔːrtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|21", "text": "'lots of' -> 'lotsa' /lɒtsə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|22", "text": "'out of' -> 'outta' /aʊtə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|23", "text": "'front of' -> 'fronta'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|24", "text": "'I am going to' se reduce a 'I'mma' en el habla informal."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|25", "text": "'don't you' -> 'doncha'; 'want to' -> 'wanna'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|26", "text": "'didn't you' -> 'didn'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|27", "text": "'haven't you' -> 'haven'tcha'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|28", "text": "'and' se reduce a la 'n' silábica /n/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|29", "text": "'day and night' -> 'day 'n night'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|30", "text": "'or' se reduce a /ər/; 'it or' se enlaza sin pausa."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|31", "text": "'or' se reduce a /ər/ átona."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|32", "text": "'and' se reduce a /n/ entre oclusivas."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|33", "text": "El relativo 'that' se reduce a /ðət/ con schwa."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|34", "text": "La conjunción 'that' es débil y breve."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|35", "text": "'that' se pronuncia /ðət/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|36", "text": "'them' se reduce a ''em' /əm/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|37", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|38", "text": "'them' -> ''em'."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|39", "text": "'some' -> /səm/; 'for' -> /fər/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|40", "text": "'for' -> /fər/; 'you' -> /jə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|41", "text": "'are' -> /ər/; 'you' -> /jə/; 'to' -> /tə/."}, {"key": "32c7dc70-a486-4d9c-8fb8-e9696206713d|note|42", "text": "'were' se reduce a /wər/."}]
[{"key": "pron.hero.title", "text": "વધુ સ્પષ્ટ, વધુ કુદરતી, વધુ અસ્ખલિત સંભળાઓ"}, {"key": "pron.hero.description", "text": "બધા {{count}} અંગ્રેજી ધ્વનિઓ ઉપરાંત શબ્દ ભાર, વાક્ય ભાર, સ્વરાઘાત, જોડાયેલી વાણી, ઘટાડા, લય, ખંડીકરણ અને અસ્ખલિતતા — દરેક પાઠ તમારી પોતાની રેકોર્ડિંગ સાથે પૂરો થાય છે."}, {"key": "pron.imageAlt", "text": "ઉચ્ચારણ કલા અને IPA"}, {"key": "pron.progress.title", "text": "તમારી ઉચ્ચારણ પ્રગતિ"}, {"key": "pron.progress.descUser", "text": "કોચે તમારી પોતાની રેકોર્ડિંગમાં ઓળખેલા શબ્દો પરથી માપવામાં આવે છે."}, {"key": "pron.progress.descGuest", "text": "તમારી જાતને રેકોર્ડ કરવા અને પ્રગતિ ટ્રૅક કરવા મફત ખાતું બનાવો."}, {"key": "pron.recommended", "text": "તમારા માટે ભલામણ કરેલ"}, {"key": "pron.soundLabel", "text": "{{symbol}} ધ્વનિ"}, {"key": "pron.skill.sounds", "text": "ધ્વનિઓ"}, {"key": "pron.skill.sounds.blurb", "text": "ન્યૂનતમ જોડીઓ સાથે બધા 44 અંગ્રેજી ધ્વનિઓ."}, {"key": "pron.skill.wordStress", "text": "શબ્દ ભાર"}, {"key": "pron.skill.wordStress.blurb", "text": "ઉચ્ચારાંશ, પ્રાથમિક અને ગૌણ ભાર."}, {"key": "pron.skill.sentenceStress", "text": "વાક્ય ભાર"}, {"key": "pron.skill.sentenceStress.blurb", "text": "અર્થવાહક શબ્દો મજબૂત, સહાયક શબ્દો નબળા."}, {"key": "pron.skill.intonation", "text": "સ્વરાઘાત"}, {"key": "pron.skill.intonation.blurb", "text": "ચઢતો, ઉતરતો, ચઢતો-ઉતરતો અને ઉતરતો-ચઢતો."}, {"key": "pron.skill.connectedSpeech", "text": "જોડાયેલી વાણી"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "જોડાણ, લોપ, સમીકરણ, નબળા સ્વરૂપો."}, {"key": "pron.skill.reductions", "text": "ઘટાડા"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — અનૌપચારિક બોલાયેલી અંગ્રેજી."}, {"key": "pron.skill.rhythm", "text": "લય"}, {"key": "pron.skill.rhythm.blurb", "text": "ભાર-સમયવાળા તાલ, સમય અને વિરામ."}, {"key": "pron.skill.chunking", "text": "વિરામ અને ખંડીકરણ"}, {"key": "pron.skill.chunking.blurb", "text": "વિચાર જૂથો અને કુદરતી શ્વાસ વિરામ."}, {"key": "pron.skill.fluency", "text": "અસ્ખલિતતા"}, {"key": "pron.skill.fluency.blurb", "text": "ઝડપ, અચકાટ, ભરણાં અને વિચારોને જોડવા."}, {"key": "pron.filter.searchPlaceholder", "text": "ધ્વનિ, શબ્દ કે પાઠ શોધો"}, {"key": "pron.filter.allLevels", "text": "બધા સ્તરો"}, {"key": "pron.filter.beginner", "text": "શરૂઆતનું"}, {"key": "pron.filter.intermediate", "text": "મધ્યમ"}, {"key": "pron.filter.advanced", "text": "અદ્યતન"}, {"key": "pron.filter.allDifficulties", "text": "બધી મુશ્કેલીઓ"}, {"key": "pron.filter.gentle", "text": "સરળ"}, {"key": "pron.filter.steady", "text": "સ્થિર"}, {"key": "pron.filter.challenging", "text": "પડકારજનક"}, {"key": "pron.filter.us", "text": "અમેરિકન અંગ્રેજી"}, {"key": "pron.filter.uk", "text": "બ્રિટિશ અંગ્રેજી"}, {"key": "pron.sounds.title", "text": "{{count}} અંગ્રેજી ધ્વનિઓ"}, {"key": "pron.sounds.shown", "text": "{{count}} દર્શાવેલ"}, {"key": "pron.lessons.title", "text": "{{skill}} પાઠ"}, {"key": "pron.lessons.none", "text": "આ ફિલ્ટર્સ સાથે કોઈ પાઠ મેળ ખાતો નથી. \"બધા સ્તરો\" અને \"કોઈપણ મુશ્કેલી\" અજમાવો."}, {"key": "pron.how", "text": "કેવી રીતે"}, {"key": "pron.commonMistakes", "text": "સામાન્ય ભૂલો"}, {"key": "pron.wordPractice", "text": "શબ્દ અભ્યાસ"}, {"key": "pron.sentencePractice", "text": "વાક્ય અભ્યાસ"}, {"key": "pron.minimalPairs", "text": "ન્યૂનતમ જોડીઓ"}, {"key": "pron.practise", "text": "અભ્યાસ કરો"}, {"key": "pron.toast.signInModel", "text": "AI મોડેલનો અવાજ સાંભળવા સાઇન ઇન કરો."}, {"key": "pron.toast.playError", "text": "ઑડિયો વગાડી શકાયો નહીં."}, {"key": "pron.voicedDesc", "text": "ઘોષ — તમારા સ્વરતંતુઓ કંપે છે"}, {"key": "pron.voicelessDesc", "text": "અઘોષ — ફક્ત શ્વાસ, કોઈ કંપન નહીં"}, {"key": "pron.soundPracticeHint", "text": "જમણી બાજુના અભ્યાસ કાર્ડમાં \"1. સાંભળો\" પર ટૅપ કરો જેથી AI મોડેલ આ ધ્વનિ અને ઉદાહરણ સાંભળી શકાય."}, {"key": "pron.paywall.soundLocked", "text": "આ ધ્વનિનો સંપૂર્ણ પાઠ — તેને કેવી રીતે બનાવવો, મુખની સ્થિતિ, ઉદાહરણ શબ્દો, વાક્યો અને ન્યૂનતમ જોડીઓ — Lingora English Premium નો ભાગ છે."}, {"key": "pron.paywall.freeLimit", "text": "પ્રથમ {{count}} ધ્વનિઓ મફત છે. બધા 44 ધ્વનિઓ અને વ્યક્તિગત કોચ પ્રતિસાદ અનલૉક કરવા અપગ્રેડ કરો."}, {"key": "pron.paywall.unlockAllSounds", "text": "બધા 44 ધ્વનિઓ અનલૉક કરો"}, {"key": "pron.wordPracticeHint", "text": "AI સાંભળવા અને અભ્યાસ કરવા શબ્દ પર ક્લિક કરો"}, {"key": "pron.eg", "text": "દા.ત."}, {"key": "pron.playing", "text": "વાગી રહ્યું છે"}, {"key": "pron.listen", "text": "સાંભળો"}, {"key": "pron.paywall.lessonLocked", "text": "આ પાઠની સમજૂતી, અભ્યાસ મુદ્દાઓ અને ઉદાહરણો Lingora English Premium નો ભાગ છે."}, {"key": "pron.paywall.lessonFreeLimit", "text": "દરેક સ્કિલના પહેલા {{count}} પાઠ મફત છે. બાકીના અનલૉક કરવા અપગ્રેડ કરો."}, {"key": "pron.paywall.unlockAllLessons", "text": "બધા પાઠ અનલૉક કરો"}, {"key": "pron.itemPracticeHint", "text": "AI સાથે અભ્યાસ કરવા આઇટમ પર ક્લિક કરો"}, {"key": "pron.practiceHint", "text": "સાંભળો, પુનરાવર્તન કરો, રેકોર્ડ કરો અને તુલના કરો — કોચ બતાવે છે કે કયા શબ્દો સ્પષ્ટ સંભળાયા."}, {"key": "pron.drillsCount", "text": "{{count}} ડ્રિલ્સ"}, {"key": "pron.useInShadowing", "text": "આ સ્કિલ શેડોઇંગમાં વાપરો"}, {"key": "pron.backToCoach", "text": "સ્પીકિંગ કોચ પર પાછા જાઓ"}, {"key": "pron.p.title", "text": "અભ્યાસ"}, {"key": "pron.p.step1.label", "text": "સાંભળો"}, {"key": "pron.p.step1.hint", "text": "મોડેલ ઑડિયો બે વાર ચલાવો."}, {"key": "pron.p.step2.label", "text": "સમજો"}, {"key": "pron.p.step2.hint", "text": "તમારા મોંને શું કરવું તે વાંચો."}, {"key": "pron.p.step3.label", "text": "જુઓ / શીખો"}, {"key": "pron.p.step3.hint", "text": "મોં, જીભ અને પેટર્ન ગાઇડ તપાસો."}, {"key": "pron.p.step4.label", "text": "પુનરાવર્તન કરો"}, {"key": "pron.p.step4.hint", "text": "ઑડિયો સાથે મોટેથી બોલો, પહેલા ધીમે."}, {"key": "pron.p.step5.label", "text": "રેકોર્ડ કરો"}, {"key": "pron.p.step5.hint", "text": "એ જ લાઇન બોલતા તમારી જાતને રેકોર્ડ કરો."}, {"key": "pron.p.step6.label", "text": "AI પ્રતિસાદ"}, {"key": "pron.p.step6.hint", "text": "કોચે શું સાંભળ્યું અને શું સુધારવું તે જુઓ."}, {"key": "pron.p.step7.label", "text": "ફરી પ્રયાસ કરો"}, {"key": "pron.p.step7.hint", "text": "એક વસ્તુ સુધારો અને ફરી એક વાર રેકોર્ડ કરો."}, {"key": "pron.p.step8.label", "text": "માસ્ટર થયું"}, {"key": "pron.p.step8.hint", "text": "સતત બે વાર સ્પષ્ટ વાંચો — આગળ વધો."}, {"key": "pron.p.stepTap", "text": "{{hint}} આ કર્યા પછી ટૅપ કરો."}, {"key": "pron.p.focusSound", "text": "ફોકસ સાઉન્ડ {{sound}}"}, {"key": "pron.p.eg", "text": "દા.ત. {{sentence}}"}, {"key": "pron.p.loading", "text": "લોડ થઈ રહ્યું છે…"}, {"key": "pron.p.speedNormal", "text": "સામાન્ય"}, {"key": "pron.p.speedSlower", "text": "ધીમું"}, {"key": "pron.p.speedSlow", "text": "ખૂબ ધીમું"}, {"key": "pron.p.loop", "text": "લૂપ"}, {"key": "pron.p.stop", "text": "બંધ કરો"}, {"key": "pron.p.voiceNote", "text": "મોડેલ ઑડિયો Lingora નો અમેરિકન ઇંગ્લિશ AI અવાજ છે, માનવ રેકોર્ડિંગ નથી."}, {"key": "pron.p.listenSentence", "text": "સાંભળો સાઉન્ડ બે વાર, પછી ઉદાહરણ શબ્દ, પછી તે ધરાવતું વાક્ય ચલાવે છે."}, {"key": "pron.p.listenExample", "text": "સાંભળો સાઉન્ડ બે વાર, પછી ઉદાહરણ ચલાવે છે."}, {"key": "pron.p.recordHint", "text": "ઉપરની લાઇન એક વાર સ્પષ્ટ બોલો."}, {"key": "pron.p.signupToRecord", "text": "રેકોર્ડ કરવા અને પ્રતિસાદ મેળવવા મફત એકાઉન્ટ બનાવો."}, {"key": "pron.p.yourRecording", "text": "તમારું રેકોર્ડિંગ"}, {"key": "pron.p.listeningRec", "text": "તમારું રેકોર્ડિંગ સાંભળી રહ્યા છીએ…"}, {"key": "pron.p.wordsClear", "text": "સ્પષ્ટ બોલાયેલા શબ્દો"}, {"key": "pron.p.wpm", "text": "બોલવાની ઝડપ (wpm)"}, {"key": "pron.p.heard", "text": "Lingora એ સાંભળ્યું"}, {"key": "pron.p.tagClear", "text": "સ્પષ્ટ"}, {"key": "pron.p.tagNeeds", "text": "સુધારાની જરૂર"}, {"key": "pron.p.measured", "text": "માપેલી રજૂઆત"}, {"key": "pron.p.paceLabel", "text": "ગતિ:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} શબ્દ પ્રતિ મિનિટ ({{pace}})"}, {"key": "pron.p.paceNote", "text": "કુદરતી વાતચીત લગભગ 120–160 હોય છે."}, {"key": "pron.p.pace.slow", "text": "ધીમી"}, {"key": "pron.p.pace.natural", "text": "કુદરતી"}, {"key": "pron.p.pace.fast", "text": "ઝડપી"}, {"key": "pron.p.fillersLabel", "text": "ભરતી-શબ્દો:"}, {"key": "pron.p.repeatedLabel", "text": "પુનરાવર્તિત શબ્દો:"}, {"key": "pron.p.noneDetected", "text": "કોઈ મળ્યું નથી"}, {"key": "pron.p.measuredNote", "text": "ગતિ, ભરતી-શબ્દો અને પુનરાવર્તન તમારા વાસ્તવિક ટ્રાન્સક્રિપ્ટ અને રેકોર્ડિંગ લંબાઈ પરથી ગણાય છે. પિચ, અવાજની તીવ્રતા અને મૌન-વિરામની લંબાઈ માપવામાં આવતી નથી, તેથી અમે સ્વર-ઉચ્ચારણ કે વિરામને આપોઆપ સ્કોર કરતા નથી."}, {"key": "pron.p.mastered", "text": "માસ્ટર થયું — બે સ્પષ્ટ પ્રયાસ"}, {"key": "pron.p.attempt", "text": "પ્રયાસ {{n}} — સતત બે સ્પષ્ટ વાંચન આ લાઇનને માસ્ટર તરીકે ચિહ્નિત કરે છે."}, {"key": "pron.p.toShadowing", "text": "આને વાસ્તવિક બોલવામાં અભ્યાસ કરો → શેડોઇંગ"}, {"key": "pron.p.toCoach", "text": "સ્પીકિંગ કોચ સાથે વાપરો"}]
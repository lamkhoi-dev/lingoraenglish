[{"key": "pron.hero.title", "text": "Fale com mais clareza, naturalidade e fluência"}, {"key": "pron.hero.description", "text": "Todos os {{count}} sons do inglês, além de acento de palavra, acento de frase, entonação, fala conectada, reduções, ritmo, chunking e fluência — cada lição termina com a sua própria gravação."}, {"key": "pron.imageAlt", "text": "Articulação e IPA da pronúncia"}, {"key": "pron.progress.title", "text": "Seu progresso na pronúncia"}, {"key": "pron.progress.descUser", "text": "Medido a partir das palavras que o coach reconheceu nas suas próprias gravações."}, {"key": "pron.progress.descGuest", "text": "Crie uma conta gratuita para se gravar e começar a acompanhar seu progresso."}, {"key": "pron.recommended", "text": "Recomendado para você"}, {"key": "pron.soundLabel", "text": "Som {{symbol}}"}, {"key": "pron.skill.sounds", "text": "Sons"}, {"key": "pron.skill.sounds.blurb", "text": "Todos os 44 fonemas do inglês com pares mínimos."}, {"key": "pron.skill.wordStress", "text": "Acento de palavra"}, {"key": "pron.skill.wordStress.blurb", "text": "Sílabas, acento primário e secundário."}, {"key": "pron.skill.sentenceStress", "text": "Acento de frase"}, {"key": "pron.skill.sentenceStress.blurb", "text": "Palavras de conteúdo fortes, palavras funcionais fracas."}, {"key": "pron.skill.intonation", "text": "Entonação"}, {"key": "pron.skill.intonation.blurb", "text": "Ascendente, descendente, ascendente-descendente e descendente-ascendente."}, {"key": "pron.skill.connectedSpeech", "text": "Fala conectada"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "Ligação, elisão, assimilação, formas fracas."}, {"key": "pron.skill.reductions", "text": "Reduções"}, {"key": "pron.skill.reductions.blurb", "text": "gonna, wanna, hafta — inglês falado informal."}, {"key": "pron.skill.rhythm", "text": "Ritmo"}, {"key": "pron.skill.rhythm.blurb", "text": "Batidas com tempo acentual, timing e pausas."}, {"key": "pron.skill.chunking", "text": "Pausas e chunking"}, {"key": "pron.skill.chunking.blurb", "text": "Grupos de pensamento e pausas naturais para respirar."}, {"key": "pron.skill.fluency", "text": "Fluência"}, {"key": "pron.skill.fluency.blurb", "text": "Velocidade, hesitação, muletas e conexão de ideias."}, {"key": "pron.filter.searchPlaceholder", "text": "Buscar um som, palavra ou lição"}, {"key": "pron.filter.allLevels", "text": "Todos os níveis"}, {"key": "pron.filter.beginner", "text": "Iniciante"}, {"key": "pron.filter.intermediate", "text": "Intermediário"}, {"key": "pron.filter.advanced", "text": "Avançado"}, {"key": "pron.filter.allDifficulties", "text": "Todas as dificuldades"}, {"key": "pron.filter.gentle", "text": "Leve"}, {"key": "pron.filter.steady", "text": "Moderado"}, {"key": "pron.filter.challenging", "text": "Desafiador"}, {"key": "pron.filter.us", "text": "Inglês americano"}, {"key": "pron.filter.uk", "text": "Inglês britânico"}, {"key": "pron.sounds.title", "text": "Os {{count}} sons do inglês"}, {"key": "pron.sounds.shown", "text": "{{count}} exibidos"}, {"key": "pron.lessons.title", "text": "Lições de {{skill}}"}, {"key": "pron.lessons.none", "text": "Nenhuma lição corresponde a esses filtros. Tente “Todos os níveis” e “Todas as dificuldades”."}, {"key": "pron.how", "text": "Como"}, {"key": "pron.commonMistakes", "text": "Erros comuns"}, {"key": "pron.wordPractice", "text": "Prática de palavras"}, {"key": "pron.sentencePractice", "text": "Prática de frases"}, {"key": "pron.minimalPairs", "text": "Pares mínimos"}, {"key": "pron.practise", "text": "Praticar"}, {"key": "pron.toast.signInModel", "text": "Entre para ouvir o modelo de IA."}, {"key": "pron.toast.playError", "text": "Não foi possível reproduzir o áudio."}, {"key": "pron.voicedDesc", "text": "Sonoro — suas cordas vocais vibram"}, {"key": "pron.voicelessDesc", "text": "Surdo — apenas sopro, sem vibração"}, {"key": "pron.soundPracticeHint", "text": "Toque em \"1. Ouvir\" no cartão de Prática à direita para ouvir o modelo de IA deste som e um exemplo."}, {"key": "pron.paywall.soundLocked", "text": "A lição completa deste som — como produzi-lo, posição da boca, palavras de exemplo, frases e pares mínimos — faz parte do Lingora English Premium."}, {"key": "pron.paywall.freeLimit", "text": "Os primeiros {{count}} sons são gratuitos. Faça upgrade para desbloquear todos os 44 sons e o feedback personalizado do coach."}, {"key": "pron.paywall.unlockAllSounds", "text": "Desbloquear todos os 44 sons"}, {"key": "pron.wordPracticeHint", "text": "Clique na palavra para ouvir a IA e praticar"}, {"key": "pron.eg", "text": "ex.:"}, {"key": "pron.playing", "text": "Reproduzindo"}, {"key": "pron.listen", "text": "Ouvir"}, {"key": "pron.paywall.lessonLocked", "text": "A explicação, os pontos de prática e os exemplos desta lição fazem parte do Lingora English Premium."}, {"key": "pron.paywall.lessonFreeLimit", "text": "As primeiras {{count}} lições de cada habilidade são gratuitas. Faça upgrade para desbloquear o resto."}, {"key": "pron.paywall.unlockAllLessons", "text": "Desbloquear todas as lições"}, {"key": "pron.itemPracticeHint", "text": "Clique no item para praticar com IA"}, {"key": "pron.practiceHint", "text": "Ouça, repita, grave e compare — o treinador mostra exatamente quais palavras saíram claras."}, {"key": "pron.drillsCount", "text": "{{count}} exercícios"}, {"key": "pron.useInShadowing", "text": "Usar esta habilidade no Shadowing"}, {"key": "pron.backToCoach", "text": "Voltar ao Treinador de Fala"}, {"key": "pron.p.title", "text": "Praticar"}, {"key": "pron.p.step1.label", "text": "Ouvir"}, {"key": "pron.p.step1.hint", "text": "Reproduza o áudio modelo duas vezes."}, {"key": "pron.p.step2.label", "text": "Entender"}, {"key": "pron.p.step2.hint", "text": "Leia o que a sua boca deve fazer."}, {"key": "pron.p.step3.label", "text": "Ver / aprender"}, {"key": "pron.p.step3.hint", "text": "Confira o guia de boca, língua e padrão."}, {"key": "pron.p.step4.label", "text": "Repetir"}, {"key": "pron.p.step4.hint", "text": "Diga em voz alta junto com o áudio, devagar primeiro."}, {"key": "pron.p.step5.label", "text": "Gravar"}, {"key": "pron.p.step5.hint", "text": "Grave você mesmo dizendo a mesma frase."}, {"key": "pron.p.step6.label", "text": "Feedback da IA"}, {"key": "pron.p.step6.hint", "text": "Veja o que o treinador ouviu e o que corrigir."}, {"key": "pron.p.step7.label", "text": "Tentar de novo"}, {"key": "pron.p.step7.hint", "text": "Corrija uma coisa e grave mais uma vez."}, {"key": "pron.p.step8.label", "text": "Dominado"}, {"key": "pron.p.step8.hint", "text": "Leitura clara duas vezes seguidas — siga em frente."}, {"key": "pron.p.stepTap", "text": "{{hint}} Toque quando tiver feito isso."}, {"key": "pron.p.focusSound", "text": "Som em foco {{sound}}"}, {"key": "pron.p.eg", "text": "ex.: {{sentence}}"}, {"key": "pron.p.loading", "text": "Carregando…"}, {"key": "pron.p.speedNormal", "text": "Normal"}, {"key": "pron.p.speedSlower", "text": "Mais devagar"}, {"key": "pron.p.speedSlow", "text": "Devagar"}, {"key": "pron.p.loop", "text": "Repetir"}, {"key": "pron.p.stop", "text": "Parar"}, {"key": "pron.p.voiceNote", "text": "O áudio modelo é a voz de IA de inglês americano da Lingora, não uma gravação humana."}, {"key": "pron.p.listenSentence", "text": "Ouvir reproduz o som duas vezes, depois a palavra de exemplo e depois uma frase que a contém."}, {"key": "pron.p.listenExample", "text": "Ouvir reproduz o som duas vezes, depois o exemplo."}, {"key": "pron.p.recordHint", "text": "Diga a frase acima uma vez, com clareza."}, {"key": "pron.p.signupToRecord", "text": "Crie uma conta gratuita para gravar e receber feedback."}, {"key": "pron.p.yourRecording", "text": "Sua gravação"}, {"key": "pron.p.listeningRec", "text": "Ouvindo sua gravação…"}, {"key": "pron.p.wordsClear", "text": "Palavras ditas com clareza"}, {"key": "pron.p.wpm", "text": "Velocidade da fala (ppm)"}, {"key": "pron.p.heard", "text": "A Lingora ouviu"}, {"key": "pron.p.tagClear", "text": "Claro"}, {"key": "pron.p.tagNeeds", "text": "Precisa melhorar"}, {"key": "pron.p.measured", "text": "Entrega medida"}, {"key": "pron.p.paceLabel", "text": "Ritmo:"}, {"key": "pron.p.paceValue", "text": "{{wpm}} palavras por minuto ({{pace}})"}, {"key": "pron.p.paceNote", "text": "Uma conversa natural fica em torno de 120–160."}, {"key": "pron.p.pace.slow", "text": "lento"}, {"key": "pron.p.pace.natural", "text": "natural"}, {"key": "pron.p.pace.fast", "text": "rápido"}, {"key": "pron.p.fillersLabel", "text": "Muletas:"}, {"key": "pron.p.repeatedLabel", "text": "Palavras repetidas:"}, {"key": "pron.p.noneDetected", "text": "nenhuma detectada"}, {"key": "pron.p.measuredNote", "text": "Ritmo, muletas e repetição são contados a partir da sua transcrição real e da duração da gravação. Tom, volume e duração de pausas silenciosas não são medidos, então não avaliamos entonação nem pausas automaticamente."}, {"key": "pron.p.mastered", "text": "Dominado — duas tentativas claras"}, {"key": "pron.p.attempt", "text": "Tentativa {{n}} — duas leituras claras seguidas marcam esta frase como dominada."}, {"key": "pron.p.toShadowing", "text": "Pratique isso na fala real → Shadowing"}, {"key": "pron.p.toCoach", "text": "Use com o Treinador de Fala"}]
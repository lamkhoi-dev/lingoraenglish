[{"key": "edaa2de3-f674-4a5e-93fc-70861e79042c|note|5", "text": "價格每年上漲。"}, {"key": "ef925ddf-56e5-4075-85f5-ebef2db9e81d|explain", "text": "加上字尾時，重音經常會移動。較長的單字也會有一個較弱的次重音。"}, {"key": "ef925ddf-56e5-4075-85f5-ebef2db9e81d|point|0", "text": "主重音：最強的節拍。"}, {"key": "ef925ddf-56e5-4075-85f5-ebef2db9e81d|point|1", "text": "次重音：較弱的節拍，通常在單字中較前面的位置。"}, {"key": "ef925ddf-56e5-4075-85f5-ebef2db9e81d|note|3", "text": "次重音在 'pro' 上。"}, {"key": "ef925ddf-56e5-4075-85f5-ebef2db9e81d|note|4", "text": "次重音在 'in' 上。"}, {"key": "691bb2a2-c8ad-40a9-bc64-0fe3cff375b6|explain", "text": "這種名詞／動詞的模式非常常見——英文中有數十個單字都是這樣運作的。"}, {"key": "691bb2a2-c8ad-40a9-bc64-0fe3cff375b6|point|0", "text": "名詞 = 重音在第一個音節。"}, {"key": "691bb2a2-c8ad-40a9-bc64-0fe3cff375b6|point|1", "text": "動詞 = 重音在第二個音節。"}, {"key": "691bb2a2-c8ad-40a9-bc64-0fe3cff375b6|note|0", "text": "Sign the contract."}, {"key": "691bb2a2-c8ad-40a9-bc64-0fe3cff375b6|note|1", "text": "Muscles contract when you exercise."}, {"key": "691bb2a2-c8ad-40a9-bc64-0fe3cff375b6|note|2", "text": "What is that object?"}, {"key": "691bb2a2-c8ad-40a9-bc64-0fe3cff375b6|note|3", "text": "I object to this plan."}, {"key": "691bb2a2-c8ad-40a9-bc64-0fe3cff375b6|note|4", "text": "This is a big project."}, {"key": "691bb2a2-c8ad-40a9-bc64-0fe3cff375b6|note|5", "text": "They project a small loss."}, {"key": "a68598f4-b5ce-4fff-8a85-52c2487576cd|explain", "text": "持續練習這個模式，直到切換重音變得自然而然。"}, {"key": "a68598f4-b5ce-4fff-8a85-52c2487576cd|point|0", "text": "也要注意母音音質的變化，不只是音量大小。"}, {"key": "a68598f4-b5ce-4fff-8a85-52c2487576cd|note|0", "text": "Coffee is a major export."}, {"key": "a68598f4-b5ce-4fff-8a85-52c2487576cd|note|1", "text": "We export coffee worldwide."}, {"key": "a68598f4-b5ce-4fff-8a85-52c2487576cd|note|2", "text": "You need a permit."}, {"key": "a68598f4-b5ce-4fff-8a85-52c2487576cd|note|3", "text": "They don't permit smoking."}, {"key": "a68598f4-b5ce-4fff-8a85-52c2487576cd|note|4", "text": "The police have a suspect."}, {"key": "a68598f4-b5ce-4fff-8a85-52c2487576cd|note|5", "text": "I suspect he is lying."}, {"key": "049d70a3-0db5-4415-8969-83f28ca6bb76|explain", "text": "大多數的雙音節英文名詞，重音都落在第一個音節。"}, {"key": "049d70a3-0db5-4415-8969-83f28ca6bb76|point|0", "text": "這是名詞的預設模式——除非你學到不同的例外，否則先假設重音在第一個音節。"}, {"key": "ad2178ac-bddd-4638-9de9-5e04a8721928|explain", "text": "大多數的雙音節英文動詞，重音都落在第二個音節——與名詞相反。"}, {"key": "ad2178ac-bddd-4638-9de9-5e04a8721928|point|0", "text": "這是動詞的預設模式。"}, {"key": "f3af3e6c-219b-4130-9e9a-e4da95b6c3d2|explain", "text": "以 -tion 或 -sion 結尾的單字，重音一定落在字尾正前方的那個音節。"}, {"key": "f3af3e6c-219b-4130-9e9a-e4da95b6c3d2|point|0", "text": "-tion / -sion → 重音移到它正前方的那個音節。"}, {"key": "f3af3e6c-219b-4130-9e9a-e4da95b6c3d2|note|3", "text": "例外模式——不確定時請查字典。"}, {"key": "aea8f0e0-be60-4e9c-a75a-c1aa9b841df8|explain", "text": "以 -ic 或 -ical 結尾的字，重音落在字尾前的那個音節，就跟 -tion 一樣。"}, {"key": "aea8f0e0-be60-4e9c-a75a-c1aa9b841df8|point|0", "text": "-ic / -ical → 重音落在字尾前的音節。"}, {"key": "600ff396-41c8-4a4a-b56b-8faba455337e|explain", "text": "另一個可靠的規則：-ity 和 -ety 會把重音拉到緊接在它們前面的那個音節。"}, {"key": "600ff396-41c8-4a4a-b56b-8faba455337e|point|0", "text": "-ity / -ety → 重音落在字尾前的音節。"}, {"key": "f3091559-0863-4539-a61e-a015e2346813|explain", "text": "在字前面加上 un-、re-、dis- 或 non- 不會改變重音位置——前綴本身保持弱讀。"}, {"key": "f3091559-0863-4539-a61e-a015e2346813|point|0", "text": "un- / re- / dis- / non- 幾乎從不重讀。"}, {"key": "f3091559-0863-4539-a61e-a015e2346813|note|3", "text": "常見的例外——'nonsense' 的重音落在第一個音節。"}, {"key": "16a5a8c4-e8b5-4780-935b-e2bb30562c4b|explain", "text": "當兩個字組合成一個名詞時，重音通常落在第一個字上。"}, {"key": "16a5a8c4-e8b5-4780-935b-e2bb30562c4b|point|0", "text": "複合名詞 → 重音落在第 1 個字。 (NOUN)"}, {"key": "16a5a8c4-e8b5-4780-935b-e2bb30562c4b|point|1", "text": "和片語形容詞比較，後者的重音落在第 2 個字（見下一課）。"}, {"key": "16a5a8c4-e8b5-4780-935b-e2bb30562c4b|note|0", "text": "一種鳥。"}, {"key": "9da7fc1c-397f-436f-b91a-0c3f01891a69|explain", "text": "和上一課比較：當它其實是形容詞修飾名詞時（兩個獨立的字、兩個意思），重音會移到名詞上。"}, {"key": "9da7fc1c-397f-436f-b91a-0c3f01891a69|point|0", "text": "black BIRD = 一隻黑色的鳥（任何鳥）。"}, {"key": "9da7fc1c-397f-436f-b91a-0c3f01891a69|point|1", "text": "BLACKbird = 某一特定種類的鳥。"}, {"key": "9da7fc1c-397f-436f-b91a-0c3f01891a69|note|0", "text": "任何剛好是黑色的鳥。"}, {"key": "9da7fc1c-397f-436f-b91a-0c3f01891a69|note|1", "text": "一棟漆成綠色的房子。"}, {"key": "9da7fc1c-397f-436f-b91a-0c3f01891a69|note|2", "text": "比較：WHITEhouse（複合詞）並不存在——這仍是兩個字。"}, {"key": "9da7fc1c-397f-436f-b91a-0c3f01891a69|note|3", "text": "一隻很熱的狗（不是食物 HOT dog）。"}, {"key": "653e14bd-40e4-486d-82f8-4d3af229dd23|explain", "text": "Thirteen 和 thirty 經常被混淆。重音位置是主要的差別。"}, {"key": "653e14bd-40e4-486d-82f8-4d3af229dd23|point|0", "text": "-TEEN 數字：重音落在第二個音節。"}, {"key": "653e14bd-40e4-486d-82f8-4d3af229dd23|point|1", "text": "-ty 數字：重音落在第一個音節。"}, {"key": "653e14bd-40e4-486d-82f8-4d3af229dd23|note|4", "text": "誇大這個對比，讓聽者能分辨兩者。"}, {"key": "0bb88819-aaae-4279-aede-d11c1d82e20a|explain", "text": "職稱詞彙——你在閒聊和面試中會不斷用到。"}, {"key": "0bb88819-aaae-4279-aede-d11c1d82e20a|point|0", "text": "大多數以 -er/-or/-ist 結尾，重音落在該字尾前的音節。"}, {"key": "0bb88819-aaae-4279-aede-d11c1d82e20a|note|1", "text": "例外——重音落在最後一個音節。"}, {"key": "2ee2a7dc-55e5-47c8-8b89-21f44a8f29b3|explain", "text": "常見科技詞彙——對工作會議以及日常談論手機和電腦的對話很有用。"}, {"key": "2ee2a7dc-55e5-47c8-8b89-21f44a8f29b3|note|4", "text": "名詞／動詞——兩者的重音都保持在第一個音節。"}, {"key": "89d2edc3-768a-424d-a572-25542e3c8c5b|explain", "text": "你在每場會議都會說到的字——把重音唸對，你在職場上就會聽起來很有自信。"}, {"key": "80692209-2db3-476f-86f0-290a4c3ed3d4|explain", "text": "下次旅行前先練習這些——把 'hotel' 或 'airport' 唸錯是常見的絆腳石。"}, {"key": "9393958a-8832-4a28-b46c-58d7f59474e8|explain", "text": "日常食物詞彙——非常適合在餐廳對話中使用。"}, {"key": "0a99bd3c-ccd6-4851-8eab-50292e0331fb|explain", "text": "談論家庭是學習者最先需要掌握的主題之一——從一開始就要把重音唸對。"}, {"key": "6b07add7-7e7d-49d7-a3b5-3b1adf64347d|explain", "text": "準確描述感受需要正確的重音，否則聽者可能完全聽錯單字。"}, {"key": "be0cebb6-000d-435e-b2e6-3ce52820ed37|explain", "text": "國家與國籍名稱的重音對學習者來說往往出乎意料。"}, {"key": "a40b2c4b-e725-4e9f-95b6-5ef7b7daba00|explain", "text": "以 -ous 結尾的形容詞，重音幾乎總是落在字尾前的那個音節。"}, {"key": "a40b2c4b-e725-4e9f-95b6-5ef7b7daba00|point|0", "text": "-ous → 重音落在它前面的音節。"}, {"key": "bb16473a-f90e-4fa1-b26a-48bccf19fb40|explain", "text": "和 -ous 一樣，字尾 -ial 和 -ual 通常會把重音拉到緊接在它們前面的音節。"}, {"key": "993ad6af-369e-49b3-8844-f76d76afec93|explain", "text": "以 -ate 結尾的單字可以是名詞或形容詞（母音較短、重音較前面），也可以是動詞（完整的 'ate' /eɪt/、重音較後面）。"}, {"key": "993ad6af-369e-49b3-8844-f76d76afec93|point|0", "text": "名詞／形容詞 -ate：較短、重音較前面。"}, {"key": "993ad6af-369e-49b3-8844-f76d76afec93|point|1", "text": "動詞 -ate：完整的 /eɪt/ 音，重音通常較後面。"}, {"key": "993ad6af-369e-49b3-8844-f76d76afec93|note|0", "text": "字尾音節弱化。"}, {"key": "993ad6af-369e-49b3-8844-f76d76afec93|note|1", "text": "字尾是完整的 /eɪt/。"}, {"key": "993ad6af-369e-49b3-8844-f76d76afec93|note|3", "text": "很少用作動詞——'certify' 更常見。"}, {"key": "629259c2-155c-4e65-b535-a78c025367a1|explain", "text": "當你逐字母拼出縮寫時，最後一個字母通常會得到最強的重音。 (LAST)"}, {"key": "629259c2-155c-4e65-b535-a78c025367a1|point|0", "text": "逐字母拼讀：最後一個字母最重。"}, {"key": "629259c2-155c-4e65-b535-a78c025367a1|note|0", "text": "重音落在 'A' 上。"}, {"key": "05a2daaf-34af-4dfb-8de6-70354419131c|explain", "text": "時間詞彙在每次對話中都會用到，所以要及早練到重音自動化。"}, {"key": "32b69097-f847-4911-b4a6-276b6d06162d|explain", "text": "英文借用了許多法文詞，且往往保留它們在法文中最後音節的重音。"}, {"key": "32b69097-f847-4911-b4a6-276b6d06162d|point|0", "text": "法文借詞通常重音落在最後一個音節——與典型英文名詞相反。 (LAST)"}, {"key": "32b69097-f847-4911-b4a6-276b6d06162d|note|1", "text": "英式英文通常說 GAR-age。"}, {"key": "0ad59539-cebf-4d7f-af12-c16be8e9f7fe|explain", "text": "名詞前的連字號形容詞單獨唸時，通常第二部分重音較強，但放在所修飾的名詞前時會變得平均。"}, {"key": "0ad59539-cebf-4d7f-af12-c16be8e9f7fe|note|0", "text": "一位 well-known 作家。"}, {"key": "0ad59539-cebf-4d7f-af12-c16be8e9f7fe|note|1", "text": "一份 part-time 工作。"}, {"key": "f4747901-e83b-4c41-b74c-998ca89c134e|explain", "text": "三音節單字通常重音落在第一個音節，但並非總是如此——遇到不熟悉的單字一定要再確認。"}, {"key": "f4747901-e83b-4c41-b74c-998ca89c134e|note|3", "text": "例外——重音落在中間音節。"}, {"key": "f4747901-e83b-4c41-b74c-998ca89c134e|note|4", "text": "例外——重音落在中間音節。"}, {"key": "3487b877-2a10-4e1e-8dc1-9cb339d3c793|explain", "text": "以 -al 結尾的單字，重音通常與其字根單字落在相同位置。"}, {"key": "3487b877-2a10-4e1e-8dc1-9cb339d3c793|note|3", "text": "這裡重音確實會移動——是值得留意的例外。"}, {"key": "81410615-130c-4dad-a5c3-167102ed1fbb|explain", "text": "談論嗜好是經典的閒聊題材——要熟悉這類詞彙。"}, {"key": "9c80d65e-c1f1-48b9-874a-02c4f06398e3|explain", "text": "聊天氣是通用的閒聊話題——務必把重音練到自動化。"}, {"key": "66dccf48-ac78-4da4-94b8-de0bb0201e2c|explain", "text": "實用、有時甚至急迫的詞彙——值得練到自動化為止。"}, {"key": "53439508-9bed-4e98-a87c-11ef56316d50|explain", "text": "學校與學習詞彙——在 IELTS Speaking Part 1 中也很常見。"}, {"key": "40e3702c-e1b5-4b3c-aa49-c21e0f0b0a00|explain", "text": "金錢詞彙不斷出現——從購物到薪資談判都少不了。"}, {"key": "2f62fdf2-30c0-4f0d-955e-69d423bc9e56|explain", "text": "名詞／動詞重音位移模式的最後一輪——到現在應該開始覺得自然而然了。"}, {"key": "2f62fdf2-30c0-4f0d-955e-69d423bc9e56|note|4", "text": "英式英語通常兩者都重讀第二個音節。"}, {"key": "5e2111a3-9ba8-4275-84cd-151eb8d7e94b|explain", "text": "-able 和 -ible 通常不會改變字根的重音。"}, {"key": "36f811e0-e465-49a6-a355-2e47d28d55d9|explain", "text": "學術英語使用冗長、源自拉丁文的詞彙——套用你已學過的 -tion／-ity／-ic 規則。"}, {"key": "7a9c158d-7f4d-4d2b-bc25-9c463df9d224|explain", "text": "這些字你每天都會說到——從第一天起就自然地重讀它們。"}, {"key": "04049d68-eab4-4afb-bb30-9b2d418fb736|explain", "text": "地名有時會打破一般規則——值得把常見的背下來。"}, {"key": "04049d68-eab4-4afb-bb30-9b2d418fb736|note|3", "text": "在美式口語中也常說成 BANG-kok。"}, {"key": "375a4330-2894-4010-8de9-be1c3c65881a|explain", "text": "以 -ize（美式）或 -ise（英式）結尾的動詞，重音保持在字尾前的那個音節。 (US) (UK)"}, {"key": "0057ea87-3856-4279-97f6-041f0b6d7829|explain", "text": "這些描述性形容詞能讓你閒聊時更生動。"}, {"key": "0dc8acd6-a65e-4ef1-b445-d04082631bb9|explain", "text": "拼字不一定能預測重音——這些長得幾乎一樣的字連進階學習者都會搞混。"}, {"key": "a3c88bea-e525-431d-9eac-e1e316af174a|explain", "text": "最後一組混合練習，綜合名詞、動詞、字尾規則與複合詞——先唸出每個字，再對照模式。"}, {"key": "92b85fc0-d477-416e-a675-ff03a849f9e1|explain", "text": "片語動詞重讀助詞；由它衍生的名詞則重讀第一部分。"}, {"key": "92b85fc0-d477-416e-a675-ff03a849f9e1|point|0", "text": "動詞：break DOWN、print OUT。"}, {"key": "92b85fc0-d477-416e-a675-ff03a849f9e1|point|1", "text": "名詞：a BREAKdown、a PRINTout。"}, {"key": "227cd8e7-9ec3-4b6d-84f2-d5ea0e5c9e74|explain", "text": "Hundred、thousand 和 million 本身從不重讀——重音落在緊接在它們前面的數字上。"}, {"key": "227cd8e7-9ec3-4b6d-84f2-d5ea0e5c9e74|note|3", "text": "常見的價格模式：$9.99。"}, {"key": "43523a38-19e6-4a4e-b12a-fa43f881266c|explain", "text": "慣用語有自己固定的重音模式，學習者應把它當作一個整體來記。"}, {"key": "79d5ac8d-0db1-4406-88b2-0c51e0cca12b|explain", "text": "有些常見字實際說出來時，幾乎總是比拼字少一個音節——這會改變重音落下的位置。"}, {"key": "79d5ac8d-0db1-4406-88b2-0c51e0cca12b|note|0", "text": "快速說話時是 3 個音節，不是 4 個。"}, {"key": "79d5ac8d-0db1-4406-88b2-0c51e0cca12b|note|1", "text": "3 個音節，不是 4 個。"}, {"key": "79d5ac8d-0db1-4406-88b2-0c51e0cca12b|note|2", "text": "2 個音節，不是 3 個。"}, {"key": "79d5ac8d-0db1-4406-88b2-0c51e0cca12b|note|3", "text": "2 個音節，不是 3 個。"}, {"key": "4e68253d-8f5b-412b-848e-9bca76a3d4ca|explain", "text": "最後一組混合練習——名詞、動詞、複合詞與字尾規則一起來。先唸出每個字，再對照模式。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|explain", "text": "透過 50 個針對性練習精通單字重音。仔細聽 AI 示範、跟著複誦，並錄下你的聲音，以獲得即時的詳細發音評分與回饋。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|point|0", "text": "專注於每個練習中標示的節奏、重音與語流。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|point|1", "text": "每次錄音前先聽參考示範音檔。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|point|2", "text": "查看你的 AI 分數與音素層級回饋，找出需要改進的地方。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|caution", "text": "不要急著做完練習；以清晰度、自然的語調與準確的發音為優先。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|0", "text": "第三個音節 'CA' 帶有主要重音。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|1", "text": "第二個音節 'TIF' 為重音。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|2", "text": "主要重音在第一個音節 'CAT'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|3", "text": "第二個音節 'FRIG' 為重音；其他音節弱化。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|4", "text": "重音在 -tic 前的 'AS'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|5", "text": "重音在 -ity 前的 'AL'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|6", "text": "重音在 -ity 前的 'TRIC'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|7", "text": "主要重音在 -tion 前的 'TRA'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|8", "text": "主要重音在 -tion 前的 'CA'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|9", "text": "主要重音在 -tion 前的 'GA'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|10", "text": "第二個音節 'NIF' 為重拍。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|11", "text": "美式英語中第一個音節 'LAB' 為重音。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|12", "text": "第二個音節 'TIC' 為重音。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|13", "text": "第二個音節 'IN' 帶有主要重音。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|14", "text": "第一個音節 'FAS' 帶有重音。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|15", "text": "第一個音節 'AR' 為重音。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|16", "text": "第一個音節 'AR' 帶有主要重音。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|17", "text": "重音轉移至第三個音節 'TEC'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|18", "text": "第二個音節 'OG' 為重音。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|19", "text": "重音轉移至 -ic 前的 'GRAPH'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|20", "text": "第二個音節 'LOS' 為重音。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|21", "text": "重音轉移至 -ical 前的 'SOPH'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|22", "text": "第二個音節 'CHOL' 為重音。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|23", "text": "重音轉移至 -ical 前的 'LOG'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|24", "text": "第二個音節 'TRON' 為重音。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|25", "text": "重音轉移至 -ical 前的 'NOM'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|26", "text": "第二個音節 'PRE' 帶有重音。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|27", "text": "重音在第四個音節 'PE'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|28", "text": "第二個音節 'TIC' 為重音。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|29", "text": "第二個音節 'GRAT' 帶有主要重音。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|30", "text": "第二音節 'CEL' 重讀。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|31", "text": "字尾 -ee 將重音吸引到最後一個音節。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|32", "text": "字尾 -eer 重音落在最後。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|33", "text": "最後一個音節 'NIR' 接受主要重音。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|34", "text": "重音在最後一個音節 'RETTE'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|35", "text": "複合名詞：主要重音在第一個名詞 'KITCH'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|36", "text": "複合名詞：重讀第一個元素 'SUN'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|37", "text": "複合名詞：第一個音節 'RAIN' 重讀。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|38", "text": "複合名詞：重音在 'HEAD'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|39", "text": "複合名詞：'EARTH' 被強調。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|40", "text": "複合名詞：重音在 'FIRE'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|41", "text": "複合名詞：主要重音落在 'TRAF'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|42", "text": "動名詞複合詞：主要重音在 'SWIM'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|43", "text": "名詞：重音在第一個音節 'RE'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|44", "text": "動詞：重音移到第二個音節 'FUND'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|45", "text": "名詞：重音在第一個音節 'PRO'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|46", "text": "動詞：重音移到第二個音節 'TEST'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|47", "text": "名詞：重音在前綴 'UP'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|48", "text": "動詞：重音移到 'DATE'。"}, {"key": "29cd7e6b-cc33-47d3-b0bd-10cc5117cc29|note|49", "text": "第二音節 'LIB' 重讀。"}]
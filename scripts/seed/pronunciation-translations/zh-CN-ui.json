[{"key": "pron.hero.title", "text": "发音更清晰、更自然、更流利"}, {"key": "pron.hero.description", "text": "涵盖全部 {{count}} 个英语音素，以及单词重音、句子重音、语调、连读、弱读、节奏、意群和流利度——每节课都以你自己的录音结束。"}, {"key": "pron.imageAlt", "text": "发音口型与音标"}, {"key": "pron.progress.title", "text": "你的发音进度"}, {"key": "pron.progress.descUser", "text": "根据教练在你自己的录音中识别出的单词来评估。"}, {"key": "pron.progress.descGuest", "text": "创建免费账户即可录音并开始跟踪进度。"}, {"key": "pron.recommended", "text": "为你推荐"}, {"key": "pron.soundLabel", "text": "{{symbol}} 音"}, {"key": "pron.skill.sounds", "text": "音素"}, {"key": "pron.skill.sounds.blurb", "text": "全部 44 个英语音素及最小对立对。"}, {"key": "pron.skill.wordStress", "text": "单词重音"}, {"key": "pron.skill.wordStress.blurb", "text": "音节、主重音和次重音。"}, {"key": "pron.skill.sentenceStress", "text": "句子重音"}, {"key": "pron.skill.sentenceStress.blurb", "text": "实词重读，虚词弱读。"}, {"key": "pron.skill.intonation", "text": "语调"}, {"key": "pron.skill.intonation.blurb", "text": "升调、降调、升降调和降升调。"}, {"key": "pron.skill.connectedSpeech", "text": "连读"}, {"key": "pron.skill.connectedSpeech.blurb", "text": "连读、省音、同化和弱读形式。"}, {"key": "pron.skill.reductions", "text": "缩略读法"}, {"key": "pron.skill.reductions.blurb", "text": "gonna、wanna、hafta——非正式英语口语。"}, {"key": "pron.skill.rhythm", "text": "节奏"}, {"key": "pron.skill.rhythm.blurb", "text": "重音节拍、时值和停顿。"}, {"key": "pron.skill.chunking", "text": "停顿与意群"}, {"key": "pron.skill.chunking.blurb", "text": "思维组块和自然的呼吸停顿。"}, {"key": "pron.skill.fluency", "text": "流利度"}, {"key": "pron.skill.fluency.blurb", "text": "语速、犹豫、填充词和观点衔接。"}, {"key": "pron.filter.searchPlaceholder", "text": "搜索音素、单词或课程"}, {"key": "pron.filter.allLevels", "text": "所有级别"}, {"key": "pron.filter.beginner", "text": "初级"}, {"key": "pron.filter.intermediate", "text": "中级"}, {"key": "pron.filter.advanced", "text": "高级"}, {"key": "pron.filter.allDifficulties", "text": "所有难度"}, {"key": "pron.filter.gentle", "text": "轻松"}, {"key": "pron.filter.steady", "text": "稳步"}, {"key": "pron.filter.challenging", "text": "挑战"}, {"key": "pron.filter.us", "text": "美式英语"}, {"key": "pron.filter.uk", "text": "英式英语"}, {"key": "pron.sounds.title", "text": "{{count}} 个英语音素"}, {"key": "pron.sounds.shown", "text": "显示 {{count}} 个"}, {"key": "pron.lessons.title", "text": "{{skill}}课程"}, {"key": "pron.lessons.none", "text": "没有符合这些筛选条件的课程。试试“所有级别”和“所有难度”。"}, {"key": "pron.how", "text": "发音方法"}, {"key": "pron.commonMistakes", "text": "常见错误"}, {"key": "pron.wordPractice", "text": "单词练习"}, {"key": "pron.sentencePractice", "text": "句子练习"}, {"key": "pron.minimalPairs", "text": "最小对立对"}, {"key": "pron.practise", "text": "练习"}, {"key": "pron.toast.signInModel", "text": "登录后即可收听 AI 示范发音。"}, {"key": "pron.toast.playError", "text": "无法播放音频。"}, {"key": "pron.voicedDesc", "text": "浊音——声带振动"}, {"key": "pron.voicelessDesc", "text": "清音——仅送气，声带不振动"}, {"key": "pron.soundPracticeHint", "text": "点击右侧练习卡片中的“1. 听”，收听 AI 示范该音素和一个示例。"}, {"key": "pron.paywall.soundLocked", "text": "该音素的完整课程——发音方法、口型位置、示例单词、句子和最小对立对——属于 Lingora English Premium 的内容。"}, {"key": "pron.paywall.freeLimit", "text": "前 {{count}} 个音素免费。升级即可解锁全部 44 个音素和个性化教练反馈。"}, {"key": "pron.paywall.unlockAllSounds", "text": "解锁全部 44 个音素"}, {"key": "pron.wordPracticeHint", "text": "点击单词收听 AI 发音并练习"}, {"key": "pron.eg", "text": "例如"}, {"key": "pron.playing", "text": "播放中"}, {"key": "pron.listen", "text": "听"}, {"key": "pron.paywall.lessonLocked", "text": "该课程的讲解、练习要点和示例属于 Lingora English Premium 的内容。"}, {"key": "pron.paywall.lessonFreeLimit", "text": "每个技能的前 {{count}} 节课免费。升级即可解锁其余内容。"}, {"key": "pron.paywall.unlockAllLessons", "text": "解锁全部课程"}, {"key": "pron.itemPracticeHint", "text": "点击条目与 AI 一起练习"}, {"key": "pron.practiceHint", "text": "听、跟读、录音、对比——教练会准确指出哪些词读得清晰。"}, {"key": "pron.drillsCount", "text": "{{count}} 个练习"}, {"key": "pron.useInShadowing", "text": "在跟读中使用此技能"}, {"key": "pron.backToCoach", "text": "返回口语教练"}, {"key": "pron.p.title", "text": "练习"}, {"key": "pron.p.step1.label", "text": "听"}, {"key": "pron.p.step1.hint", "text": "播放示范音频两遍。"}, {"key": "pron.p.step2.label", "text": "理解"}, {"key": "pron.p.step2.hint", "text": "阅读嘴部动作说明。"}, {"key": "pron.p.step3.label", "text": "观看 / 学习"}, {"key": "pron.p.step3.hint", "text": "查看嘴型、舌头和发音模式指南。"}, {"key": "pron.p.step4.label", "text": "跟读"}, {"key": "pron.p.step4.hint", "text": "跟着音频大声说出来，先慢速。"}, {"key": "pron.p.step5.label", "text": "录音"}, {"key": "pron.p.step5.hint", "text": "录下自己说同一句话。"}, {"key": "pron.p.step6.label", "text": "AI 反馈"}, {"key": "pron.p.step6.hint", "text": "看看教练听到了什么，以及需要改进的地方。"}, {"key": "pron.p.step7.label", "text": "再试一次"}, {"key": "pron.p.step7.hint", "text": "改正一个问题，再录一次。"}, {"key": "pron.p.step8.label", "text": "已掌握"}, {"key": "pron.p.step8.hint", "text": "连续两次清晰读出——继续下一句。"}, {"key": "pron.p.stepTap", "text": "{{hint}} 完成后点击一下。"}, {"key": "pron.p.focusSound", "text": "重点音 {{sound}}"}, {"key": "pron.p.eg", "text": "例如 {{sentence}}"}, {"key": "pron.p.loading", "text": "加载中…"}, {"key": "pron.p.speedNormal", "text": "正常"}, {"key": "pron.p.speedSlower", "text": "较慢"}, {"key": "pron.p.speedSlow", "text": "慢速"}, {"key": "pron.p.loop", "text": "循环"}, {"key": "pron.p.stop", "text": "停止"}, {"key": "pron.p.voiceNote", "text": "示范音频是 Lingora 的美式英语 AI 语音，并非真人录音。"}, {"key": "pron.p.listenSentence", "text": "点击听会播放两遍发音，然后是示例词，最后是包含该词的句子。"}, {"key": "pron.p.listenExample", "text": "点击听会播放两遍发音，然后是示例。"}, {"key": "pron.p.recordHint", "text": "清晰地读出上面这句话一次。"}, {"key": "pron.p.signupToRecord", "text": "创建免费账户即可录音并获得反馈。"}, {"key": "pron.p.yourRecording", "text": "你的录音"}, {"key": "pron.p.listeningRec", "text": "正在听你的录音…"}, {"key": "pron.p.wordsClear", "text": "读得清晰的词"}, {"key": "pron.p.wpm", "text": "语速（词/分钟）"}, {"key": "pron.p.heard", "text": "Lingora 听到的"}, {"key": "pron.p.tagClear", "text": "清晰"}, {"key": "pron.p.tagNeeds", "text": "需要改进"}, {"key": "pron.p.measured", "text": "实测表达"}, {"key": "pron.p.paceLabel", "text": "语速："}, {"key": "pron.p.paceValue", "text": "{{wpm}} 词/分钟（{{pace}}）"}, {"key": "pron.p.paceNote", "text": "自然对话约为 120–160。"}, {"key": "pron.p.pace.slow", "text": "偏慢"}, {"key": "pron.p.pace.natural", "text": "自然"}, {"key": "pron.p.pace.fast", "text": "偏快"}, {"key": "pron.p.fillersLabel", "text": "填充词："}, {"key": "pron.p.repeatedLabel", "text": "重复的词："}, {"key": "pron.p.noneDetected", "text": "未检测到"}, {"key": "pron.p.measuredNote", "text": "语速、填充词和重复是根据你的真实转录文本和录音时长统计的。音高、音量和静音停顿时长未测量，因此我们不会自动为语调和停顿评分。"}, {"key": "pron.p.mastered", "text": "已掌握——两次清晰尝试"}, {"key": "pron.p.attempt", "text": "第 {{n}} 次尝试——连续两次清晰读出即可将此句标记为已掌握。"}, {"key": "pron.p.toShadowing", "text": "在真实语境中练习 → 跟读"}, {"key": "pron.p.toCoach", "text": "配合口语教练使用"}]
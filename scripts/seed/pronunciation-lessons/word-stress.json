{
  "lessons": [
    {
      "title": "What is word stress?",
      "level": "beginner",
      "difficulty": "easy",
      "accent": "us",
      "explain": "Every English word of two or more syllables has one strong syllable. The strong one is longer, louder and clearer.",
      "points": [
        "Stressed syllable: longer, louder, clear vowel.",
        "Unstressed syllable: short and often a schwa /ə/.",
        "Only one primary stress per word."
      ],
      "items": [
        {
          "text": "water",
          "pattern": "WA-ter",
          "note": "Two syllables, stress on the first."
        },
        {
          "text": "hotel",
          "pattern": "ho-TEL",
          "note": "Stress on the second."
        },
        {
          "text": "computer",
          "pattern": "com-PU-ter",
          "note": "Middle syllable is strongest."
        },
        {
          "text": "important",
          "pattern": "im-POR-tant",
          "note": "The two weak syllables use /ə/."
        },
        {
          "text": "beautiful",
          "pattern": "BEAU-ti-ful",
          "note": "First syllable carries the beat."
        }
      ]
    },
    {
      "title": "Stress that changes the word",
      "level": "intermediate",
      "difficulty": "medium",
      "accent": "us",
      "explain": "Some words change meaning or word class when the stress moves. Say both versions and feel the difference.",
      "points": [
        "Nouns often stress the first syllable.",
        "Verbs often stress the second syllable."
      ],
      "items": [
        {
          "text": "a REcord",
          "pattern": "REcord (noun)",
          "note": "I bought a record."
        },
        {
          "text": "to reCORD",
          "pattern": "reCORD (verb)",
          "note": "I want to record my voice."
        },
        {
          "text": "a PREsent",
          "pattern": "PREsent (noun)",
          "note": "Here is your present."
        },
        {
          "text": "to preSENT",
          "pattern": "preSENT (verb)",
          "note": "I will present the plan."
        },
        {
          "text": "an INcrease",
          "pattern": "INcrease (noun)",
          "note": "There is an increase in price."
        },
        {
          "text": "to inCREASE",
          "pattern": "inCREASE (verb)",
          "note": "Prices increase every year."
        }
      ]
    },
    {
      "title": "Word families and secondary stress",
      "level": "advanced",
      "difficulty": "hard",
      "accent": "us",
      "explain": "When you add an ending, the stress often moves. Longer words also have a weaker secondary beat.",
      "points": [
        "Primary stress: the strongest beat.",
        "Secondary stress: a smaller beat, usually earlier in the word."
      ],
      "items": [
        {
          "text": "photograph",
          "pattern": "PHO-to-graph"
        },
        {
          "text": "photographer",
          "pattern": "pho-TO-gra-pher"
        },
        {
          "text": "photographic",
          "pattern": "pho-to-GRAPH-ic"
        },
        {
          "text": "pronunciation",
          "pattern": "pro-nun-ci-A-tion",
          "note": "Secondary beat on 'pro'."
        },
        {
          "text": "international",
          "pattern": "in-ter-NA-tio-nal",
          "note": "Secondary beat on 'in'."
        }
      ]
    },
    {
      "title": "More noun/verb stress pairs",
      "level": "intermediate",
      "difficulty": "medium",
      "accent": "us",
      "explain": "This noun/verb pattern is very common — dozens of English words work this way.",
      "points": [
        "Noun = stress first syllable.",
        "Verb = stress second syllable."
      ],
      "items": [
        {
          "text": "a CONtract",
          "pattern": "CONtract (noun)",
          "note": "Sign the contract."
        },
        {
          "text": "to conTRACT",
          "pattern": "conTRACT (verb)",
          "note": "Muscles contract when you exercise."
        },
        {
          "text": "an OBject",
          "pattern": "OBject (noun)",
          "note": "What is that object?"
        },
        {
          "text": "to obJECT",
          "pattern": "obJECT (verb)",
          "note": "I object to this plan."
        },
        {
          "text": "a PROject",
          "pattern": "PROject (noun)",
          "note": "This is a big project."
        },
        {
          "text": "to proJECT",
          "pattern": "proJECT (verb)",
          "note": "They project a small loss."
        }
      ]
    },
    {
      "title": "Even more noun/verb pairs",
      "level": "advanced",
      "difficulty": "medium",
      "accent": "us",
      "explain": "Keep practising this pattern until switching the stress feels automatic.",
      "points": [
        "Listen for the vowel quality change too, not just loudness."
      ],
      "items": [
        {
          "text": "an EXport",
          "pattern": "EXport (noun)",
          "note": "Coffee is a major export."
        },
        {
          "text": "to exPORT",
          "pattern": "exPORT (verb)",
          "note": "We export coffee worldwide."
        },
        {
          "text": "a PERmit",
          "pattern": "PERmit (noun)",
          "note": "You need a permit."
        },
        {
          "text": "to perMIT",
          "pattern": "perMIT (verb)",
          "note": "They don't permit smoking."
        },
        {
          "text": "a SUSpect",
          "pattern": "SUSpect (noun)",
          "note": "The police have a suspect."
        },
        {
          "text": "to susPECT",
          "pattern": "susPECT (verb)",
          "note": "I suspect he is lying."
        }
      ]
    },
    {
      "title": "Two-syllable nouns: first-syllable stress",
      "level": "beginner",
      "difficulty": "easy",
      "accent": "us",
      "explain": "Most two-syllable English nouns stress the first syllable.",
      "points": [
        "This is the default pattern for nouns — assume first syllable unless you learn otherwise."
      ],
      "items": [
        {
          "text": "table",
          "pattern": "TA-ble"
        },
        {
          "text": "window",
          "pattern": "WIN-dow"
        },
        {
          "text": "garden",
          "pattern": "GAR-den"
        },
        {
          "text": "office",
          "pattern": "OF-fice"
        },
        {
          "text": "picture",
          "pattern": "PIC-ture"
        }
      ]
    },
    {
      "title": "Two-syllable verbs: second-syllable stress",
      "level": "beginner",
      "difficulty": "easy",
      "accent": "us",
      "explain": "Most two-syllable English verbs stress the second syllable — the opposite of nouns.",
      "points": [
        "This is the default pattern for verbs."
      ],
      "items": [
        {
          "text": "begin",
          "pattern": "be-GIN"
        },
        {
          "text": "forget",
          "pattern": "for-GET"
        },
        {
          "text": "arrive",
          "pattern": "ar-RIVE"
        },
        {
          "text": "decide",
          "pattern": "de-CIDE"
        },
        {
          "text": "suggest",
          "pattern": "sug-GEST"
        }
      ]
    },
    {
      "title": "-tion and -sion always take the stress before them",
      "level": "intermediate",
      "difficulty": "medium",
      "accent": "us",
      "explain": "Words ending in -tion or -sion always stress the syllable right before the ending.",
      "points": [
        "-tion / -sion → stress moves to the syllable just before it."
      ],
      "items": [
        {
          "text": "information",
          "pattern": "in-for-MA-tion"
        },
        {
          "text": "decision",
          "pattern": "de-CI-sion"
        },
        {
          "text": "celebration",
          "pattern": "ce-le-BRA-tion"
        },
        {
          "text": "television",
          "pattern": "TE-le-vi-sion",
          "note": "Exception pattern — check a dictionary if unsure."
        },
        {
          "text": "organization",
          "pattern": "or-ga-ni-ZA-tion"
        }
      ]
    },
    {
      "title": "-ic and -ical always take the stress before them",
      "level": "intermediate",
      "difficulty": "medium",
      "accent": "us",
      "explain": "Words ending in -ic or -ical stress the syllable right before the ending, just like -tion.",
      "points": [
        "-ic / -ical → stress the syllable before the ending."
      ],
      "items": [
        {
          "text": "economic",
          "pattern": "e-co-NO-mic"
        },
        {
          "text": "photographic",
          "pattern": "pho-to-GRAPH-ic"
        },
        {
          "text": "historical",
          "pattern": "his-TO-ri-cal"
        },
        {
          "text": "scientific",
          "pattern": "sci-en-TI-fic"
        },
        {
          "text": "athletic",
          "pattern": "ath-LE-tic"
        }
      ]
    },
    {
      "title": "-ity and -ety always take the stress before them",
      "level": "advanced",
      "difficulty": "hard",
      "accent": "us",
      "explain": "Another reliable rule: -ity and -ety pull the stress onto the syllable right before them.",
      "points": [
        "-ity / -ety → stress the syllable before the ending."
      ],
      "items": [
        {
          "text": "ability",
          "pattern": "a-BI-li-ty"
        },
        {
          "text": "university",
          "pattern": "u-ni-VER-si-ty"
        },
        {
          "text": "curiosity",
          "pattern": "cu-ri-O-si-ty"
        },
        {
          "text": "variety",
          "pattern": "va-RI-e-ty"
        },
        {
          "text": "responsibility",
          "pattern": "re-spon-si-BI-li-ty"
        }
      ]
    },
    {
      "title": "Prefixes usually don't take the stress",
      "level": "intermediate",
      "difficulty": "medium",
      "accent": "us",
      "explain": "Adding un-, re-, dis- or non- to a word doesn't move the stress — the prefix stays weak.",
      "points": [
        "un- / re- / dis- / non- are almost never stressed."
      ],
      "items": [
        {
          "text": "happy → unhappy",
          "pattern": "un-HAP-py"
        },
        {
          "text": "do → redo",
          "pattern": "re-DO"
        },
        {
          "text": "agree → disagree",
          "pattern": "dis-a-GREE"
        },
        {
          "text": "sense → nonsense",
          "pattern": "NON-sense",
          "note": "A common exception — 'nonsense' stresses the first syllable."
        },
        {
          "text": "possible → impossible",
          "pattern": "im-POS-si-ble"
        }
      ]
    },
    {
      "title": "Compound nouns: stress the first word",
      "level": "intermediate",
      "difficulty": "medium",
      "accent": "us",
      "explain": "When two words combine into one noun, the first word usually carries the stress.",
      "points": [
        "Compound NOUN → stress word 1.",
        "Compare with phrasal adjectives, which stress word 2 (see next lesson)."
      ],
      "items": [
        {
          "text": "blackbird",
          "pattern": "BLACK-bird",
          "note": "One kind of bird."
        },
        {
          "text": "greenhouse",
          "pattern": "GREEN-house"
        },
        {
          "text": "keyboard",
          "pattern": "KEY-board"
        },
        {
          "text": "sunrise",
          "pattern": "SUN-rise"
        },
        {
          "text": "toothbrush",
          "pattern": "TOOTH-brush"
        }
      ]
    },
    {
      "title": "Adjective + noun phrases: stress the second word",
      "level": "advanced",
      "difficulty": "hard",
      "accent": "us",
      "explain": "Compare this to the last lesson: when it's really an adjective describing a noun (two separate words, two meanings), the stress moves to the noun.",
      "points": [
        "black BIRD = a bird that is black (any bird).",
        "BLACKbird = one specific kind of bird."
      ],
      "items": [
        {
          "text": "black bird",
          "pattern": "black BIRD",
          "note": "Any bird that happens to be black."
        },
        {
          "text": "green house",
          "pattern": "green HOUSE",
          "note": "A house painted green."
        },
        {
          "text": "White House",
          "pattern": "White HOUSE",
          "note": "Compare: WHITEhouse (compound) doesn't exist — this stays two words."
        },
        {
          "text": "hot dog",
          "pattern": "hot DOG",
          "note": "A dog that is hot (not the food, HOT dog)."
        }
      ]
    },
    {
      "title": "Numbers: -teen vs -ty",
      "level": "beginner",
      "difficulty": "medium",
      "accent": "us",
      "explain": "Thirteen and thirty are often confused. The stress placement is the main difference.",
      "points": [
        "-TEEN numbers: stress the second syllable.",
        "-ty numbers: stress the first syllable."
      ],
      "items": [
        {
          "text": "thirteen",
          "pattern": "thir-TEEN"
        },
        {
          "text": "thirty",
          "pattern": "THIR-ty"
        },
        {
          "text": "fourteen",
          "pattern": "four-TEEN"
        },
        {
          "text": "forty",
          "pattern": "FOR-ty"
        },
        {
          "text": "She's thirteen, not thirty.",
          "pattern": "thir-TEEN ... THIR-ty",
          "note": "Exaggerate the contrast so listeners can tell them apart."
        }
      ]
    },
